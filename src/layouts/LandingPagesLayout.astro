---
import { Font } from "astro:assets";
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Analytics from "../components/Analytics.astro";
import ThirdPartyWidgets from "../components/ThirdPartyWidgets.astro";
import FbAnalytics from "../components/FbAnalytics.astro";
import calInlineScript from "../scripts/cal-inline.js?url";
import lpCalInlineScript from "../scripts/lp-cal-inline.js?url";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  bodyClass?: string;
  jsonLd?: unknown;
  noHeader?: boolean;
  noFooter?: boolean;
  robots?: string;
  lazyCalendar?: boolean;
  useLpCal?: boolean;
  preloadImages?: Array<{
    href: string;
    imagesrcset?: string;
    imagesizes?: string;
  }>;
}

const {
  title,
  description,
  ogImage,
  bodyClass = "",
  jsonLd,
  noHeader = false,
  noFooter = false,
  robots,
  lazyCalendar = false,
  useLpCal = false,
  preloadImages = [],
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Font cssVariable="--font-manrope" preload />
    <link
      rel="icon"
      type="image/webp"
      sizes="32x32"
      href="/assets/canvassing-app/favicon-32.webp"
    />
    <link
      rel="icon"
      type="image/webp"
      sizes="192x192"
      href="/assets/canvassing-app/favicon-192.webp"
    />
    <link
      rel="preconnect"
      href="https://www.googletagmanager.com"
      crossorigin
    />
    <!-- <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
    <link rel="dns-prefetch" href="https://unpkg.com" /> -->
    <!-- <link
      rel="stylesheet"
      href="https://googleapis.com/css2?family=Manrope:wght@200..800&display=swap"
    /> -->

    {
      preloadImages.map((image) => (
        <link
          rel="preload"
          as="image"
          href={image.href}
          imagesrcset={image.imagesrcset}
          imagesizes={image.imagesizes}
        />
      ))
    }
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      robots={robots}
    />
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
    <Analytics />
  </head>
  <body class={bodyClass}>
    <Analytics placement="body" />
    <ThirdPartyWidgets talkgenie={false} />
    {
      !noHeader && (
        <header>
          <nav>
            <a href="/">Home</a>
          </nav>
        </header>
      )
    }
    <slot />
    {
      !noFooter && (
        <footer class="relative overflow-hidden border-t border-white/10 bg-[#0d2b0a]">
          <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary-500/60 to-transparent" />
          <div class="my-container">
            <div class="flex flex-col items-center gap-4 py-10 text-center sm:py-12">
              <a href="/" aria-label="Knockio home">
                <img
                  src="/assets/cfw/knockio-logo.webp"
                  alt="Knockio"
                  width="320"
                  height="96"
                  class="mx-auto h-8 w-auto object-contain sm:h-9"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <p class="max-w-md text-sm leading-6 text-white/50">
                Door-to-door sales software built for canvassing teams from the
                first knock to the paid invoice.
              </p>
              <a
                href="mailto:hello@knockio.com"
                class="text-sm font-medium text-white/70 transition hover:text-primary-400"
              >
                hello@knockio.com
              </a>
            </div>

            <div class="flex flex-col items-center gap-5 border-t border-white/10 py-6 sm:flex-row sm:justify-between">
              <p class="order-2 text-xs text-white/45 sm:order-1 sm:text-sm">
                &copy; {currentYear} Knockio. All rights reserved.
              </p>

              <div class="order-1 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm sm:order-2">
                <a
                  href="/privacy-policy/"
                  class="text-white/70 transition hover:text-primary-400"
                >
                  Privacy Policy
                </a>
                <span class="text-white/25" aria-hidden="true">
                  /
                </span>
                <a
                  href="/terms-and-conditions/"
                  class="text-white/70 transition hover:text-primary-400"
                >
                  Terms & Conditions
                </a>
              </div>

              <div class="order-3 flex items-center gap-2.5">
                {[
                  ["https://www.facebook.com/knockioapp", "Facebook", "f"],
                  [
                    "https://www.linkedin.com/company/knockio",
                    "LinkedIn",
                    "in",
                  ],
                  ["https://x.com/knockioapp", "X", "x"],
                  ["https://www.youtube.com/@knockioapp", "YouTube", "yt"],
                ].map(([href, label, text]) => (
                  <a
                    href={href}
                    aria-label={label}
                    class="grid h-9 w-9 place-items-center rounded-full border border-white/15 text-xs font-bold uppercase text-white/70 transition hover:border-primary-500/50 hover:text-primary-400"
                    target="_blank"
                    rel="noopener"
                  >
                    {text}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </footer>
      )
    }
    <FbAnalytics />
    
    <script src="../scripts/canvassing-app.js"></script>
    {useLpCal ? (
      <script src="../scripts/lp-cal-inline.js"></script>
    ) : (
      <script src="../scripts/cal-inline.js"></script>
    )}
    <script src="../scripts/calendar-cta.js"></script>
  </body>
</html>
