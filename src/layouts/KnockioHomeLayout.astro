---
import { Font } from "astro:assets";
import "../styles/global.css";
import "../styles/knockio-home.css";
import "../styles/homepage.css";
import SEO from "../components/SEO.astro";
import Analytics from "../components/Analytics.astro";
import ThirdPartyWidgets from "../components/ThirdPartyWidgets.astro";
import FbAnalytics from "../components/FbAnalytics.astro";
import KnockioHomeHeader from "../components/KnockioHomeHeader.astro";
import KnockioHomeFooter from "../components/KnockioHomeFooter.astro";
import CalcomEmbed from "../components/CalcomEmbed.astro";
import ExitIntentModal from "../components/ExitIntentModal.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: unknown;
  fAwsm?: boolean;
  whiteBg?: boolean;
  robots?: string;
  exitIntent?: boolean;
}

const {
  title,
  description,
  ogImage,
  jsonLd,
  fAwsm = false,
  whiteBg = false,
  robots,
  exitIntent = true
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Font cssVariable="--font-manrope" preload />
    <link
      rel="icon"
      type="image/webp"
      sizes="32x32"
      href="/assets/canvassing-app/favicon-32.webp"
    />
    <link
      rel="icon"
      type="image/webp"
      sizes="192x192"
      href="/assets/canvassing-app/favicon-192.webp"
    />
    <link
      rel="preconnect"
      href="https://www.googletagmanager.com"
      crossorigin
    />
    {
      fAwsm && (
        <link
          rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css"
          integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer"
        />
      )
    }
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      robots={robots}
    />
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
    <Analytics />
  </head>
  <body class="">
    <Analytics placement="body" />

    <KnockioHomeHeader whiteBg={whiteBg} />

    <slot />

    <CalcomEmbed />
    <KnockioHomeFooter />

    <ThirdPartyWidgets />
    <FbAnalytics />
    {
      exitIntent && (
        <ExitIntentModal />
        )
    }
    <script src="../scripts/home.js" ></script>
    <script src="../scripts/lp-cal-inline.js" ></script>
    <script src="../scripts/calendar-cta.js"></script>

        {
      exitIntent && (
        <script src="../scripts/exit-intent.js"></script>
        )
    }
  </body>
</html>
