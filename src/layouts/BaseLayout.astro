---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Analytics from '../components/Analytics.astro';
import ThirdPartyWidgets from '../components/ThirdPartyWidgets.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  bodyClass?: string;
  jsonLd?: unknown;
  noHeader?: boolean;
  noFooter?: boolean;
  preloadImages?: Array<{
    href: string;
    imagesrcset?: string;
    imagesizes?: string;
  }>;
}

const {
  title,
  description,
  ogImage,
  bodyClass = '',
  jsonLd,
  noHeader = false,
  noFooter = false,
  preloadImages = [],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" sizes="32x32" href="/assets/canvassing-app/favicon-32.webp" />
    <link rel="icon" type="image/webp" sizes="192x192" href="/assets/canvassing-app/favicon-192.webp" />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
    <link rel="dns-prefetch" href="https://unpkg.com" />
    {
      preloadImages.map((image) => (
        <link
          rel="preload"
          as="image"
          href={image.href}
          imagesrcset={image.imagesrcset}
          imagesizes={image.imagesizes}
        />
      ))
    }
    <SEO title={title} description={description} ogImage={ogImage} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <Analytics />
  </head>
  <body class={bodyClass}>
    <Analytics placement="body" />
    <ThirdPartyWidgets />
    {!noHeader && <header>
      <nav>
        <a href="/">Home</a>
      </nav>
    </header>}
    <slot />
    {!noFooter && <footer>
      <p>&copy; {new Date().getFullYear()} XYZ. All rights reserved.</p>
    </footer>}
  </body>
</html>
