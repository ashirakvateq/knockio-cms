---
import KnockioHomeLayout from '../layouts/KnockioHomeLayout.astro';
import '../styles/field-service-crm/index.css';
import {
  Boxes,
  ChartLine,
  Check,
  CloudLightning,
  ListChecks,
  MessagesSquare,
  Phone,
  Plug,
  Quote,
  UserRound,
} from 'lucide-astro';

const title = 'Field Service CRM & Contractor Management Software | Knockio';
const description =
  'Knockio is a field service management software for scheduling, technician dispatch, work orders, estimates, and payments, all in one easy-to-use CRM.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://knockio.com/field-service-crm/#software',
      name: 'Knockio Field Service CRM',
      url: 'https://knockio.com/field-service-crm/',
      applicationCategory: 'BusinessApplication',
      applicationSubCategory:
        'Field Service CRM, Field Service Management Software',
      operatingSystem: 'Web, iOS, Android',
      description:
        "Knockio's field service CRM for scheduling, dispatch, estimates, invoicing, and customer records.",
      provider: {
        '@id': 'https://knockio.com/#organization',
      },
      isPartOf: {
        '@id': 'https://knockio.com/#software',
      },
      featureList: [
        'Customer management',
        'Job scheduling',
        'Crew dispatching',
        'Estimates and proposals',
        'Invoicing and payments',
        'Service history',
      ],
      offers: {
        '@type': 'AggregateOffer',
        lowPrice: '30.00',
        highPrice: '35.00',
        priceCurrency: 'USD',
        url: 'https://knockio.com/pricing/',
      },
    },
    {
      '@type': 'WebPage',
      '@id': 'https://knockio.com/field-service-crm/#webpage',
      url: 'https://knockio.com/field-service-crm/',
      name: 'Field Service CRM & Management Software | Knockio',
      description:
        'Knockio is a field service management software for scheduling, technician dispatch, work orders, estimates, and payments, all in one easy-to-use CRM.',
      isPartOf: {
        '@id': 'https://knockio.com/#website',
      },
      about: {
        '@id': 'https://knockio.com/field-service-crm/#software',
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://knockio.com/field-service-crm/#breadcrumb',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://knockio.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Field Service CRM',
          item: 'https://knockio.com/field-service-crm/',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://knockio.com/field-service-crm/#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is Knockio Service CRM?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Knockio Service CRM is a customer and field service management system that covers everything from the first lead to the final payment: customer details, jobs, crews, schedules, estimates, and invoices. It keeps that data connected so sales teams, office staff, and field crews all work from the same system.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does Knockio help field service teams?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Knockio covers the full workflow: capturing leads, storing customer details, creating estimates, scheduling jobs, assigning crews, tracking job progress, uploading photos, sending invoices, and following up with customers afterward.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can Knockio manage customer and job history?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Yes. Knockio keeps customer's notes, past visits, job details, photos, documents, invoices, payments, and messages together on their profile, so your team can see what happened before and what's next.",
          },
        },
        {
          '@type': 'Question',
          name: 'Does Knockio support estimates and invoices?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Knockio supports estimates, proposals, invoices, and payment tracking. Your team can move a customer from lead to estimate, then from approved work to scheduled job and invoice. This keeps sales and service steps connected instead of spread across different tools.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is Knockio useful for both sales and service teams?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Knockio is built for teams that need both sales and service workflows. Sales reps can manage leads and proposals, while office and field teams can manage scheduling, dispatching, job updates, invoices, and customer service history from the same CRM.',
          },
        },
      ],
    },
  ],
};
---

<KnockioHomeLayout title={title} description={description} jsonLd={jsonLd}>
  <div id="field-service-crm-page">
    <!-- Hero -->
    <section
      class="hero-background relative z-0 overflow-hidden pt-32 text-center text-white sm:pt-36 md:pt-40 lg:pt-44 xl:pt-[200px]"
    >
      <div class="my-container">
        <div class="mx-auto max-w-6xl">
          <div
            class="mb-3 flex items-center justify-center gap-3 max-md:flex-col max-md:gap-1"
          >
            <span class="text-sm font-medium text-neutral-200 sm:text-base">
              The CRM built to organize your field service operations
            </span>
          </div>

          <h1
            class="mx-auto mb-4 max-w-5xl text-4xl font-extrabold leading-[1.15] text-white sm:text-5xl md:text-[52px] lg:text-6xl lg:leading-[1.12] xl:text-[64px] xl:leading-[76px]"
          >
            The Complete Field Service CRM for Contractors
          </h1>

          <p
            class="mx-auto mb-7 max-w-5xl text-base font-normal leading-7 text-neutral-200 sm:text-lg sm:leading-8"
          >
            Knockio is a field service CRM built to run your back office, from
            customer records to crew dispatch and invoicing. When your sales reps
            close a deal using our
            <a
              href="/canvassing/"
              class="font-semibold text-white underline decoration-primary-500 underline-offset-4 transition hover:text-primary-400 ml-1"
            >
              canvassing app
            </a>,
            this contractor CRM takes over. Manage work orders, dispatch crews, send
            digital estimates, and collect on-site payments without ever switching
            between disconnected tools.
          </p>

          <div
            class="my-6 flex flex-wrap items-center justify-center gap-3 sm:gap-4"
          >
            <a
              href="https://play.google.com/store/apps/details?id=com.knockio.crm&hl=en"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex rounded-lg shadow-md transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-400"
              aria-label="Download Knockio from Google Play"
            >
              <img
                decoding="async"
                src="/assets/cfw/google-play-button.webp"
                alt="Download on Google Play"
                width="176"
                height="52"
                class="h-auto w-36 sm:w-40 lg:w-[145px] xl:w-44"
              />
            </a>

            <a
              href="https://apps.apple.com/us/app/knockio/id6756485440"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex rounded-lg shadow-md transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-400"
              aria-label="Download Knockio from the App Store"
            >
              <img
                decoding="async"
                src="/assets/cfw/apple-store-button.webp"
                alt="Download on the App Store"
                width="176"
                height="52"
                class="h-auto w-36 sm:w-40 lg:w-[145px] xl:w-44"
              />
            </a>
          </div>

          <div class="flex items-center justify-center">
            <a
              href="#cal-sec"
              class="inline-flex min-h-12 w-full items-center justify-center rounded-lg border border-solid border-primary-500 bg-primary-500 px-6 py-3 text-base font-medium text-white transition hover:bg-transparent focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-400 sm:w-60 lg:text-lg"
            >
              Schedule a Demo
            </a>
          </div>
        </div>

        <img
          src="/assets/cfw/field-service-crm-landing-hero-img.webp"
          alt="Field Service CRM"
          width="1200"
          height="720"
          class="mx-auto mt-12 hidden h-auto w-full md:block lg:mt-16 xl:mt-20"
          loading="eager"
          decoding="async"
        />
      </div>
    </section>

    <section class="py-16 sm:py-20 lg:py-36 bg-neutral-50">
      <div class="my-container mx-auto">
        <div class="text-center max-w-[846px] mx-auto mb-10 lg:mb-14">
          <h2
            class="text-3xl leading-tight sm:text-4xl lg:text-[42px] xl:text-5xl 2xl:text-[56px] lg:leading-none font-bold text-neutral-950 mb-5"
          >
            Smarter Service CRM, Better <br class="hidden md:block" />
            Field Control
          </h2>

          <p
            class="text-neutral-600 text-sm leading-6 sm:text-base sm:leading-7 md:text-lg md:leading-8 font-normal"
          >
            Field work gets confusing when leads, jobs, notes, calls, crews, and
            invoices live in different tools. Knockio keeps customer data and
            service work connected.
          </p>
        </div>

        <div
          class="rounded-3xl lg:rounded-[40px] overflow-hidden px-4 pt-6 sm:px-8 sm:pt-10 lg:px-10 lg:pt-12 w-fit mx-auto bg-neutral-100 mb-14"
        >
          <img
            decoding="async"
            src="/assets/cfw/all-devices-view-knockio.webp"
            alt="Dashboard Preview"
            width="1280"
            height="800"
            loading="lazy"
            class="h-auto w-full max-w-5xl"
          />
        </div>

        <div class="grid gap-8 lg:grid-cols-3 sm:grid-cols-2 lg:gap-14">
          <div class="border border-neutral-200 rounded-2xl p-6 sm:p-8 lg:p-10">
            <div
              class="w-10 h-10 xl:w-14 xl:h-14 text-2xl xl:text-3xl flex items-center justify-center rounded-lg bg-primary-500 text-white mb-4"
            >
              <span class="font-bold text-white">1</span>
            </div>
            <h3 class="font-semibold text-xl text-neutral-900 mb-2">
              Customer Management
            </h3>
            <p class="text-neutral-600 text-sm leading-normal">
              Store customer names, contact details, addresses, notes, photos, job history, and service records in one simple CRM for faster daily work.
            </p>
          </div>

          <div class="border border-neutral-200 rounded-2xl p-6 sm:p-8 lg:p-10">
            <div
              class="w-10 h-10 xl:w-14 xl:h-14 text-2xl xl:text-3xl flex items-center justify-center rounded-lg bg-primary-500 text-white mb-4"
            >
              <span class="font-bold text-white">2</span>
            </div>
            <h3 class="font-semibold text-xl text-neutral-900 mb-2">
              Lead to Job Conversion
            </h3>
            <p class="text-neutral-600 text-sm leading-normal">
              Turn new leads into customers, estimates, proposals, scheduled jobs, invoices, and payments without losing important sales or service details.
            </p>
          </div>

          <div class="border border-neutral-200 rounded-2xl p-6 sm:p-8 lg:p-10">
            <div
              class="w-10 h-10 xl:w-14 xl:h-14 text-2xl xl:text-3xl flex items-center justify-center rounded-lg bg-primary-500 text-white mb-4"
            >
              <span class="font-bold text-white">3</span>
            </div>
            <h3 class="font-semibold text-xl text-neutral-900 mb-2">
              Job Scheduling
            </h3>
            <p class="text-neutral-600 text-sm leading-normal">
              Schedule jobs, assign crews, manage appointments, and keep office teams and field teams updated before work starts.
            </p>
          </div>

          <div class="border border-neutral-200 rounded-2xl p-6 sm:p-8 lg:p-10">
            <div
              class="w-10 h-10 xl:w-14 xl:h-14 text-2xl xl:text-3xl flex items-center justify-center rounded-lg bg-primary-500 text-white mb-4"
            >
              <span class="font-bold text-white">4</span>
            </div>
            <h3 class="font-semibold text-xl text-neutral-900 mb-2">
              Crew Dispatching
            </h3>
            <p class="text-neutral-600 text-sm leading-normal">
              Send the right crew to the right job with clear customer details, job notes, location, and task information.
            </p>
          </div>

          <div class="border border-neutral-200 rounded-2xl p-6 sm:p-8 lg:p-10">
            <div
              class="w-10 h-10 xl:w-14 xl:h-14 text-2xl xl:text-3xl flex items-center justify-center rounded-lg bg-primary-500 text-white mb-4"
            >
              <span class="font-bold text-white">5</span>
            </div>
            <h3 class="font-semibold text-xl text-neutral-900 mb-2">
              Estimates and Proposals
            </h3>
            <p class="text-neutral-600 text-sm leading-normal">
              Create estimates, send digital proposals, share pricing details, and move approved work into the next service step.
            </p>
          </div>

          <div class="border border-neutral-200 rounded-2xl p-6 sm:p-8 lg:p-10">
            <div
              class="w-10 h-10 xl:w-14 xl:h-14 text-2xl xl:text-3xl flex items-center justify-center rounded-lg bg-primary-500 text-white mb-4"
            >
              <span class="font-bold text-white">6</span>
            </div>
            <h3 class="font-semibold text-xl text-neutral-900 mb-2">
              Invoices and Payments
            </h3>
            <p class="text-neutral-600 text-sm leading-normal">
              Create invoices, track payments, and connect billing details to the same customer and job record for easier follow-up.
            </p>
          </div>

          <div class="border border-neutral-200 rounded-2xl p-6 sm:p-8 lg:p-10">
            <div
              class="w-10 h-10 xl:w-14 xl:h-14 text-2xl xl:text-3xl flex items-center justify-center rounded-lg bg-primary-500 text-white mb-4"
            >
              <span class="font-bold text-white">7</span>
            </div>
            <h3 class="font-semibold text-xl text-neutral-900 mb-2">
              Service History
            </h3>
            <p class="text-neutral-600 text-sm leading-normal">
              Keep past jobs, notes, photos, documents, calls, messages, and invoices connected to each customer for better future service.
            </p>
          </div>

          <div class="border border-neutral-200 rounded-2xl p-6 sm:p-8 lg:p-10">
            <div
              class="w-10 h-10 xl:w-14 xl:h-14 text-2xl xl:text-3xl flex items-center justify-center rounded-lg bg-primary-500 text-white mb-4"
            >
              <span class="font-bold text-white">8</span>
            </div>
            <h3 class="font-semibold text-xl text-neutral-900 mb-2">
              Task Tracking
            </h3>
            <p class="text-neutral-600 text-sm leading-normal">
              Assign tasks, set reminders, track job progress, and help teams know what needs to be done next.
            </p>
          </div>

          <div class="border border-neutral-200 rounded-2xl p-6 sm:p-8 lg:p-10">
            <div
              class="w-10 h-10 xl:w-14 xl:h-14 text-2xl xl:text-3xl flex items-center justify-center rounded-lg bg-primary-500 text-white mb-4"
            >
              <span class="font-bold text-white">9</span>
            </div>
            <h3 class="font-semibold text-xl text-neutral-900 mb-2">
              Field Updates
            </h3>
            <p class="text-neutral-600 text-sm leading-normal">
              Let crews update job status, add notes, upload photos, and share work details from the field in real time.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- Pricing Plans -->
    <section
      id="pricing-plans"
      class="relative z-10 py-20 max-xl:py-16 max-lg:py-14"
    >
      <div class="my-container">
        <!-- Section Heading -->
        <div class="mb-10 text-center max-md:mb-7">
          <h2
            class="mx-auto mb-4 max-w-3xl font-inter text-[56px] font-bold leading-tight text-neutral-900 max-2xl:text-5xl max-xl:text-4xl max-md:text-3xl"
          >
            Straightforward pricing. No surprises.
          </h2>

          <p class="mx-auto max-w-xl text-lg text-neutral-600 max-xl:text-base">
            Start with the plan your team needs now. Add users as you grow, with
            volume discounts applied automatically at 5 users.
          </p>
        </div>

        <!-- Pricing Benefits -->
        <div class="mb-12 flex flex-wrap items-center justify-center gap-3">
          <div
            class="flex items-center rounded-full border border-solid border-neutral-200 px-5 py-2.5 text-sm text-neutral-900"
          >
            <Check
              class="mr-2 size-4 shrink-0 text-primary-500"
              aria-hidden="true"
            />
            <span>Pro-rated billing</span>
          </div>

          <div
            class="flex items-center rounded-full border border-solid border-neutral-200 px-5 py-2.5 text-sm text-neutral-900"
          >
            <Check
              class="mr-2 size-4 shrink-0 text-primary-500"
              aria-hidden="true"
            />
            <span>No setup fee</span>
          </div>

          <div
            class="flex items-center rounded-full border border-solid border-neutral-200 px-5 py-2.5 text-sm text-neutral-900"
          >
            <Check
              class="mr-2 size-4 shrink-0 text-primary-500"
              aria-hidden="true"
            />
            <span>No contracts</span>
          </div>
        </div>

        <!-- Pricing Cards -->
        <div
          class="mx-auto grid max-w-[920px] grid-cols-1 items-stretch gap-14 md:grid-cols-2 max-xl:gap-7"
        >
          <!-- Organize Plan -->
          <div
            class="flex flex-col rounded-3xl border border-solid border-neutral-200 p-8 transition duration-150 ease-out hover:scale-[1.03] max-md:p-6"
          >
            <div class="mb-3 flex items-center gap-4">
              <Boxes class="size-5 text-orange-600" aria-hidden="true" />

              <h3 class="text-3xl font-bold text-neutral-900 max-xl:text-2xl">
                Organize
              </h3>
            </div>

            <p class="mb-5 text-base leading-7 text-neutral-700 max-md:mb-4">
              For teams that need CRM, pipelines, estimates, work orders,
              invoices, contracts, and customer records.
            </p>

            <div
              class="mb-1 flex items-end text-5xl font-bold text-neutral-900 max-md:text-4xl"
            >
              <span>$30</span>

              <span class="mb-1 ml-2 text-base font-normal text-neutral-500">
                /user/mo
              </span>
            </div>

            <p class="mb-6 text-sm text-neutral-500 max-md:mb-5">
              <span>$35</span>/user for 1–4 users
            </p>

            <button
              type="button"
              data-package="5"
              aria-label="Start Organize plan"
              class="knockio-checkout-btn mb-8 w-full cursor-pointer rounded-md border border-solid border-primary-500 bg-white py-3 font-medium text-primary-500 transition-colors duration-200 hover:bg-primary-500 hover:text-white"
            >
              Start Organize
            </button>

            <h4
              class="mb-4 text-xl font-semibold text-neutral-900 max-md:mb-3 max-md:text-lg"
            >
              Features Included:
            </h4>

            <ul class="flex-1 space-y-3.5 text-neutral-700">
              <li
                class="flex items-start text-base leading-7 max-md:text-[15px]"
              >
                <Check
                  class="mr-3 mt-1 size-4 shrink-0 text-primary-500"
                  aria-hidden="true"
                />
                <span>Pipelines & Lead Management</span>
              </li>

              <li
                class="flex items-start text-base leading-7 max-md:text-[15px]"
              >
                <Check
                  class="mr-3 mt-1 size-4 shrink-0 text-primary-500"
                  aria-hidden="true"
                />
                <span>Estimates & Work Orders</span>
              </li>

              <li
                class="flex items-start text-base leading-7 max-md:text-[15px]"
              >
                <Check
                  class="mr-3 mt-1 size-4 shrink-0 text-primary-500"
                  aria-hidden="true"
                />
                <span>Invoices & Payments</span>
              </li>

              <li
                class="flex items-start text-base leading-7 max-md:text-[15px]"
              >
                <Check
                  class="mr-3 mt-1 size-4 shrink-0 text-primary-500"
                  aria-hidden="true"
                />
                <span>Digital Contracts & E-Signature</span>
              </li>

              <li
                class="flex items-start text-base leading-7 max-md:text-[15px]"
              >
                <Check
                  class="mr-3 mt-1 size-4 shrink-0 text-primary-500"
                  aria-hidden="true"
                />
                <span>Email Communication & Permissions</span>
              </li>

              <li
                class="flex items-start text-base leading-7 max-md:text-[15px]"
              >
                <Phone
                  class="mr-3 mt-1 size-4 shrink-0 text-primary-500"
                  aria-hidden="true"
                />

                <span>
                  Engage Add-On
                  <span class="text-neutral-500"> ($15/number/mo) </span>
                </span>
              </li>

              <li
                class="flex items-start text-base leading-7 max-md:text-[15px]"
              >
                <Plug
                  class="mr-3 mt-1 size-4 shrink-0 text-neutral-400"
                  aria-hidden="true"
                />

                <span class="text-neutral-500">
                  Zapier & FlowChef integrations
                </span>
              </li>
            </ul>
          </div>

          <!-- Growth Plan -->
          <div
            class="relative flex flex-col rounded-3xl border border-solid border-[#0f172a] bg-[#0f172a] p-8 transition duration-150 ease-out hover:scale-[1.03] max-md:p-6"
          >
            <div
              class="absolute -top-4 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full border border-solid border-neutral-300 bg-primary-500 px-9 py-1.5 text-base font-medium text-white"
            >
              Recommended
            </div>

            <div class="mb-3 mt-2 flex items-center gap-4">
              <ChartLine class="size-5 text-primary-500" aria-hidden="true" />

              <h3 class="text-3xl font-bold text-white max-xl:text-2xl">
                Growth
              </h3>
            </div>

            <p class="mb-5 text-base leading-7 text-neutral-300 max-md:mb-4">
              Canvassing, CRM, jobs, estimates, invoices, payments, and
              reporting in one platform.
            </p>

            <div
              class="mb-1 flex items-end text-5xl font-bold text-white max-md:text-4xl"
            >
              <span>$45</span>

              <span class="mb-1 ml-2 text-base font-normal text-neutral-400">
                /user/mo
              </span>
            </div>

            <p class="mb-6 text-sm text-neutral-400 max-md:mb-5">
              <span>$60</span>/user for 1–4 users
            </p>

            <button
              type="button"
              data-package="6"
              aria-label="Start Growth plan"
              class="knockio-checkout-btn mb-8 w-full cursor-pointer rounded-md bg-primary-500 py-3 font-medium text-white transition-colors duration-200 hover:bg-primary-700"
            >
              Start Growth
            </button>

            <h4
              class="mb-4 text-xl font-semibold text-white max-md:mb-3 max-md:text-lg"
            >
              Features Included:
            </h4>

            <ul class="flex-1 space-y-3.5 text-neutral-300">
              <li
                class="flex items-start text-base font-semibold leading-7 max-md:text-[15px]"
              >
                <Check
                  class="mr-3 mt-1 size-4 shrink-0 text-primary-500"
                  aria-hidden="true"
                />
                <span>Full sales-to-payment workflow</span>
              </li>

              <li
                class="flex items-start text-base leading-7 max-md:text-[15px]"
              >
                <Check
                  class="mr-3 mt-1 size-4 shrink-0 text-primary-500"
                  aria-hidden="true"
                />
                <span>Unlimited workspaces</span>
              </li>

              <li
                class="flex items-start text-base leading-7 max-md:text-[15px]"
              >
                <Check
                  class="mr-3 mt-1 size-4 shrink-0 text-primary-500"
                  aria-hidden="true"
                />
                <span>Prospect + full CRM in one platform</span>
              </li>

              <li
                class="flex items-start text-base leading-7 max-md:text-[15px]"
