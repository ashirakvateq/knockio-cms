---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/restoration-job-management-software.css";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Restoration Job Management Software for Crews | Knockio";
const description = "Restoration job management software to manage water, fire, and mold jobs from first call to final invoice with documentation, work orders, and billing.";

const asset = (name: string) => `/assets/cfw/${name}`;

const capabilityTabs = [
	{
		label: "Centralized Records",
		cards: [
			{
				title: "One Record for Every Loss",
				text: "Centralized Records during every visit, log outcomes, add notes or voice notes, and move prospects into a clear CRM pipeline.",
				image: asset("inner-restoration-job-management-software-one-record-for-every-loss.webp"),
				alt: "Door-to-door canvassing in Knockio",
			},
			{
				title: "Customizable Job Pipeline",
				text: "Knockio moves each job through stages you define, such as new loss, inspection, mitigation, drying, rebuild, and claim, so owners catch a job stuck waiting on an adjuster before it stalls.",
				image: asset("inner-restoration-job-management-software-customizable-job-pipeline.webp"),
				alt: "Lead management in Knockio",
			},
			{
				title: "Communication History Per Job",
				text: "Knockio saves every call, text, and email with the homeowner, adjuster, and crew on the job record, so the full thread of a claim sits in one place instead of scattered across inboxes.",
				image: asset("inner-restoration-job-management-software-communication-history-per-job.webp"),
				alt: "Kanban-style sales pipeline in Knockio",
			},
		],
	},
	{
		label: "Respond & Schedule",
		cards: [
			{
				title: "Crew Scheduling and Dispatch",
				text: "Knockio assigns first-response and rebuild crews to the right job and keeps the office and the field on the same calendar, so an emergency loss gets a crew moving without scrambling the whole day.",
				image: asset("inner-restoration-job-management-software-crew-scheduling-and-dispatch.webp"),
				alt: "Route planning in Knockio",
			},
			{
				title: "GPS Tracking With Proximity",
				text: "Knockio shows where every crew is in real time and uses proximity intelligence to confirm how close they were to the address when they marked a job worked, so dispatch sends the closest crew to a new loss and the activity log holds up.",
				image: asset("inner-restoration-job-management-software-gps-tracking-with-proximity.webp"),
				alt: "Territory management in Knockio",
			},
			{
				title: "Automated Territory Creation",
				text: "Knockio builds service territories automatically from zip codes and cities, so after a storm event you can carve up the affected area and balance crews by region in minutes instead of mapping boundaries by hand.",
				image: asset("inner-restoration-job-management-software-automated-territory-creation.webp"),
				alt: "Field activity log in Knockio",
			},
		],
	},
	{
		label: "Document Every Loss",
		cards: [
			{
				title: "Photo Annotation for Records",
				text: "Document every loss from lead to service with notes, status updates, documents, customer details, photos, and clear next steps, so every restoration job stays fully organized from first contact through final billing.",
				image: asset("inner-restoration-job-management-software-photo-annotation-for-records.webp"),
				alt: "Job management in Knockio",
			},
			{
				title: "Job Notes, Surveys, and Readings",
				text: "Knockio captures detailed notes and survey answers on every visit, so moisture readings, drying logs, and site conditions are recorded straight to the job instead of a paper slip lost on site.",
				image: asset("inner-restoration-job-management-software-job-notes-surveys-and-readings.webp"),
				alt: "Crew dispatching in Knockio",
			},
			{
				title: "Centralized File Storage Per Job",
				text: "Knockio keeps the estimate, photos, drying logs, and signed agreements attached to the job record, so when the adjuster asks for documentation it is all in one place, not pulled from five sources.",
				image: asset("inner-restoration-job-management-software-centralized-file-storage-per-job.webp"),
				alt: "Work orders in Knockio",
			},
		],
	},
	{
		label: "Manage Equipment & Materials",
		cards: [
			{
				title: "Work Orders With Tasks, Budget, and Materials",
				text: "Knockio carries a work order with tasks, a budget, and a material takeoff for the rebuild, so drywall, flooring, and finish materials are tracked against real numbers instead of a guess from the estimate.",
				image: asset("inner-restoration-job-management-software-work-orders-with-tasks-budget-and-materials.webp"),
				alt: "Smart estimates in Knockio",
			},
			{
				title: "Inventory Management for Equipment and Supplies",
				text: "Knockio tracks products, variants, SKUs, cost, and markup for air movers, dehumidifiers, and rebuild supplies, with low-stock alerts so you know what is available before assigning it to a job.",
				image: asset("inner-restoration-job-management-software-inventory-management-for-equipment-and-supplies.webp"),
				alt: "Proposals in Knockio",
			},
			{
				title: "Vendor Bills and Purchase Orders with Knockio",
				text: "Knockio raises a purchase order to your supplier when stock runs low and records the vendor bill against that purchase order or a work order, so subcontractor and supplier spend ties straight to the job and your claim numbers stay accurate.",
				image: asset("inner-restoration-job-management-software-vendor-bills-and-purchase-orders-with-knockio.webp"),
				alt: "Digital contracts in Knockio",
			},
		],
	},
	{
		label: "Get Paid",
		cards: [
			{
				title: "Digital Contracts with E-Signs",
				text: "Knockio sends work authorizations and agreements for digital signature with a documented audit trail, IP address and timestamp logged on every view and signature, so you have authorization on file before mitigation starts.",
				image: asset("inner-restoration-job-management-software-digital-contracts-with-e-signs.webp"),
				alt: "Video and file storage in Knockio",
			},
			{
				title: "Milestone-Based Collection",
				text: "Knockio collects a deposit, progress draws as mitigation and rebuild phases complete, and the final balance at closeout, all tied to the job, so cash flow moves with the work instead of waiting on one claim payout at the end.",
				image: asset("inner-restoration-job-management-software-milestone-based-collection.webp"),
				alt: "Photo uploads in Knockio",
			},
			{
				title: "Flexible Payment Methods",
				text: "Knockio processes tap to pay, text to pay, card, and ACH through its own payment platform, so deductibles and balances get collected on site or remotely, with the money tied to the right job.",
				image: asset("inner-restoration-job-management-software-flexible-payment-methods.webp"),
				alt: "Service reports in Knockio",
			},
		],
	},
];

const organizedItems = [
	{
		title: "Live Field Tracking",
		text: "Knockio monitors crews in real time with GPS tracking and proximity intelligence, so dispatch knows who is on which loss and can route the closest crew to the next emergency.",
		href: "https://knockio.com/features/gps-tracking-software/",
		icon: "crosshair" as const,
	},
	{
		title: "Native Automation Builder",
		text: "Knockio runs automations you build without code: an authorization request when a job is opened, an adjuster update when a phase completes, or an equipment-check reminder during drying. You set the trigger and Knockio handles the rest.",
		href: "https://knockio.com/features/business-automation-software/",
		icon: "sparkles" as const,
	},
	{
		title: "Job History and Media",
		text: "Knockio keeps every job's annotated photos, drying logs, and notes in one view, so the office, the field, and the adjuster work from the same record.",
		href: "#",
		icon: "ruler" as const,
	},
	{
		title: "E-Contracts",
		text: "Create contracts, send them for approval, capture digital signatures, and move every accepted deal forward without messy paperwork.",
		href: "https://knockio.com/e-contracts/",
		icon: "file" as const,
	},
	{
		title: "CRM Integrations",
		text: "Knockio integrates your restoration jobs and claim records with Salesforce, HubSpot, Google Calendar, and GHL, reaching thousands of apps via Zapier, FlowChef, and webhooks.",
		href: "https://knockio.com/knockio-integrations/",
		icon: "zap" as const,
	},
	{
		title: "Team Communication",
		text: "Knockio connects mitigation crews, rebuild teams, and adjusters to the same job record through assignees and notes, so claim updates reach everyone without a separate email chain.",
		href: "https://knockio.com/features/business-texting-and-calling-software/",
		icon: "message" as const,
	},
];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
	{
		q: "What should I look for in restoration software?",
		a: "Look for fast damage documentation, full job history per address, work orders with equipment and materials, e-contracts for authorizations, and flexible billing, all tied to one job record. The platform should hold everything an adjuster might ask for in one place. Knockio was built to run mitigation and rebuild from the same system.",
	},
	{
		q: "Which software is best for a small restoration company?",
		a: "Knockio helps field service teams manage the full workflow. Teams can Centralized Records, store customer details, create estimates, schedule jobs, assign crews, track job progress, upload photos, send invoices, and follow up with customers. This helps reduce manual work and keeps everyone updated.",
	},
	{
		q: "Can Knockio document damage for insurance claims?",
		a: "Yes. Knockio captures annotated photos, notes, surveys, and readings on the job record, and stores the estimate, drying logs, and signed authorizations together, so the documentation an adjuster needs is in one place.",
	},
	{
		q: "Can Knockio bill a job in stages?",
		a: "Yes. Knockio supports milestone-based payment collection, so you can take a deposit, bill progress draws as mitigation and rebuild phases complete, and collect the final balance at closeout, all tied to the job.",
	},
	{
		q: "Can Knockio track my crews and equipment?",
		a: "Yes. Knockio includes live GPS tracking with proximity intelligence for crews, and inventory management tracks air movers, dehumidifiers, and supplies, so you know who and what is assigned to each job.",
	},
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const heroImage = asset("inner-industry-restoration-job-software.webp");

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://knockio.com/industry/restoration-job-management-software/#webpage",
      url: "https://knockio.com/industry/restoration-job-management-software/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      audience: {
        "@type": "Audience",
        audienceType: "Restoration Contractors",
      },
      mainEntity: {
        "@id": "https://knockio.com/industry/restoration-job-management-software/#faq",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://knockio.com/industry/restoration-job-management-software/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Restoration Job Management Software",
          item: "https://knockio.com/industry/restoration-job-management-software/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/industry/restoration-job-management-software/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={heroImage}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="resto-industry-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white"
    >
      <div
        class="grid min-h-0 lg:min-h-[610px] lg:grid-cols-[55%_45%] xl:min-h-[720px] 2xl:min-h-[820px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] pt-[calc(72px+3rem)] pb-12 sm:pt-[calc(72px+4rem)] sm:pb-16 lg:min-h-[600px] lg:px-0 lg:pb-[72px] lg:pt-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[36px] font-bold leading-[44px] text-neutral-950 sm:text-[44px] sm:leading-[54px] xl:text-[58px] xl:leading-[66px] 2xl:text-[64px] 2xl:leading-[74px]"
            >
              Restoration Job Management Software
            </h1>
            <p
              class="mb-10 max-w-[760px] text-base font-medium leading-8 text-neutral-600 sm:text-lg sm:leading-9"
            >
              Knockio is restoration job management software and CRM for contractors handling water, fire, and mold jobs. Manage customer records, damage photos, crews, equipment, materials, milestones, billing, and claim documentation in one place.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white transition-colors duration-300 hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <p
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              What should restoration contractors look for in a CRM and job platform?
            </p>
            <p
              class="max-w-[760px] text-[15px] leading-7 text-neutral-600 sm:text-base sm:leading-7"
            >
              A restoration contractor should look for a CRM that carries the job from first response through the insurance claim. That means full customer and property records, fast damage documentation with annotated photos, crew scheduling, work orders with equipment and materials, e-contracts, and milestone-based payment collection. Knockio handles all of it in one platform. It adds live GPS tracking with proximity intelligence and a full job history per address, so every photo, note, and reading sits on one record the adjuster can be walked through. That depth, plus affordable pricing and support that picks up the phone, is what a generic CRM built for another trade leaves out.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-resto-visual relative min-h-[340px] overflow-hidden sm:min-h-[440px] lg:min-h-full"
        >
          <img
            src={heroImage}
            alt="Roofing contractors working on a residential roof"
            width="830"
            height="560"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="h-full min-h-[340px] w-full object-cover object-center sm:min-h-[440px] lg:min-h-full"
          />
        </div>
      </div>
    </section>

    <!-- ========== Why Restoration / Sticky tabs ========== -->
    <section id="platform-capabilities" class="bg-white py-20 sm:py-24 lg:py-28">
      <div class="my-container">
        <div class="mx-auto mb-10 max-w-[1120px] text-center lg:mb-12">
          <h2
            class="mb-5 text-center text-[34px] font-bold leading-[42px] text-neutral-950 sm:text-4xl sm:leading-[48px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Why Restoration Pros Choose Knockio
          </h2>
          <p
            class="mx-auto max-w-[960px] text-base font-normal leading-8 text-neutral-600 sm:text-lg sm:leading-9"
          >
            Knockio helps restoration contractors manage customers, job
            documentation, scheduling, crews, equipment, materials, invoices, and
            payments. From the first emergency call to a settled claim, it all sits
            in one connected platform. Owners run mitigation and rebuild without
            losing track of who is where, what was documented, and what still needs
            billing.
          </p>
        </div>

        <div
          id="restoCapScrollTrack"
          class="hp-scroll-track"
          style="--scroll-steps: 5"
        >
          <div
            class="lg:sticky lg:top-0 lg:z-20 lg:flex lg:min-h-[760px] lg:flex-col lg:bg-white lg:pt-6"
          >
            <div
              class="sticky top-0 z-30 border-b border-solid border-neutral-200/80 bg-white/95 pb-5 pt-2 backdrop-blur-md lg:static lg:border-0 lg:bg-transparent lg:pb-8"
            >
              <div
                id="restoTabsNav"
                class="mx-auto flex max-w-[1050px] items-center gap-4 overflow-x-auto scroll-smooth px-1 [scrollbar-width:none] lg:justify-center [&::-webkit-scrollbar]:hidden"
                role="tablist"
                aria-label="Restoration platform capabilities"
              >
                {
                  capabilityTabs.map((tab, index) => (
                    <button
                      type="button"
                      role="tab"
                      data-resto-tab={String(index)}
                      aria-selected={index === 0 ? "true" : "false"}
                      class:list={[
                        "hp-tab-btn shrink-0 rounded-full border px-5 py-2.5 text-base font-medium leading-6 transition-all duration-300 hover:border-primary-500 hover:text-primary-500 sm:px-6",
                        index === 0
                          ? "is-active border-solid border-primary-500 bg-[#f9fff8] text-primary-500"
                          : "border-dashed border-neutral-300 bg-white text-neutral-700",
                      ]}
                    >
                      {tab.label}
                    </button>
                  ))
                }
              </div>
            </div>

            <div id="restoTabsPanels" class="relative lg:flex-1">
              {
                capabilityTabs.map((tab, tabIndex) => (
                  <div
                    class:list={["hp-panel", tabIndex === 0 && "is-active"]}
                    role="tabpanel"
                  >
                    <div class="grid gap-6 lg:grid-cols-3 lg:gap-8">
                      {tab.cards.map((card) => (
                        <article class="hp-card flex min-h-[520px] flex-col overflow-hidden rounded-[28px] border border-solid border-neutral-200 bg-neutral-50 p-7 sm:p-8">
                          <h3 class="mb-4 text-[26px] font-bold leading-8 text-neutral-950 sm:text-[30px] sm:leading-9">
                            {card.title}
                          </h3>
                          <p class="mb-8 text-base leading-7 text-neutral-600 sm:text-[17px] sm:leading-8">
                            {card.text}
                          </p>
                          <div class="mt-auto flex justify-center overflow-hidden rounded-3xl">
                            <img
                              src={card.image}
                              alt={card.alt}
                              width="430"
                              height="320"
                              decoding="async"
                              loading="lazy"
                              class="w-full max-w-[430px] object-contain object-bottom"
                            />
                          </div>
                        </article>
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="sr-only">
          {
            capabilityTabs.map((tab) => (
              <div>
                <h3>{tab.label}</h3>
                {tab.cards.map((card) => (
                  <article>
                    <h3>{card.title}</h3>
                    <p>{card.text}</p>
                  </article>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ========== Organized (dark) ========== -->
    <section
      class="relative overflow-hidden bg-[#0F172A] py-24 sm:py-28 lg:py-[150px]"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.22] [background-image:radial-gradient(rgba(255,255,255,0.65)_0.8px,transparent_0.8px)] [background-size:18px_18px]"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-14 max-w-[1120px] text-center lg:mb-20">
          <h2
            class="mb-6 text-center text-[31px] font-bold leading-[39px] text-white sm:text-4xl sm:leading-[44px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Run Mitigation and Rebuild From One System
          </h2>
          <p
            class="mx-auto max-w-[800px] text-base leading-7 text-white/80 sm:text-lg sm:leading-8"
          >
            Knockio pulls the whole restoration job into one platform, so first
            response, drying, rebuild, and the claim file run from the same place.
            Track crews, document damage, manage equipment, capture readings, and
            send digital contracts, all in one system.
          </p>
        </div>

        <div class="mx-auto grid max-w-[1380px] gap-x-12 gap-y-12 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-16 lg:gap-y-14">
          {
            organizedItems.map((item) => (
              <div class="border-b border-solid border-white/20 pb-10">
                <div class="mb-7 flex h-16 w-16 items-center justify-center rounded-xl bg-primary-500 text-white">
                  {item.icon === "crosshair" && (
                    <Crosshair class="size-[30px]" aria-hidden="true" />
                  )}
                  {item.icon === "sparkles" && (
