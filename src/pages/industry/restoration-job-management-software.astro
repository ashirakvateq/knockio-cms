const operatingModelsData = {
  pillTag: "OPERATING MODEL FLEXIBILITY",
  title: "Built for How Your Restoration Business Actually Operates",
  subtitle:
    "A water mitigation contractor and a contents pack-out specialist share a trade name, but run completely different workflows. Knockio adapts to your specific psychrometric logs, TPA programs, and rebuild pipelines out of the box.",
  cards: [
    {
      icon: "house-flood",
      title: "Water Mitigation & Drying",
      text: "Engineered for emergency water mitigation (a large share of trade revenue). Dispatch 24/7 FNOL crews, capture Direction to Pay forms on site, log 3-to-5-day IICRC S500 psychrometric drying data, and scan equipment.",
      pills: ["24/7 Emergency FNOL", "IICRC Psychrometric Logs", "Direction to Pay Forms"],
    },
    {
      icon: "trowel",
      title: "Reconstruction & Remodel",
      text: "Manage the rebuild phase after mitigation completes. Build itemized reconstruction estimates, coordinate in-house or 1099 subcontractor framing/drywall crews, and collect additional invoices as repairs advance.",
