      pills: ["TPA Program SLA Compliance", "Multi-Building Moisture Logs", "Catastrophe (CAT) Mobilization"],
    },
  ],
};

const oldStackComparisonData = {
  title: "How Knockio Replaces Your Taped-Together Restoration Stack",
  subtitle:
    "Stop paying for separate emergency dispatch apps, standalone moisture logging tools, and disconnected CRM spreadsheets. Knockio brings your mitigation crews and office into one platform.",
