		icon: "sparkles" as const,
	},
	{
		title: "Media & Measurements",
		text: "See every loss's thermal infrared photos, IICRC psychrometric drying logs, equipment barcode counts, and Xactimate ESX scopes in one view.",
		href: "#",
		icon: "ruler" as const,
	},
	{
		title: "E-Contracts",
		text: "Send emergency Work Authorizations, Direction to Pay forms, and Hazmat Discovery Waivers for e-signature with built-in legal compliance.",
		href: "https://knockio.com/e-contracts/",
		icon: "file" as const,
	},
	{
		title: "CRM Integrations",
		text: "Knockio connects your customer records, invoices, and payments to the tools you use via Zapier and webhooks. It also connects via Zapier and webhooks with Google Calendar, HubSpot, GoHighLevel (GHL), and Salesforce.",
		href: "https://knockio.com/knockio-integrations/",
		icon: "zap" as const,
	},
	{
		title: "Team Communication",
		text: "Link emergency mitigation techs, contents pack-out teams, and rebuild PMs to the same loss record so adjuster scope details never get lost.",
