---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Restoration Job Management Software for Crews | Knockio";
const description = "Restoration job management software to manage water, fire, and mold jobs from first call to final invoice with documentation, work orders, and billing.";

const asset = (name: string) => `/assets/cfw/${name}`;

const capabilityTabs = [
	{
		label: "Manage Losses & History",
		cards: [
			{
				title: "Property Loss & Insurance Claim History",
				text: "Every property record logs insurance carrier names, claim numbers, policy deductibles, adjuster contact info, TPA program details (Alacrity, Contractor Connection), and past loss history. Your team sees the complete claim background in one centralized file.",
				image: asset("inner-restoration-job-management-software-one-record-for-every-loss.webp"),
				alt: "Door-to-door canvassing in Knockio",
			},
			{
				title: "Dynamic Pipeline for Restoration Stages",
				text: "Move losses through clear stages: 24/7 Emergency FNOL, Mitigation Authorized, Water Extraction, Moisture Drying Active, Adjuster Scope Approved, Rebuild Scheduled, and Final Invoice Submitted. Separate boards for mitigation versus reconstruction.",
				image: asset("inner-restoration-job-management-software-customizable-job-pipeline.webp"),
				alt: "Lead management in Knockio",
			},
			{
				title: "Commercial Large-Loss & TPA Accounts",
				text: "Manage complex commercial flood, fire, and catastrophe (CAT) response jobs (the majority of trade revenue). Streamline TPA SLA tracking, track multi-unit job notes, and manage commercial billing.",
				image: asset("inner-restoration-job-management-software-communication-history-per-job.webp"),
				alt: "Kanban-style sales pipeline in Knockio",
			},
		],
	},
	{
		label: "Track & Dispatch",
		cards: [
			{
				title: "24/7 Emergency Live GPS Rep Tracking",
				text: "See where every mitigation crew and technician is on a live map. When a burst pipe or flood First Notice of Loss (FNOL) arrives at 2 AM, use the live rep map to assign the nearest available emergency crew immediately.",
				image: asset("inner-restoration-job-management-software-crew-scheduling-and-dispatch.webp"),
				alt: "Route planning in Knockio",
			},
			{
				title: "Auto Territory Creation by ZIP & City",
				text: "Build emergency response territories automatically from ZIP codes and cities. Target storm-affected areas or commercial property management districts after freeze events or hurricane floods.",
				image: asset("inner-restoration-job-management-software-gps-tracking-with-proximity.webp"),
				alt: "Territory management in Knockio",
			},
			{
				title: "Smarter Moisture Monitoring Routing",
				text: "Optimize daily travel routes for technicians running mandatory 3-to-5-day daily moisture monitoring visits. Ensure technicians hit every active drying site on time without unnecessary driving across town.",
				image: asset("inner-restoration-job-management-software-automated-territory-creation.webp"),
				alt: "Field activity log in Knockio",
			},
		],
	},
	{
		label: "Drying Ops & Inventory",
		cards: [
			{
				title: "IICRC S500 Psychrometric Drying Logs",
				text: "Stay compliant with industry drying standards. Technicians record daily relative humidity (RH), temperature, GPP (grains per pound), and moisture meter percentage readings across affected rooms directly into the permanent record.",
				image: asset("inner-restoration-job-management-software-photo-annotation-for-records.webp"),
				alt: "Job management in Knockio",
			},
			{
				title: "Drying Equipment Barcode Rental Tracking",
				text: "Stop losing rental revenue on forgotten equipment. Scan QR codes or barcodes on air movers, dehumidifiers, and scrubbers left on site to automate daily per-diem equipment billing against the insurance claim.",
				image: asset("inner-restoration-job-management-software-job-notes-surveys-and-readings.webp"),
				alt: "Crew dispatching in Knockio",
			},
			{
				title: "Contents Pack-Out Barcode Inventory",
				text: "Manage damaged belongings with chain-of-custody precision. Generate digital pack-out logs with barcode/QR itemization, tracking furniture and personal property through off-site ultrasonic cleaning and vault storage.",
				image: asset("inner-restoration-job-management-software-centralized-file-storage-per-job.webp"),
				alt: "Work orders in Knockio",
			},
		],
	},
	{
		label: "Documents & Compliance",
		cards: [
			{
				title: "Direction to Pay & Work Authorizations",
				text: "Capture legally binding emergency Work Authorizations and Direction to Pay e-signatures on site under duress. Keep your contract templates aligned with state rules such as Florida's AOB restrictions.",
				image: asset("inner-restoration-job-management-software-work-orders-with-tasks-budget-and-materials.webp"),
				alt: "Smart estimates in Knockio",
			},
			{
				title: "Hazmat Discovery & Asbestos NESHAP Waivers",
				text: "If crews uncover asbestos, mold, or biohazards during tear-out, immediately trigger a digital Hazmat Discovery Waiver to pause work and enforce mandatory NESHAP notification before abatement proceeds.",
				image: asset("inner-restoration-job-management-software-inventory-management-for-equipment-and-supplies.webp"),
				alt: "Proposals in Knockio",
			},
			{
				title: "Before & After Moisture Photo Proof",
				text: "Crews capture annotated photos of standing water, thermal infrared camera moisture scans, and dry structural framing—attaching undeniable visual proof to the loss file for insurance adjusters.",
				image: asset("inner-restoration-job-management-software-vendor-bills-and-purchase-orders-with-knockio.webp"),
				alt: "Digital contracts in Knockio",
			},
		],
	},
	{
		label: "Quote & Get Paid",
		cards: [
			{
				title: "Xactimate Scope & ESX Billing Alignment",
				text: "Align your field documentation directly with Xactimate billing. Export complete drying logs, equipment rental counts, and photo sheets to support your Xactimate estimate and justify supplements to the adjuster.",
				image: asset("inner-restoration-job-management-software-digital-contracts-with-e-signs.webp"),
				alt: "Video and file storage in Knockio",
			},
			{
				title: "Reconstruction Estimating & Change Orders",
				text: "Seamlessly transition from mitigation to rebuild. Build itemized reconstruction estimates, manage GC subcontractor work orders, and capture dual-signature bilateral change orders for homeowner upgrades.",
				image: asset("inner-restoration-job-management-software-milestone-based-collection.webp"),
				alt: "Photo uploads in Knockio",
			},
			{
				title: "Deductible Collection on Site",
				text: "Collect property insurance deductibles and self-pay mitigation balances immediately upon drying completion via mobile Text-to-Pay, card, or ACH—never rebating or waiving deductibles.",
				image: asset("inner-restoration-job-management-software-flexible-payment-methods.webp"),
				alt: "Service reports in Knockio",
			},
		],
	},
];

const organizedItems = [
	{
		title: "Live Field Tracking",
		text: "Knockio monitors crews in real time with GPS tracking and proximity intelligence, so dispatch knows who is on which loss and can route the closest crew to the next emergency.",
		href: "https://knockio.com/features/gps-tracking-software/",
		icon: "crosshair" as const,
	},
	{
		title: "Flow Automation",
		text: "Automatically handle the daily grind like daily moisture visit reminders, customer updates, and adjuster follow-ups so your office stays organized during surges.",
