---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Map,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Home Security Sales Software & CRM for Dealers| Knockio";
const description =
  "Home security sales software to track door-to-door reps, schedule installations, automate monitoring plan billing, and manage sales with Knockio.";

const asset = (name: string) => `/assets/cfw/${name}`;

type CapCard = {
  title: string;
  text: string;
  image: string;
  alt: string;
};

const capabilityTabs: { label: string; cards: CapCard[] }[] = [
  {
    label: "Manage Accounts & RMR",
    cards: [
      {
        title: "Customer & Security Property Profiles",
        text: "Every property record logs existing alarm panels, smart-home Z-Wave devices, camera locations, gate codes, emergency contacts, and past alarm history. Installers arrive knowing exactly what hardware is in the home before unloading their van.",
        image: asset(
          "inner-home-security-sales-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp",
        ),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "Dynamic Pipeline for Alarm Stages",
        text: "Move accounts through clear stages: D2D Lead, Credit Check Approved, Monitoring Contract Signed, Same-Day Install Dispatched, Central-Station Signal Verified, 3-Day Cancel Window Passed, and Active RMR.",
        image: asset(
          "inner-home-security-sales-software-and-crm-address-level-signup-capture.webp",
        ),
        alt: "Lead management in Knockio",
      },
      {
        title: "Multi-Year Monitored RMR Agreements",
        text: "Turn alarm sales into high-value Recurring Monthly Revenue ($1,000–$3,600 lifetime value over 36–60 months). Manage contract terms, track automatic renewal rollover dates, and process recurring invoicing.",
        image: asset(
          "inner-home-security-sales-software-and-crm-pre-knock-homeowner-data.webp",
        ),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Track & Canvass",
    cards: [
      {
        title: "Auto Territory Creation by ZIP & City",
        text: "Build canvassing territories automatically from ZIP codes and cities. Carve up residential neighborhoods and deploy summer sales teams to knock doors in minutes, tracking street-level coverage with precision.",
        image: asset(
          "inner-home-security-sales-software-and-crm-live-gps-tracking-with-proximity-intelligence.webp",
        ),
        alt: "Route planning in Knockio",
      },
      {
        title: "Live GPS Tracking of Summer Sales Reps",
        text: "See where every door-to-door sales rep, setter, and installer is in real time on a live map. Pin-drop verification confirms exactly where reps stood when marking a door worked, improving sales floor accountability.",
        image: asset(
          "inner-home-security-sales-software-and-crm-disposition-every-door.webp",
        ),
        alt: "Territory management in Knockio",
      },
      {
        title: "Smarter Setter-to-Installer Routing",
        text: "Optimize routes so door-to-door sales reps cover more ground and same-day installation technicians arrive within hours of contract signature—beating buyer's remorse by installing while the pitch is fresh.",
        image: asset(
          "inner-home-security-sales-software-and-crm-rep-activity-reporting.webp",
        ),
        alt: "Field activity log in Knockio",
      },
    ],
  },
  {
    label: "Work Orders & Hardware",
    cards: [
      {
        title: "Security Work Orders With Hardware Specs",
        text: "Build detailed work orders tracking alarm control panels, door/window sensors, motion detectors, video doorbells, and smart locks against real costs. Installers view itemized hardware takeoffs on their mobile app.",
        image: asset(
          "inner-home-security-sales-software-and-crm-pipeline-built-for-security-signups.webp",
        ),
        alt: "Job management in Knockio",
      },
      {
        title: "Purchase Orders to Alarm Distributors",
        text: "When alarm panels, cameras, or low-voltage wire run short, generate a purchase order for your supplier such as ADI Global, Anixter, or Alarm.com distributors before shortages delay an install.",
        image: asset(
          "inner-home-security-sales-software-and-crm-communication-history-per-homeowner.webp",
        ),
        alt: "Crew dispatching in Knockio",
      },
      {
        title: "Van Stock & Hardware Tracking",
        text: "Track sensors, cameras, and smart-home automation hardware across individual technician vans. Know exactly which installer has outdoor wireless cameras before routing them to a same-day upgrade call.",
        image: asset(
          "inner-home-security-sales-software-and-crm-appointment-and-install-scheduling.webp",
        ),
        alt: "Work orders in Knockio",
      },
    ],
  },
  {
    label: "Documents & Compliance",
    cards: [
      {
        title: "FTC 3-Day Notice of Cancellation Disclosures",
        text: "Stay compliant with federal door-to-door sales laws. You can add the mandatory FTC 3-Day Notice of Cancellation to your contract templates, which appends it to every digital monitoring agreement, complete with timestamped IP audit trails.",
        image: asset(
          "inner-home-security-sales-software-and-crm-photo-annotation-at-the-door.webp",
        ),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "Municipal False-Alarm Permit Registration",
        text: "Prevent expensive municipal false-alarm dispatch fines for your customers. Capture and permanently store local police and fire alarm permit registration numbers directly on the property record.",
        image: asset(
          "inner-home-security-sales-software-and-crm-e-contracts-for-monitoring-agreements.webp",
        ),
        alt: "Proposals in Knockio",
      },
      {
        title: "Central-Station Signal Verification Logs",
        text: "Gate account activation on verified safety. Technicians log live testing of police, fire, and medical panic signals with the central-station monitoring center (e.g., Manitou) before leaving the customer's home.",
        image: asset(
          "inner-home-security-sales-software-and-crm-centralized-file-storage-per-homeowner.webp",
        ),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
  {
    label: "Quote & Get Paid",
    cards: [
      {
        title: "Fast Doorstep Package & RMR Quoting",
        text: "Create interactive security package proposals at the door in minutes. Compare base intrusion alarm plans against full smart-home automation packages with cameras, quoting upfront equipment versus monthly RMR.",
        image: asset(
          "inner-home-security-sales-software-and-crm-native-automation-builder.webp",
        ),
        alt: "Video and file storage in Knockio",
      },
      {
        title: "Monitoring Contract Records",
        text: "Protect your dealership from chargebacks. Add a credit status step to your pipeline that flags contract execution, ensuring only qualified homeowners sign 36-to-60-month monitoring agreements.",
        image: asset(
          "inner-home-security-sales-software-and-crm-communication-history-for-follow-ups.webp",
        ),
        alt: "Photo uploads in Knockio",
      },
      {
        title: "Same-Day Activation & Recurring Invoicing Billing",
        text: "Capture card or ACH details on file during the doorstep sale. Automatically trigger initial equipment charges and begin recurring monthly RMR recurring invoicing the moment the installer verifies central-station signals.",
        image: asset(
          "inner-home-security-sales-software-and-crm-flexible-payment-collection.webp",
        ),
        alt: "Service reports in Knockio",
      },
    ],
  },
];

const organizedItems = [
