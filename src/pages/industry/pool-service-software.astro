];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const operatingModelsData = {
  pillTag: "OPERATING MODEL FLEXIBILITY",
  title: "Built for How Your Pool Service Business Actually Operates",
  subtitle:
    "A weekly residential cleaning route and a commercial HOA pool maintenance contract share a trade name, but run completely different workflows. Knockio adapts to your specific LSI chemistry logs, equipment repairs, and leak detection out of the box.",
  cards: [
    {
      icon: "water-ladder",
      title: "Recurring Weekly Maintenance",
      text: "Engineered for high-density weekly cleaning routes. Optimize route clustering, calculate LSI water chemistry in-app, capture before/after clean photos, and trigger recurring invoicing upon proof of service.",
      pills: ["LSI Chemistry Calculator", "Before/After Photo Proof", "Route Density Planning"],
    },
    {
      icon: "cog",
      title: "Equipment Repair & Upgrades",
      text: "Maximize profit margins on equipment repairs. Quote variable-speed pumps, automation systems, heaters, and salt cells with instant SMS customer approval, supplier PO tracking, and invoices.",
      pills: ["Instant SMS Quoting", "POOLCORP / SCP POs", "Variable-Speed Pump Quotes"],
    },
    {
      icon: "droplet",
      title: "Leak Detection & Testing",
      text: "Streamline specialized acoustic listening and pressure-testing leak detection services ($350–$800 diagnostic fees). Generate structured diagnostic finding reports that convert directly into repair excavation quotes.",
      pills: ["Acoustic Diagnostic Reports", "Underwater Photo Proof", "Repair Excavation Quotes"],
    },
    {
      icon: "hotel",
      title: "Commercial HOA & Hotel Pools",
      text: "Serve hotels, gyms, and HOA community pools requiring daily or multi-weekly maintenance. Log CPO (Certified Pool Operator) credentials, maintain health department chemical records, and handle commercial billing.",
      pills: ["CPO Compliance Logging", "Health Dept Audit Trails", "Multi-Day Route Schedules"],
    },
  ],
};

const oldStackComparisonData = {
  title: "How Knockio Replaces Your Taped-Together Pool Service Stack",
  subtitle:
    "Stop paying for separate route apps, standalone chemical calculators, and manual invoicing spreadsheets. Knockio brings your cleaning technicians, repair specialists, and office into one platform.",
  rows: [
    {
      stage: "Canvassing & Routes",
      oldStack: "Paying per seat for standalone door apps without visibility into where your existing weekly pool routes are clustered.",
      knockio: "Built-in D2D canvassing that targets streets adjacent to your existing routes to maximize route density.",
    },
    {
      stage: "Chemistry & Proof",
      oldStack: "Technicians guessing chemical dosages or writing readings on paper slips without capturing visual proof of a clean pool.",
      knockio: "Mobile LSI chemistry calculator, chemical dosing logs, and timestamped before/after photo proof of service.",
    },
    {
      stage: "Equipment Repairs",
      oldStack: "Texting pump model numbers to the office and waiting days to email formal repair quotes to homeowners.",
      knockio: "Fast mobile quoting for pumps and filters sent via SMS for instant digital customer approval.",
    },
    {
      stage: "Recurring Billing",
      oldStack: "Chasing monthly paper checks or manually running credit cards after route technicians turn in paper checklists.",
      knockio: "Automated recurring invoicing triggered immediately after chemical logs and service photos are uploaded.",
    },
  ],
};

const heroImage = asset("inner-industry-pool-service-software.webp");

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://knockio.com/industry/pool-service-software/#webpage",
      url: "https://knockio.com/industry/pool-service-software/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      audience: {
        "@type": "Audience",
        audienceType: "Pool Cleaning and Maintenance Pros",
      },
      mainEntity: {
        "@id": "https://knockio.com/industry/pool-service-software/#faq",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://knockio.com/industry/pool-service-software/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Pool Service Software & CRM",
          item: "https://knockio.com/industry/pool-service-software/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/industry/pool-service-software/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={heroImage}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="industry-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white"
    >
      <div
        class="grid min-h-0 lg:min-h-[610px] lg:grid-cols-[55%_45%] xl:min-h-[720px] 2xl:min-h-[820px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] pt-[calc(72px+3rem)] pb-12 sm:pt-[calc(72px+4rem)] sm:pb-16 lg:min-h-[600px] lg:px-0 lg:pb-[72px] lg:pt-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[36px] font-bold leading-[44px] text-neutral-950 sm:text-[44px] sm:leading-[54px] xl:text-[58px] xl:leading-[66px] 2xl:text-[64px] 2xl:leading-[74px]"
            >
              Pool Service Software<br class="hidden xl:block" />
              That Runs Your Route
            </h1>
            <p
              class="mb-10 max-w-[760px] text-base font-medium leading-8 text-neutral-600 sm:text-lg sm:leading-9"
            >
              Pool service is a weekly rhythm. The same customers, the same route, chemical readings logged at every stop, and a filter swap or pump repair worked when something breaks. Knockio is pool service software built for cleaners and maintenance pros who need one place to hold customer records, schedule recurring stops, route techs, log chemical readings and dosing, and collect payment.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white transition-colors duration-300 hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <p
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              What should pool service companies look for in a CRM and route platform?
            </p>
            <p
              class="max-w-[760px] text-[15px] leading-7 text-neutral-600 sm:text-base sm:leading-7"
            >
              A pool service company should look for a CRM that carries the account the whole way, from the first clean to a steady weekly plan. That means full customer and pool records, recurring scheduling, route planning, technician tracking, chemical and reading logs, on-site quotes, and payment collection. Knockio handles all of it in one platform. It adds live GPS tracking with proximity intelligence and automated territory creation by zip code and city, so route assignments and service history live in the same record. That depth, plus affordable pricing and support that actually answers, is what a generic CRM built for another industry leaves out.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-industry-visual relative min-h-[340px] overflow-hidden sm:min-h-[440px] lg:min-h-full"
        >
          <img
            src={heroImage}
            alt="What should pool service companies look for in a crm and route platform"
            width="830"
            height="560"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="h-full min-h-[340px] w-full object-cover object-center sm:min-h-[440px] lg:min-h-full"
          />
        </div>
      </div>
    </section>

    <!-- ========== Why Pool Pros / Sticky tabs ========== -->
    <section id="platform-capabilities" class="bg-white py-20 sm:py-24 lg:py-28">
      <div class="my-container">
        <div class="mx-auto mb-10 max-w-[1120px] text-center lg:mb-12">
          <h2
            class="mb-5 text-center text-[34px] font-bold leading-[42px] text-neutral-950 sm:text-4xl sm:leading-[48px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Why Pool Pros Choose Knockio
          </h2>
          <p
            class="mx-auto max-w-[960px] text-base font-normal leading-8 text-neutral-600 sm:text-lg sm:leading-9"
          >
            Knockio helps pool cleaning and maintenance businesses manage customer accounts, recurring routes, techs, chemical logs, repairs, invoices, and payments. From the first service call to a renewing weekly plan, it all sits in one connected platform. Owners keep the route running and the billing clean without the back-and-forth between three different tools.
          </p>
        </div>

          <div
            id="hpCapScrollTrack"
            class="h-[calc(100vh+(var(--scroll-steps,5)-1)*45vh)] max-lg:h-auto motion-reduce:h-auto"
            style="--scroll-steps: 5"
          >
            <div
              class="contents lg:flex lg:sticky lg:top-0 lg:z-20 lg:h-[min(calc(100vh-2rem),880px)] lg:flex-col lg:bg-white/95 lg:pt-1 motion-reduce:h-auto motion-reduce:static"
            >
              <div
                class="sticky top-0 z-30 shrink-0 bg-white/95 px-1 pb-5 pt-2 backdrop-blur-md max-lg:overflow-hidden"
              >
                <div
                  id="hpTabs1Nav"
                  class="relative mx-auto flex max-w-6xl scroll-smooth items-center gap-2 overflow-x-auto [scrollbar-width:none] max-xl:gap-3 lg:justify-between max-lg:flex-nowrap max-lg:justify-start max-lg:px-[12vw] [&::-webkit-scrollbar]:hidden"
                  role="tablist"
                  aria-label="Pool platform capabilities"
                >
                  <span
                    id="hpTabs1Indicator"
                    class="pointer-events-none absolute left-0 top-0 z-0 rounded-full border-2 border-solid border-primary-500 bg-[#F9FFF8] transition-all duration-300 ease-out"
                    aria-hidden="true"></span>
                  {
                    capabilityTabs.map((tab, index) => (
                      <button
                        type="button"
                        data-hp-scroll-step={String(index)}
                        class:list={[
                          "hpTabs1_btn relative z-10 shrink-0 rounded-full border-2 px-5 py-2.5 text-lg font-bold transition-colors hover:border-primary-500/40 hover:text-primary-500 max-xl:px-4 max-xl:py-2 max-xl:text-base max-md:text-sm",
                          index === 0
                            ? "border-transparent text-primary-500"
                            : "border-dashed border-neutral-300 text-neutral-700",
                        ]}
                      >
                        {tab.label}
                      </button>
                    ))
                  }
                </div>
              </div>

              <div id="hpTabs1Panels" class="relative lg:flex-1">
                {
                  capabilityTabs.map((tab, tabIndex) => (
                    <div
                      id={`hpTabs${tabIndex + 1}_tab${tabIndex + 1}`}
                      class:list={[
