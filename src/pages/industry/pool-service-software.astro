---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Pool Service Software & CRM for Pool Pros | Knockio";
const description = "Pool service software to schedule cleanings, manage repairs, route technicians, send invoices, collect payment on site, and grow with Knockio.";

const asset = (name: string) => `/assets/cfw/${name}`;

const capabilityTabs = [
  {
    label: "Best for Pool Jobs",
    cards: [
      {
        title: "One Record for Every Pool",
        text: "Best for pool jobs during every visit, log outcomes, add notes or quick voice notes, and move prospects into a clear CRM pipeline, so your whole team sees the full history and no lead slips.",
        image: asset("inner-pool-cleaning-and-maintenance-software-one-record-for-every-pool.webp"),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "Chemical Readings and Dosing Logs",
        text: "Capture pH, chlorine, and other readings on every stop, along with what was added, saved straight to the pool record. You build a clean chemistry history per account instead of scribbled numbers on a slip.",
        image: asset("inner-pool-service-software-chemical-readings-and-dosing-logs.webp"),
        alt: "Lead management in Knockio",
      },
      {
        title: "Communication History Per Customer",
        text: "Every call, text, and email tied to a customer lands on the record, so when someone asks to skip a week or reports green water, the whole back-and-forth is right there instead of buried in a phone.",
        image: asset("inner-pool-cleaning-and-maintenance-software-communication-history-per-customer.webp"),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Schedule and Route",
    cards: [
      {
        title: "Recurring Weekly Scheduling",
        text: "Set up weekly, biweekly, or custom recurring stops, and let the schedule build itself out so the office is not rebooking every account by hand. Seasonal openings and closings stay on the calendar instead of slipping.",
        image: asset("inner-pool-cleaning-and-maintenance-software-recurring-weekly-scheduling.webp"),
        alt: "Route planning in Knockio",
      },
      {
        title: "Tight Route Planning",
        text: "Plan smarter, tighter routes so your techs cover more pools in less time each day, instead of zigzagging back and forth across town between accounts that sit just a few streets apart.",
        image: asset("inner-pool-cleaning-and-maintenance-software-tight-route-planning.webp"),
        alt: "Territory management in Knockio",
      },
      {
        title: "Automated Territory Creation",
        text: "Carve your service area into routes automatically from zip codes and cities, instead of mapping every boundary by hand. As you pick up accounts in a new subdivision, you can stand up a route in minutes. Most pool service tools simply do not do this.",
        image: asset("inner-pool-cleaning-and-maintenance-software-automated-territory-creation-by-zip-code-and-city.webp"),
        alt: "Field activity log in Knockio",
      },
    ],
  },
  {
    label: "Keep Techs Accountable",
    cards: [
      {
        title: "Live GPS Tracking With Proximity Intelligence",
        text: "Keep Techs Accountable from lead to service with notes, status updates, documents, customer details, and clear next steps.",
        image: asset("inner-pool-cleaning-and-maintenance-software-live-gps-tracking-with-proximity-intelligence.webp"),
        alt: "Job management in Knockio",
      },
      {
        title: "Photo Annotation for Pool Conditions",
        text: "Snap a photo of cloudy water, a torn liner, or a worn-out pump, then mark it up with notes and arrows, so the office can quote a repair and the customer sees what you saw.",
        image: asset("inner-pool-cleaning-and-maintenance-software-photo-annotation-for-pool-conditions.webp"),
        alt: "Crew dispatching in Knockio",
      },
      {
        title: "Service Notes and Surveys on Site",
        text: "Drop detailed notes on every visit and use built-in surveys to capture equipment condition or extra work spotted, saved straight to the account instead of a slip lost in the truck.",
        image: asset("inner-pool-cleaning-and-maintenance-software-service-notes-and-surveys-on-site.webp"),
        alt: "Work orders in Knockio",
      },
    ],
  },
  {
    label: "Parts, and Inventory",
    cards: [
      {
        title: "Work Orders for Equipment Repairs",
        text: "When a pump or heater needs replacing, build a work order with tasks, a budget, and a material takeoff, so a repair is tracked against real numbers instead of a guess scribbled on the back of a route slip.",
        image: asset("inner-pool-cleaning-and-maintenance-software-work-orders-for-equipment-repairs.webp"),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "Inventory Management for Parts and Chemicals",
        text: "Track products, variants, SKUs, cost, and markup for everything from chlorine tabs to filter cartridges, with low-stock alerts so you reorder before a tech rolls up without the part on the truck.",
        image: asset("inner-pool-service-software-inventory-management-for-parts-and-chemicals.webp"),
        alt: "Proposals in Knockio",
      },
      {
        title: "Create Vendor Bills and Purchase Orders",
        text: "Raise a purchase order when stock runs low, then record the vendor bill against that purchase order or a work order, so what you buy from your supply house ties straight to the job and your numbers stay honest.",
        image: asset("inner-pool-cleaning-and-maintenance-software-vendor-bills-and-purchase-orders.webp"),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
  {
    label: "Quote and Get Paid",
    cards: [
      {
        title: "On-Site Quotes and Estimates",
        text: "Build estimates with optional line items, so a salt cell upgrade or an acid wash goes on the quote without a second visit. Save templates and pull from a service catalog so pricing stays consistent across every tech.",
        image: asset("inner-pool-service-software-on-site-quotes-and-estimates.webp"),
        alt: "Video and file storage in Knockio",
      },
      {
        title: "Digital Contracts",
        text: "Send service agreements for digital signature with a documented audit trail, so a recurring maintenance plan is locked in with a clean legal record instead of a verbal yes.",
        image: asset("inner-pool-cleaning-and-maintenance-software-digital-contracts-with-e-signatures.webp"),
        alt: "Photo uploads in Knockio",
      },
      {
        title: "Flexible Payment Collection",
        text: "Collect one-time repairs and recurring monthly balances through tap to pay, text to pay, card, or ACH, all tied directly to the account through Knockio's own payment processing, so cash flow keeps pace with the route.",
        image: asset("inner-pool-cleaning-and-maintenance-software-flexible-payment-collection.webp"),
        alt: "Service reports in Knockio",
      },
    ],
  }
];

const organizedItems = [
  {
    title: "Live Field Tracking",
    text: "Monitor techs in real time with GPS tracking and proximity intelligence. It helps with routing, accountability, and giving customers a straight answer about arrival times.",
    href: "https://knockio.com/features/gps-tracking-software/",
    icon: "crosshair" as const,
  },
  {
    title: "Native Automation Builder",
    text: "Build your own automations without code: text a customer when the tech is on the way, flag the office when a reading comes back out of range, or remind an account that their service is due. The office stops chasing the same tasks by hand.",
    href: "https://knockio.com/features/business-automation-software/",
    icon: "sparkles" as const,
  },
  {
    title: "Service History and Media",
    text: "See every pool's chemical logs, annotated photos, and notes in one view, so the office and the field are looking at the same record instead of asking each other for it.",
    href: "#",
    icon: "ruler" as const,
  },
  {
    title: "E-Contracts",
    text: "Create and send e-contracts faster, capture signatures online, and keep every approved deal moving toward the next workflow step.",
    href: "https://knockio.com/e-contracts/",
    icon: "file" as const,
  },
  {
    title: "CRM Integrations",
    text: "Knockio plugs into Salesforce, HubSpot, Google Calendar, and GHL, with thousands more apps available through Zapier, FlowChef, and webhooks, so your route data stays connected.",
    href: "https://knockio.com/knockio-integrations/",
    icon: "zap" as const,
  },
  {
    title: "Team Communication",
    text: "Knockio logs every note, assignee, and activity update on the pool record, so the next tech arrives knowing exactly what the last visit found.",
    href: "https://knockio.com/features/business-texting-and-calling-software/",
    icon: "message" as const,
  }
];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "What should I look for in pool service software?",
    a: "Look for recurring scheduling, route density planning, GPS technician tracking, LSI chemical dosing logs, before-and-after photo proof of service, on-site repair quoting, and recurring invoicing—all tied to one pool record. The platform should make a weekly route effortless to run instead of forcing you to rebook every account by hand. Knockio was built around exactly this kind of recurring, route-based service.",
  },
  {
    q: "Can technicians calculate LSI and log water chemistry on their mobile device?",
    a: "Yes. Knockio includes an integrated LSI (Langelier Saturation Index) chemistry calculator where technicians input pH, free chlorine, alkalinity, cyanuric acid, calcium hardness, and water temperature to log exact chemical dosages into the pool record.",
  },
  {
    q: "Does Knockio send after-service photo reports to homeowners?",
    a: "Yes. Technicians capture timestamped photos of the clean pool, emptied skimmer baskets, and brushed waterlines. Knockio automatically sends a branded digital service report to the homeowner, eliminating \"the tech never showed up\" billing disputes.",
  },
  {
    q: "Can Knockio gate recurring invoicing until proof of service is completed?",
    a: "Yes. You can automatically send the recurring invoice when the service is marked complete.",
  },
  {
    q: "How is Knockio different from Skimmer, Pool Brain, or Jobber for pool service companies?",
    a: "Skimmer and Pool Brain are strong on basic route management but lack native door-to-door sales canvassing, while Jobber is generic across all trades. Knockio combines neighborhood D2D canvassing, LSI chemistry logging, before/after photo proof of service, equipment POs, and recurring invoicing in one flat-rate platform.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
