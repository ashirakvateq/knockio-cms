---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Pest Control Software & CRM for Technicians | Knockio";
const description =
  "Pest control software and crm to manage recurring treatments, route technicians, send invoices, collect payment on site, and handle sales and service.";

const asset = (name: string) => `/assets/cfw/${name}`;

type CapCard = {
  title: string;
  text: string;
  image: string;
  alt: string;
};

const capabilityTabs: { label: string; cards: CapCard[] }[] = [
  {
    label: "Centralized Data",
    cards: [
      {
        title: "One Record for Every Property",
        text: "Centralize customer data during every visit, log outcomes, add notes or quick voice notes, and move prospects into a clear CRM pipeline, so your whole team sees the full history and nothing important ever slips through the cracks between calls.",
        image: asset(
          "inner-pest-control-software-and-crm-one-record-for-every-property.webp",
        ),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "Service Notes and Surveys at the Door",
        text: "Drop detailed notes on every stop, and use built-in surveys to capture what the tech found, conditions on site, and follow-up needs, all saved straight to the account instead of a paper ticket that gets lost in the truck.",
        image: asset(
          "inner-pest-control-software-and-crm-service-notes-and-surveys-at-the-door.webp",
        ),
        alt: "Lead management in Knockio",
      },
      {
        title: "Lifetime Activity Tracking",
        text: "Every status change, note, treatment, and payment is logged on a running timeline, so you can see the full story of an account at a glance, which matters when a customer disputes a charge or asks what you did six months ago.",
        image: asset(
          "inner-pest-control-software-and-crm-lifetime-activity-tracking-new.webp",
        ),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Schedule and Route",
    cards: [
      {
        title: "Recurring Service Scheduling",
        text: "Set up quarterly, monthly, or custom recurring visits, and let the schedule build itself out so the office is not rebooking every account by hand. Renewals and re-services stay on the calendar instead of falling through the cracks.",
        image: asset(
          "inner-pest-control-software-and-crm-recurring-service-scheduling.webp",
        ),
        alt: "Route planning in Knockio",
      },
      {
        title: "Route Planning for the Day",
        text: "Plan smarter, tighter routes so your techs cover more stops in less time each day, instead of zigzagging back and forth across town and burning gas and daylight between accounts that sit just a mile or two apart.",
        image: asset(
          "inner-pest-control-software-and-crm-route-planning-for-the-day.webp",
        ),
        alt: "Territory management in Knockio",
      },
      {
        title: "Automated Territory Creation",
        text: "Carve up your service area into territories automatically from zip codes and cities, instead of mapping every boundary by hand. As you grow into a new town, you can stand up a route in minutes. Most pest control tools simply do not do this.",
        image: asset(
          "inner-pest-control-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp",
        ),
        alt: "Field activity log in Knockio",
      },
    ],
  },
  {
    label: "Keep Techs Accountable",
    cards: [
      {
        title: "Live GPS Tracking of Every Tech",
        text: "Keep Techs Accountable from lead to service with notes, status updates, documents, customer details, and clear next steps.",
        image: asset(
          "inner-pest-control-software-and-crm-live-gps-tracking-of-every-tech.webp",
        ),
        alt: "Job management in Knockio",
      },
      {
        title: "Pin Drop Verification at the Stop",
        text: "Confirm how close a tech actually was to the property when they marked a stop complete, so the route log holds up when you review the day.",
        image: asset(
          "inner-pest-control-software-and-crm-pin-drop-verification-at-the-stop.webp",
        ),
        alt: "Crew dispatching in Knockio",
      },
      {
        title: "Treatment and Application Log",
        text: "Capture what was applied, where, and when on each visit, saved to the account record, so you have a clean history for compliance and for the next tech who works that property.",
        image: asset(
          "inner-pest-control-software-and-crm-treatment-and-application-logging.webp",
        ),
        alt: "Work orders in Knockio",
      },
    ],
  },
  {
    label: "Material, and Inventory",
    cards: [
      {
        title: "Work Orders for Bigger Jobs",
        text: "For a heavy infestation or a commercial account, build a work order with tasks, a budget, and a material takeoff, so a larger job is tracked against real numbers instead of a guess.",
        image: asset(
          "inner-pest-control-software-and-crm-work-orders-for-bigger-jobs.webp",
        ),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "Product and Chemical Inventory",
        text: "Track products, variants, SKUs, cost, and markup, with low-stock alerts so you reorder before a tech shows up to a job without the right product on the truck.",
        image: asset(
          "inner-pest-control-software-and-crm-product-and-chemical-inventory-new.webp",
        ),
        alt: "Proposals in Knockio",
      },
      {
        title: "Create Purchase Orders in Knockio",
        text: "Raise a purchase order straight from a work order or on its own when inventory runs short, and keep receiving tied to the same system that tracks what you use.",
        image: asset(
          "inner-pest-control-software-and-crm-purchase-orders-when-stock-runs-low.webp",
        ),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
  {
    label: "Billing With Detail",
    cards: [
      {
        title: "On-Site Estimates and Service Agreements",
        text: "Build estimates with optional line items, so an add-on like a termite inspection or a mosquito treatment goes on the ticket without a second trip. Save templates and pull from a service catalog so pricing stays the same across every tech.",
        image: asset(
          "inner-pest-control-software-and-crm-on-site-estimates-and-service-agreements.webp",
        ),
        alt: "Video and file storage in Knockio",
      },
      {
        title: "Digital Contracts With E-Signatures",
        text: "Send service agreements for digital signature with a documented audit trail, so recurring maintenance plans are locked in with a clean legal record and timestamp instead of just a verbal yes over the phone.",
        image: asset(
          "inner-pest-control-software-and-crm-digital-contracts-with-e-signatures.webp",
        ),
        alt: "Photo uploads in Knockio",
      },
      {
        title: "Flexible Payment Collection with Knockio",
        text: "Collect one-time and recurring balances through tap to pay, text to pay, card, or ACH, all tied directly to the account through Knockio's own payment processing, so cash flow keeps pace with the route.",
        image: asset(
          "inner-pest-control-software-and-crm-flexible-payment-collection.webp",
        ),
        alt: "Service reports in Knockio",
      },
    ],
  },
];

const organizedItems = [
  {
    title: "Live Field Tracking",
    text: "Monitor techs in real time with GPS tracking. It helps with routing, accountability, and giving customers a straight answer about arrival times.",
    href: "https://knockio.com/features/gps-tracking-software/",
    icon: "crosshair" as const,
  },
  {
    title: "Flow Automation",
    text: "Automatically handle reminders, re-service callbacks, and appointment confirmations, so a quarterly account does not slip past its service window while the office is buried in something else.",
    href: "https://knockio.com/features/business-automation-software/",
    icon: "sparkles" as const,
  },
  {
    title: "Service History and Media",
    text: "See every account's photos, treatment notes, and survey answers in one view, so the office and the field are looking at the same record instead of asking each other for it.",
    href: null,
    icon: "ruler" as const,
  },
  {
    title: "E-Contracts",
    text: "Turn approved estimates into signed contracts faster with digital review, clear approvals, fewer manual steps, and less back-and-forth.",
    href: "https://knockio.com/e-contracts/",
    icon: "file" as const,
  },
  {
    title: "CRM Integrations",
    text: "Tie Knockio into Salesforce, HubSpot, Google Calendar, and GHL, plus thousands of apps via Zapier, FlowChef, and webhooks, so account and route data flows everywhere.",
    href: "https://knockio.com/knockio-integrations/",
    icon: "zap" as const,
  },
  {
    title: "Team Communication",
    text: "Knockio logs assignees, notes, and activity on every account, so any tech picking up a route already knows what the last visit found.",
    href: "https://knockio.com/features/business-texting-and-calling-software/",
    icon: "message" as const,
  },
];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "Can Knockio handle recurring service schedules?",
    a: "Yes. You can set up quarterly, monthly, or custom recurring visits, and the schedule builds itself out so renewals and re-services stay on the calendar instead of getting forgotten.",
  },
  {
    q: "Can Knockio log treatments for each visit?",
    a: "Knockio helps field service teams manage the full workflow. Teams can Centralized Data, store customer details, create estimates, schedule jobs, assign crews, track job progress, upload photos, send invoices, and follow up with customers. This helps reduce manual work and keeps everyone updated.",
  },
  {
    q: "Can Knockio route and track my techs?",
    a: "Yes. Knockio includes route planning plus live GPS tracking, with pin drop verification to confirm a stop was actually worked at the property.",
  },
  {
    q: "Does Knockio collect recurring payments?",
    a: "Yes. You can collect one-time and recurring balances through tap to pay, text to pay, card, or ACH, all tied directly to the account.",
  },
  {
    q: "How is Knockio different from GorillaDesk, PestPac, or FieldRoutes for pest control companies?",
    a: "PestPac and FieldRoutes are built for large operations and can feel heavy, while GorillaDesk keeps things light but thin on deeper job tracking. Knockio sits in the middle: recurring scheduling, routing, treatment logging, work orders, and payments in one connected system, with live tech tracking, a fully customizable pipeline with unlimited boards, automated territory creation by zip and city, personalized support, and pricing that does not punish a growing route.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const heroImage = asset(
  "inner-pest-control-software-and-crm-what-should-pest-control-companies-look-for-in-a-crm-and-routing-platform.webp",
);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://knockio.com/industry/pest-control-software/#webpage",
      url: "https://knockio.com/industry/pest-control-software/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      audience: {
        "@type": "Audience",
        audienceType: "Pest Control Operators",
      },
      mainEntity: {
        "@id": "https://knockio.com/industry/pest-control-software/#faq",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://knockio.com/industry/pest-control-software/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Pest Control Software",
          item: "https://knockio.com/industry/pest-control-software/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/industry/pest-control-software/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={heroImage}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="industry-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white"
    >
      <div
        class="grid min-h-0 lg:min-h-[610px] lg:grid-cols-[55%_45%] xl:min-h-[720px] 2xl:min-h-[820px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] pt-[calc(72px+3rem)] pb-12 sm:pt-[calc(72px+4rem)] sm:pb-16 lg:min-h-[600px] lg:px-0 lg:pb-[72px] lg:pt-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[36px] font-bold leading-[44px] text-neutral-950 sm:text-[44px] sm:leading-[54px] xl:text-[58px] xl:leading-[66px] 2xl:text-[64px] 2xl:leading-[74px]"
            >
              Pest Control Software That Runs Every Route
            </h1>
            <p
              class="mb-10 max-w-[760px] text-base font-medium leading-8 text-neutral-600 sm:text-lg sm:leading-9"
            >
              Pest control lives and dies by the route. Recurring accounts,
              quarterly treatments, the re-service call that has to happen this
              week, and a tech log that has to hold up if anyone ever asks what
              was applied where. Knockio is pest control software and CRM built
              for operators who need one place to hold customer records,
              schedule recurring service, route techs, log treatments, and
              collect payment.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white transition-colors duration-300 hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <p
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              What should pest control companies look for in a CRM and routing
              platform?
            </p>
            <p
              class="max-w-[760px] text-[15px] leading-7 text-neutral-600 sm:text-base sm:leading-7"
            >
              A pest control company should look for a CRM that carries the
              account the whole way, from the first appointment to a steady
              recurring plan. That means full customer and property records,
              recurring service scheduling, route planning, technician tracking,
              treatment logging, on-site estimates, and payment collection.
              Knockio handles all of it in one platform. It also adds live GPS
              tracking of techs and automated territory creation by zip code and
              city, so route assignments and account history live in the same
              record. That depth, plus affordable pricing and support that
              actually picks up the phone, is what a generic CRM built for
              another industry leaves out.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-industry-visual relative min-h-[340px] overflow-hidden sm:min-h-[440px] lg:min-h-full"
        >
          <img
            src={heroImage}
            alt="What should pest control companies look for in a crm and routing platform"
            width="830"
            height="560"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="h-full min-h-[340px] w-full object-cover object-center sm:min-h-[440px] lg:min-h-full"
          />
        </div>
      </div>
    </section>

    <!-- ========== Why / Sticky tabs ========== -->
    <section id="platform-capabilities" class="bg-white py-20 sm:py-24 lg:py-28">
      <div class="my-container">
        <div class="mx-auto mb-10 max-w-[1120px] text-center lg:mb-12">
          <h2
            class="mb-5 text-center text-[34px] font-bold leading-[42px] text-neutral-950 sm:text-4xl sm:leading-[48px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Why Pest Control Operators Choose Knockio
          </h2>
          <p
            class="mx-auto max-w-[960px] text-base font-normal leading-8 text-neutral-600 sm:text-lg sm:leading-9"
          >
            Knockio helps pest control companies manage customer accounts,
            recurring schedules, routes, techs, treatment records, invoices, and
            payments. From the first treatment to a renewing service plan, it
            all sits in one connected platform. Owners keep the route running
            and the billing clean without the back-and-forth between three
            different tools.
          </p>
        </div>

        <div class="sr-only">
          {
            capabilityTabs.map((tab) => (
              <div>
                <h3>{tab.label}</h3>
                {tab.cards.map((card) => (
                  <article>
                    <h3>{card.title}</h3>
                    <p>{card.text}</p>
                  </article>
                ))}
              </div>
            ))
          }
        </div>

          <div
            id="hpCapScrollTrack"
            class="h-[calc(100vh+(var(--scroll-steps,5)-1)*45vh)] max-lg:h-auto motion-reduce:h-auto"
            style="--scroll-steps: 5"
          >
            <div
              class="contents lg:flex lg:sticky lg:top-0 lg:z-20 lg:h-[min(calc(100vh-2rem),880px)] lg:flex-col lg:bg-white/95 lg:pt-1 motion-reduce:h-auto motion-reduce:static"
            >
              <div
                class="sticky top-0 z-30 shrink-0 bg-white/95 px-1 pb-5 pt-2 backdrop-blur-md max-lg:overflow-hidden"
              >
                <div
                  id="hpTabs1Nav"
                  class="relative mx-auto flex max-w-6xl scroll-smooth items-center gap-2 overflow-x-auto [scrollbar-width:none] max-xl:gap-3 lg:justify-between max-lg:flex-nowrap max-lg:justify-start max-lg:px-[12vw] [&::-webkit-scrollbar]:hidden"
                  role="tablist"
                  aria-label="Pest control platform capabilities"
                >
                  <span
                    id="hpTabs1Indicator"
                    class="pointer-events-none absolute left-0 top-0 z-0 rounded-full border-2 border-solid border-primary-500 bg-[#F9FFF8] transition-all duration-300 ease-out"
                    aria-hidden="true"></span>
                  {
                    capabilityTabs.map((tab, index) => (
                      <button
                        type="button"
                        data-hp-scroll-step={String(index)}
                        class:list={[
                          "hpTabs1_btn relative z-10 shrink-0 rounded-full border-2 px-5 py-2.5 text-lg font-bold transition-colors hover:border-primary-500/40 hover:text-primary-500 max-xl:px-4 max-xl:py-2 max-xl:text-base max-md:text-sm",
                          index === 0
                            ? "border-transparent text-primary-500"
                            : "border-dashed border-neutral-300 text-neutral-700",
                        ]}
                      >
                        {tab.label}
                      </button>
                    ))
                  }
                </div>
              </div>

              <div id="hpTabs1Panels" class="relative lg:flex-1">
                {
                  capabilityTabs.map((tab, tabIndex) => (
                    <div
                      id={`hpTabs${tabIndex + 1}_tab${tabIndex + 1}`}
                      class:list={[
                        "hpTabs1_content scroll-mt-24 lg:absolute lg:inset-0 lg:flex lg:h-full lg:flex-col lg:gap-3 lg:overflow-hidden transition-opacity duration-300 max-lg:static max-lg:mb-10 max-lg:h-auto max-lg:overflow-visible max-lg:opacity-100 max-lg:visible max-lg:pointer-events-auto motion-reduce:static motion-reduce:h-auto pt-5",
                        tabIndex === 0
                          ? "opacity-100 visible pointer-events-auto"
                          : "opacity-0 invisible pointer-events-none",
                      ]}
                      role="tabpanel"
                    >
                      <div class="grid gap-6 lg:grid-cols-3 lg:gap-8">
                        {tab.cards.map((card) => (
                          <article
                            class:list={[
                              "hp-cap-card hp-card flex min-h-[520px] flex-col overflow-hidden rounded-[28px] border border-solid border-neutral-200 bg-neutral-50 p-7 sm:p-8",
                            ]}
                          >
                            <div
                              class:list={[
                                "relative z-10 shrink-0",
                              ]}
                            >
                              <h5 class="text-3xl max-2xl:text-2xl max-md:text-lg font-bold text-neutral-900 mb-3 max-md:mb-1">
                                {card.title}
                              </h5>
                              <p class="mb-8 text-base leading-7 text-neutral-600 sm:text-[17px] sm:leading-8">
                                {card.text}
                              </p>
                            </div>
                            <div class="mt-auto flex justify-center overflow-hidden rounded-3xl">
                              <img
                                src={card.image}
                                alt={card.alt}
                                width="430"
                                height="320"
                                decoding="async"
                                loading="lazy"
                                class="w-full max-w-[430px] object-contain object-bottom"
                              />
                            </div>
                          </article>
                        ))}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
      </div>
    </section>

    <!-- ========== Organized (dark) ========== -->
    <section
