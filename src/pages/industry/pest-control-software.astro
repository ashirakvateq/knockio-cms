---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Pest Control Software & CRM for Technicians | Knockio";
const description =
  "Pest control software and crm to manage recurring treatments, route technicians, send invoices, collect payment on site, and handle sales and service.";

const asset = (name: string) => `/assets/cfw/${name}`;

type CapCard = {
  title: string;
  text: string;
  image: string;
  alt: string;
};

const capabilityTabs: { label: string; cards: CapCard[] }[] = [
  {
    label: "Manage Accounts & Routes",
    cards: [
      {
        title: "Customer & Pest Activity History",
        text: "Every property record logs target pests (ants, roaches, rodents), bait station locations, gate access codes, pet alerts, and historical treatment notes. Technicians arrive knowing exactly where the problem areas are around the perimeter before stepping out of the truck.",
        image: asset(
          "inner-pest-control-software-and-crm-one-record-for-every-property.webp",
        ),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "Dynamic Pipeline for Pest Control Stages",
        text: "Move accounts through clear stages: Lead, Initial Service Scheduled, Active Quarterly Subscription, Re-Service Requested, Annual Termite Inspection Due, and Renewal. Fully customize statuses for general household pest versus WDO termite accounts.",
        image: asset(
          "inner-pest-control-software-and-crm-service-notes-and-surveys-at-the-door.webp",
        ),
        alt: "Lead management in Knockio",
      },
      {
        title: "Recurring Quarterly Service Schedules",
        text: "Turn initial sales into predictable recurring revenue. Set up quarterly, bi-monthly, or seasonal service cadences that automatically re-populate on your route board so renewals and re-services never drop off the calendar.",
        image: asset(
          "inner-pest-control-software-and-crm-lifetime-activity-tracking-new.webp",
        ),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Track & Route",
    cards: [
      {
        title: "Auto Territory Creation by ZIP & City",
        text: "Build canvassing territories automatically from ZIP codes and cities instead of drawing boundaries by hand. Carve up a high-density residential neighborhood and get summer sales teams knocking doors in minutes.",
        image: asset(
          "inner-pest-control-software-and-crm-recurring-service-scheduling.webp",
        ),
        alt: "Route planning in Knockio",
      },
      {
        title: "Live GPS Tracking & Pin-Drop Verification",
        text: "See where every canvasser and route technician is in real time. Pin-drop verification confirms exactly how close a technician stood to a property when marking a service complete, eliminating \"tech never showed up\" customer disputes.",
        image: asset(
          "inner-pest-control-software-and-crm-route-planning-for-the-day.webp",
        ),
        alt: "Territory management in Knockio",
      },
      {
        title: "Smarter Pest Control Route Planning",
        text: "Optimize daily routes for technicians running 15 to 20 residential stops a day. Maximize route density by clustering neighborhoods together, reducing windshield time and saving fuel across your fleet.",
        image: asset(
          "inner-pest-control-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp",
        ),
        alt: "Field activity log in Knockio",
      },
    ],
  },
  {
    label: "Treatments & Inventory",
    cards: [
      {
        title: "EPA Chemical & Dilution Dosing Logs",
        text: "Stay compliant with state and federal pesticide laws. Technicians record exact EPA registration numbers, dilution rates, product quantities, target pests, and wind/weather conditions directly into the customer's permanent record.",
        image: asset(
          "inner-pest-control-software-and-crm-live-gps-tracking-of-every-tech.webp",
        ),
        alt: "Job management in Knockio",
      },
      {
        title: "Purchase Orders for Chemical Supply",
        text: "When termiticides, baits, aerosol sprays, or safety PPE run short, generate a purchase order for your supplier such as Veseris or Target Specialty Products before stockouts stall your route.",
        image: asset(
          "inner-pest-control-software-and-crm-pin-drop-verification-at-the-stop.webp",
        ),
        alt: "Crew dispatching in Knockio",
      },
      {
        title: "Truck Stock & Chemical Tracking",
        text: "Track chemical usage and bait station supplies across individual technician vehicles. Know exactly which truck has termiticide or rodent exclusion hardware before dispatching them to a specialty call.",
        image: asset(
          "inner-pest-control-software-and-crm-treatment-and-application-logging.webp",
        ),
        alt: "Work orders in Knockio",
      },
    ],
  },
  {
    label: "Documents & Compliance",
    cards: [
      {
        title: "WDO & Termite Inspection Reports",
        text: "Generate official Wood-Destroying Organism (WDO) inspection reports (like Florida FDACS-13645) signed by certified inspectors. Store termite protection plans and guarantees attached directly to the property record.",
        image: asset(
          "inner-pest-control-software-and-crm-work-orders-for-bigger-jobs.webp",
        ),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "Bed Bug & Prep Liability Waivers",
        text: "When selling high-liability bed bug heat remediation or fumigation, require customers to sign mandatory Pre-Treatment Homeowner Preparation Checklists and Waivers before technicians begin treatment.",
        image: asset(
          "inner-pest-control-software-and-crm-product-and-chemical-inventory-new.webp",
        ),
        alt: "Proposals in Knockio",
      },
      {
        title: "Commercial Sanitation & Audit Logs",
        text: "Store restaurant, warehouse, and food-processing compliance logs, pest sighting trends, and trap inspection diagrams in one centralized portal ready for health department or third-party auditor reviews.",
        image: asset(
          "inner-pest-control-software-and-crm-purchase-orders-when-stock-runs-low.webp",
        ),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
  {
    label: "Quote & Get Paid",
    cards: [
      {
        title: "Fast Doorstep Agreement Builder",
        text: "Create digital service agreements in under 5 minutes at the door. Quote initial flush-out pricing alongside recurring quarterly rates, and capture customer e-signatures on a tablet before buyer's remorse sets in.",
        image: asset(
          "inner-pest-control-software-and-crm-on-site-estimates-and-service-agreements.webp",
        ),
        alt: "Video and file storage in Knockio",
      },
      {
        title: "E-Contracts With Auto-Renewal Disclosures",
        text: "Send recurring service agreements that let you add state automatic-renewal disclosures and FTC 3-Day Cancellation notices to your contract templates — documenting your recurring service terms with timestamped IP audit trails.",
        image: asset(
          "inner-pest-control-software-and-crm-digital-contracts-with-e-signatures.webp",
        ),
        alt: "Photo uploads in Knockio",
      },
      {
        title: "Recurring Invoicing & On-Site Payment Collection",
        text: "Record the payment method on the account during the initial sale. Automatically trigger recurring invoices the moment a technician marks a quarterly service complete and uploads their chemical log.",
        image: asset(
          "inner-pest-control-software-and-crm-flexible-payment-collection.webp",
        ),
        alt: "Service reports in Knockio",
      },
    ],
  },
];

const organizedItems = [
  {
    title: "Live Field Tracking",
    text: "Monitor canvassers and route technicians in real time with GPS tracking. Verify service visits with pin-drop proximity to eliminate billing disputes.",
    href: "https://knockio.com/features/gps-tracking-software/",
    icon: "crosshair" as const,
  },
  {
    title: "Flow Automation",
    text: "Automatically handle the daily grind like quarterly service reminders, payment receipts, and renewal notices so your office staff can focus on growth.",
    href: "https://knockio.com/features/business-automation-software/",
    icon: "sparkles" as const,
  },
  {
    title: "Media & Measurements",
    text: "See every property's pest activity photos, bait station diagrams, EPA chemical logs, and WDO inspection forms in one centralized account view.",
    href: null,
    icon: "ruler" as const,
  },
  {
    title: "E-Contracts",
    text: "Send recurring service agreements and WDO termite protection plans for digital signature with auto-renewal disclosures you add to your templates, plus audit trails.",
    href: "https://knockio.com/e-contracts/",
    icon: "file" as const,
  },
  {
    title: "CRM Integrations",
    text: "Knockio connects your customer records, invoices, and payments to the tools you use via Zapier and webhooks. It also connects via Zapier and webhooks with Google Calendar, HubSpot, GoHighLevel (GHL), and Salesforce.",
    href: "https://knockio.com/knockio-integrations/",
    icon: "zap" as const,
  },
  {
    title: "Team Communication",
    text: "Link D2D sales reps, route managers, and certified applicators to the same customer record through assignees and notes so gate codes never get missed.",
    href: "https://knockio.com/features/business-texting-and-calling-software/",
    icon: "message" as const,
  },
];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "Can Knockio handle recurring quarterly service schedules automatically?",
    a: "Yes. Knockio automates your recurring service cadences. You can set up monthly, quarterly, or seasonal billing and visit cycles that automatically populate on your route board so renewals and re-services never drop off the calendar.",
  },
  {
    q: "Can technicians log EPA chemical dilution rates and target pests on their mobile device?",
    a: "Yes. Knockio's mobile app includes a dedicated chemical logging interface where technicians record EPA registration numbers, dilution rates, quantities applied, target pests, and weather conditions directly into the customer's permanent record.",
  },
  {
    q: "Does Knockio collect recurring invoicing upon service completion?",
    a: "Yes. You can automatically send the recurring invoice when the service is marked complete.",
  },
  {
    q: "How is Knockio different from FieldRoutes, PestPac, or GorillaDesk for pest control companies?",
    a: "FieldRoutes and PestPac are built for massive enterprises with complex administrative overhead, while GorillaDesk is lightweight but thin on door-to-door sales tools. Knockio sits in the sweet spot—combining native D2D canvassing, automated territory creation, recurring routing, EPA chemical logging, and recurring invoicing in one flat-rate platform.",
  },
  {
    q: "Can Knockio generate WDO and termite inspection reports?",
    a: "Yes. Knockio supports state-mandated Wood-Destroying Organism (WDO) inspection reports (such as Florida FDACS-13645) and stores annual termite protection guarantees and retreatment disclosures directly on the property record.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const operatingModelsData = {
  pillTag: "OPERATING MODEL FLEXIBILITY",
  title: "Built for How Your Pest Control Business Actually Operates",
  subtitle:
    "A general household pest route and a wildlife exclusion contractor share a trade name, but run completely different workflows. Knockio adapts to your specific subscription cadences, termite guarantees, and commercial compliance out of the box.",
  cards: [
    {
      icon: "bug",
      title: "General Household Pest Routes",
      text: "Engineered for high-density quarterly subscription routes sold door-to-door. Fast sign-to-service loops, automated recurring route rebooking, and recurring invoicing tied to proof of service.",
      pills: ["Quarterly Recurring Invoicing Billing", "High-Density Route Planning", "D2D Summer Sales Tools"],
    },
    {
      icon: "house-circle",
      title: "Termite & WDO Protection Plans",
      text: "Manage state-mandated Wood-Destroying Organism (WDO) inspections and annual termite guarantees. Explicitly declare statutory \"Retreatment Only\" versus \"Repair and Retreatment\" coverage limits on contracts.",
      pills: ["WDO State Inspection Forms", "Termite Bond Guarantees", "Annual Renewal Tracking"],
    },
    {
      icon: "paw",
      title: "Wildlife Exclusion & Trapping",
      text: "Streamline one-off wildlife trapping, structural exclusion repairs, and attic decontamination projects. Manage DNR trapping permit numbers, multi-day trap check schedules, and custom repair estimates.",
      pills: ["DNR Trapping Permit Logs", "Exclusion Repair Estimates", "Multi-Day Trap Schedules"],
    },
    {
      icon: "building-shield",
      title: "Commercial Compliance & Food Safety",
      text: "Serve restaurants, warehouses, and multi-family HOAs requiring strict audit trails. Generate detailed chemical application logs, rodent station trend reports, and health department compliance documentation.",
      pills: ["Health Inspection Audit Logs", "Rodent Trend Reporting", "Commercial PMA Billing"],
    },
  ],
};

const oldStackComparisonData = {
  title: "How Knockio Replaces Your Taped-Together Pest Control Stack",
  subtitle:
    "Stop paying for separate door-knocking apps, heavy legacy FSMs, and standalone chemical log sheets. Knockio brings your sales reps and route technicians into one platform.",
  rows: [
    {
      stage: "Door Canvassing",
      oldStack: "Paying per seat for standalone door apps (SalesRabbit/SPOTIO) that don't sync with your scheduling board.",
      knockio: "Built-in D2D canvassing, territory cutting, and instant initial-service scheduling at the door.",
    },
    {
      stage: "Route Scheduling",
      oldStack: "Spending hours manually rebooking quarterly accounts onto route sheets across scattered spreadsheets.",
      knockio: "Automated recurring route generation that clusters neighborhoods for maximum route density.",
    },
    {
      stage: "Chemical Logging",
      oldStack: "Technicians filling out paper chemical usage logs that get lost or illegible before reaching the office.",
      knockio: "Mobile EPA chemical, dilution rate, and target pest entry saved directly to the account record.",
    },
    {
      stage: "Recurring Billing",
      oldStack: "Chasing overdue checks or manually running credit cards after route technicians turn in paper tickets.",
