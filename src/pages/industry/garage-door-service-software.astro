  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const operatingModelsData = {
  pillTag: "OPERATING MODEL FLEXIBILITY",
  title: "Built for How Your Garage Door Business Actually Operates",
  subtitle:
    "A same-day residential spring repair business and a commercial loading-dock contractor share a trade name, but run completely different workflows. Knockio adapts to your specific diagnostic fees, custom factory POs, and dock contracts out of the box.",
  cards: [
    {
      icon: "wrench",
      title: "Residential Same-Day Repair",
      text: "Engineered for single-visit emergency repairs (springs, cables, openers). Quote diagnostic trip fees at booking, run multi-point safety inspections, quote itemized repairs on a tablet, and collect payment same-day.",
      pills: ["Single-Visit Repair Flow", "Torsion Spring Safety Logs", "On-Site Payment Collection"],
    },
    {
      icon: "warehouse",
      title: "Custom Residential Installation",
      text: "Streamline new door installations from consultation to install. Manage Good/Better/Best panel options, track 8-to-14-week custom factory PO lead times (Clopay/Amarr), and collect staged non-refundable deposits.",
      pills: ["8–14 Week Factory POs", "Staged 50% Deposits", "Good/Better/Best Tiers"],
    },
    {
      icon: "building",
      title: "Commercial Docks & Rolling Steel",
      text: "Serve commercial warehouses, fire stations, and retail centers. Manage rolling-steel doors, sectional gates, loading-dock levelers, and high-cycle operators with recurring preventive maintenance contracts.",
      pills: ["Rolling-Steel Maintenance", "Loading-Dock Leveler Logs", "B2B Service Contracts"],
    },
    {
      icon: "badge-check",
      title: "New Construction & Builders",
      text: "Manage multi-home builder and general contractor accounts. Coordinate volume door installations across residential developments, manage bulk factory orders, and track progress billing against GC schedules.",
      pills: ["Builder Volume Scheduling", "Bulk Manufacturer POs", "GC Progress Billing"],
    },
  ],
};

const oldStackComparisonData = {
  title: "How Knockio Replaces Your Taped-Together Garage Door Stack",
  subtitle:
    "Stop paying for basic scheduling calendars, standalone quoting apps, and manual factory order spreadsheets. Knockio brings your technicians, installers, and office into one platform.",
  rows: [
    {
      stage: "Scheduling & Dispatch",
      oldStack: "Using basic calendar apps without live GPS technician tracking or scheduling for emergency spring repairs.",
      knockio: "Visual drag-and-drop dispatch board with real-time GPS tech tracking and same-day emergency routing.",
    },
    {
      stage: "Estimating & Quoting",
      oldStack: "Writing lump-sum estimates on paper invoices without offering Good/Better/Best door replacement tiers.",
      knockio: "Interactive Good/Better/Best proposals with optional hardware add-ons and integrated consumer financing.",
    },
    {
      stage: "Factory PO Tracking",
      oldStack: "Losing track of custom carriage house door orders in manufacturer portals without alerting installation teams.",
      knockio: "Integrated purchase orders tracking 8-to-14-week factory lead times linked directly to the job stage.",
    },
    {
      stage: "Safety & Waivers",
      oldStack: "Replacing single torsion springs without requiring customers to sign a digital Declined-Repair Waiver.",
      knockio: "Mandatory digital Declined-Repair Liability Waivers and torsion spring safety calibration logs saved on site.",
    },
  ],
};

const heroImage = asset("inner-industry-garage-door-software.webp");

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id":
        "https://knockio.com/industry/garage-door-service-software/#webpage",
      url: "https://knockio.com/industry/garage-door-service-software/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      audience: {
        "@type": "Audience",
        audienceType: "Garage Door Contractors",
      },
      mainEntity: {
        "@id":
          "https://knockio.com/industry/garage-door-service-software/#faq",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id":
        "https://knockio.com/industry/garage-door-service-software/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Garage Door Service Software",
          item: "https://knockio.com/industry/garage-door-service-software/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/industry/garage-door-service-software/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={heroImage}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="industry-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white"
    >
      <div
        class="grid min-h-0 lg:min-h-[610px] lg:grid-cols-[55%_45%] xl:min-h-[720px] 2xl:min-h-[820px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] pt-[calc(72px+3rem)] pb-12 sm:pt-[calc(72px+4rem)] sm:pb-16 lg:min-h-[600px] lg:px-0 lg:pb-[72px] lg:pt-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[36px] font-bold leading-[44px] text-neutral-950 sm:text-[44px] sm:leading-[54px] xl:text-[58px] xl:leading-[66px] 2xl:text-[64px] 2xl:leading-[74px]"
            >
              Garage Door Service Software & CRM Built for Repair and Install Pros
            </h1>
            <p
              class="mb-10 max-w-[760px] text-base font-medium leading-8 text-neutral-600 sm:text-lg sm:leading-9"
            >
              Garage door companies manage two distinct tracks: same-day
              single-visit emergency repairs and high-ticket custom door
              installations with 8-to-14-week factory lead times. Knockio
              connects your service technicians, door installers, and dispatchers
              into one platform—giving garage door businesses the tools to run
              diagnostic inspections, quote itemized repairs, track custom
              factory purchase orders, log torsion spring calibration, and
              collect payments on completion.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white transition-colors duration-300 hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <p
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              What should garage door companies look for in a CRM and field
              platform?
            </p>
            <p
              class="max-w-[760px] text-[15px] leading-7 text-neutral-600 sm:text-base sm:leading-7"
            >
              A true garage door service software carries both fast same-day
              spring repairs and scheduled custom door installations without
              forcing you into two tools. That means complete property records
              with door and opener specs, visual dispatching, itemized
              hardware/labor estimating, custom factory PO lead-time tracking,
              torsion spring safety logs, Declined-Repair Waivers, and on-site
              payment billing. Knockio handles all of it in one platform—adding
              live GPS tracking of technicians so your entire job history lives
              in a single record.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-industry-visual relative min-h-[340px] overflow-hidden sm:min-h-[440px] lg:min-h-full"
        >
          <img
            src={heroImage}
            alt="What should garage door companies look for in a CRM and field platform"
            width="830"
            height="560"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="h-full min-h-[340px] w-full object-cover object-center sm:min-h-[440px] lg:min-h-full"
          />
        </div>
      </div>
    </section>

    <!-- ========== Why / Sticky tabs ========== -->
    <section id="platform-capabilities" class="bg-white py-20 sm:py-24 lg:py-28">
      <div class="my-container">
        <div class="mx-auto mb-10 max-w-[1120px] text-center lg:mb-12">
          <h2
            class="mb-5 text-center text-[34px] font-bold leading-[42px] text-neutral-950 sm:text-4xl sm:leading-[48px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Why Garage Door Teams Choose Knockio
          </h2>
          <p
            class="mx-auto max-w-[960px] text-base font-normal leading-8 text-neutral-600 sm:text-lg sm:leading-9"
          >
            Knockio helps garage door contractors manage customers, job history,
            scheduling, dispatch, estimates, parts, invoices, and payments. From
            a same-day spring repair to a scheduled door install, it all sits in
            one connected platform. Owners run the board and the field without
            losing track of who is where, what was done, and what still needs
            billing.
          </p>
        </div>

        <div class="sr-only">
          {
            capabilityTabs.map((tab) => (
              <div>
                <h3>{tab.label}</h3>
                {tab.cards.map((card) => (
                  <article>
                    <h3>{card.title}</h3>
                    <p>{card.text}</p>
                  </article>
                ))}
              </div>
            ))
          }
        </div>

          <div
            id="hpCapScrollTrack"
            class="h-[calc(100vh+(var(--scroll-steps,5)-1)*45vh)] max-lg:h-auto motion-reduce:h-auto"
            style="--scroll-steps: 5"
          >
            <div
              class="contents lg:flex lg:sticky lg:top-0 lg:z-20 lg:h-[min(calc(100vh-2rem),880px)] lg:flex-col lg:bg-white/95 lg:pt-1 motion-reduce:h-auto motion-reduce:static"
            >
              <div
                class="sticky top-0 z-30 shrink-0 bg-white/95 px-1 pb-5 pt-2 backdrop-blur-md max-lg:overflow-hidden"
              >
                <div
                  id="hpTabs1Nav"
                  class="relative mx-auto flex max-w-6xl scroll-smooth items-center gap-2 overflow-x-auto [scrollbar-width:none] max-xl:gap-3 lg:justify-between max-lg:flex-nowrap max-lg:justify-start max-lg:px-[12vw] [&::-webkit-scrollbar]:hidden"
                  role="tablist"
                  aria-label="Garage door platform capabilities"
                >
                  <span
                    id="hpTabs1Indicator"
