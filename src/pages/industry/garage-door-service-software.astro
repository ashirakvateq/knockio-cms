---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Garage Door Service Software for Repair Pros | Knockio";
const description =
  "Garage door service software to schedule repairs and installs, send estimates, dispatch techs, collect payment on site, and manage jobs.";

const asset = (name: string) => `/assets/cfw/${name}`;

type CapCard = {
  title: string;
  text: string;
  image: string;
  alt: string;
};

const capabilityTabs: { label: string; cards: CapCard[] }[] = [
  {
    label: "Manage Jobs & History",
    cards: [
      {
        title: "Door & Opener Property History",
        text: "Every property record logs garage door dimensions, panel styles, track clearances (headroom, backroom), spring wire sizes, opener brands (LiftMaster, Genie), and past repair history. Technicians arrive knowing exact door specs before stepping out of the van.",
        image: asset(
          "inner-garage-door-software-and-crm-one-record-for-every-customer-and-property.webp",
        ),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "Dynamic Pipeline for Garage Door Stages",
        text: "Move jobs through clear stages: Emergency Repair Dispatched, Multi-Point Inspection, Repair Completed Same-Day, Custom Door Quoted, 50% Deposit Paid, Factory PO Ordered, Door Received, Install Scheduled, and Warranty Active.",
        image: asset(
          "inner-garage-door-software-and-crm-customizable-job-pipeline.webp",
        ),
        alt: "Lead management in Knockio",
      },
      {
        title: "Annual Maintenance Agreements",
        text: "Turn annual garage door tune-ups into predictable repeat business. Track required annual maintenance schedules to keep manufacturer warranties valid, automate inspection reminders, and bill recurring membership fees.",
        image: asset(
          "inner-garage-door-software-and-crm-communication-history-per-customer.webp",
        ),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Track & Dispatch",
    cards: [
      {
        title: "Live GPS Tracking & Emergency Routing",
        text: "See every technician's real-time GPS location on a visual map. When a trapped vehicle or broken spring call arrives, use the live rep map to assign the nearest available repair technician immediately.",
        image: asset(
          "inner-garage-door-service-software-scheduling-and-dispatch-in-one-calendar.webp",
        ),
        alt: "Route planning in Knockio",
      },
      {
        title: "Auto Territory Creation by ZIP & City",
        text: "Carve out service zones or neighborhood canvassing territories automatically by ZIP code and city. Target aging residential neighborhoods with garage door replacement or smart opener upgrade campaigns.",
        image: asset(
          "inner-garage-door-software-and-crm-live-gps-tracking-with-proximity-intelligence.webp",
        ),
        alt: "Territory management in Knockio",
      },
      {
        title: "Smarter Garage Door Route Planning",
        text: "Optimize daily schedules for service technicians running 6 to 8 residential repair calls a day. Minimize drive time across town and keep technicians arriving within promised customer service windows.",
        image: asset(
          "inner-garage-door-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp",
        ),
        alt: "Field activity log in Knockio",
      },
    ],
  },
  {
    label: "Work Orders & Orders",
    cards: [
      {
        title: "Itemized Hardware & Labor Work Orders",
        text: "Build detailed work orders tracking torsion springs, cables, rollers, hinges, bottom seals, and opener hardware against real costs. Technicians view itemized material takeoffs and safety notes directly on their mobile app.",
        image: asset(
          "inner-garage-door-software-and-crm-detailed-estimates-with-templates.webp",
        ),
        alt: "Job management in Knockio",
      },
      {
        title: "Custom Factory PO Lead-Time Tracking",
        text: "When ordering custom carriage house or architectural wood doors, generate a purchase order straight from the job to Clopay, Amarr, or C.H.I.. Track 8-to-14-week factory lead times so install schedules stay aligned.",
        image: asset(
          "inner-garage-door-software-and-crm-work-orders-with-tasks-budget-and-materials.webp",
        ),
        alt: "Crew dispatching in Knockio",
      },
      {
        title: "Truck Stock & Spring Inventory",
        text: "Track standard torsion springs, struts, and remotes across individual service vans. Know exactly which truck has the required spring sizes before dispatching them to an emergency spring replacement call.",
        image: asset(
          "inner-garage-door-service-software-assign-work-to-crews-or-subcontractors.webp",
        ),
        alt: "Work orders in Knockio",
      },
    ],
  },
  {
    label: "Documents & Compliance",
    cards: [
      {
        title: "Torsion Spring Safety Calibration Logs",
        text: "Document vital mechanical safety data. Technicians record spring wire diameter, inner diameter, length, and exact turn counts during balancing directly into the property record to prove professional installation.",
        image: asset(
          "inner-garage-door-service-software-inventory-management-for-garage-door-parts.webp",
        ),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "Declined-Repair Liability Waivers",
        text: "When a homeowner replaces only one broken torsion spring on a dual-spring door or declines frayed cable replacement, require a digital Declined-Repair Waiver e-signature on site to insulate your company against liability.",
        image: asset(
          "inner-garage-door-software-and-crm-vendor-bills-and-purchase-orders.webp",
        ),
        alt: "Proposals in Knockio",
      },
      {
        title: "Before & After Door Photo Proof",
        text: "Technicians capture timestamped photos of damaged panels, worn gears, and balanced installations—uploading visual proof to the customer record to justify recommendations and confirm quality workmanship.",
        image: asset(
          "inner-garage-door-software-and-crm-photo-annotation-for-doors-and-repairs.webp",
        ),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
  {
    label: "Quote & Get Paid",
    cards: [
      {
        title: "Good / Better / Best Door Estimates",
        text: "Build interactive Good/Better/Best proposals comparing standard non-insulated steel doors against polyurethane insulated doors with smart belt-drive openers. Let homeowners select hardware add-ons on their phone.",
        image: asset(
          "inner-garage-door-software-and-crm-digital-contracts-with-e-signatures.webp",
        ),
        alt: "Video and file storage in Knockio",
      },
      {
        title: "Consumer Financing Documents",
        text: "Make high-end custom doors affordable. Connect customer installation quotes directly with consumer lenders like GreenSky, Service Finance, or Wisetack to present monthly payment framing and close bigger sales on site.",
        image: asset(
          "inner-garage-door-software-and-crm-flexible-payment-collection.webp",
        ),
        alt: "Photo uploads in Knockio",
      },
      {
        title: "On-Site Payment Collection",
        text: "Collect diagnostic trip fees and repair balances on completion via Text-to-Pay. For custom door installations, collect 50% non-refundable material deposits before placing factory orders.",
        image: asset(
          "inner-garage-door-software-and-crm-milestone-billing-for-larger-installs.webp",
        ),
        alt: "Service reports in Knockio",
      },
    ],
  },
];

const organizedItems = [
  {
    title: "Live Field Tracking",
    text: "Monitor technicians in real time with GPS tracking. Use the live rep map to assign the nearest available van to emergency broken spring or trapped vehicle calls.",
    href: "https://knockio.com/features/gps-tracking-software/",
    icon: "crosshair" as const,
  },
  {
    title: "Flow Automation",
    text: "Automatically handle the daily grind like annual maintenance reminders, booking confirmations, and invoice follow-ups so your office runs smoothly.",
    href: "https://knockio.com/features/business-automation-software/",
    icon: "sparkles" as const,
  },
  {
    title: "Media & Measurements",
    text: "See every job's door dimensions, track clearances, opener serial tags, before/after photos, and spring calibration logs in one view.",
    href: null,
    icon: "ruler" as const,
  },
  {
    title: "E-Contracts",
    text: "Send installation agreements and Declined-Repair Liability Waivers for digital signature with IP timestamp logging to protect your business against disputes.",
    href: "https://knockio.com/e-contracts/",
    icon: "file" as const,
  },
  {
    title: "CRM Integrations",
    text: "Knockio connects your customer records, invoices, and payments to the tools you use via Zapier and webhooks. It also connects via Zapier and webhooks with Google Calendar, HubSpot, GoHighLevel (GHL), and Salesforce.",
    href: "https://knockio.com/knockio-integrations/",
    icon: "zap" as const,
  },
  {
    title: "Team Communication",
    text: "Link repair technicians, custom door installers, and dispatchers to the same job record through assignees and notes so headroom measurements never get lost.",
    href: "https://knockio.com/features/business-texting-and-calling-software/",
    icon: "message" as const,
  },
];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "What should I look for in garage door service software?",
    a: "Look for scheduling and dispatch, full job history per address, detailed itemized estimating, work orders with hardware takeoffs, e-contracts, and flexible on-site payment—all tied to one customer record. The platform should carry both quick same-day repairs and custom door installations without forcing you into two tools. Knockio was built to run both from the same system.",
  },
  {
    q: "Can Knockio track custom factory door orders and lead times?",
    a: "Yes. When ordering custom carriage house or architectural wood doors, you can generate purchase orders to manufacturers like Clopay or Amarr straight from the job record. Knockio tracks 8-to-14-week factory lead times so your installation schedules stay perfectly aligned.",
  },
  {
    q: "Does Knockio protect my business when customers decline spring replacements?",
    a: "Yes. When a homeowner replaces only one broken torsion spring on a dual-spring door or declines frayed cable replacement, Knockio lets you capture a digital Declined-Repair Liability Waiver e-signature on site to protect your company from future damage claims.",
  },
  {
    q: "Can technicians log torsion spring safety calibration data?",
    a: "Yes. Technicians can record spring wire diameter, inner diameter, length, and exact turn counts during balancing directly into the property record to prove professional installation and code compliance.",
  },
  {
    q: "How is Knockio different from ServiceTitan, Housecall Pro, or Jobber for garage door companies?",
    a: "ServiceTitan is heavy and priced for large enterprise shops, while Housecall Pro and Jobber lack specialized garage door workflows like custom factory PO lead-time tracking and spring calibration logging. Knockio combines same-day scheduling, itemized repair quoting, Declined-Repair Waivers, and Good/Better/Best estimating in one flat-rate platform.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
