const operatingModelsData = {
  pillTag: "OPERATING MODEL FLEXIBILITY",
  title: "Built for How Your Window Cleaning Business Actually Operates",
  subtitle:
    "A residential quarterly window cleaning route and a high-rise commercial rope-access contractor share a trade name, but run completely different workflows. Knockio adapts to your specific route density, glass scratch waivers, and multi-service bundling out of the box.",
  cards: [
    {
      icon: "house",
      title: "Routine Residential & Low-Rise",
      text: "Engineered for high-density residential routes (the bulk of the market). Automate quarterly and semi-annual rebooking schedules, optimize neighborhood route clustering, and process recurring invoicing upon job completion.",
      pills: ["Quarterly Route Rebooking", "Recurring Invoicing", "Pane Count Quoting"],
