---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Window Cleaning Business Software for Cleaners | Knockio";
const description =
  "Window cleaning business software to schedule recurring cleanings, send estimates, route crews, collect payment on site, and manage jobs with Knockio.";

const asset = (name: string) => `/assets/cfw/${name}`;

const capabilityTabs = [
  {
    label: "Manage Accounts & Routes",
    cards: [
      {
        title: "Pane Counts & Property Access Profiles",
        text: "Every property record logs window pane counts, story heights, screen/track details, water-fed pole (WFP) tap locations, gate codes, and dog warnings. Cleaning crews arrive knowing exact job requirements before unloading their equipment.",
        image: asset(
          "inner-window-cleaning-software-and-crm-one-record-for-every-property.webp",
        ),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "Dynamic Pipeline for Cleaning Stages",
        text: "Move accounts through clear stages: Lead, Instant Quote Sent, Scheduled, Weekly/Quarterly Route Active, Post-Construction Cleaning, and Annual Renewal. Separate boards for residential window washing versus high-rise commercial jobs.",
        image: asset(
          "inner-window-cleaning-software-and-crm-communication-history-per-customer.webp",
        ),
        alt: "Lead management in Knockio",
      },
      {
        title: "Recurring Quarterly Service Schedules",
        text: "Turn window cleaning into predictable recurring revenue. Set up monthly, quarterly, or semi-annual service cadences that automatically re-populate on your route board so regular cleanings rebook themselves without manual selling.",
        image: asset(
          "inner-window-cleaning-business-software-lifetime-activity-tracking.webp",
        ),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Track & Route",
    cards: [
      {
        title: "Smarter Route Density Planning",
        text: "Window cleaning margins are won on route density. Optimize daily schedules for technicians running 8 to 12 residential properties a day—clustering neighborhood stops to eliminate crisscrossing and save fuel across your fleet.",
        image: asset(
          "inner-window-cleaning-software-and-crm-recurring-service-scheduling.webp",
        ),
        alt: "Route planning in Knockio",
      },
      {
        title: "Auto Territory Creation by ZIP & City",
        text: "Build canvassing territories automatically from ZIP codes and cities. Target dense residential subdivisions with spring window washing, gutter cleaning, or holiday lighting door-to-door canvassing campaigns.",
        image: asset(
          "inner-window-cleaning-software-and-crm-tight-route-planning.webp",
        ),
        alt: "Territory management in Knockio",
      },
      {
        title: "Live GPS Tracking & Pin-Drop Verification",
        text: "Monitor cleaning crews in real time on a live map. Pin-drop verification confirms exactly when a crew arrived and departed a property, providing clear proof of service to commercial property managers and homeowners.",
        image: asset(
          "inner-window-cleaning-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp",
        ),
        alt: "Field activity log in Knockio",
      },
    ],
  },
  {
    label: "Work Orders & Equipment",
    cards: [
      {
        title: "Window Cleaning Work Orders & Tasks",
        text: "Build detailed work orders tracking interior/exterior pane counts, screen washing, track detailing, and hard-water stain removal tasks. Cleaners view itemized checklists and special property notes directly on their mobile app.",
        image: asset(
          "inner-window-cleaning-software-and-crm-live-gps-tracking-with-proximity-intelligence.webp",
        ),
        alt: "Job management in Knockio",
      },
      {
        title: "Water-Fed Pole & Equipment Tracking",
        text: "Track deionized pure-water pole systems, replacement resin beads, squeegee rubbers, and pressure washing rigs across individual service vans so crews never arrive at a jobsite with worn-out equipment.",
        image: asset(
          "inner-window-cleaning-software-and-crm-photo-annotation-for-before-and-after.webp",
        ),
        alt: "Crew dispatching in Knockio",
      },
      {
        title: "Bundled Home-Services Work Orders",
        text: "Easily combine window cleaning with adjacent exterior services. Create multi-task work orders that include gutter vacuuming, house soft-washing, solar panel cleaning, or seasonal holiday lighting installation under one job.",
        image: asset(
          "inner-window-cleaning-software-and-crm-job-notes-and-surveys-on-site.webp",
        ),
        alt: "Work orders in Knockio",
      },
    ],
  },
  {
    label: "Documents & Compliance",
    cards: [
      {
        title: "Pre-Existing Glass Scratch & Defect Waivers",
        text: "Protect your company from expensive glass-damage claims. Enforce a mandatory Pre-Existing Glass Defect Acknowledgment on estimates—documenting broken thermal seals, hard-water stains, or fabrication debris scratches before washing.",
        image: asset(
          "inner-window-cleaning-business-software-on-site-quotes-and-estimates.webp",
        ),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "High-Rise OSHA & Rope-Access Checklists",
        text: "For commercial high-rise window cleaning, store mandatory OSHA fall-protection checklists, roof anchor-point certifications, and IRATA/SPRAT rope-access technician credentials attached directly to the building record.",
        image: asset(
          "inner-window-cleaning-software-and-crm-flexible-payment-collection-with-e-signatures.webp",
        ),
        alt: "Proposals in Knockio",
      },
      {
        title: "Before & After Window Photo Proof",
        text: "Technicians snap timestamped photos of clean glass, cleared gutters, and spotless sills—automatically saving visual service reports to the customer record to prove job completion and quality.",
        image: asset(
          "inner-window-cleaning-software-and-crm-flexible-payment-collection.webp",
        ),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
  {
    label: "Quote & Get Paid",
    cards: [
      {
        title: "Fast Pane-Count Quoting & Bundling",
        text: "Build fast, accurate estimates based on pane counts, story heights, and screen cleaning add-ons. Offer bundled packages combining exterior window washing with gutter cleaning and house washing for higher average tickets.",
        image: asset(
          "inner-window-cleaning-business-software-on-site-quotes-and-estimates.webp",
        ),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "E-Contracts With Liability Hold-Harmless",
        text: "Send recurring window cleaning agreements that embed mandatory liability hold-harmless waivers—documenting pre-existing window frame or glass conditions with timestamped IP audit trails.",
        image: asset(
          "inner-window-cleaning-software-and-crm-flexible-payment-collection-with-e-signatures.webp",
        ),
        alt: "Proposals in Knockio",
      },
      {
        title: "Recurring Invoicing",
        text: "Record the payment method on the account during booking. Automatically trigger recurring invoices the moment a technician marks a quarterly cleaning complete, or collect on site via mobile Text-to-Pay.",
        image: asset(
          "inner-window-cleaning-software-and-crm-flexible-payment-collection.webp",
        ),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
];

const organizedItems = [
  {
    title: "Live Field Tracking",
