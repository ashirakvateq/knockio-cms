---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Window Cleaning Business Software for Cleaners | Knockio";
const description =
  "Window cleaning business software to schedule recurring cleanings, send estimates, route crews, collect payment on site, and manage jobs with Knockio.";

const asset = (name: string) => `/assets/cfw/${name}`;

const capabilityTabs = [
  {
    label: "Centralized Data",
    cards: [
      {
        title: "One Record for Every Property",
        text: "Centralize customer data during every visit, log outcomes, add notes or voice notes, and move prospects into a clear CRM pipeline, so nothing important ever slips.",
        image: asset(
          "inner-window-cleaning-software-and-crm-one-record-for-every-property.webp",
        ),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "Communication History",
        text: "Every call, text, and email tied to a customer is saved on the record, so when someone asks to move their next clean, the whole back-and-forth is right there instead of buried in a phone.",
        image: asset(
          "inner-window-cleaning-software-and-crm-communication-history-per-customer.webp",
        ),
        alt: "Lead management in Knockio",
      },
      {
        title: "Lifetime Activity Tracking",
        text: "Every status change, note, quote, and payment lands on a running timeline, so you can see the full story of an account at a glance, which helps when a customer questions a charge or asks what you did last time.",
        image: asset(
          "inner-window-cleaning-business-software-lifetime-activity-tracking.webp",
        ),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Schedule and Route",
    cards: [
      {
        title: "Recurring Service Scheduling",
        text: "Set up monthly, quarterly, or custom recurring cleans, and let the schedule build itself out so the office is not rebooking every account by hand. Renewals stay on the calendar instead of slipping away.",
        image: asset(
          "inner-window-cleaning-software-and-crm-recurring-service-scheduling.webp",
        ),
        alt: "Route planning in Knockio",
      },
      {
        title: "Tight Route Planning",
        text: "Plan smarter routes so crews cover more stops in less time, instead of crossing town twice for two houses that sit a few blocks apart.",
        image: asset(
          "inner-window-cleaning-software-and-crm-tight-route-planning.webp",
        ),
        alt: "Territory management in Knockio",
      },
      {
        title: "Automated Territory Creation",
        text: "Carve your service area into territories automatically from zip codes and cities, instead of mapping every boundary by hand. As you expand into a new part of town, you can stand up a route in minutes.",
        image: asset(
          "inner-window-cleaning-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp",
        ),
        alt: "Field activity log in Knockio",
      },
    ],
  },
  {
    label: "Keep Crews Accountable",
    cards: [
      {
        title: "Live GPS Tracking With Proximity",
        text: "Keep Crews Accountable from lead to service with notes, status updates, documents, customer details, and clear next steps.",
        image: asset(
          "inner-window-cleaning-software-and-crm-live-gps-tracking-with-proximity-intelligence.webp",
        ),
        alt: "Job management in Knockio",
      },
      {
        title: "Photo Annotations",
        text: "Snap before-and-after photos at each stop, mark them up with notes and arrows on the image, so the customer sees the result and the next crew knows about that problem gutter.",
        image: asset(
          "inner-window-cleaning-software-and-crm-photo-annotation-for-before-and-after.webp",
        ),
        alt: "Crew dispatching in Knockio",
      },
      {
        title: "Job Notes and Surveys on Site",
        text: "Drop detailed notes on every clean and use built-in surveys to capture conditions or extra work spotted, saved straight to the account instead of a paper ticket lost in the van.",
        image: asset(
          "inner-window-cleaning-software-and-crm-job-notes-and-surveys-on-site.webp",
        ),
        alt: "Work orders in Knockio",
      },
    ],
  },
  {
    label: "Quote and Get Paid",
    cards: [
      {
        title: "On-Site Quotes and Estimates",
        text: "Build estimates with optional line items, so a screen cleaning or a gutter add-on goes on the quote without a second visit. Save templates and pull from a service catalog so pricing stays consistent across every crew.",
        image: asset(
          "inner-window-cleaning-business-software-on-site-quotes-and-estimates.webp",
        ),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "Service Agreement with E-Signs",
        text: "Send service agreements for digital signature with a documented audit trail, so a recurring plan is locked in with a clean legal record instead of a verbal handshake.",
        image: asset(
          "inner-window-cleaning-software-and-crm-flexible-payment-collection-with-e-signatures.webp",
        ),
        alt: "Proposals in Knockio",
      },
      {
        title: "Flexible Payment Collection",
        text: "Collect one-time and recurring balances through tap to pay, text to pay, card, or ACH, all tied directly to the account through Knockio's own payment processing, so cash flow keeps pace with the route.",
        image: asset(
          "inner-window-cleaning-software-and-crm-flexible-payment-collection.webp",
        ),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
];

const organizedItems = [
  {
    title: "Live Field Tracking",
    text: "Monitor crews in real time with GPS tracking and proximity intelligence. It helps with routing, accountability, and giving customers a straight answer about arrival times.",
    href: "https://knockio.com/features/gps-tracking-software/",
    icon: "crosshair" as const,
  },
  {
    title: "Native Automation Builder",
    text: "Build your own automations without code: text a customer when the crew is on the way, send a review request after a completed clean, or remind an account that their quarterly is due. The office stops chasing the same tasks by hand.",
    href: "https://knockio.com/features/business-automation-software/",
    icon: "sparkles" as const,
  },
  {
    title: "Service History and Media",
    text: "See every account's annotated photos, notes, and survey answers in one view, so the office and the field are looking at the same record instead of asking each other for it.",
    href: null,
    icon: "ruler" as const,
  },
  {
    title: "E-Contracts",
    text: "Keep every contract digital, organized, and ready to sign so approved deals never get stuck in paperwork or missed communication.",
    href: "https://knockio.com/e-contracts/",
    icon: "file" as const,
  },
  {
    title: "CRM Integrations",
    text: "Sync Knockio with Salesforce, HubSpot, Google Calendar, and GHL, and connect thousands of apps through Zapier, FlowChef, and webhooks, keeping every account in one place.",
    href: "https://knockio.com/knockio-integrations/",
    icon: "zap" as const,
  },
  {
    title: "Team Communication",
    text: "Knockio keeps office staff and crews on the same job record through assignees and internal notes, so a reschedule never catches anyone off guard.",
    href: "https://knockio.com/features/business-texting-and-calling-software/",
    icon: "message" as const,
  },
];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "What should I look for in window cleaning software?",
    a: "Look for recurring scheduling, route density planning, crew tracking, on-site quoting, e-contracts, and payment collection—all tied to one customer record. The platform should make repeat business easy to manage instead of forcing you to rebook every account by hand. Knockio was built around exactly this kind of recurring, route-based work.",
  },
  {
    q: "Can Knockio handle recurring quarterly cleanings automatically?",
    a: "Yes. You can set up monthly, quarterly, or semi-annual service cadences that automatically re-populate on your route board so regular cleanings rebook themselves without manual selling or calendar tracking.",
  },
  {
    q: "How does Knockio protect my business from glass scratch claims?",
    a: "Knockio lets you enforce a mandatory Pre-Existing Glass Defect Acknowledgment on your digital estimates. Cleaners can document broken thermal seals, hard-water stains, and fabrication debris before washing, capturing customer e-signature approval on site.",
  },
  {
    q: "Can Knockio bundle window cleaning with gutter cleaning or pressure washing?",
    a: "Yes. You can build multi-service estimates and work orders that combine window washing with adjacent home exterior services like gutter vacuuming, house soft-washing, or solar panel cleaning—all billed under one customer invoice.",
  },
  {
    q: "How is Knockio different from ResponsiBid, Jobber, or Housecall Pro for window cleaners?",
    a: "ResponsiBid focuses primarily on instant website calculators, while Jobber and Housecall Pro are generic field service tools without native door-to-door canvassing. Knockio combines neighborhood D2D canvassing, route density optimization, glass defect waivers, multi-service bundling, and recurring invoicing in one flat-rate platform.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const operatingModelsData = {
  pillTag: "OPERATING MODEL FLEXIBILITY",
  title: "Built for How Your Window Cleaning Business Actually Operates",
  subtitle:
    "A residential quarterly window cleaning route and a high-rise commercial rope-access contractor share a trade name, but run completely different workflows. Knockio adapts to your specific route density, glass scratch waivers, and multi-service bundling out of the box.",
  cards: [
    {
      icon: "house",
      title: "Routine Residential & Low-Rise",
      text: "Engineered for high-density residential routes (the bulk of the market). Automate quarterly and semi-annual rebooking schedules, optimize neighborhood route clustering, and process recurring invoicing upon job completion.",
      pills: ["Quarterly Route Rebooking", "Recurring Invoicing", "Pane Count Quoting"],
    },
    {
      icon: "broom",
      title: "Bundled Home Exterior Services",
      text: "Maximize average ticket sizes by cross-selling adjacent exterior services. Create unified multi-service work orders combining window washing, gutter cleaning, pressure washing, soft-washing, and solar panel deionization.",
      pills: ["Multi-Service Work Orders", "Gutter & Pressure Wash Add-Ons", "Solar Panel Cleaning"],
    },
    {
      icon: "shield-halved",
      title: "Glass Scratch & Defect Protection",
      text: "Document pre-existing glass conditions to reduce disputes over glass-damage claims. Enforce digital Pre-Existing Glass Defect Acknowledgments on estimates to document broken thermal seals, hard-water stains, and fabrication debris before washing.",
      pills: ["Glass Defect Waivers", "Broken Seal Documentation", "Timestamped Photo Proof"],
    },
    {
      icon: "building",
      title: "High-Rise Commercial & OSHA",
      text: "Manage commercial office and multi-story window cleaning contracts. Store OSHA fall-protection checklists, roof anchor-point inspection logs, and IRATA/SPRAT rope-access technician certifications on the building record.",
      pills: ["OSHA Fall-Protection Logs", "IRATA/SPRAT Certifications", "Commercial Building Bids"],
    },
  ],
};

const oldStackComparisonData = {
  title: "How Knockio Replaces Your Taped-Together Window Cleaning Stack",
  subtitle:
    "Stop paying for standalone route apps, basic quoting software, and manual invoicing spreadsheets. Knockio brings your cleaners, canvassers, and office into one platform.",
  rows: [
    {
      stage: "Canvassing & Routes",
      oldStack: "Paying per seat for standalone door apps without visibility into where your existing quarterly window routes are clustered.",
      knockio: "Built-in D2D canvassing that targets streets adjacent to your existing routes to maximize route density.",
    },
    {
      stage: "Quoting & Waivers",
      oldStack: "Sending simple email quotes without requiring customers to sign a pre-existing glass scratch and broken thermal seal waiver.",
      knockio: "Detailed pane-count quoting with mandatory digital Pre-Existing Glass Defect Acknowledgment e-signatures.",
    },
    {
      stage: "Service Bundling",
      oldStack: "Using separate calendars and invoices when a window washing client adds gutter cleaning or house soft-washing.",
      knockio: "Unified multi-service work orders combining windows, gutters, and pressure washing under one customer record.",
    },
    {
      stage: "Recurring Billing",
      oldStack: "Chasing monthly paper checks or manually running credit cards after cleaning crews turn in paper completion sheets.",
      knockio: "Automated recurring invoicing triggered immediately after completion photos are uploaded to the job record.",
    },
  ],
};

const heroImage = asset("inner-industry-window-cleaning-software.webp");

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id":
        "https://knockio.com/industry/window-cleaning-business-software/#webpage",
      url: "https://knockio.com/industry/window-cleaning-business-software/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      audience: {
        "@type": "Audience",
        audienceType: "Window Cleaning Businesses",
      },
      mainEntity: {
        "@id":
          "https://knockio.com/industry/window-cleaning-business-software/#faq",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id":
        "https://knockio.com/industry/window-cleaning-business-software/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Window Cleaning Business Software",
          item: "https://knockio.com/industry/window-cleaning-business-software/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id":
        "https://knockio.com/industry/window-cleaning-business-software/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={heroImage}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="industry-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white"
    >
      <div
        class="grid min-h-0 lg:min-h-[610px] lg:grid-cols-[55%_45%] xl:min-h-[720px] 2xl:min-h-[820px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] pt-[calc(72px+3rem)] pb-12 sm:pt-[calc(72px+4rem)] sm:pb-16 lg:min-h-[600px] lg:px-0 lg:pb-[72px] lg:pt-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[36px] font-bold leading-[44px] text-neutral-950 sm:text-[44px] sm:leading-[54px] xl:text-[58px] xl:leading-[66px] 2xl:text-[64px] 2xl:leading-[74px]"
            >
              Window Cleaning Business Software
            </h1>
            <p
              class="mb-10 max-w-[760px] text-base font-medium leading-8 text-neutral-600 sm:text-lg sm:leading-9"
            >
              Window cleaning runs on repeat customers and a route that has to
              stay tight. A first-time quote turns into a quarterly account, the
              crew works a neighborhood in one efficient loop, and the invoice
              goes out before they pull away from the curb. Knockio is window
              cleaning business software and CRM built for owners who need one
              place to hold customer records, schedule recurring cleans, route
              crews, send quotes, and collect payment.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white transition-colors duration-300 hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <p
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              What should window cleaning businesses look for in a CRM and
              scheduling platform?
            </p>
            <p
              class="max-w-[760px] text-[15px] leading-7 text-neutral-600 sm:text-base sm:leading-7"
            >
              A window cleaning business should look for a CRM that carries the
              customer the whole way, from the first quote to a steady recurring
              plan. That means full customer and property records, recurring
              scheduling, route planning, crew tracking, on-site quotes, and
              payment collection. Knockio handles all of it in one platform. It
              adds live GPS tracking with proximity intelligence and automated
              territory creation by zip code and city, so route assignments and
              job history live in the same record. That depth, plus affordable
              pricing and support that actually picks up, is what a generic CRM
              built for another industry leaves out.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-industry-visual relative min-h-[340px] overflow-hidden sm:min-h-[440px] lg:min-h-full"
        >
          <img
            src={heroImage}
            alt="What should window cleaning businesses look for in a crm and scheduling platform"
            width="830"
            height="560"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="h-full min-h-[340px] w-full object-cover object-center sm:min-h-[440px] lg:min-h-full"
          />
        </div>
      </div>
    </section>

    <!-- ========== Why Window Cleaners / Sticky tabs ========== -->
    <section id="platform-capabilities" class="bg-white py-20 sm:py-24 lg:py-28">
      <div class="my-container">
        <div class="mx-auto mb-10 max-w-[1120px] text-center lg:mb-12">
          <h2
            class="mb-5 text-center text-[34px] font-bold leading-[42px] text-neutral-950 sm:text-4xl sm:leading-[48px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Why Window Cleaners Choose Knockio
          </h2>
          <p
            class="mx-auto max-w-[960px] text-base font-normal leading-8 text-neutral-600 sm:text-lg sm:leading-9"
          >
            Knockio helps window cleaning businesses manage customer accounts,
            recurring schedules, routes, crews, quotes, invoices, and payments.
            From the first clean to a renewing service plan, it all sits in one
            connected platform. Owners keep the route tight and the billing
            clean without the back-and-forth between three different tools.
          </p>
        </div>

        <div class="sr-only">
          {
            capabilityTabs.map((tab) => (
              <div>
                <h3>{tab.label}</h3>
                {tab.cards.map((card) => (
                  <article>
                    <h3>{card.title}</h3>
                    <p>{card.text}</p>
                  </article>
                ))}
              </div>
            ))
          }
        </div>

          <div
            id="hpCapScrollTrack"
            class="h-[calc(100vh+(var(--scroll-steps,5)-1)*45vh)] max-lg:h-auto motion-reduce:h-auto"
            style="--scroll-steps: 5"
          >
            <div
              class="contents lg:flex lg:sticky lg:top-0 lg:z-20 lg:h-[min(calc(100vh-2rem),880px)] lg:flex-col lg:bg-white/95 lg:pt-1 motion-reduce:h-auto motion-reduce:static"
            >
              <div
                class="sticky top-0 z-30 shrink-0 bg-white/95 px-1 pb-5 pt-2 backdrop-blur-md max-lg:overflow-hidden"
              >
                <div
                  id="hpTabs1Nav"
                  class="relative mx-auto flex max-w-6xl scroll-smooth items-center gap-2 overflow-x-auto [scrollbar-width:none] max-xl:gap-3 lg:justify-between max-lg:flex-nowrap max-lg:justify-start max-lg:px-[12vw] [&::-webkit-scrollbar]:hidden"
                  role="tablist"
                  aria-label="Window cleaning platform capabilities"
                >
                  <span
                    id="hpTabs1Indicator"
                    class="pointer-events-none absolute left-0 top-0 z-0 rounded-full border-2 border-solid border-primary-500 bg-[#F9FFF8] transition-all duration-300 ease-out"
                    aria-hidden="true"></span>
                  {
                    capabilityTabs.map((tab, index) => (
                      <button
                        type="button"
                        data-hp-scroll-step={String(index)}
                        class:list={[
                          "hpTabs1_btn relative z-10 shrink-0 rounded-full border-2 px-5 py-2.5 text-lg font-bold transition-colors hover:border-primary-500/40 hover:text-primary-500 max-xl:px-4 max-xl:py-2 max-xl:text-base max-md:text-sm",
                          index === 0
                            ? "border-transparent text-primary-500"
                            : "border-dashed border-neutral-300 text-neutral-700",
                        ]}
                      >
                        {tab.label}
                      </button>
                    ))
                  }
                </div>
              </div>

              <div id="hpTabs1Panels" class="relative lg:flex-1">
                {
                  capabilityTabs.map((tab, tabIndex) => (
                    <div
                      id={`hpTabs${tabIndex + 1}_tab${tabIndex + 1}`}
                      class:list={[
                        "hpTabs1_content scroll-mt-24 lg:absolute lg:inset-0 lg:flex lg:h-full lg:flex-col lg:gap-3 lg:overflow-hidden transition-opacity duration-300 max-lg:static max-lg:mb-10 max-lg:h-auto max-lg:overflow-visible max-lg:opacity-100 max-lg:visible max-lg:pointer-events-auto motion-reduce:static motion-reduce:h-auto pt-5",
                        tabIndex === 0
                          ? "opacity-100 visible pointer-events-auto"
