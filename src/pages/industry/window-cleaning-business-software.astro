const oldStackComparisonData = {
  title: "How Knockio Replaces Your Taped-Together Window Cleaning Stack",
  subtitle:
    "Stop paying for standalone route apps, basic quoting software, and manual invoicing spreadsheets. Knockio brings your cleaners, canvassers, and office into one platform.",
