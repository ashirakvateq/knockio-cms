---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Painting Contractor Software & CRM for Painters | Knockio";
const description = "Painting contractor software to send detailed estimates, schedule crews, track job budgets, collect payment on completion, and manage jobs.";

const asset = (name: string) => `/assets/cfw/${name}`;

const capabilityTabs = [
  {
    label: "Manage Jobs & History",
    cards: [
      {
        title: "Paint SKU, Sheen & Color Property History",
        text: "Every property record logs exact manufacturer paint codes (Sherwin-Williams, Benjamin Moore), sheen finishes, surface substrates, and historical touch-up formulas per room or exterior elevation so future warranty work is effortless.",
        image: asset("inner-painting-contractor-software-and-crm-detailed-estimates-for-interior-and-exterior-work-1.webp"),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "Dynamic Pipeline for Painting Stages",
        text: "Move jobs through clear stages: Lead, Color Consultation, Estimate Quoted, Proposal Approved, Prep Scheduled, Painting in Progress, Final Walkthrough Punch List, and Completed. Customize boards for residential repaint versus commercial jobs.",
        image: asset("inner-painting-contractor-software-and-crm-one-record-per-customer-and-property.webp"),
        alt: "Lead management in Knockio",
      },
      {
        title: "HOA & Multi-Family Painting Programs",
        text: "Streamline large-scale exterior repainting for HOAs, apartment complexes, and property managers. Track multi-building schedules, manage tenant parking broadcast notices, and handle multi-month staged invoicing.",
        image: asset("inner-painting-contractor-software-and-crm-communication-history-on-every-job.webp"),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Track & Route",
    cards: [
      {
        title: "Auto Territory Creation by ZIP & City",
        text: "Build canvassing territories automatically from ZIP codes and cities. Target aging residential neighborhoods with exterior repaint or cabinet refinishing door-to-door canvassing campaigns during spring and summer seasons.",
        image: asset("inner-painting-contractor-software-and-crm-crew-scheduling-and-job-stages.webp"),
        alt: "Route planning in Knockio",
      },
      {
        title: "Live GPS Tracking of Painting Crews",
        text: "See where every painting crew, foreman, and estimator is in real time on a live map. Pin-drop verification confirms when crews arrive on site, ensuring accountability across multiple simultaneous residential or commercial jobsites.",
        image: asset("inner-painting-contractor-software-and-crm-live-gps-tracking-with-proximity-intelligence.webp"),
        alt: "Territory management in Knockio",
      },
      {
        title: "Smarter Estimator & Crew Routing",
        text: "Optimize daily travel routes for project estimators running 4 to 6 on-site property estimates a day. Minimize drive time across town and keep estimators arriving within promised customer consultation windows.",
        image: asset("inner-painting-contractor-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp"),
        alt: "Field activity log in Knockio",
      },
    ],
  },
  {
    label: "Work Orders & Materials",
    cards: [
      {
        title: "Painting Work Orders With Takeoffs",
        text: "Build detailed work orders tracking gallons of paint, primer, caulk, masking tape, and drop cloths against labor budgets. Painters view itemized prep instructions, coat counts, and color specs directly on their mobile app.",
        image: asset("inner-painting-contractor-software-and-crm-work-orders-with-budgets-and-material-takeoffs.webp"),
        alt: "Job management in Knockio",
      },
      {
        title: "Purchase Orders to Paint Retailers",
        text: "When specific paint sheens, specialty primers, or spray tips run short, generate a purchase order for your supplier such as Sherwin-Williams, PPG, or Benjamin Moore stores before shortages delay a project.",
        image: asset("inner-painting-contractor-software-and-crm-inventory-management-for-paint-and-supplies-1.webp"),
        alt: "Crew dispatching in Knockio",
      },
      {
        title: "Assign Jobs to Crews or Subcontractors",
        text: "Route work orders directly to your in-house painters or trusted 1099 subcontractor crews. Attach surface prep notes, color schedules, and site photos while stripping out sensitive customer pricing and financial markup.",
        image: asset("inner-painting-contractor-software-and-crm-vendor-bills-and-purchase-orders.webp"),
        alt: "Work orders in Knockio",
      },
    ],
  },
  {
    label: "Documents & Compliance",
    cards: [
      {
        title: "EPA RRP \"Renovate Right\" Compliance Logs",
        text: "Stay compliant on pre-1978 residential properties. Add the mandatory EPA \"Renovate Right\" lead hazard acknowledgments to contracts, and store photos of plastic containment and HEPA vacuum setups.",
        image: asset("inner-painting-contractor-software-and-crm-photo-annotation-for-scope-and-touch-ups.webp"),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "Digital Punch-List Completion Sign-Offs",
        text: "Gate final payment release on customer satisfaction. Conduct a joint final walkthrough with the homeowner, check off completed touch-ups, and capture a digital Certificate of Completion e-signature on your tablet.",
        image: asset("inner-painting-contractor-software-and-crm-job-notes-and-surveys-on-site.webp"),
        alt: "Proposals in Knockio",
      },
      {
        title: "Bilateral Change Orders for Extra Scope",
        text: "When prep work uncovers rotted fascia boards, drywall damage, or a client requests an extra accent wall mid-job, generate a dual-signature digital Change Order on site to price and approve extra work before painting proceeds.",
        image: asset("inner-painting-contractor-software-and-crm-centralized-file-storage-per-job.webp"),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
  {
    label: "Quote & Get Paid",
    cards: [
      {
        title: "Detailed Prep & Coat Estimating",
        text: "Build professional estimates that clearly separate surface prep, scraping, priming, and coat counts. Integrate production-rate calculators to price interior rooms, exterior elevations, or cabinetry with precision.",
        image: asset("inner-painting-contractor-software-and-crm-digital-contracts-with-e-signatures.webp"),
        alt: "Video and file storage in Knockio",
      },
      {
        title: "Good / Better / Best Painting Proposals",
        text: "Offer tiered proposals comparing standard acrylic paints against premium elastomeric coatings or fine-finish cabinet refinishing. Present the consumer financing you offer (GreenSky, Wisetack, and the like) and keep the signed agreement on the job.",
        image: asset("inner-painting-contractor-software-and-crm-flexible-payment-collection.webp"),
        alt: "Photo uploads in Knockio",
      },
      {
        title: "On-Site Payment Collection",
        text: "Protect cash flow across multi-week jobs. Collect an initial deposit upon signing, send an additional invoice at project midpoint, and capture final balance payment on site upon punch-list sign-off.",
        image: asset("inner-painting-contractor-software-and-crm-lifetime-activity-tracking.webp"),
        alt: "Service reports in Knockio",
      },
    ],
  }
];

const organizedItems = [
  {
    title: "Live Field Tracking",
    text: "Monitor crews in real time with GPS tracking and proximity intelligence. It helps with scheduling, accountability, and knowing exactly who is on which job right now.",
    href: "https://knockio.com/features/gps-tracking-software/",
    icon: "crosshair" as const,
  },
  {
    title: "Native Automation Builder",
    text: "Build your own automations without code: send a deposit request when an estimate is approved, text the homeowner the morning the crew arrives, or trigger a review request after the final walk-through.",
    href: "https://knockio.com/features/business-automation-software/",
    icon: "sparkles" as const,
  },
  {
    title: "Job History and Media",
    text: "See every job's annotated photos, color choices, and notes in one view, so the office and the crews are looking at the same record instead of asking each other for it.",
    href: "#",
    icon: "ruler" as const,
  },
  {
    title: "E-Contracts",
    text: "Review, approve, and sign contracts from anywhere so your team can close deals faster without paperwork slowing the process.",
    href: "https://knockio.com/e-contracts/",
    icon: "file" as const,
  },
  {
    title: "CRM Integrations",
    text: "Connect your painting jobs and customer records across Salesforce, HubSpot, Google Calendar, and GHL, plus thousands of apps via Zapier, FlowChef, and webhooks.",
    href: "https://knockio.com/knockio-integrations/",
    icon: "zap" as const,
  },
  {
    title: "Team Communication",
    text: "Knockio assigns estimators and crews to the same job record with shared notes, so a color change or a scope update reaches everyone immediately.",
    href: "https://knockio.com/features/business-texting-and-calling-software/",
    icon: "message" as const,
  }
];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "What should I look for in painting contractor software?",
    a: "Look for detailed estimating that breaks out prep and coats, crew scheduling, paint SKU and sheen tracking, e-contracts, and staged invoicing—all tied to one customer record. The platform should carry a job from the initial walk-through to final payment instead of leaving you to stitch pieces together. Knockio was built around exactly this kind of estimate-to-completion workflow.",
  },
  {
    q: "Can Knockio track paint SKUs, sheens, and color formulas for each job?",
    a: "Yes. Every property record in Knockio maintains a dedicated color and finish log where you can store manufacturer paint codes (Sherwin-Williams, Benjamin Moore, PPG), sheens, and custom touch-up formulas per room or exterior elevation.",
  },
  {
    q: "Does Knockio support EPA RRP lead-safe compliance documentation?",
    a: "Yes. For pre-1978 residential homes, Knockio lets you add the mandatory EPA \"Renovate Right\" lead hazard disclosures to your digital e-contracts and lets crews upload photos of plastic containment and HEPA vacuum setups to the job record.",
  },
  {
    q: "Can Knockio require a signed punch list before releasing final payment?",
    a: "Yes. You can conduct a joint final walkthrough with the homeowner, check off completed punch-list items, and capture a digital Certificate of Completion e-signature on a tablet—immediately triggering on-site Text-to-Pay collection for the final balance.",
  },
  {
    q: "How is Knockio different from PaintScout, Jobber, or Housecall Pro for painting contractors?",
    a: "PaintScout focuses purely on estimating, while Jobber and Housecall Pro are generic field service tools without native door-to-door sales canvassing. Knockio combines D2D neighborhood canvassing, detailed prep-and-coat estimating, paint SKU tracking, EPA RRP compliance, and staged invoicing in one flat-rate platform.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
