      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const operatingModelsData = {
  pillTag: "OPERATING MODEL FLEXIBILITY",
  title: "Built for How Your Painting Business Actually Operates",
  subtitle:
    "A residential repaint contractor and an industrial coatings applicator share a trade name, but run completely different workflows. Knockio adapts to your specific prep scopes, EPA RRP lead-safe rules, and cabinet refinishing out of the box.",
  cards: [
    {
      icon: "house",
      title: "Residential Interior & Exterior",
      text: "Engineered for residential repaint contractors (the majority of trade revenue). Build marketing and D2D canvassing pipelines, quote detailed surface prep and coat counts, and collect invoices as work advances.",
      pills: ["Detailed Prep & Coat Quotes", "D2D Exterior Canvassing", "Invoicing"],
    },
    {
      icon: "paint-roller",
      title: "Fine Finish & Cabinet Refinishing",
      text: "Manage high-margin spray shop cabinetry and architectural millwork projects. Track specialty lacquer and urethane formulas, manage off-site door spraying schedules, and quote premium per-piece finishing rates.",
      pills: ["Cabinetry Finishing Rates", "Off-Site Spray Schedules", "Specialty Lacquer SKUs"],
    },
    {
      icon: "shield-halved",
      title: "EPA RRP Lead-Safe Painting",
      text: "Stay compliant when disturbing paint on pre-1978 residential homes. Add the mandatory EPA \"Renovate Right\" disclosures to e-contracts and store photo proof of plastic containment and HEPA setups.",
      pills: ["EPA RRP Disclosures", "Lead Containment Photo Logs", "Certified Renovator IDs"],
    },
    {
      icon: "building",
      title: "Commercial & Multi-Family HOAs",
      text: "Serve retail centers, office buildings, and multi-family HOA complexes. Manage multi-building painting schedules, send bulk SMS tenant parking notices, and handle formal commercial bidding and draw schedules.",
      pills: ["Multi-Building Schedules", "Bulk Tenant SMS Notices", "Commercial RFP Bidding"],
    },
  ],
};

const oldStackComparisonData = {
  title: "How Knockio Replaces Your Taped-Together Painting Stack",
  subtitle:
    "Stop paying for standalone canvassing apps, basic quoting software, and manual paint color spreadsheets. Knockio brings your painters, estimators, and office into one platform.",
  rows: [
    {
      stage: "Canvassing & Leads",
      oldStack: "Paying per seat for standalone door apps (SalesRabbit) to canvass neighborhoods without syncing with estimator calendars.",
      knockio: "Built-in D2D canvassing, territory cutting, and direct appointment booking onto estimator calendars.",
    },
    {
      stage: "Estimating & Colors",
      oldStack: "Writing lump-sum estimates on PDFs and losing Sherwin-Williams paint SKUs and sheen finishes in scattered text messages.",
      knockio: "Detailed estimating separating prep and coats, with exact paint SKU, sheen, and color history per room.",
    },
    {
      stage: "Compliance & Scope",
      oldStack: "Forgetting required EPA RRP lead-safe forms on older homes and arguing over mid-job drywall repair additions.",
      knockio: "Automatic EPA \"Renovate Right\" disclosures and digital dual-signature change orders captured on site.",
    },
    {
      stage: "Closeout & Payments",
      oldStack: "Chasing final payment checks days after painters leave without a formal signed completion punch list.",
      knockio: "Co-signed digital Punch-List Certificate of Completion that immediately sends the final invoice for payment.",
    },
  ],
};

const heroImage = asset("inner-industry-painting-contractor-software.webp");

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://knockio.com/industry/painting-contractor-software-and-crm/#webpage",
      url: "https://knockio.com/industry/painting-contractor-software-and-crm/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      audience: {
        "@type": "Audience",
        audienceType: "Painting Contractors",
      },
      mainEntity: {
        "@id": "https://knockio.com/industry/painting-contractor-software-and-crm/#faq",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://knockio.com/industry/painting-contractor-software-and-crm/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Painting Contractor Software & CRM",
          item: "https://knockio.com/industry/painting-contractor-software-and-crm/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/industry/painting-contractor-software-and-crm/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={heroImage}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="industry-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white"
    >
      <div
        class="grid min-h-0 lg:min-h-[610px] lg:grid-cols-[55%_45%] xl:min-h-[720px] 2xl:min-h-[820px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] pt-[calc(72px+3rem)] pb-12 sm:pt-[calc(72px+4rem)] sm:pb-16 lg:min-h-[600px] lg:px-0 lg:pb-[72px] lg:pt-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[36px] font-bold leading-[44px] text-neutral-950 sm:text-[44px] sm:leading-[54px] xl:text-[58px] xl:leading-[66px] 2xl:text-[64px] 2xl:leading-[74px]"
            >
              Painting Contractor Software & CRM Built for Painters
            </h1>
            <p
              class="mb-10 max-w-[760px] text-base font-medium leading-8 text-neutral-600 sm:text-lg sm:leading-9"
            >
              Painting projects depend on detailed surface prep, exact paint SKU and sheen tracking, EPA RRP lead-safe compliance, and flawless final walkthroughs. Knockio connects your estimators, painting crews, and project managers into one platform—giving painting contractors the tools to quote prep and coats, track paint formulas, log EPA lead-safe containment, and capture punch-list sign-offs to release final payments.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white transition-colors duration-300 hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <p
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              What should painting contractors look for in a CRM and project platform?
            </p>
            <p
              class="max-w-[760px] text-[15px] leading-7 text-neutral-600 sm:text-base sm:leading-7"
            >
              A true painting contractor software carries a job from the initial color consultation to the final punch-list sign-off. That means complete property records with paint SKU and finish history, automated territory cutting for exterior painting campaigns, detailed estimating breaking out prep and coats, EPA RRP lead-safe documentation, change orders, and invoices. Knockio handles all of it in one platform—adding live GPS tracking of crews so your entire job history lives in a single record.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-industry-visual relative min-h-[340px] overflow-hidden sm:min-h-[440px] lg:min-h-full"
        >
          <img
            src={heroImage}
            alt="What should painting contractors look for in a crm and estimating platform"
            width="830"
            height="560"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="h-full min-h-[340px] w-full object-cover object-center sm:min-h-[440px] lg:min-h-full"
          />
        </div>
      </div>
    </section>

    <!-- ========== Why Painters / Sticky tabs ========== -->
    <section id="platform-capabilities" class="bg-white py-20 sm:py-24 lg:py-28">
      <div class="my-container">
        <div class="mx-auto mb-10 max-w-[1120px] text-center lg:mb-12">
          <h2
            class="mb-5 text-center text-[34px] font-bold leading-[42px] text-neutral-950 sm:text-4xl sm:leading-[48px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Why Painting Teams Choose Knockio
          </h2>
          <p
            class="mx-auto max-w-[960px] text-base font-normal leading-8 text-neutral-600 sm:text-lg sm:leading-9"
          >
            Knockio helps painting contractors manage customer records, estimates,
            crews, production, materials, invoices, and payments. From the first
            walk-through to the final walk-through, it all sits on one connected
            platform. Owners run the schedule and the billing without the
            back-and-forth between three different tools.
          </p>
        </div>

          <div
            id="hpCapScrollTrack"
            class="h-[calc(100vh+(var(--scroll-steps,5)-1)*45vh)] max-lg:h-auto motion-reduce:h-auto"
            style="--scroll-steps: 5"
          >
            <div
              class="contents lg:flex lg:sticky lg:top-0 lg:z-20 lg:h-[min(calc(100vh-2rem),880px)] lg:flex-col lg:bg-white/95 lg:pt-1 motion-reduce:h-auto motion-reduce:static"
            >
              <div
                class="sticky top-0 z-30 shrink-0 bg-white/95 px-1 pb-5 pt-2 backdrop-blur-md max-lg:overflow-hidden"
              >
                <div
                  id="hpTabs1Nav"
                  class="relative mx-auto flex max-w-6xl scroll-smooth items-center gap-2 overflow-x-auto [scrollbar-width:none] max-xl:gap-3 lg:justify-between max-lg:flex-nowrap max-lg:justify-start max-lg:px-[12vw] [&::-webkit-scrollbar]:hidden"
                  role="tablist"
                  aria-label="Painting platform capabilities"
                >
                  <span
                    id="hpTabs1Indicator"
                    class="pointer-events-none absolute left-0 top-0 z-0 rounded-full border-2 border-solid border-primary-500 bg-[#F9FFF8] transition-all duration-300 ease-out"
                    aria-hidden="true"></span>
                  {
                    capabilityTabs.map((tab, index) => (
                      <button
                        type="button"
                        data-hp-scroll-step={String(index)}
                        class:list={[
                          "hpTabs1_btn relative z-10 shrink-0 rounded-full border-2 px-5 py-2.5 text-lg font-bold transition-colors hover:border-primary-500/40 hover:text-primary-500 max-xl:px-4 max-xl:py-2 max-xl:text-base max-md:text-sm",
                          index === 0
                            ? "border-transparent text-primary-500"
                            : "border-dashed border-neutral-300 text-neutral-700",
                        ]}
                      >
