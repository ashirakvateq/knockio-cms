---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Painting Contractor Software & CRM for Painters | Knockio";
const description = "Painting contractor software to send detailed estimates, schedule crews, track job budgets, collect payment on completion, and manage jobs.";

const asset = (name: string) => `/assets/cfw/${name}`;

const capabilityTabs = [
  {
    label: "Win the Job",
    cards: [
      {
        title: "Detailed Estimates for Interior and Exterior Work",
        text: "Win the job during every visit, log outcomes, add notes or quick voice notes, and move prospects into a clear CRM pipeline, so your whole team sees the full history and no promising lead ever slips through the cracks between quotes.",
        image: asset("inner-painting-contractor-software-and-crm-detailed-estimates-for-interior-and-exterior-work-1.webp"),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "One Record Per Customer and Property",
        text: "Each job holds the address, contacts, custom fields, room counts, color choices, photos, and notes, so the crew shows up knowing the scope, the colors, and the spots the homeowner flagged on the walk-through.",
        image: asset("inner-painting-contractor-software-and-crm-one-record-per-customer-and-property.webp"),
        alt: "Lead management in Knockio",
      },
      {
        title: "Communication History on Every Job",
        text: "Every call, text, and email tied to a customer lands on the record, so when someone asks to change a color the week before, the whole back-and-forth is right there instead of buried in a phone.",
        image: asset("inner-painting-contractor-software-and-crm-communication-history-on-every-job.webp"),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Schedule With Tracking",
    cards: [
      {
        title: "Crew Scheduling and Job Stages",
        text: "Move each job through clear stages like estimate, approved, scheduled, prepping, painting, and final walk-through. Statuses are fully customizable to fit your shop, and unlimited boards let the office and crews each see the view they care about.",
        image: asset("inner-painting-contractor-software-and-crm-crew-scheduling-and-job-stages.webp"),
        alt: "Route planning in Knockio",
      },
      {
        title: "Live GPS Tracking With Proximity",
        text: "See where every crew is in real time, and let proximity intelligence confirm how close they actually were to a property when they marked a job started or done, so the schedule reflects reality, not a guess.",
        image: asset("inner-painting-contractor-software-and-crm-live-gps-tracking-with-proximity-intelligence.webp"),
        alt: "Territory management in Knockio",
      },
      {
        title: "Automated Territory Creation",
        text: "If you run estimates or canvassing across a wide service area, build territories automatically from zip codes and cities instead of mapping every boundary by hand, so you can balance estimators across town in minutes.",
        image: asset("inner-painting-contractor-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp"),
        alt: "Field activity log in Knockio",
      },
    ],
  },
  {
    label: "Track Materials and Costs",
    cards: [
      {
        title: "Work Orders With Budgets and Material Takeoffs",
        text: "Track Materials and Costs from lead to service with notes, status updates, documents, customer details, and clear next steps.",
        image: asset("inner-painting-contractor-software-and-crm-work-orders-with-budgets-and-material-takeoffs.webp"),
        alt: "Job management in Knockio",
      },
      {
        title: "Inventory Management for Paint and Supplies",
        text: "Track products, variants, SKUs, cost, and markup for paint, primer, tape, and rollers, with low-stock alerts so you reorder before a crew shows up to a job short on a color.",
        image: asset("inner-painting-contractor-software-and-crm-inventory-management-for-paint-and-supplies-1.webp"),
        alt: "Crew dispatching in Knockio",
      },
      {
        title: "Vendor Bills and Material Purchase Orders",
        text: "Raise a purchase order to the paint store when stock runs low, then record the vendor bill against that purchase order or work order, so supplier spend ties straight to the job and margins stay honest.",
        image: asset("inner-painting-contractor-software-and-crm-vendor-bills-and-purchase-orders.webp"),
        alt: "Work orders in Knockio",
      },
    ],
  },
  {
    label: "Media Storage",
    cards: [
      {
        title: "Photo Annotation Touch-Ups",
        text: "Snap photos at the walk-through and during the job, then mark them up with notes and arrows on the image, so the crew knows which surfaces to prep and the homeowner sees the punch-list items.",
        image: asset("inner-painting-contractor-software-and-crm-photo-annotation-for-scope-and-touch-ups.webp"),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "Job Notes and Surveys on Site",
        text: "Drop detailed notes on every job and use built-in surveys to capture wall conditions, surface issues, or extra work spotted, saved straight to the record instead of a slip lost in the truck.",
        image: asset("inner-painting-contractor-software-and-crm-job-notes-and-surveys-on-site.webp"),
        alt: "Proposals in Knockio",
      },
      {
        title: "Centralized File Storage Per Job",
        text: "Keep color specs, warranties, and signed agreements attached right to the job record, not scattered across email and a folder nobody can find when a customer calls about a touch-up next year.",
        image: asset("inner-painting-contractor-software-and-crm-centralized-file-storage-per-job.webp"),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
  {
    label: "Close and Get Paid",
    cards: [
      {
        title: "Digital Contracts",
        text: "Send the job agreement for digital signature with a documented audit trail, so scope and price are locked in with a clean legal record before the first drop cloth goes down. Change orders work the same way, logged instead of argued over later.",
        image: asset("inner-painting-contractor-software-and-crm-digital-contracts-with-e-signatures.webp"),
        alt: "Video and file storage in Knockio",
      },
      {
        title: "Flexible Payment Collection",
        text: "Collect deposits, progress draws, and final balances through tap to pay, text to pay, card, or ACH, all tied directly to the job through Knockio's own payment processing, so you are not chasing a check after the last coat dries.",
        image: asset("inner-painting-contractor-software-and-crm-flexible-payment-collection.webp"),
        alt: "Photo uploads in Knockio",
      },
      {
        title: "Lifetime Activity Tracking",
        text: "Every status change, note, estimate, and payment lands on a running timeline, so you can see the full story of a job at a glance, which helps when a customer questions a charge or asks what was done.",
        image: asset("inner-painting-contractor-software-and-crm-lifetime-activity-tracking.webp"),
        alt: "Service reports in Knockio",
      },
    ],
  }
];

const organizedItems = [
  {
    title: "Live Field Tracking",
    text: "Monitor crews in real time with GPS tracking and proximity intelligence. It helps with scheduling, accountability, and knowing exactly who is on which job right now.",
    href: "https://knockio.com/features/gps-tracking-software/",
    icon: "crosshair" as const,
  },
  {
    title: "Native Automation Builder",
    text: "Build your own automations without code: send a deposit request when an estimate is approved, text the homeowner the morning the crew arrives, or trigger a review request after the final walk-through.",
    href: "https://knockio.com/features/business-automation-software/",
    icon: "sparkles" as const,
  },
  {
    title: "Job History and Media",
    text: "See every job's annotated photos, color choices, and notes in one view, so the office and the crews are looking at the same record instead of asking each other for it.",
    href: "#",
    icon: "ruler" as const,
  },
  {
    title: "E-Contracts",
    text: "Review, approve, and sign contracts from anywhere so your team can close deals faster without paperwork slowing the process.",
    href: "https://knockio.com/e-contracts/",
    icon: "file" as const,
  },
  {
    title: "CRM Integrations",
    text: "Connect your painting jobs and customer records across Salesforce, HubSpot, Google Calendar, and GHL, plus thousands of apps via Zapier, FlowChef, and webhooks.",
    href: "https://knockio.com/knockio-integrations/",
    icon: "zap" as const,
  },
  {
    title: "Team Communication",
    text: "Knockio assigns estimators and crews to the same job record with shared notes, so a color change or a scope update reaches everyone immediately.",
    href: "https://knockio.com/features/business-texting-and-calling-software/",
    icon: "message" as const,
  }
];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "What should I look for in painting contractor software?",
    a: "Look for detailed estimating that breaks out prep and coats, crew scheduling, material tracking, e-contracts, and payment collection, all tied to one customer record. The platform should carry a job from the walk-through to final payment instead of leaving you to stitch the pieces together. Knockio was built around exactly this kind of estimate-to-completion workflow.",
  },
  {
    q: "Which software is best for a small painting business?",
    a: "Knockio helps field service teams manage the full workflow. Teams can Win the Job, store customer details, create estimates, schedule jobs, assign crews, track job progress, upload photos, send invoices, and follow up with customers. This helps reduce manual work and keeps everyone updated.",
  },
  {
    q: "Can Knockio track paint and materials per job?",
    a: "Yes. Work orders carry a material takeoff, and inventory management tracks paint, primer, and supplies with low-stock alerts, so each job is cost against what it actually used.",
  },
  {
    q: "Can Knockio handle change orders mid-job?",
    a: "Yes. You can send change orders for digital signature the same way as the original agreement, so an added room or an upgraded finish is documented and priced instead of handled loosely.",
  },
  {
    q: "Does Knockio track my crews in the field?",
    a: "Yes. Knockio includes live GPS tracking with proximity intelligence, so you can confirm how close a crew was to a property when they marked a job started or completed.",
  }
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const heroImage = asset("inner-industry-painting-contractor-software.webp");

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://knockio.com/industry/painting-contractor-software-and-crm/#webpage",
      url: "https://knockio.com/industry/painting-contractor-software-and-crm/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      audience: {
        "@type": "Audience",
        audienceType: "Painting Contractors",
      },
      mainEntity: {
        "@id": "https://knockio.com/industry/painting-contractor-software-and-crm/#faq",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://knockio.com/industry/painting-contractor-software-and-crm/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Painting Contractor Software & CRM",
          item: "https://knockio.com/industry/painting-contractor-software-and-crm/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/industry/painting-contractor-software-and-crm/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={heroImage}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="industry-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white"
    >
      <div
        class="grid min-h-0 lg:min-h-[610px] lg:grid-cols-[55%_45%] xl:min-h-[720px] 2xl:min-h-[820px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] pt-[calc(72px+3rem)] pb-12 sm:pt-[calc(72px+4rem)] sm:pb-16 lg:min-h-[600px] lg:px-0 lg:pb-[72px] lg:pt-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[36px] font-bold leading-[44px] text-neutral-950 sm:text-[44px] sm:leading-[54px] xl:text-[58px] xl:leading-[66px] 2xl:text-[64px] 2xl:leading-[74px]"
            >
              Painting Contractor Software
            </h1>
            <p
              class="mb-10 max-w-[760px] text-base font-medium leading-8 text-neutral-600 sm:text-lg sm:leading-9"
            >
              Painting is a walk-through business. You measure the rooms, count the doors and trim, price the prep and the coats, and then a crew has to show up, knock out the work, and get paid before the next estimate is even booked. Knockio is painting contractor software and CRM built for painters who need one place to hold customer records, quote jobs, schedule crews, track materials, and collect payment.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white transition-colors duration-300 hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <p
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              What should painting contractors look for in a CRM and estimating platform?
            </p>
            <p
              class="max-w-[760px] text-[15px] leading-7 text-neutral-600 sm:text-base sm:leading-7"
            >
              A painting contractor should look for a CRM that carries the job from the first walk-through to the final coat. That means full customer and property records, detailed estimates for prep, primer, and coats, crew scheduling, material and paint tracking, e-contracts, and payment collection. Knockio handles all of it in one platform. It adds live GPS tracking with proximity intelligence and automated territory creation by zip code and city, so estimates, crews, and job history live in the same record. That depth, plus affordable pricing and support that actually answers, is what a generic CRM built for another industry leaves out.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-industry-visual relative min-h-[340px] overflow-hidden sm:min-h-[440px] lg:min-h-full"
        >
          <img
            src={heroImage}
            alt="What should painting contractors look for in a crm and estimating platform"
            width="830"
            height="560"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="h-full min-h-[340px] w-full object-cover object-center sm:min-h-[440px] lg:min-h-full"
          />
        </div>
      </div>
    </section>

    <!-- ========== Why Painters / Sticky tabs ========== -->
    <section id="platform-capabilities" class="bg-white py-20 sm:py-24 lg:py-28">
      <div class="my-container">
        <div class="mx-auto mb-10 max-w-[1120px] text-center lg:mb-12">
          <h2
            class="mb-5 text-center text-[34px] font-bold leading-[42px] text-neutral-950 sm:text-4xl sm:leading-[48px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Why Painters Choose Knockio
          </h2>
          <p
            class="mx-auto max-w-[960px] text-base font-normal leading-8 text-neutral-600 sm:text-lg sm:leading-9"
          >
            Knockio helps painting contractors manage customer records, estimates,
            crews, production, materials, invoices, and payments. From the first
            walk-through to the final walk-through, it all sits on one connected
            platform. Owners run the schedule and the billing without the
            back-and-forth between three different tools.
          </p>
        </div>

          <div
            id="hpCapScrollTrack"
            class="h-[calc(100vh+(var(--scroll-steps,5)-1)*45vh)] max-lg:h-auto motion-reduce:h-auto"
            style="--scroll-steps: 5"
          >
            <div
              class="contents lg:flex lg:sticky lg:top-0 lg:z-20 lg:h-[min(calc(100vh-2rem),880px)] lg:flex-col lg:bg-white/95 lg:pt-1 motion-reduce:h-auto motion-reduce:static"
            >
              <div
                class="sticky top-0 z-30 shrink-0 bg-white/95 px-1 pb-5 pt-2 backdrop-blur-md max-lg:overflow-hidden"
              >
                <div
                  id="hpTabs1Nav"
                  class="relative mx-auto flex max-w-6xl scroll-smooth items-center gap-2 overflow-x-auto [scrollbar-width:none] max-xl:gap-3 lg:justify-between max-lg:flex-nowrap max-lg:justify-start max-lg:px-[12vw] [&::-webkit-scrollbar]:hidden"
                  role="tablist"
                  aria-label="Painting platform capabilities"
                >
                  <span
                    id="hpTabs1Indicator"
                    class="pointer-events-none absolute left-0 top-0 z-0 rounded-full border-2 border-solid border-primary-500 bg-[#F9FFF8] transition-all duration-300 ease-out"
                    aria-hidden="true"></span>
                  {
                    capabilityTabs.map((tab, index) => (
                      <button
                        type="button"
                        data-hp-scroll-step={String(index)}
                        class:list={[
                          "hpTabs1_btn relative z-10 shrink-0 rounded-full border-2 px-5 py-2.5 text-lg font-bold transition-colors hover:border-primary-500/40 hover:text-primary-500 max-xl:px-4 max-xl:py-2 max-xl:text-base max-md:text-sm",
                          index === 0
                            ? "border-transparent text-primary-500"
                            : "border-dashed border-neutral-300 text-neutral-700",
                        ]}
                      >
                        {tab.label}
                      </button>
                    ))
                  }
                </div>
              </div>

              <div id="hpTabs1Panels" class="relative lg:flex-1">
                {
                  capabilityTabs.map((tab, tabIndex) => (
                    <div
                      id={`hpTabs${tabIndex + 1}_tab${tabIndex + 1}`}
                      class:list={[
                        "hpTabs1_content scroll-mt-24 lg:absolute lg:inset-0 lg:flex lg:h-full lg:flex-col lg:gap-3 lg:overflow-hidden transition-opacity duration-300 max-lg:static max-lg:mb-10 max-lg:h-auto max-lg:overflow-visible max-lg:opacity-100 max-lg:visible max-lg:pointer-events-auto motion-reduce:static motion-reduce:h-auto pt-5",
                        tabIndex === 0
                          ? "opacity-100 visible pointer-events-auto"
                          : "opacity-0 invisible pointer-events-none",
                      ]}
                      role="tabpanel"
                    >
                      <div class="grid gap-6 lg:grid-cols-3 lg:gap-8">
                        {tab.cards.map((card) => (
                          <article
                            class:list={[
                              "hp-cap-card hp-card flex min-h-[520px] flex-col overflow-hidden rounded-[28px] border border-solid border-neutral-200 bg-neutral-50 p-7 sm:p-8",
                            ]}
                          >
                            <div
                              class:list={[
                                "relative z-10 shrink-0",
                              ]}
                            >
                              <h5 class="text-3xl max-2xl:text-2xl max-md:text-lg font-bold text-neutral-900 mb-3 max-md:mb-1">
                                {card.title}
                              </h5>
                              <p class="mb-8 text-base leading-7 text-neutral-600 sm:text-[17px] sm:leading-8">
                                {card.text}
                              </p>
                            </div>
                            <div class="mt-auto flex justify-center overflow-hidden rounded-3xl">
                              <img
                                src={card.image}
                                alt={card.alt}
                                width="430"
                                height="320"
                                decoding="async"
                                loading="lazy"
                                class="w-full max-w-[430px] object-contain object-bottom"
                              />
                            </div>
                          </article>
                        ))}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

        <div class="sr-only">
          {
            capabilityTabs.map((tab) => (
              <div>
                <h3>{tab.label}</h3>
                {tab.cards.map((card) => (
                  <article>
                    <h3>{card.title}</h3>
                    <p>{card.text}</p>
                  </article>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ========== Organized (dark) ========== -->
    <section
      class="relative overflow-hidden bg-[#0F172A] py-24 sm:py-28 lg:py-[150px]"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.22] [background-image:radial-gradient(rgba(255,255,255,0.65)_0.8px,transparent_0.8px)] [background-size:18px_18px]"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-14 max-w-[1120px] text-center lg:mb-20">
          <h2
