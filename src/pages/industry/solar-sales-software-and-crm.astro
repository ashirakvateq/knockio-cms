    icon: "sparkles" as const,
  },
  {
    title: "Media and Measurements",
    text: "See every deal's photos, site survey details, and notes in one view, so the office and the field are looking at the same record instead of asking each other for it.",
    href: null,
    icon: "ruler" as const,
  },
  {
    title: "E-Contracts",
    text: "Create digital contracts, collect signatures, and move approved jobs forward faster without printing, scanning, chasing updates, or losing important details.",
    href: "https://knockio.com/e-contracts/",
    icon: "file" as const,
  },
  {
    title: "CRM Integrations",
    text: "Connect Knockio to Salesforce, HubSpot, Google Calendar, and GHL, then reach thousands more apps through Zapier, FlowChef, and webhooks, keeping every solar deal in sync.",
    href: "https://knockio.com/knockio-integrations/",
    icon: "zap" as const,
  },
  {
    title: "Team Communication",
    text: "Knockio links setters, closers, and ops to the same deal record through assignees and notes, so handoffs never depend on a forwarded text.",
    href: "https://knockio.com/features/business-texting-and-calling-software/",
    icon: "message" as const,
  },
];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "How does Knockio handle the handoff between setters and closers?",
    a: "Knockio links setters and closers to the exact same customer record. When a setter schedules an appointment at the door, the closer receives an instant notification with the roof photos, shading notes, and utility bill attached—eliminating pre-appointment confusion and blind presentations.",
  },
  {
    q: "Can Knockio track utility interconnection and PTO stages?",
    a: "Yes. Knockio features fully customizable project pipelines that let you track deals through site survey, engineering design, permitting, HOA approval, installation, municipal inspection, utility interconnection submission, and final Permission to Operate (PTO).",
  },
  {
    q: "Are door-to-door sales disclosures included in Knockio e-contracts?",
    a: "Yes. You can add mandatory disclosures to your contract templates—such as the FTC 3-Day Notice of Cancellation for door-to-door signups—to your digital agreements, complete with timestamped audit logging.",
  },
  {
    q: "How is Knockio different from Solargraf, Sunbase, or SalesRabbit for solar companies?",
    a: "Solargraf leans into design and proposal work, and SalesRabbit leans into canvassing, but Knockio brings canvassing, automated territory creation, live setter tracking, estimates, digital contracts, work orders, and payments into one connected system. Add deep deal history per property, a fully customizable pipeline with unlimited boards, personalized support, and pricing that does not punish a growing team, and you have one platform that runs the deal from the first knock to permission to operate.",
  },
  {
    q: "Does Knockio connect with the tools I already use?",
    a: "Knockio connects your customer records, invoices, and payments to the tools you use via Zapier and webhooks. It also connects via Zapier and webhooks with Google Calendar, HubSpot, GoHighLevel (GHL), and Salesforce.",
  },
];

