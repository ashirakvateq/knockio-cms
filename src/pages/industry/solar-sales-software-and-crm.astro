---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Solar Sales Software & CRM for Solar Teams | Knockio";
const description =
  "Solar CRM system and sales software for door-to-door canvassing & service teams. Auto-built canvassing territories, setter-to-closer handoff, estimates & e-contracts in one platform.";

const asset = (name: string) => `/assets/cfw/${name}`;

type CapCard = {
  title: string;
  text: string;
  image: string;
  alt: string;
};

const capabilityTabs: { label: string; cards: CapCard[] }[] = [
  {
    label: "Manage Records",
    cards: [
      {
        title: "Customer and Property Records in One Place",
        text: "Manage records during every single visit, log outcomes, add detailed notes or quick voice memos, and move qualified prospects steadily into a clear, organized CRM pipeline your whole team can trust today.",
        image: asset(
          "inner-solar-sales-software-and-crm-customer-and-property-records-in-one-place.webp",
        ),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "Dynamic Sales Pipeline for Solar Project Stages",
        text: "Move deals through clear stages like lead, appointment, survey, design, permitting, install, and PTO. Statuses stay fully customizable, so every board matches your exact sales-to-install process and each team sees what matters.",
        image: asset(
          "inner-solar-sales-software-and-crm-dynamic-pipeline-for-solar-stages.webp",
        ),
        alt: "Lead management in Knockio",
      },
      {
        title: "Setter to Closer Handoff and Scheduling",
        text: "Assign appointments from setters to closers, track who showed and who sat, and keep the sales floor and the field reading the same calendar instead of two versions that drift apart by midday.",
        image: asset(
          "inner-solar-sales-software-and-crm-setter-to-closer-handoff-and-scheduling.webp",
        ),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Track the Field",
    cards: [
      {
        title: "Automated Territory Creation by Zip Code and City",
        text: "Build canvassing territories automatically from zip codes and cities, instead of drawing every boundary by hand. You can carve up a target market and get setters knocking in minutes, not hours. Most solar CRMs simply do not do this.",
        image: asset(
          "inner-solar-sales-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp",
        ),
        alt: "Route planning in Knockio",
      },
      {
        title: "Live GPS Tracking of Every Field Setter",
        text: "See exactly where every setter is in real time, which helps accountability, safety, and knowing who works which neighborhood right now. Pin drop verification confirms how close reps stood when marking doors.",
        image: asset(
          "inner-solar-sales-software-and-crm-live-gps-tracking-of-every-setter.webp",
        ),
        alt: "Territory management in Knockio",
      },
      {
        title: "Smarter Route Planning for Busy Field Reps",
        text: "Plan smarter, tighter routes so your reps cover far more doors in much less time each day, instead of crisscrossing the very same streets over and over again and burning valuable daylight.",
        image: asset("inner-solar-sales-software-and-crm-route-planning.webp"),
        alt: "Field activity log in Knockio",
      },
    ],
  },
  {
    label: "Work Orders and Materials",
    cards: [
      {
        title: "Solar Work Orders With Tasks and Materials",
        text: "Track solar work orders from lead to service with notes, status updates, documents, customer details, and clear next steps, so every install job stays organized and nothing important slips through the cracks.",
        image: asset(
          "inner-solar-sales-software-and-crm-work-orders-with-tasks-budget-and-materials.webp",
        ),
        alt: "Job management in Knockio",
      },
      {
        title: "Purchase Orders When Solar Equipment Runs Short",
        text: "When panels, inverters, or racking fall out of inventory, raise a purchase order straight from the work order. Knockio tracks products, variants, SKUs, cost, and markup, flagging low stock before you run short.",
        image: asset(
          "inner-solar-sales-software-and-crm-purchase-orders-when-equipment-runs-short.webp",
        ),
        alt: "Crew dispatching in Knockio",
      },
      {
        title: "Assign Solar Installs to Crews or Subcontractors",
        text: "Send solar work orders directly to your own install crew or to a trusted subcontractor, with tasks, notes, photos, and the full schedule attached, so whoever does the work always has the complete picture.",
        image: asset(
          "inner-solar-sales-software-and-crm-assign-solar-installs-to-crews-or-subcontractors.webp",
        ),
        alt: "Work orders in Knockio",
      },
    ],
  },
  {
    label: "Documents and Media",
    cards: [
      {
        title: "Site Photos and System Media in One Place",
        text: "Upload roof photos, electrical panel shots, and site survey images straight to the deal. Your design team, install crew, and the customer all get the full visual record together in one shared spot.",
        image: asset(
          "inner-solar-sales-software-and-crm-site-photos-and-system-media-in-one-place.webp",
        ),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "E-Contracts for Solar Agreements",
        text: "Send install contracts for digital signature with a documented audit trail, so financing partners and homeowners alike have a clean legal record. Every view and signature is logged with IP address and timestamp.",
        image: asset(
          "inner-solar-sales-software-and-crm-e-contracts-for-solar-agreements.webp",
        ),
        alt: "Proposals in Knockio",
      },
      {
        title: "Centralized File Storage Per Solar Deal",
        text: "Keep utility bills, interconnection paperwork, and permits attached right to the customer record, not scattered across inboxes and a shared drive nobody can ever navigate, so the whole team finds documents fast.",
        image: asset(
          "inner-solar-sales-software-and-crm-centralized-file-storage-per-deal.webp",
        ),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
  {
    label: "Quote and Get Paid",
    cards: [
      {
        title: "Solar Estimate and Quote Builder",
        text: "Create estimates with system size, equipment, and clear line-item pricing built in, so homeowners compare real numbers instead of squinting at a handwritten napkin estimate. Add optional line items like battery storage, save templates, and pull from a product catalog.",
        image: asset(
          "inner-solar-sales-software-and-crm-solar-estimate-and-quote-builder-1.webp",
        ),
        alt: "Video and file storage in Knockio",
      },
      {
        title: "Digital Solar Contracts With E-Signatures",
        text: "Once the homeowner is ready, send the install contract for digital signature with a documented audit trail. Change orders work exactly the same way, so any mid-deal adjustment is logged and tracked cleanly instead of handled loosely over text message.",
        image: asset(
          "inner-solar-sales-software-and-crm-digital-contracts-with-e-signatures.webp",
        ),
        alt: "Photo uploads in Knockio",
      },
      {
        title: "Flexible Payment Collection Options",
        text: "Collect deposits, milestone payments, and final balances through tap to pay, text to pay, card, or ACH, all tied directly to the job through Knockio's own payment processing. Cash flow no longer waits around on a paper check showing up later.",
        image: asset(
          "inner-solar-sales-software-and-crm-flexible-payment-collection.webp",
        ),
        alt: "Service reports in Knockio",
      },
    ],
  },
];

const organizedItems = [
  {
    title: "Live Field Tracking",
    text: "Monitor setters in real time with GPS tracking. It helps with accountability, safety, and knowing exactly who is working in which neighborhood right now.",
    href: "https://knockio.com/features/gps-tracking-software/",
    icon: "crosshair" as const,
  },
  {
    title: "Flow Automation",
    text: "Automatically handle the repetitive work like follow ups, callbacks, and appointment confirmations, so a deal does not go cold while your closers are out running other appointments.",
