const heroImage = asset(
  "inner-solar-sales-software-and-crm-what-should-solar-companies-look-for-in-a-crm-and-sales-platform.webp",
);

const operatingModelsData = {
  pillTag: "OPERATING MODEL FLEXIBILITY",
  title: "Built for How Your Solar Business Actually Operates",
  subtitle:
    "A $0-down PPA installer and a residential cash sales team share an industry, but run completely different workflows. Knockio adapts to your specific financial model, sales posture, and installation pipeline out of the box.",
  cards: [
    {
      icon: "sun",
      title: "Residential Cash & Solar Loans",
      text: "Engineered for high-velocity D2D sales teams and regional installers selling customer-owned systems. Track invoices from M1 install through final M2 PTO funding and keep each lender's signed agreement on the deal.",
      pills: [
        "GoodLeap / Mosaic Docs on File",
        "Deposit + Invoicing",
        "High-Speed D2D Canvassing",
      ],
    },
    {
      icon: "file-text",
      title: "Third-Party Leases & PPAs",
