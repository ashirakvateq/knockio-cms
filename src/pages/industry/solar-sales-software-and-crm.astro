---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Solar Sales Software & CRM for Solar Teams | Knockio";
const description =
  "Solar CRM system and sales software for door-to-door canvassing & service teams. Auto-built canvassing territories, setter-to-closer handoff, estimates & e-contracts in one platform.";

const asset = (name: string) => `/assets/cfw/${name}`;

type CapCard = {
  title: string;
  text: string;
  image: string;
  alt: string;
};

const capabilityTabs: { label: string; cards: CapCard[] }[] = [
  {
    label: "Manage Deals",
    cards: [
      {
        title: "Customer & Property Records in One Place",
        text: "Manage records during every visit, log outcomes, attach roof shading notes, and store utility bill history. When a homeowner calls back, your team sees the full conversation instead of digging through personal phones.",
        image: asset("inner-solar-sales-software-and-crm-customer-and-property-records-in-one-place.webp"),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "Dynamic Pipeline for Solar Stages",
        text: "Move deals through clear stages: Lead, Site Survey, Design, HOA Approval, Permitting, Install, Inspection, and PTO. Fully customize statuses to match your exact sales-to-install workflow.",
        image: asset("inner-solar-sales-software-and-crm-dynamic-pipeline-for-solar-stages.webp"),
        alt: "Lead management in Knockio",
      },
      {
        title: "Setter to Closer Handoffs",
        text: "Book appointments at the door straight onto a closer's calendar. Automatically attach 12-month kWh usage graphs, electrical panel photos, and decision-maker details so closers never arrive blind.",
        image: asset("inner-solar-sales-software-and-crm-setter-to-closer-handoff-and-scheduling.webp"),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Track Setters",
    cards: [
      {
        title: "Automated Territory Creation by ZIP & City",
        text: "Build canvassing territories automatically from ZIP codes and cities instead of drawing boundaries by hand. Carve up a target neighborhood and get setters knocking doors in minutes.",
        image: asset("inner-solar-sales-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp"),
        alt: "Route planning in Knockio",
      },
      {
        title: "Live GPS Tracking of Field Setters",
        text: "See where every setter is in real time to balance coverage across a build area. Pin-drop verification confirms exactly how close a rep stood to an address when marking a door worked.",
        image: asset("inner-solar-sales-software-and-crm-live-gps-tracking-of-every-setter.webp"),
        alt: "Territory management in Knockio",
      },
      {
        title: "Smarter Route Planning",
        text: "Plan tighter routes so reps cover more doors in less time each day—eliminating crisscrossing across the same blocks and saving valuable daylight hours.",
        image: asset("inner-solar-sales-software-and-crm-route-planning.webp"),
        alt: "Field activity log in Knockio",
      },
    ],
  },
  {
    label: "Work Orders & Equipment",
    cards: [
      {
        title: "Solar Work Orders With Takeoffs",
        text: "Track work orders from lead to service with clear equipment takeoffs. Attach panel models, inverter SKUs, racking specs, and safety notes so install crews always arrive prepared.",
        image: asset("inner-solar-sales-software-and-crm-work-orders-with-tasks-budget-and-materials.webp"),
        alt: "Job management in Knockio",
      },
      {
        title: "Purchase Orders for Solar Equipment",
        text: "When panels, microinverters, or rails run short, fire off a purchase order straight from the work order. Knockio flags low stock before your crew runs out mid-install.",
        image: asset("inner-solar-sales-software-and-crm-purchase-orders-when-equipment-runs-short.webp"),
        alt: "Crew dispatching in Knockio",
      },
      {
        title: "Assign Installs to Subcontractors",
        text: "Route work orders directly to your in-house crew or a trusted 1099 subcontractor. Attach satellite layouts, MPU photos, and schedules while stripping out sensitive customer pricing.",
        image: asset("inner-solar-sales-software-and-crm-assign-solar-installs-to-crews-or-subcontractors.webp"),
        alt: "Work orders in Knockio",
      },
    ],
  },
  {
    label: "Interconnection & PTO",
    cards: [
      {
        title: "Interconnection & PTO Status Tracking",
        text: "Don't let cash flow wait on permitting. Track municipal permit approvals, utility net-metering applications, and final Permission to Operate (PTO) letters in explicit wait-stage boards.",
        image: asset("inner-solar-sales-software-and-crm-site-photos-and-system-media-in-one-place.webp"),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "HOA & Architectural Review Gating",
        text: "Prevent expensive mid-install stop-work fines. Store HOA Architectural Review Board (ARB) approval letters directly on the record before scheduling crew dispatch.",
        image: asset("inner-solar-sales-software-and-crm-e-contracts-for-solar-agreements.webp"),
        alt: "Proposals in Knockio",
      },
      {
        title: "Site Survey Media & MPU Documentation",
        text: "Site surveyors upload roof condition photos, attic framing measurements, and main panel breaker ratings straight to the deal—preventing engineering redesigns.",
        image: asset("inner-solar-sales-software-and-crm-centralized-file-storage-per-deal.webp"),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
  {
    label: "Proposals & Payments",
    cards: [
      {
        title: "Solar Proposal & Quote Builder",
        text: "Create clean proposals with system size (kW), offset projections, and line-item equipment specs. Add optional battery storage line items and compare Cash vs. Loan pricing.",
        image: asset("inner-solar-sales-software-and-crm-solar-estimate-and-quote-builder-1.webp"),
        alt: "Video and file storage in Knockio",
      },
      {
        title: "E-Contracts With 3-Day Cancellation Disclosures",
        text: "Send install agreements for digital signature with IP timestamp logging. You can add the mandatory FTC 3-Day Notice of Cancellation to your contract templates, which appends it to door-to-door deals.",
        image: asset("inner-solar-sales-software-and-crm-digital-contracts-with-e-signatures.webp"),
        alt: "Photo uploads in Knockio",
      },
      {
        title: "On-Site Payment Collection",
        text: "Collect deposits, MPU upgrade fees, and invoices through Text-to-Pay, card, or ACH. Cash flow keeps pace with installation progress.",
        image: asset("inner-solar-sales-software-and-crm-flexible-payment-collection.webp"),
        alt: "Service reports in Knockio",
      },
    ],
  },
];

const organizedItems = [
  {
    title: "Live Field Tracking",
    text: "Monitor setters in real time with GPS tracking. It helps with accountability, safety, and knowing exactly who is working which neighborhood right now.",
    href: "https://knockio.com/features/gps-tracking-software/",
    icon: "crosshair" as const,
  },
  {
    title: "Flow Automation",
    text: "Automatically handle the daily grind like follow-ups, callbacks, and appointment confirmations so a deal does not go cold while closers are out running other appointments.",
    href: "https://knockio.com/features/business-automation-software/",
    icon: "sparkles" as const,
  },
  {
    title: "Media & Site Audits",
    text: "See every deal's photos, site survey details, electrical panel shots, and notes in one view, so engineering and the field read the same record.",
    href: null,
    icon: "ruler" as const,
  },
  {
    title: "E-Contracts",
    text: "Create digital contracts, add mandatory 3-day cancellation notices to your templates, collect signatures, and move approved jobs forward without paperwork delays.",
    href: "https://knockio.com/e-contracts/",
    icon: "file" as const,
  },
  {
    title: "CRM Integrations",
    text: "Knockio connects your customer records, invoices, and payments to the tools you use via Zapier and webhooks. It also connects natively or via Zapier and webhooks with Google Calendar, HubSpot, GoHighLevel (GHL), and Salesforce.",
    href: "https://knockio.com/knockio-integrations/",
    icon: "zap" as const,
  },
  {
    title: "Team Communication",
    text: "Link setters, closers, and ops to the same deal record through assignees and notes, so handoffs never depend on a forwarded text.",
    href: "https://knockio.com/features/business-texting-and-calling-software/",
    icon: "message" as const,
  },
];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "How does Knockio handle the handoff between setters and closers?",
    a: "Knockio links setters and closers to the exact same customer record. When a setter schedules an appointment at the door, the closer receives an instant notification with the roof photos, shading notes, and utility bill attached—eliminating pre-appointment confusion and blind presentations.",
  },
  {
    q: "Can Knockio track utility interconnection and PTO stages?",
    a: "Yes. Knockio features fully customizable project pipelines that let you track deals through site survey, engineering design, permitting, HOA approval, installation, municipal inspection, utility interconnection submission, and final Permission to Operate (PTO).",
  },
  {
    q: "Are door-to-door sales disclosures included in Knockio e-contracts?",
    a: "Yes. You can add mandatory disclosures to your contract templates—such as the FTC 3-Day Notice of Cancellation for door-to-door signups—to your digital agreements, complete with timestamped audit logging.",
  },
  {
    q: "How is Knockio different from Solargraf, Sunbase, or SalesRabbit for solar companies?",
    a: "Solargraf leans into design and proposal work, and SalesRabbit leans into canvassing, but Knockio brings canvassing, automated territory creation, live setter tracking, estimates, digital contracts, work orders, and payments into one connected system. Add deep deal history per property, a fully customizable pipeline with unlimited boards, personalized support, and pricing that does not punish a growing team, and you have one platform that runs the deal from the first knock to permission to operate.",
  },
  {
    q: "Does Knockio connect with the tools I already use?",
    a: "Knockio connects your customer records, invoices, and payments to the tools you use via Zapier and webhooks. It also connects natively or via Zapier and webhooks with Google Calendar, HubSpot, GoHighLevel (GHL), and Salesforce.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const heroImage = asset(
  "inner-solar-sales-software-and-crm-what-should-solar-companies-look-for-in-a-crm-and-sales-platform.webp",
);

const operatingModelsData = {
  pillTag: "OPERATING MODEL FLEXIBILITY",
  title: "Built for How Your Solar Business Actually Operates",
  subtitle:
    "A $0-down PPA installer and a residential cash sales team share an industry, but run completely different workflows. Knockio adapts to your specific financial model, sales posture, and installation pipeline out of the box.",
  cards: [
    {
      icon: "sun",
      title: "Residential Cash & Solar Loans",
      text: "Engineered for high-velocity D2D sales teams and regional installers selling customer-owned systems. Track invoices from M1 install through final M2 PTO funding and keep each lender's signed agreement on the deal.",
      pills: [
        "GoodLeap / Mosaic Docs on File",
        "Deposit + Invoicing",
        "High-Speed D2D Canvassing",
      ],
    },
    {
      icon: "file-text",
      title: "Third-Party Leases & PPAs",
      text: "Streamline $0-down solar agreements where a third-party finance partner owns the equipment. Manage 20-to-25 year lease approvals, customer credit status records, and long-term production monitoring seamlessly.",
      pills: [
        "$0-Down Agreement Flow",
        "3rd-Party Owner Approvals",
        "Production Guarantees",
      ],
    },
    {
      icon: "battery-full",
      title: "Battery Storage & NEM 3.0 Retrofits",
      text: "Adapt to modern net-metering changes. Run dedicated, rapid-turnaround pipelines for adding battery storage (Tesla Powerwall, Enphase, FranklinWH) and EV chargers to existing residential arrays.",
      pills: [
        "Rapid Non-PTO Pipelines",
        "Storage Add-On Quotes",
        "Main Panel Upgrade (MPU) Tracking",
      ],
    },
    {
      icon: "building",
      title: "Commercial Solar & O&M Contracts",
      text: "Manage Commercial & Industrial (C&I) multi-roof projects alongside recurring Operations & Maintenance (O&M) service contracts, routine panel washing, inverter replacements, and system health audits.",
      pills: [
        "B2B & RFP Bidding",
        "Recurring O&M Agreements",
        "Commercial Equipment Logging",
      ],
    },
  ],
};

const oldStackComparisonData = {
  title: "How Knockio Replaces Your Taped-Together Solar Stack",
  subtitle:
    "Stop paying for separate door-knocking apps, generic CRMs, and custom spreadsheets. Knockio brings your sales floor and install crews into one platform.",
  rows: [
    {
      stage: "Door Canvassing",
      oldStack:
        "Paying per seat for a standalone door app (SalesRabbit/SPOTIO) that doesn't sync with office calendars.",
      knockio:
        "Built-in D2D mapping, PIN-verification, and direct calendar dispatch to closers.",
    },
    {
      stage: "Sales Handoff",
      oldStack:
        "Texting roof photos and utility bills through group chats where details get lost.",
      knockio:
        "Centralized deal records holding site photos, shading notes, and utility bills in one view.",
    },
    {
      stage: "Interconnection & PTO",
      oldStack:
        "Spreadsheets tracking permit and net-metering approvals across separate departments.",
      knockio:
        "Visual Kanban boards tracking HOA approvals, permits, utility grid ties, and PTO sign-offs.",
    },
    {
      stage: "Contracts & Payments",
      oldStack:
        "Chasing paper signatures and manual invoice checks across multiple systems.",
      knockio:
        "Native e-contracts, 3-day cancellation notices you add to your templates, and mobile deposit collection.",
    },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id":
        "https://knockio.com/industry/solar-sales-software-and-crm/#webpage",
      url: "https://knockio.com/industry/solar-sales-software-and-crm/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      audience: {
        "@type": "Audience",
        audienceType: "Solar Sales Teams",
      },
      mainEntity: {
        "@id": "https://knockio.com/industry/solar-sales-software-and-crm/#faq",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id":
        "https://knockio.com/industry/solar-sales-software-and-crm/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Solar Sales Software and CRM",
          item: "https://knockio.com/industry/solar-sales-software-and-crm/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/industry/solar-sales-software-and-crm/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={heroImage}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="industry-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white"
    >
      <div
        class="grid min-h-0 lg:min-h-[610px] lg:grid-cols-[55%_45%] xl:min-h-[720px] 2xl:min-h-[820px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] pt-[calc(72px+3rem)] pb-12 sm:pt-[calc(72px+4rem)] sm:pb-16 lg:min-h-[600px] lg:px-0 lg:pb-[72px] lg:pt-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[36px] font-bold leading-[44px] text-neutral-950 sm:text-[44px] sm:leading-[54px] xl:text-[58px] xl:leading-[66px] 2xl:text-[64px] 2xl:leading-[74px]"
            >
              Solar Sales Software & CRM Built for Canvassers and Installers
            </h1>
            <p
              class="mb-10 max-w-[760px] text-base font-medium leading-8 text-neutral-600 sm:text-lg sm:leading-9"
            >
              Solar deals don't happen behind a desk. They start on a doorstep, advance through a technical site audit, navigate weeks of permitting and HOA limbo, and only turn into revenue when the utility issues Permission to Operate (PTO). Knockio connects your door-to-door solar canvassing tracking directly to your back-office operations—helping setters, closers, and install crews move deals faster.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white transition-colors duration-300 hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <p
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              What should solar companies look for in a CRM and sales platform?
            </p>
            <p
              class="max-w-[760px] text-[15px] leading-7 text-neutral-600 sm:text-base sm:leading-7"
            >
              A true solar project management software carries the deal from first knock to a working system on the roof. That means complete property records, setter-to-closer appointment handoffs, a pipeline matching solar stages, utility PTO tracking, e-contracts, and deposit collection. Knockio handles all of it in one platform—adding live GPS tracking of field reps and automated territory creation by ZIP and city so your deal history lives in a single record.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-industry-visual relative min-h-[340px] overflow-hidden sm:min-h-[440px] lg:min-h-full"
        >
          <img
            src={heroImage}
            alt="What should solar companies look for in a crm and sales platform"
            width="830"
            height="560"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="h-full min-h-[340px] w-full object-cover object-center sm:min-h-[440px] lg:min-h-full"
          />
        </div>
      </div>
    </section>

    <!-- ========== Why / Sticky tabs ========== -->
    <section id="platform-capabilities" class="bg-white py-20 sm:py-24 lg:py-28">
      <div class="my-container">
        <div class="mx-auto mb-10 max-w-[1120px] text-center lg:mb-12">
          <h2
            class="mb-5 text-center text-[34px] font-bold leading-[42px] text-neutral-950 sm:text-4xl sm:leading-[48px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Why Solar Teams Choose Knockio
          </h2>
          <p
            class="mx-auto max-w-[960px] text-base font-normal leading-8 text-neutral-600 sm:text-lg sm:leading-9"
          >
            Knockio is solar sales software and CRM built for installers who need one place to hold customer records, manage reps, set appointments, track every project stage, build proposals, send digital contracts, and collect deposits. No more working off three spreadsheets that never agree on where a deal stands.
          </p>
        </div>

        <div class="sr-only">
          {
            capabilityTabs.map((tab) => (
              <div>
                <h3>{tab.label}</h3>
                {tab.cards.map((card) => (
                  <article>
                    <h3>{card.title}</h3>
                    <p>{card.text}</p>
                  </article>
                ))}
              </div>
            ))
          }
        </div>

          <div
            id="hpCapScrollTrack"
            class="h-[calc(100vh+(var(--scroll-steps,5)-1)*45vh)] max-lg:h-auto motion-reduce:h-auto"
            style="--scroll-steps: 5"
          >
            <div
              class="contents lg:flex lg:sticky lg:top-0 lg:z-20 lg:h-[min(calc(100vh-2rem),880px)] lg:flex-col lg:bg-white/95 lg:pt-1 motion-reduce:h-auto motion-reduce:static"
            >
              <div
                class="sticky top-0 z-30 shrink-0 bg-white/95 px-1 pb-5 pt-2 backdrop-blur-md max-lg:overflow-hidden"
              >
                <div
                  id="hpTabs1Nav"
                  class="relative mx-auto flex max-w-6xl scroll-smooth items-center gap-2 overflow-x-auto [scrollbar-width:none] max-xl:gap-3 lg:justify-between max-lg:flex-nowrap max-lg:justify-start max-lg:px-[12vw] [&::-webkit-scrollbar]:hidden"
                  role="tablist"
                  aria-label="Solar platform capabilities"
                >
                  <span
                    id="hpTabs1Indicator"
                    class="pointer-events-none absolute left-0 top-0 z-0 rounded-full border-2 border-solid border-primary-500 bg-[#F9FFF8] transition-all duration-300 ease-out"
                    aria-hidden="true"></span>
