const oldStackComparisonData = {
  title: "How Knockio Replaces Your Taped-Together Electrical Stack",
  subtitle:
    "Stop paying for basic calendar dispatch apps, standalone proposal builders, and manual permitting spreadsheets. Knockio brings your electricians, estimators, and office into one platform.",
