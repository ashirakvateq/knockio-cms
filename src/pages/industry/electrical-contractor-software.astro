const operatingModelsData = {
  pillTag: "OPERATING MODEL FLEXIBILITY",
  title: "Built for How Your Electrical Business Actually Operates",
  subtitle:
    "A residential same-day service electrician and a commercial generator installer share a trade name, but run completely different workflows. Knockio adapts to your specific dispatch model, permitted projects, and electrification niche out of the box.",
  cards: [
    {
      icon: "zap",
      title: "Residential Service & Repair",
      text: "Designed for fast-paced service dispatching. Quote trip fees at booking, assign the nearest available electrician using the live rep map, present flat-rate repair quotes on a mobile tablet, and collect payment before leaving the driveway.",
