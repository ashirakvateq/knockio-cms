---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Electrical Contractor Software for Electricians | Knockio";
const description = "Electrical contractor software to schedule service calls, send estimates, dispatch electricians, collect payment on site, and manage jobs.";

const asset = (name: string) => `/assets/cfw/${name}`;

const capabilityTabs = [
	{
		label: "Manage Jobs & History",
		cards: [
			{
				title: "Electrical Panel & Breaker Property History",
				text: "Every property record logs main panel amperage (100A vs. 200A), wiring types (copper vs. aluminum), grounding details, and past service history. Electricians arrive knowing if the home has capacity for an EV charger before stepping on site.",
				image: asset("inner-electrician-software-and-crm-one-record-for-every-customer-and-property.webp"),
				alt: "Door-to-door canvassing in Knockio",
			},
			{
				title: "Dynamic Pipeline for Electrical Stages",
				text: "Move jobs through clear stages: Service Dispatch, Diagnosing, Estimate Quoted, Proposal Approved, Permit Pulled, Rough-In Inspection, Final Inspection, and Completed. Separate boards for service calls versus major rewires.",
				image: asset("inner-electrician-software-and-crm-customizable-job-pipeline.webp"),
				alt: "Lead management in Knockio",
			},
			{
				title: "Electrical Safety Plan Memberships",
				text: "Turn annual home electrical safety inspections into predictable recurring revenue. Manage safety plan memberships, track member-only discounts on panel servicing, and process recurring membership invoicing.",
				image: asset("inner-electrician-software-and-crm-communication-history-per-customer.webp"),
				alt: "Kanban-style sales pipeline in Knockio",
			},
		],
	},
	{
		label: "Track & Dispatch",
		cards: [
			{
				title: "Live GPS Tracking & Emergency Routing",
				text: "See every electrician's real-time GPS location on a visual dispatch map. When an emergency power outage or sparking outlet call arrives, use the live rep map to assign the nearest available technician immediately.",
				image: asset("inner-electrical-contractor-software-scheduling-and-dispatch-in-one-calendar.webp"),
				alt: "Route planning in Knockio",
			},
			{
				title: "Auto Territory Creation by ZIP & City",
				text: "Carve out service zones or neighborhood canvassing territories automatically by ZIP code and city. Target aging residential developments with 200-amp Main Panel Upgrade (MPU) or surge protection campaigns.",
				image: asset("inner-electrician-software-and-crm-live-gps-tracking-with-proximity-intelligence.webp"),
				alt: "Territory management in Knockio",
			},
			{
				title: "Smarter Electrical Route Planning",
				text: "Optimize daily routes for electricians running multiple residential repair calls a day. Reduce unnecessary drive time across town and keep electricians arriving within promised customer service windows.",
				image: asset("inner-electrician-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp"),
				alt: "Field activity log in Knockio",
			},
		],
	},
	{
		label: "Work Orders & Parts",
		cards: [
			{
				title: "Electrical Work Orders With Takeoffs",
				text: "Build detailed work orders tracking Romex wire, conduit, circuit breakers, GFCI/AFCI outlets, and disconnect boxes against real job costs. Electricians view itemized material takeoffs directly on their mobile app.",
				image: asset("inner-electrician-software-and-crm-detailed-estimates-with-templates.webp"),
				alt: "Job management in Knockio",
			},
			{
				title: "Purchase Orders to Electrical Suppliers",
				text: "When specialty breakers, EV charging stations, or generator transfer switches run short, generate a purchase order for your supplier such as CED, Graybar, or Rexel. Flag low stock before parts delay a job.",
				image: asset("inner-electrician-software-and-crm-work-orders-with-tasks-budget-and-materials.webp"),
				alt: "Crew dispatching in Knockio",
			},
			{
				title: "Van Stock & Inventory Management",
				text: "Track standard breakers, wire spools, and electrical boxes across individual service vans. Know exactly which truck has the required replacement hardware before dispatching them to a high-priority call.",
				image: asset("inner-electrical-contractor-software-assign-work-to-crews-or-subcontractors.webp"),
				alt: "Work orders in Knockio",
			},
		],
	},
	{
		label: "Documents & Media",
		cards: [
			{
				title: "Permit & AHJ Inspection Sign-Off Tracking",
				text: "Don't let project draws stall in permitting. Store municipal electrical permits, NEC code compliance checklists, and AHJ building inspector rough-in and final sign-off sheets attached directly to the property record.",
				image: asset("inner-electrical-contractor-software-inventory-management-for-electrical-parts.webp"),
				alt: "Smart estimates in Knockio",
			},
			{
				title: "Hazmat Discovery & Stop-Work Waivers",
				text: "If electricians open a wall in an older home and discover asbestos insulation or knob-and-tube wiring, immediately trigger a digital Hazmat Stop-Work Waiver to pause work and document the stop-work decision.",
				image: asset("inner-electrician-software-and-crm-vendor-bills-and-purchase-orders.webp"),
				alt: "Proposals in Knockio",
			},
			{
				title: "Panel Photos & Breaker Directory Media",
				text: "Upload high-resolution photos of open electrical panels, breaker directories, and grounding rods directly to the customer record—giving estimators and inspectors a clear visual record of code compliance.",
				image: asset("inner-electrician-software-and-crm-photo-annotation-for-panels-and-problems.webp"),
				alt: "Digital contracts in Knockio",
			},
		],
	},
	{
		label: "Quote & Get Paid",
		cards: [
			{
				title: "Good / Better / Best Panel & EV Estimates",
				text: "Build interactive Good/Better/Best proposals on major projects. Compare standard panel replacements against smart load-center installations with integrated Level 2 EV chargers and whole-home surge protection.",
				image: asset("inner-electrician-software-and-crm-digital-contracts-with-e-signatures.webp"),
				alt: "Video and file storage in Knockio",
			},
			{
				title: "Consumer Financing Documents",
				text: "Present monthly payment framing first. Present the monthly financing you offer, then import and e-sign the lender agreement (GreenSky, Service Finance, Wisetack, and the like) right on the job so the paperwork lives with the record.",
				image: asset("inner-electrician-software-and-crm-milestone-based-payment-collection.webp"),
				alt: "Photo uploads in Knockio",
			},
			{
				title: "On-Site Payment Collection",
				text: "Collect diagnostic trip fees on completion via Text-to-Pay. On larger permitted rewires, collect initial deposits, additional invoices, and final balances as AHJ inspections pass.",
				image: asset("inner-electrician-software-and-crm-flexible-payment-methods.webp"),
				alt: "Service reports in Knockio",
			},
		],
	},
];

const organizedItems = [
	{
		title: "Live Field Tracking",
		text: "Monitor electricians in real time with GPS tracking. Use the live rep map to assign the nearest available van to emergency power outages or sparking panels.",
