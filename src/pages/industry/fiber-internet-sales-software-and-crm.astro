---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Fiber Internet Sales Software & CRM for ISPs | Knockio";
const description =
  "Knockio CRM and door-to-door fiber internet sales software helps teams map territories, track reps by GPS, qualify addresses, & book installs faster.";

const asset = (name: string) => `/assets/cfw/${name}`;

const capabilityTabs = [
  {
    label: "Own the Map",
    cards: [
      {
        title: "Automated Territory Creation by Zip Code and City",
        text: "Own the Map during every visit, log outcomes, add notes or voice notes, and move prospects into a clear CRM pipeline.",
        image: asset(
          "inner-fiber-internet-sales-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp",
        ),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "Address-Level Lead Capture",
        text: "A rep logs a sign-up the second a homeowner says yes, with the address, contact info, plan, and notes saved before they reach the next door. No re-keying back at the office, no lost cards.",
        image: asset(
          "inner-fiber-internet-sales-software-and-crm-address-level-lead-capture.webp",
        ),
        alt: "Lead management in Knockio",
      },
      {
        title: "Pre-Knock Homeowner Data",
        text: "Pull homeowner details before the rep even knocks, so they walk up already knowing who lives there instead of starting cold.",
        image: asset(
          "inner-fiber-internet-sales-software-and-crm-pre-knock-homeowner-data.webp",
        ),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Track Every Rep",
    cards: [
      {
        title: "Live GPS Tracking of Every Rep",
        text: "See where every canvasser is on the map right now, so managers can balance coverage across a build area and reps are not all bunched on the same three streets.",
        image: asset(
          "inner-fiber-internet-sales-software-and-crm-live-gps-tracking-of-every-rep.webp",
        ),
        alt: "Route planning in Knockio",
      },
      {
        title: "Pin Drop Verification at the Door",
        text: 'Confirm how close a rep actually was to an address when they marked it worked, so the day\'s knock count holds up and "I hit that whole block" can be checked.',
        image: asset(
          "inner-fiber-internet-sales-software-and-crm-pin-drop-verification-at-the-door.webp",
        ),
        alt: "Territory management in Knockio",
      },
      {
        title: "Disposition Every Door",
        text: "Mark each address as sold, not home, callback, or not interested, so the map shows exactly where the team has been and where the open doors still are.",
        image: asset(
          "inner-fiber-internet-sales-software-and-crm-disposition-every-door.webp",
        ),
        alt: "Field activity log in Knockio",
      },
    ],
  },
  {
    label: "Move the Deal Forward",
    cards: [
      {
        title: "Pipeline Built for Fiber Sign-Ups",
        text: "Move the Deal Forward from lead to service with notes, status updates, documents, customer details, and clear next steps.",
        image: asset(
          "inner-fiber-internet-sales-software-and-crm-pipeline-built-for-fiber-sign-ups.webp",
        ),
        alt: "Job management in Knockio",
      },
      {
        title: "Communication History Per Lead",
        text: "Every call, text, and email tied to a homeowner is saved on the record, so when a rep follows up three days later, the whole back-and-forth is right there instead of buried in someone's phone.",
        image: asset(
          "inner-fiber-internet-sales-software-and-crm-communication-history-per-lead.webp",
        ),
        alt: "Crew dispatching in Knockio",
      },
      {
        title: "Appointment and Install Scheduling",
        text: "Book the install or the closer appointment on the spot and assign it to the right person, so the office and the field share one calendar instead of two that drift apart.",
        image: asset(
          "inner-fiber-internet-sales-software-and-crm-appointment-and-install-scheduling.webp",
        ),
        alt: "Work orders in Knockio",
      },
    ],
  },
  {
    label: "Documents and Media",
    cards: [
      {
        title: "Photo Annotation at the Door",
        text: "Snap a photo of the install spot, the junction box, or a problem on the property, then mark it up with notes and arrows right on the image, so the install crew knows exactly what they are walking into.",
        image: asset(
          "inner-fiber-internet-sales-software-and-crm-photo-annotation-at-the-door.webp",
        ),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "E-Contracts With Legal Protection",
        text: "Send the service agreement for digital signature with a documented audit trail, IP address and timestamp logged on every view and signature, so a signed deal is a clean legal record, not a verbal yes.",
        image: asset(
          "inner-fiber-internet-sales-software-and-crm-e-contracts-with-legal-protection.webp",
        ),
        alt: "Proposals in Knockio",
      },
      {
        title: "Centralized File Storage Per Lead",
        text: "Keep ID verification, agreements, and any service documents attached right to the homeowner record instead of scattered across inboxes.",
        image: asset(
          "inner-fiber-internet-sales-software-and-crm-centralized-file-storage-per-lead.webp",
        ),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
  {
    label: "Automate the Busywork",
    cards: [
      {
        title: "Native Automation Builder",
        text: "Build your own automations without code: trigger a follow-up text when a door is marked callback, alert a manager when a rep signs a deal, or remind a closer the night before an install. The office stops chasing the same tasks by hand.",
        image: asset(
          "inner-fiber-internet-sales-software-and-crm-native-automation-builder.webp",
        ),
        alt: "Video and file storage in Knockio",
      },
      {
        title: "E-Contracts for Follow-Ups",
        text: "Automatically handle callbacks, confirmation texts, and reminders, so an interested homeowner does not go cold while the rep is three streets over knocking the next door.",
        image: asset(
          "inner-fiber-internet-sales-software-and-crm-e-contracts-for-follow-ups.webp",
        ),
        alt: "Photo uploads in Knockio",
      },
      {
        title: "Reporting on Rep Activity and Priority Sorting",
        text: "Knockio ties setters, closers, and install coordinators to the same record through assignees and notes, so no detail falls through the handoff.",
        image: asset(
          "inner-fiber-internet-sales-software-and-crm-reporting-on-rep-activity-and-priority-sorting.webp",
        ),
        alt: "Service reports in Knockio",
      },
    ],
  },
];

const organizedItems = [
  {
    title: "Live Field Tracking",
    text: "Monitor reps in real time with GPS tracking. It helps with coverage, accountability, and knowing exactly who is working in which neighborhood right now.",
    href: "https://knockio.com/features/gps-tracking-software/",
    icon: "crosshair" as const,
  },
  {
    title: "CRM Integrations",
    text: "Knockio connects your fiber signups and rep activity to Salesforce, HubSpot, Google Calendar, and GHL, reaching thousands more apps through Zapier, FlowChef, and webhooks.",
    href: "https://knockio.com/knockio-integrations/",
    icon: "sparkles" as const,
  },
  {
    title: "Communication History",
    text: "Every text, call, and email with a homeowner lives on their record, so any rep who picks up the account sees the full conversation instead of starting over.",
    href: "https://knockio.com/features/business-texting-and-calling-software/",
    icon: "ruler" as const,
  },
  {
    title: "Map and Disposition View",
    text: "See who has been contacted, who signed, and who needs a revisit. The live map makes it obvious where the team should knock next.",
    href: "https://knockio.com/canvassing/",
    icon: "file" as const,
  },
  {
    title: "E-Contracts",
    text: "Send contracts for review and signature instantly so every approved deal moves forward without paper forms or slow manual follow-ups.",
    href: "https://knockio.com/features/e-contracts-software/",
    icon: "zap" as const,
  },
  {
    title: "Reporting on Rep Activity",
    text: "See knocks, dispositions, sign-ups, and install rates per rep, so you know who is producing and who needs coaching, not just who says they had a good day.",
    href: "https://knockio.com/features/reporting-software/",
    icon: "message" as const,
  },
];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "What should I look for in fiber door-to-door sales software?",
    a: "Look for automated territory assignment, live GPS rep tracking, fast address-level lead capture, full communication history per door, e-contracts, and a customizable pipeline. The platform should match the speed of a live build map, not slow a rep down with office-style data entry. Knockio was built around exactly this kind of field workflow.",
  },
  {
    q: "Which software is best for managing a door-to-door fiber team?",
    a: "Knockio helps field service teams manage the full workflow. Teams can Own the Map, store customer details, create estimates, schedule jobs, assign crews, track job progress, upload photos, send invoices, and follow up with customers. This helps reduce manual work and keeps everyone updated.",
  },
  {
    q: "Can Knockio create canvassing territories automatically?",
    a: "Yes. Knockio can build territories automatically from zip codes and cities, so the day a neighborhood goes live you can split it up and get reps knocking fast, without drawing boundaries by hand.",
  },
  {
    q: "Can Knockio track my reps and verify which doors were worked?",
    a: "Yes. Knockio includes live GPS tracking plus pin drop verification, so you can confirm how close a rep was to an address when they marked it worked.",
  },
  {
    q: "Does Knockio keep a record of every conversation with a homeowner?",
    a: "Yes. Communication history saves every call, text, and email tied to a lead on the record, so any rep following up sees the full back-and-forth instead of starting cold.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const heroImage = asset(
  "inner-fiber-internet-sales-software-and-crm-what-should-fiber-sales-teams-look-for-in-a-canvassing-and-sales-platform.webp",
);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id":
        "https://knockio.com/industry/fiber-internet-sales-software-and-crm/#webpage",
      url: "https://knockio.com/industry/fiber-internet-sales-software-and-crm/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      audience: {
        "@type": "Audience",
        audienceType: "Fiber and Internet Service Providers",
      },
      mainEntity: {
        "@id":
          "https://knockio.com/industry/fiber-internet-sales-software-and-crm/#faq",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id":
        "https://knockio.com/industry/fiber-internet-sales-software-and-crm/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Fiber Internet Sales Software & CRM",
          item: "https://knockio.com/industry/fiber-internet-sales-software-and-crm/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id":
        "https://knockio.com/industry/fiber-internet-sales-software-and-crm/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={heroImage}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="industry-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white"
    >
      <div
        class="grid min-h-0 lg:min-h-[610px] lg:grid-cols-[55%_45%] xl:min-h-[720px] 2xl:min-h-[820px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] pt-[calc(72px+3rem)] pb-12 sm:pt-[calc(72px+4rem)] sm:pb-16 lg:min-h-[600px] lg:px-0 lg:pb-[72px] lg:pt-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[36px] font-bold leading-[44px] text-neutral-950 sm:text-[44px] sm:leading-[54px] xl:text-[58px] xl:leading-[66px] 2xl:text-[64px] 2xl:leading-[74px]"
            >
              Fiber and Internet Sales Software<br class="hidden xl:block" />
            </h1>
            <p
              class="mb-10 max-w-[760px] text-base font-medium leading-8 text-neutral-600 sm:text-lg sm:leading-9"
            >
              A rep works a street the day the fiber goes live, qualifies the
              address, signs the homeowner, and books the install before the
              competitor's truck even shows up. Knockio is a fiber and internet
              sales software built for teams who need to assign territories,
              track reps in the field, capture sign-ups at the door, log every
              conversation, and move installs forward, all from one app instead
              of a paper map and a group text.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white transition-colors duration-300 hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <p
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              What should fiber sales teams look for in a canvassing and sales
              platform?
            </p>
            <p
              class="max-w-[760px] text-[15px] leading-7 text-neutral-600 sm:text-base sm:leading-7"
            >
              A fiber sales team should look for a platform that matches the
              speed of a door-to-door push: automated territory assignment, live
              rep tracking, fast address-level lead capture, full conversation
              history per door, and a pipeline that runs from first knock to
              confirmed install. Knockio covers all of it in one app. It also
              adds automated territory creation by zip code and city plus pin
              drop verification, so managers know exactly which addresses were
              worked and by whom. That speed, plus affordable pricing and
              support that actually answers, is what generic CRMs built for
              office sales simply do not offer a field team.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-industry-visual relative min-h-[340px] overflow-hidden sm:min-h-[440px] lg:min-h-full"
        >
          <img
            src={heroImage}
            alt="What should fiber sales teams look for in a canvassing and sales platform"
            width="830"
            height="560"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="h-full min-h-[340px] w-full object-cover object-center sm:min-h-[440px] lg:min-h-full"
          />
        </div>
      </div>
    </section>

    <!-- ========== Why Fiber / Sticky tabs ========== -->
    <section
      id="platform-capabilities"
      class="bg-white py-20 sm:py-24 lg:py-28"
    >
      <div class="my-container">
        <div class="mx-auto mb-10 max-w-[1120px] text-center lg:mb-12">
          <h2
            class="mb-5 text-center text-[34px] font-bold leading-[42px] text-neutral-950 sm:text-4xl sm:leading-[48px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Why Fiber Sales Teams Choose Knockio
          </h2>
          <p
            class="mx-auto max-w-[960px] text-base font-normal leading-8 text-neutral-600 sm:text-lg sm:leading-9"
          >
            Knockio helps fiber and internet sales teams manage territories,
            reps, sign-ups, appointments, install scheduling, and follow-ups.
            From the first knock to a confirmed install date, it all sits in one
            connected platform. Managers run the field without stitching
            together a spreadsheet, a mapping tool, and a separate messaging
            app.
          </p>
        </div>

          <div
            id="hpCapScrollTrack"
            class="h-[calc(100vh+(var(--scroll-steps,5)-1)*45vh)] max-lg:h-auto motion-reduce:h-auto"
            style="--scroll-steps: 5"
          >
            <div
              class="contents lg:flex lg:sticky lg:top-0 lg:z-20 lg:h-[min(calc(100vh-2rem),880px)] lg:flex-col lg:bg-white/95 lg:pt-1 motion-reduce:h-auto motion-reduce:static"
            >
              <div
                class="sticky top-0 z-30 shrink-0 bg-white/95 px-1 pb-5 pt-2 backdrop-blur-md max-lg:overflow-hidden"
              >
                <div
                  id="hpTabs1Nav"
                  class="relative mx-auto flex max-w-6xl scroll-smooth items-center gap-2 overflow-x-auto [scrollbar-width:none] max-xl:gap-3 lg:justify-between max-lg:flex-nowrap max-lg:justify-start max-lg:px-[12vw] [&::-webkit-scrollbar]:hidden"
                  role="tablist"
                  aria-label="Fiber platform capabilities"
                >
                  <span
                    id="hpTabs1Indicator"
                    class="pointer-events-none absolute left-0 top-0 z-0 rounded-full border-2 border-solid border-primary-500 bg-[#F9FFF8] transition-all duration-300 ease-out"
                    aria-hidden="true"></span>
                  {
                    capabilityTabs.map((tab, index) => (
                      <button
                        type="button"
                        data-hp-scroll-step={String(index)}
                        class:list={[
                          "hpTabs1_btn relative z-10 shrink-0 rounded-full border-2 px-5 py-2.5 text-lg font-bold transition-colors hover:border-primary-500/40 hover:text-primary-500 max-xl:px-4 max-xl:py-2 max-xl:text-base max-md:text-sm",
                          index === 0
                            ? "border-transparent text-primary-500"
                            : "border-dashed border-neutral-300 text-neutral-700",
                        ]}
                      >
                        {tab.label}
                      </button>
                    ))
                  }
                </div>
              </div>

              <div id="hpTabs1Panels" class="relative lg:flex-1">
                {
                  capabilityTabs.map((tab, tabIndex) => (
                    <div
                      id={`hpTabs${tabIndex + 1}_tab${tabIndex + 1}`}
                      class:list={[
                        "hpTabs1_content scroll-mt-24 lg:absolute lg:inset-0 lg:flex lg:h-full lg:flex-col lg:gap-3 lg:overflow-hidden transition-opacity duration-300 max-lg:static max-lg:mb-10 max-lg:h-auto max-lg:overflow-visible max-lg:opacity-100 max-lg:visible max-lg:pointer-events-auto motion-reduce:static motion-reduce:h-auto pt-5",
                        tabIndex === 0
                          ? "opacity-100 visible pointer-events-auto"
                          : "opacity-0 invisible pointer-events-none",
                      ]}
                      role="tabpanel"
                    >
                      <div class="grid gap-6 lg:grid-cols-3 lg:gap-8">
                        {tab.cards.map((card, cardIndex) => (
                          <article
                            class:list={[
                              "hp-cap-card hp-card flex min-h-[520px] flex-col overflow-hidden rounded-[28px] border border-solid border-neutral-200 bg-neutral-50 p-7 sm:p-8",
                            ]}
                          >
                            <div
                              class:list={[
                                "relative z-10 shrink-0",
                                // cardIndex === 0
                                //   ? "max-w-full p-7 max-xl:p-6 max-md:p-5 lg:max-[1439px]:pb-0 min-[1440px]:max-w-[50%]"
                                //   : "",
                              ]}
                            >
                              <h5 class="text-3xl max-2xl:text-2xl max-md:text-lg font-bold text-neutral-900 mb-3 max-md:mb-1">
                                {card.title}
                              </h5>
                              <p class="mb-8 text-base leading-7 text-neutral-600 sm:text-[17px] sm:leading-8">
                                {card.text}
                              </p>
                            </div>
                            <div class="mt-auto flex justify-center overflow-hidden rounded-3xl">
                              <img
                                src={card.image}
                                alt={card.alt}
                                width="430"
                                height="320"
                                decoding="async"
                                loading="lazy"
                                class="w-full max-w-[430px] object-contain object-bottom"
                              />
                            </div>
                          </article>
                        ))}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

        <div class="sr-only">
          {
            capabilityTabs.map((tab) => (
              <div>
                <h3>{tab.label}</h3>
                {tab.cards.map((card) => (
                  <article>
                    <h3>{card.title}</h3>
