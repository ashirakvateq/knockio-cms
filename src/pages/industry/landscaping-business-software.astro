---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Landscaping Business Software for Landscapers | Knockio";
const description =
  "Landscaping business software to manage design proposals, schedule crews, track project budgets, and collect payment with Knockio.";

const asset = (name: string) => `/assets/cfw/${name}`;

type CapCard = {
  title: string;
  text: string;
  image: string;
  alt: string;
};

const capabilityTabs: { label: string; cards: CapCard[] }[] = [
  {
    label: "Manage Accounts & Projects",
    cards: [
      {
        title: "Property Maintenance & Turf History",
        text: "Every property record logs lot square footage, turf grass types, irrigation zones, gate access codes, dog warnings, and past service history. Crews arrive on site with clear instructions visible on their mobile route sheet.",
        image: asset(
          "inner-landscaping-software-and-crm-detailed-estimates-for-maintenance-and-design-build.webp",
        ),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "Dynamic Pipeline for Landscaping Stages",
        text: "Move accounts and projects through clear stages: Lead, Property Walkthrough, Estimate Quoted, Maintenance Active, Design-Build Permitted, Hardscape in Progress, and Seasonal Renewal. Separate boards for mowing versus installs.",
        image: asset(
          "inner-landscaping-software-and-crm-one-record-per-customer-and-property.webp",
        ),
        alt: "Lead management in Knockio",
      },
      {
        title: "Recurring Seasonal Maintenance Contracts",
        text: "Manage weekly, bi-weekly, or annual landscape maintenance agreements. Automate recurring billing schedules, track seasonal contract start/end dates, and process recurring invoicing without chasing invoices.",
        image: asset(
          "inner-landscaping-software-and-crm-communication-history-on-every-account.webp",
        ),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Track & Route",
    cards: [
      {
        title: "Smarter Route Density Planning",
        text: "Landscaping profitability is won on route density. Optimize daily schedules for mowing crews to cluster stops within the same neighborhood—drastically cutting windshield time, fuel costs, and equipment wear.",
        image: asset(
          "inner-landscaping-software-and-crm-recurring-routes-and-project-scheduling.webp",
        ),
        alt: "Route planning in Knockio",
      },
      {
        title: "Auto Territory Creation by ZIP & City",
        text: "Build canvassing territories automatically from ZIP codes and cities. Target dense residential subdivisions with lawn care, aeration, or seasonal mulch canvassing campaigns to dominate entire streets.",
        image: asset(
          "inner-landscaping-software-and-crm-crew-assignment-and-job-stages.webp",
        ),
        alt: "Territory management in Knockio",
      },
      {
        title: "Live GPS Tracking & Crew Accountability",
        text: "Monitor mowing and installation crews in real time on a live map. Pin-drop verification confirms when a crew arrived and departed a property, providing clear proof of service to commercial property managers.",
        image: asset(
          "inner-landscaping-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp",
        ),
        alt: "Field activity log in Knockio",
      },
    ],
  },
  {
    label: "Work Orders & Materials",
    cards: [
      {
        title: "Landscaping Work Orders With Takeoffs",
        text: "Build detailed work orders tracking sod pallets, pavers, retaining wall blocks, mulch yards, and irrigation heads against real job budgets. Install crews view itemized material takeoffs directly on their mobile app.",
        image: asset(
          "inner-landscaping-software-and-crm-work-orders-with-budgets-and-material-takeoffs.webp",
        ),
        alt: "Job management in Knockio",
      },
      {
        title: "Purchase Orders to Nursery & Stone Suppliers",
        text: "When plant nursery stock, hardscape pavers, or fertilizer bags run short, generate a purchase order for your supplier such as SiteOne, John Deere Landscapes, or local nurseries before shortages delay a build.",
        image: asset(
          "inner-landscaping-software-and-crm-inventory-management-for-plants-and-materials.webp",
        ),
        alt: "Crew dispatching in Knockio",
      },
      {
        title: "Pesticide & Turf Chemical Application Logs",
        text: "Stay compliant with state agricultural departments. Track commercial pesticide applicator license numbers, fertilizer N-P-K ratios, application rates, and weather conditions directly on customer chemical receipts.",
        image: asset(
          "inner-landscaping-software-and-crm-vendor-bills-and-purchase-orders.webp",
        ),
        alt: "Work orders in Knockio",
      },
    ],
  },
  {
    label: "Documents & Media",
    cards: [
      {
        title: "Before & After Landscape Photo Proof",
        text: "Crews capture timestamped before-and-after photos of mowed properties, clean hardscapes, and seasonal cleanups—uploading visual proof to the customer record to eliminate client billing disputes.",
        image: asset(
          "inner-landscaping-software-and-crm-photo-annotation-for-scope-and-progress.webp",
        ),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "Bilateral Change Orders for Extra Scope",
        text: "When a client asks a maintenance crew to install extra mulch beds or add irrigation heads mid-job, generate a dual-signature digital Change Order on site to document scope and price before extra work occurs.",
        image: asset(
          "inner-landscaping-software-and-crm-job-notes-and-surveys-on-site.webp",
        ),
        alt: "Proposals in Knockio",
      },
      {
        title: "HOA Architectural Review & Permit Storage",
        text: "Store HOA Architectural Review Board (ARB) approval letters, municipal retaining wall engineering permits, and irrigation backflow test certifications attached directly to the property record.",
        image: asset(
          "inner-landscaping-software-and-crm-centralized-file-storage-per-project.webp",
        ),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
  {
    label: "Quote & Get Paid",
    cards: [
      {
        title: "Fast Property Walkthrough Estimates",
        text: "Build accurate estimates during on-site property walkthroughs. Quote recurring mowing rates alongside one-time cleanup or aeration fees, and capture customer e-signatures on a tablet before leaving the property.",
        image: asset(
          "inner-landscaping-software-and-crm-milestone-based-payment-collection.webp",
        ),
        alt: "Video and file storage in Knockio",
      },
      {
        title: "Good / Better / Best Design-Build Proposals",
        text: "Offer tiered proposals on major outdoor living projects. Compare standard paver patios against complete outdoor kitchen installations with lighting, incorporating consumer financing options to lift ticket sizes.",
        image: asset(
          "inner-landscaping-software-and-crm-digital-contracts-with-e-signatures.webp",
        ),
        alt: "Photo uploads in Knockio",
      },
      {
        title: "Recurring Invoicing",
        text: "Send recurring invoices for weekly mowing. On large design-build projects, collect initial material deposits, additional invoices as hardscape stages complete, and final balances on site via Text-to-Pay.",
        image: asset(
          "inner-landscaping-software-and-crm-flexible-payment-methods.webp",
        ),
        alt: "Service reports in Knockio",
      },
    ],
  },
];

const organizedItems = [
  {
    title: "Live Field Tracking",
    text: "Monitor mowing and hardscape crews in real time with GPS tracking. Verify arrival and departure times with pin-drop proximity to provide proof of service.",
    href: "https://knockio.com/features/gps-tracking-software/",
    icon: "crosshair" as const,
  },
  {
    title: "Flow Automation",
    text: "Automatically handle the daily grind like seasonal cleanup reminders, rain-delay notifications, and payment receipts so your office runs smoothly.",
    href: "https://knockio.com/features/business-automation-software/",
    icon: "sparkles" as const,
  },
  {
    title: "Media & Measurements",
    text: "See every property's lot square footage, before-and-after mowing photos, irrigation zone diagrams, and chemical application logs in one view.",
    href: null,
    icon: "ruler" as const,
  },
  {
    title: "E-Contracts",
    text: "Send annual maintenance contracts, design-build agreements, and digital Change Orders for e-signature with built-in legal protection and audit trails.",
    href: "https://knockio.com/e-contracts/",
    icon: "file" as const,
  },
  {
    title: "CRM Integrations",
    text: "Knockio connects your customer records, invoices, and payments to the tools you use via Zapier and webhooks. It also connects via Zapier and webhooks with Google Calendar, HubSpot, GoHighLevel (GHL), and Salesforce.",
    href: "https://knockio.com/knockio-integrations/",
    icon: "zap" as const,
  },
  {
    title: "Team Communication",
    text: "Link landscape architects, maintenance foremen, and account managers to the same property record so customer preferences never get lost.",
    href: "https://knockio.com/features/business-texting-and-calling-software/",
    icon: "message" as const,
  },
];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "What should I look for in landscaping business software?",
    a: "Look for a platform that handles both recurring maintenance and full design-build projects: route density optimization, detailed estimating, material tracking, e-contracts, and staged invoicing—all tied to one customer record. Most tools do one side well and the other poorly. Knockio was built to run both from the same system.",
  },
  {
    q: "Can Knockio optimize routes for weekly mowing crews?",
    a: "Yes. Knockio includes visual route planning and GPS tracking that clusters stops by neighborhood to maximize route density—reducing windshield time, fuel costs, and unnecessary driving across town.",
  },
  {
    q: "Can technicians log chemical lawn fertilization and pesticide applications?",
    a: "Yes. Technicians can log commercial pesticide applicator license numbers, N-P-K fertilizer ratios, application quantities, and weather conditions directly into the property record to satisfy state agricultural compliance.",
  },
  {
    q: "Does Knockio support staged invoicing for large hardscape projects?",
    a: "Yes. While maintenance routes use recurring invoicing, large design-build projects can be billed via invoices—capturing initial material deposits, mid-job draws, and final payment upon completion.",
  },
  {
    q: "How is Knockio different from Aspire, LMN, or Jobber for landscaping companies?",
    a: "Aspire and LMN are complex systems built primarily for large commercial bidding, while Jobber focuses on basic residential scheduling without native sales canvassing. Knockio combines D2D neighborhood canvassing, route density planning, chemical logging, and design-build invoices in one flat-rate platform.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

