  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const operatingModelsData = {
  pillTag: "OPERATING MODEL FLEXIBILITY",
  title: "Built for How Your Landscaping Business Actually Operates",
  subtitle:
    "A weekly lawn mowing route and a $50,000 hardscape design-build project share a trade name, but run completely different workflows. Knockio adapts to your specific route density, chemical turf care, and seasonal snow removal out of the box.",
  cards: [
    {
      icon: "leaf",
      title: "Recurring Lawn Maintenance",
      text: "Engineered for high-density weekly and bi-weekly mowing routes (the largest share of trade revenue). Optimize route clustering, store gate codes on mobile route sheets, and trigger recurring invoicing upon completion.",
      pills: ["Route Density Optimization", "Recurring Invoicing", "Gate Code & Pet Alerts"],
    },
    {
      icon: "spray-can",
      title: "Chemical Lawn Care & Turf",
      text: "Manage fertilizer, weed control, and pesticide application routes. Ensure compliance by logging commercial pesticide applicator license numbers, N-P-K ratios, and chemical dilution rates on customer receipts.",
      pills: ["Pesticide Applicator Logs", "Turf Application Receipts", "D2D Neighborhood Sales"],
    },
    {
      icon: "trowel",
      title: "Design-Build & Hardscaping",
      text: "Streamline high-ticket patio, retaining wall, and outdoor living installations. Manage staged material takeoffs (pavers, stone, sod), bilateral change orders for scope additions, and invoices.",
      pills: ["Invoicing", "Bilateral Change Orders", "Paver & Nursery POs"],
    },
    {
      icon: "snowflake",
      title: "Winter Snow & Event Lighting",
      text: "Toggle operational modes seamlessly when seasons change. Pivot maintenance crews to commercial snow/ice removal contracts or Q4 architectural holiday lighting leases with warehouse bin storage tracking.",
      pills: ["Seasonal Pivot Mode", "Snow & Ice Dispatch", "Holiday Lighting Storage"],
    },
  ],
};

const oldStackComparisonData = {
  title: "How Knockio Replaces Your Taped-Together Landscaping Stack",
  subtitle:
    "Stop paying for basic routing apps, standalone estimating software, and manual spreadsheet billing. Knockio brings your maintenance crews, hardscape installers, and office into one platform.",
  rows: [
    {
      stage: "Canvassing & Sales",
      oldStack: "Using standalone door apps (SalesRabbit) to sell lawn care without visibility into existing crew route density.",
      knockio: "Built-in D2D canvassing that targets streets adjacent to your existing routes to maximize density.",
    },
    {
      stage: "Route Scheduling",
      oldStack: "Juggling spreadsheets or basic calendars that fail to optimize stop order or store gate codes and pet alerts.",
      knockio: "Visual route optimization that clusters neighborhoods and displays clear property notes on mobile.",
    },
    {
      stage: "Design-Build & Scope",
      oldStack: "Handwriting hardscape estimates and relying on verbal agreements when clients ask for extra landscaping mid-job.",
      knockio: "Tiered Good/Better/Best proposals and digital dual-signature change orders captured on a tablet.",
    },
    {
      stage: "Invoicing & Payments",
      oldStack: "Printing paper invoices for mowing clients and chasing overdue checks at the end of every month.",
      knockio: "Automated recurring invoicing for maintenance and invoices for installations.",
    },
  ],
};

const heroImage = asset(
  "inner-landscaping-software-and-crm-what-should-landscaping-companies-look-for-in-a-crm-and-project-platform.webp",
);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id":
        "https://knockio.com/industry/landscaping-business-software/#webpage",
      url: "https://knockio.com/industry/landscaping-business-software/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      audience: {
        "@type": "Audience",
        audienceType: "Landscaping Contractors",
      },
      mainEntity: {
        "@id":
          "https://knockio.com/industry/landscaping-business-software/#faq",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id":
        "https://knockio.com/industry/landscaping-business-software/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Landscaping Business Software",
          item: "https://knockio.com/industry/landscaping-business-software/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/industry/landscaping-business-software/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={heroImage}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="industry-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white"
    >
      <div
        class="grid min-h-0 lg:min-h-[610px] lg:grid-cols-[55%_45%] xl:min-h-[720px] 2xl:min-h-[820px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] pt-[calc(72px+3rem)] pb-12 sm:pt-[calc(72px+4rem)] sm:pb-16 lg:min-h-[600px] lg:px-0 lg:pb-[72px] lg:pt-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[36px] font-bold leading-[44px] text-neutral-950 sm:text-[44px] sm:leading-[54px] xl:text-[58px] xl:leading-[66px] 2xl:text-[64px] 2xl:leading-[74px]"
            >
              Landscaping Business Software Built for Lawn Care and Design-Build Teams
            </h1>
            <p
              class="mb-10 max-w-[760px] text-base font-medium leading-8 text-neutral-600 sm:text-lg sm:leading-9"
            >
              Landscaping contractors run two businesses under one roof: high-density recurring lawn maintenance routes and high-ticket design-build hardscaping projects. Knockio connects your maintenance crews, landscape designers, and chemical applicators into one platform—giving landscaping businesses the tools to optimize mowing routes, log turf fertilization, manage project billing, and pivot to snow removal in the winter.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white transition-colors duration-300 hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <p
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              What should landscapers look for in a CRM and field service platform?
            </p>
            <p
              class="max-w-[760px] text-[15px] leading-7 text-neutral-600 sm:text-base sm:leading-7"
            >
              A true landscaping business software handles both recurring weekly mowing routes and multi-stage hardscape installations without forcing you into two tools. That means complete property records with gate codes and pet alerts, automated neighborhood canvassing territories, route density optimization, commercial pesticide applicator logs, bilateral change orders, and staged invoicing. Knockio handles all of it in one platform—adding live GPS tracking of crews so your job history lives in a single record.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-industry-visual relative min-h-[340px] overflow-hidden sm:min-h-[440px] lg:min-h-full"
        >
          <img
            src={heroImage}
            alt="What should landscaping companies look for in a crm and project platform"
            width="830"
            height="560"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="h-full min-h-[340px] w-full object-cover object-center sm:min-h-[440px] lg:min-h-full"
          />
        </div>
      </div>
    </section>

    <!-- ========== Why / Sticky tabs ========== -->
    <section id="platform-capabilities" class="bg-white py-20 sm:py-24 lg:py-28">
      <div class="my-container">
        <div class="mx-auto mb-10 max-w-[1120px] text-center lg:mb-12">
          <h2
            class="mb-5 text-center text-[34px] font-bold leading-[42px] text-neutral-950 sm:text-4xl sm:leading-[48px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Why Landscaping Teams Choose Knockio
          </h2>
          <p
            class="mx-auto max-w-[960px] text-base font-normal leading-8 text-neutral-600 sm:text-lg sm:leading-9"
          >
            Knockio helps landscaping contractors manage customer accounts,
            recurring routes, design-build projects, crews, materials, invoices,
            and payments. From a weekly maintenance stop to a months-long
            install, it all sits in one connected platform. Owners run
            maintenance and production without bouncing between three different
            tools.
          </p>
        </div>

        <div class="sr-only">
          {
            capabilityTabs.map((tab) => (
              <div>
                <h3>{tab.label}</h3>
                {tab.cards.map((card) => (
                  <article>
                    <h3>{card.title}</h3>
                    <p>{card.text}</p>
                  </article>
                ))}
              </div>
            ))
          }
        </div>

          <div
            id="hpCapScrollTrack"
            class="h-[calc(100vh+(var(--scroll-steps,5)-1)*45vh)] max-lg:h-auto motion-reduce:h-auto"
            style="--scroll-steps: 5"
          >
            <div
              class="contents lg:flex lg:sticky lg:top-0 lg:z-20 lg:h-[min(calc(100vh-2rem),880px)] lg:flex-col lg:bg-white/95 lg:pt-1 motion-reduce:h-auto motion-reduce:static"
            >
              <div
                class="sticky top-0 z-30 shrink-0 bg-white/95 px-1 pb-5 pt-2 backdrop-blur-md max-lg:overflow-hidden"
              >
                <div
                  id="hpTabs1Nav"
                  class="relative mx-auto flex max-w-6xl scroll-smooth items-center gap-2 overflow-x-auto [scrollbar-width:none] max-xl:gap-3 lg:justify-between max-lg:flex-nowrap max-lg:justify-start max-lg:px-[12vw] [&::-webkit-scrollbar]:hidden"
                  role="tablist"
                  aria-label="Landscaping platform capabilities"
                >
                  <span
                    id="hpTabs1Indicator"
                    class="pointer-events-none absolute left-0 top-0 z-0 rounded-full border-2 border-solid border-primary-500 bg-[#F9FFF8] transition-all duration-300 ease-out"
                    aria-hidden="true"></span>
                  {
                    capabilityTabs.map((tab, index) => (
                      <button
                        type="button"
                        data-hp-scroll-step={String(index)}
                        class:list={[
