---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/landscaping-business-software.css";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Landscaping Business Software for Landscapers | Knockio";
const description =
  "Landscaping business software to manage design proposals, schedule crews, track project budgets, and collect payment with Knockio.";

const asset = (name: string) => `/assets/cfw/${name}`;

type CapCard = {
  title: string;
  text: string;
  image: string;
  alt: string;
};

const capabilityTabs: { label: string; cards: CapCard[] }[] = [
  {
    label: "Land the Project",
    cards: [
      {
        title: "Detailed Estimates for Maintenance and Design-Build",
        text: "Land the project during every visit, log outcomes, add notes or quick voice notes, and move prospects into a clear CRM pipeline, so your whole team sees the full history and no promising lead ever slips through the cracks between seasons.",
        image: asset(
          "inner-landscaping-software-and-crm-detailed-estimates-for-maintenance-and-design-build.webp",
        ),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "One Record Per Customer and Property",
        text: "Each account holds the address, contacts, custom fields, property size, gate codes, photos, and a full history of every visit, so the crew shows up knowing the scope, the layout, and the spots the homeowner flagged on the walk-through.",
        image: asset(
          "inner-landscaping-software-and-crm-one-record-per-customer-and-property.webp",
        ),
        alt: "Lead management in Knockio",
      },
      {
        title: "Communication History on Every Account",
        text: "Every call, text, and email tied to a customer lands on the record, so when someone asks to adjust a plan or add a phase, the whole back-and-forth is right there instead of buried in a phone.",
        image: asset(
          "inner-landscaping-software-and-crm-communication-history-on-every-account.webp",
        ),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Schedule Maintenance",
    cards: [
      {
        title: "Recurring Routes and Project Scheduling",
        text: "Run weekly maintenance routes and multi-week install projects from the same calendar. Recurring service builds itself out so the office is not rebooking by hand, while bigger projects move through their own stages.",
        image: asset(
          "inner-landscaping-software-and-crm-recurring-routes-and-project-scheduling.webp",
        ),
        alt: "Route planning in Knockio",
      },
      {
        title: "Crew Assignment and Job Stage Tracking",
        text: "Move each project through clear stages like estimate, approved, scheduled, in production, and final cleanup. Statuses are fully customizable, and unlimited boards let the office and the crews each see the view they care about.",
        image: asset(
          "inner-landscaping-software-and-crm-crew-assignment-and-job-stages.webp",
        ),
        alt: "Territory management in Knockio",
      },
      {
        title: "Automated Territory Creation by Zip Code and City",
        text: "Carve your maintenance area into routes automatically from zip codes and cities, instead of mapping every boundary by hand. As you grow into a new part of town, you can stand up a route in minutes. Most landscaping tools simply do not do this.",
        image: asset(
          "inner-landscaping-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp",
        ),
        alt: "Field activity log in Knockio",
      },
    ],
  },
  {
    label: "Track Materials and Costs",
    cards: [
      {
        title: "Work Orders With Budgets and Material Takeoffs",
        text: "Track materials and costs from lead to service with notes, status updates, documents, customer details, photos, and clear next steps, so every landscaping project stays organized from first walkthrough to final invoice.",
        image: asset(
          "inner-landscaping-software-and-crm-work-orders-with-budgets-and-material-takeoffs.webp",
        ),
        alt: "Job management in Knockio",
      },
      {
        title: "Inventory Management for Plants and Materials",
        text: "Track products, variants, SKUs, cost, and markup for everything from sod to stone to sprinkler heads, with low-stock alerts so you reorder before a crew shows up to a job short on materials.",
        image: asset(
          "inner-landscaping-software-and-crm-inventory-management-for-plants-and-materials.webp",
        ),
        alt: "Crew dispatching in Knockio",
      },
      {
        title: "Vendor Bills and Material Purchase Orders",
        text: "Raise a purchase order to your nursery or stone yard when stock runs low, then record the vendor bill against that purchase order or a work order, so what you spend at the supplier ties straight to the project and your margins stay honest.",
        image: asset(
          "inner-landscaping-software-and-crm-vendor-bills-and-purchase-orders.webp",
        ),
        alt: "Work orders in Knockio",
      },
    ],
  },
  {
    label: "Document and Media",
    cards: [
      {
        title: "Photo Annotation for Scope and Progress",
        text: "Snap photos at the walk-through and through each phase, then mark them up with notes and arrows right on the image, so the crew knows exactly what goes where and the homeowner sees the progress before each payment.",
        image: asset(
          "inner-landscaping-software-and-crm-photo-annotation-for-scope-and-progress.webp",
        ),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "Job Notes and Site Survey Photos",
        text: "Drop detailed notes on every visit and use built-in surveys to capture site conditions, drainage issues, plant health, or extra work spotted, saved straight to the customer account instead of a slip lost in the truck.",
        image: asset(
          "inner-landscaping-software-and-crm-job-notes-and-surveys-on-site.webp",
        ),
        alt: "Proposals in Knockio",
      },
      {
        title: "Centralized File Storage Per Project",
        text: "Keep design plans, permits, warranties, and signed agreements attached right to the project record, not scattered across email and a folder nobody can find when a question comes up next season.",
        image: asset(
          "inner-landscaping-software-and-crm-centralized-file-storage-per-project.webp",
        ),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
  {
    label: "Bill by Milestone",
    cards: [
      {
        title: "Milestone-Based Payment Collection",
        text: "Collect a deposit up front, progress draws as each phase wraps, and a final balance at cleanup, all tied directly to the project. For a long design-build job, you get paid as the work moves instead of fronting materials and labor for weeks while you wait on one big check.",
        image: asset(
          "inner-landscaping-software-and-crm-milestone-based-payment-collection.webp",
        ),
        alt: "Video and file storage in Knockio",
      },
      {
        title: "Digital Contracts With E-Signatures",
        text: "Send the project agreement for digital signature with a documented audit trail, so the scope and price are locked in with a clean legal record before the first plant goes into the ground. Change orders work the same way, so an added phase is logged and priced instead of argued over later.",
        image: asset(
          "inner-landscaping-software-and-crm-digital-contracts-with-e-signatures.webp",
        ),
        alt: "Photo uploads in Knockio",
      },
      {
        title: "Flexible Milestone Payment Methods",
        text: "Collect through tap to pay, text to pay, card, or ACH, all through Knockio's own built-in payment processing, so whether the customer pays on site or later from their phone, the money always lands tied to the right project.",
        image: asset(
          "inner-landscaping-software-and-crm-flexible-payment-methods.webp",
        ),
        alt: "Service reports in Knockio",
      },
    ],
  },
];

const organizedItems = [
  {
    title: "Live Field Tracking",
    text: "Monitor crews in real time with GPS tracking and proximity intelligence. It helps with routing, accountability, and knowing exactly who is on which job right now.",
    href: "https://knockio.com/features/gps-tracking-software/",
    icon: "crosshair" as const,
  },
  {
    title: "Native Automation Builder",
    text: "Build your own automations without code: send a deposit request when an estimate is approved, text the homeowner when a crew is on the way, or trigger a milestone invoice when a phase is marked done. The office stops chasing the same tasks by hand.",
    href: "https://knockio.com/features/business-automation-software/",
    icon: "sparkles" as const,
  },
  {
    title: "Project History and Media",
    text: "See every project's annotated photos, design plans, and notes in one view, so the office and the crews are looking at the same record instead of asking each other for it.",
    href: null,
    icon: "ruler" as const,
  },
  {
    title: "E-Contracts",
    text: "Send professional e-contracts, collect signatures, and keep each approved deal connected to the right customer, job, and payment record.",
    href: "https://knockio.com/e-contracts/",
    icon: "file" as const,
  },
  {
    title: "CRM Integrations",
    text: "Link Knockio to Salesforce, HubSpot, Google Calendar, and GHL, then connect thousands more apps via Zapier, FlowChef, and webhooks, so project data lives in one system.",
    href: "https://knockio.com/knockio-integrations/",
    icon: "zap" as const,
  },
  {
    title: "Team Communication",
    text: "Knockio connects estimators, install crews, and the office on the same project record through assignees and internal notes, so phase updates reach the right people.",
    href: "https://knockio.com/features/business-texting-and-calling-software/",
    icon: "message" as const,
  },
];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "What should I look for in landscaping software?",
    a: "Look for a platform that handles both recurring maintenance and full design-build projects: recurring scheduling, detailed estimating, material tracking, e-contracts, and milestone billing, all tied to one customer record. Most tools do one side well and the other poorly. Knockio was built to run both from the same system.",
  },
  {
    q: "Which software is best for a landscaping business that does both maintenance and installs?",
    a: "Knockio helps field service teams manage the full workflow. Teams can Land the Project, store customer details, create estimates, schedule jobs, assign crews, track job progress, upload photos, send invoices, and follow up with customers. This helps reduce manual work and keeps everyone updated.",
  },
  {
    q: "Can Knockio bill a project in stages?",
    a: "Yes. Knockio supports milestone-based payment collection, so you can take a deposit, bill progress draws as each phase completes, and collect the final balance at cleanup, all tied to the project.",
  },
  {
    q: "Can Knockio track plants and materials per project?",
    a: "Yes. Work orders carry a material takeoff, and inventory management tracks plants, hardscape, and irrigation parts with low-stock alerts, so each project is cost against what it actually used.",
  },
  {
    q: "Can Knockio track my crews in the field?",
    a: "Yes. Knockio includes live GPS tracking with proximity intelligence, so you can confirm how close a crew was to a property when they marked a job started or completed.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const heroImage = asset(
  "inner-landscaping-software-and-crm-what-should-landscaping-companies-look-for-in-a-crm-and-project-platform.webp",
);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id":
        "https://knockio.com/industry/landscaping-business-software/#webpage",
      url: "https://knockio.com/industry/landscaping-business-software/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      audience: {
        "@type": "Audience",
        audienceType: "Landscaping Contractors",
      },
      mainEntity: {
        "@id":
          "https://knockio.com/industry/landscaping-business-software/#faq",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id":
        "https://knockio.com/industry/landscaping-business-software/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Landscaping Business Software",
          item: "https://knockio.com/industry/landscaping-business-software/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/industry/landscaping-business-software/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={heroImage}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="ls-industry-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white"
    >
      <div
        class="grid min-h-0 lg:min-h-[610px] lg:grid-cols-[55%_45%] xl:min-h-[720px] 2xl:min-h-[820px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] pt-[calc(72px+3rem)] pb-12 sm:pt-[calc(72px+4rem)] sm:pb-16 lg:min-h-[600px] lg:px-0 lg:pb-[72px] lg:pt-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[36px] font-bold leading-[44px] text-neutral-950 sm:text-[44px] sm:leading-[54px] xl:text-[58px] xl:leading-[66px] 2xl:text-[64px] 2xl:leading-[74px]"
            >
              Landscaping Business Software
            </h1>
            <p
              class="mb-10 max-w-[760px] text-base font-medium leading-8 text-neutral-600 sm:text-lg sm:leading-9"
            >
              Landscaping covers a lot of ground, from recurring maintenance
              routes to full design-build projects with hardscaping, irrigation,
              and crews on site for weeks. Knockio is landscaping business
              software and CRM built to hold customer records, quote projects,
              schedule crews, track materials, and collect payment by milestone,
              all in one place instead of three apps that never agree.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white transition-colors duration-300 hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <p
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              What should landscaping companies look for in a CRM and project
              platform?
            </p>
            <p
              class="max-w-[760px] text-[15px] leading-7 text-neutral-600 sm:text-base sm:leading-7"
            >
              A landscaping company should look for a CRM that carries both
              sides of the business, the recurring maintenance route and the big
              design-build project. That means full customer and property
              records, recurring scheduling, detailed estimates, crew tracking,
              material and plant tracking, e-contracts, and milestone-based
              payment collection. Knockio handles all of it in one platform. It
              adds live GPS tracking with proximity intelligence and automated
              territory creation by zip code and city, so routes, crews, and
              project history live in the same record. That depth, plus
              affordable pricing and support that actually answers, is what a
              generic CRM built for another industry leaves out.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-ls-visual relative min-h-[340px] overflow-hidden sm:min-h-[440px] lg:min-h-full"
        >
          <img
            src={heroImage}
            alt="What should landscaping companies look for in a crm and project platform"
            width="830"
            height="560"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="h-full min-h-[340px] w-full object-cover object-center sm:min-h-[440px] lg:min-h-full"
          />
        </div>
      </div>
    </section>

    <!-- ========== Why / Sticky tabs ========== -->
    <section id="platform-capabilities" class="bg-white py-20 sm:py-24 lg:py-28">
      <div class="my-container">
        <div class="mx-auto mb-10 max-w-[1120px] text-center lg:mb-12">
          <h2
            class="mb-5 text-center text-[34px] font-bold leading-[42px] text-neutral-950 sm:text-4xl sm:leading-[48px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Why Landscapers Choose Knockio
          </h2>
          <p
            class="mx-auto max-w-[960px] text-base font-normal leading-8 text-neutral-600 sm:text-lg sm:leading-9"
          >
            Knockio helps landscaping contractors manage customer accounts,
            recurring routes, design-build projects, crews, materials, invoices,
            and payments. From a weekly maintenance stop to a months-long
            install, it all sits in one connected platform. Owners run
            maintenance and production without bouncing between three different
            tools.
          </p>
        </div>

        <div class="sr-only">
          {
            capabilityTabs.map((tab) => (
              <div>
                <h3>{tab.label}</h3>
                {tab.cards.map((card) => (
                  <article>
                    <h3>{card.title}</h3>
                    <p>{card.text}</p>
                  </article>
                ))}
              </div>
            ))
          }
        </div>

        <div
          id="lsCapScrollTrack"
          class="hp-scroll-track"
          style="--scroll-steps: 5"
        >
          <div
            class="lg:sticky lg:top-0 lg:z-20 lg:flex lg:min-h-[760px] lg:flex-col lg:bg-white lg:pt-6"
          >
            <div
              class="sticky top-0 z-30 border-b border-solid border-neutral-200/80 bg-white/95 pb-5 pt-2 backdrop-blur-md lg:static lg:border-0 lg:bg-transparent lg:pb-8"
            >
              <div
                id="lsTabsNav"
                class="mx-auto flex max-w-[1050px] items-center gap-4 overflow-x-auto scroll-smooth px-1 [scrollbar-width:none] lg:justify-center [&::-webkit-scrollbar]:hidden"
                role="tablist"
                aria-label="Landscaping platform capabilities"
              >
                {
                  capabilityTabs.map((tab, index) => (
                    <button
                      type="button"
                      role="tab"
                      data-ls-tab={String(index)}
                      aria-selected={index === 0 ? "true" : "false"}
                      class:list={[
                        "hp-tab-btn shrink-0 rounded-full border px-5 py-2.5 text-base font-medium leading-6 transition-all duration-300 hover:border-primary-500 hover:text-primary-500 sm:px-6",
                        index === 0
                          ? "is-active border-solid border-primary-500 bg-[#f9fff8] text-primary-500"
                          : "border-dashed border-neutral-300 bg-white text-neutral-700",
                      ]}
                    >
                      {tab.label}
                    </button>
                  ))
                }
              </div>
            </div>

            <div id="lsTabsPanels" class="relative lg:flex-1">
              {
                capabilityTabs.map((tab, tabIndex) => (
                  <div
                    class:list={["hp-panel", tabIndex === 0 && "is-active"]}
                    role="tabpanel"
                  >
                    <div class="grid gap-6 lg:grid-cols-3 lg:gap-8">
                      {tab.cards.map((card) => (
                        <article class="hp-card flex min-h-[520px] flex-col overflow-hidden rounded-[28px] border border-solid border-neutral-200 bg-neutral-50 p-7 sm:p-8">
                          <p class="mb-4 text-[26px] font-bold leading-8 text-neutral-950 sm:text-[30px] sm:leading-9">
                            {card.title}
                          </p>
                          <p class="mb-8 text-base leading-7 text-neutral-600 sm:text-[17px] sm:leading-8">
                            {card.text}
                          </p>
                          <div class="mt-auto flex justify-center overflow-hidden rounded-3xl">
                            <img
                              src={card.image}
                              alt={card.alt}
                              width="430"
                              height="320"
                              decoding="async"
                              loading="lazy"
                              class="w-full max-w-[430px] object-contain object-bottom"
                            />
                          </div>
                        </article>
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== Organized (dark) ========== -->
    <section
      class="relative overflow-hidden bg-[#0F172A] py-24 sm:py-28 lg:py-[150px]"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.22] [background-image:radial-gradient(rgba(255,255,255,0.65)_0.8px,transparent_0.8px)] [background-size:18px_18px]"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-14 max-w-[1120px] text-center lg:mb-20">
          <h2
            class="mb-6 text-center text-[34px] font-bold leading-[42px] text-white sm:text-4xl sm:leading-[48px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Run Maintenance and Builds From One Platform
          </h2>
          <p
