const operatingModelsData = {
  pillTag: "OPERATING MODEL FLEXIBILITY",
  title: "Built for How Your Roofing Business Actually Operates",
  subtitle:
    "A storm-chasing insurance roofer and a retail cash-replacement roofer share a trade name, but run completely different workflows. Knockio adapts to your specific funding model, sales posture, and installation pipeline out of the box.",
  cards: [
    {
      icon: "house",
      title: "Residential Retail Replacement",
      text: "Homeowner-initiated replacements driven by age, leaks, or aesthetics. Build marketing-led pipelines, present Good/Better/Best shingle tiers, and present the monthly financing you offer and keep the signed agreement on the job record.",
      pills: ["Good/Better/Best Tiers", "Financing Docs on File", "Marketing-Led Pipeline"],
    },
    {
      icon: "cloud-lightning",
      title: "Storm & Insurance Restoration",
      text: "Designed for hail and wind claims where the adjuster controls the scope. Manage contingency agreements, adjuster roof meetings, ACV/RCV check endorsements, and insurance supplements without missing a dollar.",
      pills: ["Contingency Agreements", "ACV / RCV Claim Tracking", "Direction to Pay Workflows"],
    },
    {
