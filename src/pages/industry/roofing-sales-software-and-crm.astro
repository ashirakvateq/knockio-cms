      pills: ["GC & Property Mgmt Bids", "TPO & EPDM Estimating", "Invoices Schedules"],
    },
  ],
};

const oldStackComparisonData = {
  title: "How Knockio Replaces Your Taped-Together Roofing Stack",
  subtitle:
    "Stop paying for separate door-knocking apps, production CRMs, and custom spreadsheets. Knockio brings your canvassers, project managers, and install crews into one platform.",
