---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Roofing Sales Software & CRM for Roofers | Knockio";
const description =
  "Roofing CRM & sales software for door-to-door teams. Auto-built canvassing territories, live GPS tracking, estimates, e-contracts & payments in one platform.";

const asset = (name: string) => `/assets/cfw/${name}`;

type CapCard = {
  title: string;
  text: string;
  image: string;
  alt: string;
  link?: { href: string; label: string };
  textSuffix?: string;
};

const capabilityTabs: { label: string; cards: CapCard[] }[] = [
  {
    label: "Manage Jobs",
    cards: [
      {
        title: "Customer and Property Records in One Place",
        text: "Every job record holds the address, contacts, custom fields, photos, notes, tasks, and full ownership history. When a homeowner calls back about a repair, your team sees the whole history instead of digging through texts.",
        image: asset(
          "inner-roofing-sales-software-and-crm-customer-and-property-records-in-one-place.webp",
        ),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "Dynamic Job Pipeline for Roofing Stages",
        text: "Move jobs through clear stages like lead, inspection, estimate, proposal, approval, production, payment, and closeout. Statuses stay fully customizable, so you name and order them to match your own shop and run unlimited boards.",
        image: asset(
          "inner-roofing-sales-software-and-crm-dynamic-job-pipeline-for-roofing-stages.webp",
        ),
        alt: "Lead management in Knockio",
      },
      {
        title: "Crew and Roofing Production Scheduling",
        text: "Assign crews to jobs, track production progress closely, and keep the office and the field reading one shared schedule instead of two versions of the truth. Everyone sees who is on which roof next.",
        image: asset(
          "inner-roofing-sales-software-and-crm-crew-and-production-scheduling-new.webp",
        ),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Track the Field",
    cards: [
      {
        title: "Auto Territory Creation by ZIP & City",
        text: "Build canvassing territories automatically from zip codes and cities, instead of drawing every single boundary by hand. After a storm, carve up a whole area and get reps knocking doors in minutes, not hours, unlike most roofing CRMs.",
        image: asset(
          "inner-roofing-sales-software-and-crm-auto-territory-creation-by-zip-city.webp",
        ),
        alt: "Route planning in Knockio",
      },
      {
        title: "Live GPS Tracking of Every Roofing Rep",
        text: "See where every canvasser and crew is in real time, which helps with accountability, safety, and knowing exactly who works which street right now. Pin drop verification confirms how close a rep stood when marking a door worked. See ",
        link: {
          href: "https://knockio.com/blog/roofers-knocking-on-doors/",
          label: "how door-to-door roofing reps use canvassing software",
        },
        textSuffix: ".",
        image: asset(
          "inner-roofing-sales-software-and-crm-live-gps-tracking-of-every-rep.webp",
        ),
        alt: "Territory management in Knockio",
      },
      {
        title: "Route Planning That Saves Daylight",
        text: "Plan smarter, tighter routes so your roofing reps hit far more doors in less time each day, instead of crisscrossing the very same blocks over and over and burning the daylight hours that matter most after a storm.",
        image: asset(
          "inner-roofing-sales-software-and-crm-route-planning-that-saves-daylight.webp",
        ),
        alt: "Field activity log in Knockio",
      },
    ],
  },
  {
    label: "Work Orders and Materials",
    cards: [
      {
        title: "Work Orders With Tasks, Budget, and Materials",
        text: "Build a work order with tasks, a budget, and a material takeoff for every roof. The job is tracked against real numbers, not a rough guess from the estimate, and the office can see exactly what was used and what it cost.",
        image: asset(
          "inner-roofing-sales-software-and-crm-work-orders-with-tasks-budget-and-materials.webp",
        ),
        alt: "Job management in Knockio",
      },
      {
        title: "Purchase Orders When Materials Run Short",
        text: "When shingles or flashing are not in inventory, fire off a purchase order straight from the work order. Knockio tracks products, variants, SKUs, cost, and markup, and flags low stock before you run out mid-job.",
        image: asset(
          "inner-roofing-sales-software-and-crm-purchase-orders-when-materials-run-short.webp",
        ),
        alt: "Crew dispatching in Knockio",
      },
      {
        title: "Assign Jobs to Crews or Subcontractors",
        text: "Work orders can go directly to your own in-house crew or to a trusted outside subcontractor, with tasks, notes, photos, and the full production schedule all attached, so whoever climbs the ladder on that roof always has the complete picture.",
        image: asset(
          "inner-roofing-sales-software-and-crm-assign-jobs-to-crews-or-subcontractors-new.webp",
        ),
        alt: "Work orders in Knockio",
      },
    ],
  },
  {
    label: "Documents and Media",
    cards: [
      {
        title: "Job Photos and Roof Media in One Place",
        text: "Upload before, during, and after photos straight to the job. Insurance adjusters, homeowners, and your own crew all get the full visual record in one spot instead of scattered across phones.",
        image: asset(
          "inner-roofing-sales-software-and-crm-job-photos-and-roof-media-in-one-place.webp",
        ),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "E-Contracts With Legal Protection",
        text: "Send contracts for digital signature with IP address and timestamp logging built in. If a job is ever disputed, you have a documented trail instead of a he-said argument.",
        image: asset(
          "inner-roofing-sales-software-and-crm-e-contracts-with-legal-protection.webp",
        ),
        alt: "Proposals in Knockio",
      },
      {
        title: "Centralized File Storage Per Job",
        text: "Keep permits, warranties, and insurance documents attached right to the job record, not scattered across email and a filing cabinet drawer nobody can find when a claim comes up.",
        image: asset(
          "inner-roofing-sales-software-and-crm-centralized-file-storage-per-job.webp",
        ),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
  {
    label: "Quote and Get Paid",
    cards: [
      {
        title: "Roof Estimates From Real Measurement Data",
        text: "Build clean, accurate estimates using roof measurement data from EagleView or other providers. Pricing reflects the actual roof, not a satellite guess. Add optional line items, save templates, and pull from a product catalog so pricing stays consistent.",
        image: asset(
          "inner-roofing-sales-software-and-crm-roof-estimates-from-real-measurement-data-new.webp",
        ),
        alt: "Video and file storage in Knockio",
      },
      {
        title: "Digital Proposals With E-Signatures",
        text: "Send a proposal the homeowner reviews and signs from their phone, through a customer portal, with financing and product choices built in. Change orders work the same way, so a mid-job add-on is documented instead of scribbled on a clipboard.",
        image: asset(
          "inner-roofing-sales-software-and-crm-digital-proposals-with-e-signatures.webp",
        ),
        alt: "Photo uploads in Knockio",
      },
      {
        title: "Get Paid With Tap to Pay or Text to Pay",
        text: "Collect deposits and final payments on the spot or remotely through Knockio's own payment processing. Credit card, ACH, tap to pay, text to pay, so cash flow does not wait on a check in the mail.",
        image: asset(
          "inner-roofing-sales-software-and-crm-get-paid-with-tap-to-pay-or-text-to-pay.webp",
        ),
        alt: "Service reports in Knockio",
      },
    ],
  },
];

const organizedItems = [
  {
    title: "Live Field Tracking",
    text: "Monitor field reps in real time with GPS tracking. It helps with accountability, safety, and knowing exactly who is working which street right now.",
    href: "https://knockio.com/features/gps-tracking-software/",
    icon: "crosshair" as const,
  },
  {
    title: "Flow Automation",
    text: "Automatically handles the daily grind like follow ups, callbacks, and appointment confirmations, so a job does not go cold while your office is buried in something else.",
    href: "https://knockio.com/features/business-automation-software/",
    icon: "sparkles" as const,
  },
  {
    title: "Media & Measurements",
    text: "See every job's photos, measurement data, and notes in one view, so the office and the field are looking at the same record instead of asking each other for it.",
    href: null,
    icon: "ruler" as const,
  },
  {
    title: "E-Contracts",
    text: "Create, send, review, and sign contracts digitally so every approved deal moves forward faster without paperwork delays or manual follow-ups.",
    href: "https://knockio.com/e-contracts/",
    icon: "file" as const,
  },
  {
    title: "CRM Integrations",
    text: "Knockio syncs your roofing leads and job records with Salesforce, HubSpot, Google Calendar, and GHL, plus thousands of apps via Zapier, FlowChef, and webhooks.",
    href: "https://knockio.com/knockio-integrations/",
    icon: "zap" as const,
  },
  {
    title: "Team Communication",
    text: "Quickly sort and manage jobs by priority, so your highest value roofs never sit forgotten at the bottom of someone's task list.",
    href: "https://knockio.com/features/business-texting-and-calling-software/",
    icon: "message" as const,
  },
];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "Can Knockio keep all my job history in one record?",
    a: "Yes. As a complete roofing contractor CRM, Knockio ensures every job record holds the property's contacts, photos, notes, documents, and full activity history, so anyone on your team sees the whole story instead of piecing it together from texts and email.",
  },
  {
    q: "Can Knockio create canvassing territories automatically?",
    a: "Yes. Our built-in roofing canvassing app can build territories automatically from ZIP codes and cities, so you can split up a storm-hit area and get reps knocking fast, without drawing every boundary by hand.",
  },
  {
    q: "Can Knockio build estimates from EagleView measurement reports?",
    a: "Yes. Knockio lets you create roof estimates using measurements from your EagleView, or entered from your Hover or GAF QuickMeasure report, so pricing is based on accurate roof data instead of a rough guess.",
  },
  {
    q: "Does Knockio handle work orders and materials for production?",
    a: "Yes. Functioning as a full roofing project management software, Knockio ensures work orders carry tasks, a budget, and a material takeoff. You can even raise a purchase order straight from the work order when materials run short, with low-stock alerts to warn you first.",
  },
  {
    q: "How is Knockio different from AccuLynx, JobNimbus, or Jobber for roofing companies?",
    a: "AccuLynx and JobNimbus are built mainly for production and job management, while Jobber focuses on basic residential scheduling. Knockio gives you estimating, work orders, and invoicing, but natively adds live rep tracking and automated territory creation for your sales team. It is one connected system built around the way a roofing job actually runs, from the first knock to the final payment.",
  },
];

