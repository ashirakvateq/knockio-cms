---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "HVAC Software & CRM for Service Contractors | Knockio";
const description =
  "Book service calls, dispatch techs, build estimates, and collect payment on site. HVAC software that runs every job from the first call to the final invoice.";

const asset = (name: string) => `/assets/cfw/${name}`;

const capabilityTabs = [
  {
    label: "Manage Jobs & History",
    cards: [
      {
        title: "Equipment & Property Service History",
        text: "Every property record logs condenser model numbers, air handler serial tags, filter sizes, warranty expiration dates, and past repair history. Technicians arrive knowing the home's mechanical background before they step out of the van.",
        image: asset("inner-hvac-software-and-crm-customer-and-equipment-history-in-one-record.webp"),
        alt: "Equipment history in Knockio",
      },
      {
        title: "Dynamic Pipeline for HVAC Stages",
        text: "Move jobs through clear stages: Emergency Dispatch, Diagnosing, Estimate Sent, Proposal Approved, Equipment Ordered, Install Scheduled, Inspection, and Completed. Customize boards for service repairs versus residential changeouts.",
        image: asset("inner-hvac-software-and-crm-dynamic-job-pipeline-for-hvac-stages.webp"),
        alt: "Job pipeline in Knockio",
      },
      {
        title: "Preventive Maintenance Agreements (PMAs)",
        text: "Turn seasonal spring and fall tune-ups into predictable recurring revenue. Manage PMA memberships, track member-only repair discounts, and process recurring invoicing and let you add state auto-renewal disclosures to your agreements.",
        image: asset("inner-hvac-software-and-crm-scheduling-and-dispatch-that-match-the-board-1.webp"),
        alt: "Maintenance agreements in Knockio",
      },
    ],
  },
  {
    label: "Track & Dispatch",
    cards: [
      {
        title: "Live GPS Tracking & Emergency Dispatch",
        text: "View every technician's live GPS location on a visual map. Use the live rep map to assign the nearest available tech to an emergency no-heat or no-cool call instantly, reducing windshield time.",
        image: asset("inner-hvac-software-and-crm-live-gps-tracking-of-every-tech.webp"),
        alt: "GPS tracking in Knockio",
      },
      {
        title: "Auto Territory Creation by ZIP & City",
        text: "Carve out service territories or door-to-door replacement canvassing zones automatically by ZIP code and city. Perfect for comfort advisors running seasonal changeout campaigns in aging neighborhoods.",
        image: asset("inner-hvac-software-and-crm-route-planning-for-service-days.webp"),
        alt: "Territory creation in Knockio",
      },
      {
        title: "Smarter HVAC Route Planning",
        text: "Optimize daily routes for maintenance technicians running 6 to 8 seasonal tune-ups a day. Reduce backtracking across town and keep technicians on time for scheduled arrival windows.",
        image: asset("inner-hvac-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp"),
        alt: "Route planning in Knockio",
      },
    ],
  },
  {
    label: "Work Orders & Parts",
    cards: [
      {
        title: "HVAC Work Orders With Material Takeoffs",
        text: "Build detailed work orders tracking line-set sizes, copper fittings, whip disconnects, pad sizes, and thermostat wire against real job costs. Install crews see exact equipment takeoffs on their mobile app.",
        image: asset("inner-hvac-software-and-crm-work-orders-with-tasks-budget-and-materials.webp"),
        alt: "Work orders in Knockio",
      },
      {
        title: "Purchase Orders to Supply Houses",
        text: "When condensers, coils, or refrigerant cylinders run short, fire off a purchase order for your supplier such as Ferguson, Johnstone Supply, or Lennox. Flag low stock before parts delay an install.",
        image: asset("inner-hvac-software-and-crm-purchase-orders-when-parts-run-short.webp"),
        alt: "Purchase orders in Knockio",
      },
      {
        title: "EPA 608 Refrigerant Tracking Logs",
        text: "Stay compliant with federal regulations. Technicians log refrigerant types (R-410A, R-32, R-454B), recovery cylinder numbers, and pressure testing weights directly into the customer's permanent job record.",
        image: asset("inner-hvac-software-and-crm-assign-jobs-to-crews-or-subcontractors-1.webp"),
        alt: "EPA tracking in Knockio",
      },
    ],
  },
  {
    label: "Documents & Media",
    cards: [
      {
        title: "Before & After Equipment Photo Proof",
        text: "Technicians snap photos of corroded evaporator coils, burnt contactors, and clean data plates, annotating images with arrows right in the app to justify repair quotes to homeowners and landlords.",
        image: asset("inner-hvac-software-and-crm-job-photos-and-equipment-media-in-one-place.webp"),
        alt: "Photo documentation in Knockio",
      },
      {
        title: "Declined-Recommendation Liability Waivers",
        text: "When a homeowner declines a recommended system replacement and opts for a temporary patch, capture a digital Declined-Repair Waiver e-signature on site to document that the customer declined the recommended repair.",
        image: asset("inner-hvac-software-and-crm-e-contracts-with-legal-protection.webp"),
        alt: "Liability waivers in Knockio",
      },
      {
        title: "Manual J Load Calcs & Inspection Files",
        text: "Store Manual J sizing calculations, AHRI matched system certificates, municipal mechanical permits, and manufacturer warranty registrations attached directly to the job record for easy retrieval.",
        image: asset("inner-hvac-software-and-crm-centralized-file-storage-per-job.webp"),
        alt: "File storage in Knockio",
      },
    ],
  },
  {
    label: "Quote & Get Paid",
    cards: [
      {
        title: "Good / Better / Best Tiered Proposals",
        text: "Build interactive Good/Better/Best estimates comparing 14 SEER2 base systems against variable-speed heat pumps. Let homeowners select optional add-ons like UV purifiers or smart thermostats from their phone.",
        image: asset("inner-hvac-software-and-crm-estimates-and-service-agreements.webp"),
        alt: "Tiered proposals in Knockio",
      },
      {
        title: "Consumer Financing Documents",
        text: "Present monthly payment framing first. Present the monthly financing you offer, then import and e-sign the lender agreement (GreenSky, Service Finance, Wisetack, and the like) right on the job so the paperwork lives with the record.",
        image: asset("inner-hvac-software-and-crm-digital-contracts-with-e-signatures.webp"),
        alt: "Financing documents in Knockio",
      },
      {
        title: "Collect on Site",
        text: "Collect diagnostic fees, tune-up balances, and installation deposits the moment the tool bag is packed using Text-to-Pay, credit card readers, or ACH processing in the field.",
        image: asset("inner-hvac-software-and-crm-flexible-payment-collection.webp"),
        alt: "Payment collection in Knockio",
      },
    ],
  },
];

const organizedItems = [
  {
    title: "Live Field Tracking",
    text: "Monitor technicians in real time with GPS tracking. Use the live rep map to assign the nearest available van to emergency no-heat or no-cool calls.",
    href: "https://knockio.com/features/gps-tracking-software/",
    icon: "crosshair" as const,
  },
  {
    title: "Flow Automation",
    text: "Automatically handle the daily grind like seasonal tune-up reminders, booking confirmations, and invoice follow-ups so your dispatchers can focus on incoming calls.",
    href: "https://knockio.com/features/business-automation-software/",
    icon: "sparkles" as const,
  },
  {
    title: "Media and Measurements",
    text: "See every job's equipment photos, data plates, Manual J sizing, and refrigerant logs in one view, so technicians arrive prepared for the repair.",
    href: null,
    icon: "ruler" as const,
  },
  {
    title: "E-Contracts",
    text: "Send installation agreements and Declined-Recommendation Waivers for digital signature with IP timestamp logging to protect your business against disputes.",
    href: "https://knockio.com/e-contracts/",
    icon: "file" as const,
  },
  {
    title: "CRM Integrations",
    text: "Knockio connects your customer records, invoices, and payments to the tools you use via Zapier and webhooks. It also connects via Zapier and webhooks with Google Calendar, HubSpot, GoHighLevel (GHL), and Salesforce.",
    href: "https://knockio.com/knockio-integrations/",
    icon: "zap" as const,
  },
  {
    title: "Team Communication",
    text: "Link comfort advisors, installation crews, and dispatchers to the same job record through assignees and notes, so install specs never get lost.",
    href: "https://knockio.com/features/business-texting-and-calling-software/",
    icon: "message" as const,
  },
];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "Can technicians build Good/Better/Best estimates directly from a tablet or phone?",
    a: "Yes. Knockio's native iOS and Android apps allow technicians and comfort advisors to generate multi-option Good/Better/Best proposals in the field. They can pull pre-saved equipment templates, apply member discounts, and capture digital signatures on the spot.",
  },
  {
    q: "How does Knockio handle recurring Preventive Maintenance Agreements (PMAs)?",
    a: "Knockio automates your entire PMA workflow. You can set up monthly, quarterly, or annual billing cycles with automatic card processing, track member-only repair discounts, and trigger automated SMS or email reminders when a customer is due for their seasonal tune-up.",
  },
  {
    q: "Does Knockio track equipment serial numbers and warranty dates?",
    a: "Yes. Every property record in Knockio maintains a dedicated equipment history log where technicians can record model numbers, serial tags, installation dates, filter sizes, EPA 608 refrigerant types, and manufacturer warranty expiration dates.",
  },
  {
    q: "How is Knockio different from ServiceTitan, Housecall Pro, or FieldEdge for HVAC companies?",
    a: "ServiceTitan is built and priced for large enterprise operations with heavy overhead, while Housecall Pro relies on paid add-ons for advanced sales features. Knockio brings dispatch, equipment history, Good/Better/Best estimating, work orders, and payments together in one flat-rate system—adding live GPS tracking, automated territory canvassing for changeout campaigns, and personalized support.",
  },
  {
    q: "Does Knockio connect with the tools I already use?",
    a: "Yes. Knockio connects your customer records, invoices, and payments to the tools you use via Zapier and webhooks. You can also present the monthly financing you offer and store the signed lender agreement (GreenSky, Service Finance, Wisetack, and the like) on the customer record.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const operatingModelsData = {
  pillTag: "OPERATING MODEL FLEXIBILITY",
  title: "Built for How Your HVAC Business Actually Operates",
  subtitle:
    "An emergency repair business and a commercial refrigeration contractor share a trade name, but run completely different workflows. Knockio adapts to your specific dispatch model, maintenance agreements, and install pipeline out of the box.",
  cards: [
    {
      icon: "truck-fast",
      title: "Emergency Service & Repair",
      text: "Designed for fast-paced diagnostic dispatching. Quote trip fees at booking, assign the nearest available technician using the live rep map, present flat-rate repair quotes on a tablet, and collect payment before leaving the driveway.",
      pills: ["Live GPS Rep Tracking", "Flat-Rate Price Books", "On-Site Payment Collection"],
    },
    {
      icon: "calendar-check",
      title: "Preventive Maintenance Plans",
      text: "Build a predictable recurring revenue engine. Manage seasonal spring and fall tune-up agreements, automate member-only discount pricing, and bill recurring membership fees via recurring invoicing and add state-compliant renewal notices to your agreements.",
      pills: ["Recurring Invoicing", "Seasonal Tune-Up Routes", "Member Discount Tracking"],
    },
    {
      icon: "thermometer",
      title: "Residential Replacement & Retrofits",
      text: "Convert aging systems into high-efficiency replacements. Build interactive Good/Better/Best tiered proposals, present the monthly financing you offer (GreenSky/Wisetack and the like), and track municipal permit inspections.",
      pills: ["Good/Better/Best Tiers", "Financing Docs on File", "Declined-Repair Waivers"],
    },
    {
      icon: "snowflake",
      title: "IAQ & Commercial Refrigeration",
      text: "Manage complex multi-system commercial HVAC and refrigeration contracts alongside residential Indoor Air Quality (IAQ) dehumidifier, HEPA filtration, and duct-sealing installations.",
      pills: ["EPA 608 Compliance Logs", "Commercial Asset Tracking", "IAQ System Upgrades"],
    },
  ],
};

const oldStackComparisonData = {
  title: "How Knockio Replaces Your Taped-Together HVAC Stack",
  subtitle:
    "Stop paying for basic calendar dispatch apps, standalone proposal builders, and manual spreadsheet maintenance tracking. Knockio brings your technicians and office into one platform.",
  rows: [
    {
      stage: "Scheduling & Dispatch",
      oldStack: "Using basic calendar apps or whiteboards with zero live GPS tech tracking.",
      knockio: "Visual drag-and-drop dispatch board with real-time GPS technician tracking and routing.",
    },
    {
      stage: "Estimating & Sales",
      oldStack: "Handwritten paper quotes or basic PDFs with no tiered Good/Better/Best pricing options.",
      knockio: "Interactive Good/Better/Best proposals with optional add-on line items and the financing you offer.",
    },
    {
      stage: "Maintenance & Billing",
      oldStack: "Spreadsheets tracking tune-up dates and manual invoicing for recurring service contracts.",
      knockio: "Automated PMA memberships with recurring invoicing and seasonal maintenance reminders.",
    },
    {
      stage: "Equipment & History",
      oldStack: "Technicians calling the office to ask what filter size or condenser unit the house has installed.",
      knockio: "Permanent property records storing model numbers, serial tags, EPA logs, and warranty dates.",
    },
  ],
};

const heroImage = asset(
  "inner-hvac-software-and-crm-what-should-hvac-contractors-look-for-in-a-crm-and-service-platform.webp",
);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://knockio.com/industry/hvac-software-and-crm/#webpage",
      url: "https://knockio.com/industry/hvac-software-and-crm/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      audience: {
        "@type": "Audience",
        audienceType: "HVAC Contractors",
      },
      mainEntity: {
        "@id": "https://knockio.com/industry/hvac-software-and-crm/#faq",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://knockio.com/industry/hvac-software-and-crm/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "HVAC Software & CRM",
          item: "https://knockio.com/industry/hvac-software-and-crm/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/industry/hvac-software-and-crm/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={heroImage}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="industry-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white"
    >
      <div
        class="grid min-h-0 lg:min-h-[610px] lg:grid-cols-[55%_45%] xl:min-h-[720px] 2xl:min-h-[820px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] pt-[calc(72px+3rem)] pb-12 sm:pt-[calc(72px+4rem)] sm:pb-16 lg:min-h-[600px] lg:px-0 lg:pb-[72px] lg:pt-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[36px] font-bold leading-[44px] text-neutral-950 sm:text-[44px] sm:leading-[54px] xl:text-[58px] xl:leading-[66px] 2xl:text-[64px] 2xl:leading-[74px]"
            >
              HVAC Software &amp; CRM Built for Service and Installation Contractors
            </h1>
            <p
              class="mb-10 max-w-[760px] text-base font-medium leading-8 text-neutral-600 sm:text-lg sm:leading-9"
            >
              HVAC contractors live in two different worlds: emergency no-cool repairs that demand instant GPS dispatching, and planned system replacements requiring Good/Better/Best proposals and Manual J sizing. Knockio connects your field technicians and comfort advisors directly to your office—giving heating and cooling contractors one platform to schedule calls, build tiered estimates, manage maintenance agreements, and collect on site.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white transition-colors duration-300 hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <p
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              What should HVAC contractors look for in a CRM and field service
              platform?
            </p>
            <p
              class="max-w-[760px] text-[15px] leading-7 text-neutral-600 sm:text-base sm:leading-7"
            >
              A true HVAC contractor software carries both fast service calls and multi-day installations. That means complete property records with equipment serial numbers, drag-and-drop dispatching, interactive Good/Better/Best proposals, EPA Section 608 refrigerant tracking, automated Preventive Maintenance Agreements (PMAs), and mobile billing. Knockio handles all of it in one platform—adding live GPS tracking of technicians and automated territory creation so your service history lives in a single record.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-industry-visual relative min-h-[340px] overflow-hidden sm:min-h-[440px] lg:min-h-full"
        >
          <img
            src={heroImage}
            alt="What should hvac contractors look for in a crm and service platform"
            width="830"
            height="560"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="h-full min-h-[340px] w-full object-cover object-center sm:min-h-[440px] lg:min-h-full"
          />
        </div>
      </div>
    </section>

    <!-- ========== Why HVAC / Sticky tabs ========== -->
    <section id="platform-capabilities" class="bg-white py-20 sm:py-24 lg:py-28">
      <div class="my-container">
        <div class="mx-auto mb-10 max-w-[1120px] text-center lg:mb-12">
          <h2
            class="mb-5 text-center text-[34px] font-bold leading-[42px] text-neutral-950 sm:text-4xl sm:leading-[48px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Why HVAC Teams Choose Knockio
          </h2>
          <p
            class="mx-auto max-w-[960px] text-base font-normal leading-8 text-neutral-600 sm:text-lg sm:leading-9"
          >
            Knockio is HVAC software and CRM built for contractors who need one place to hold customer records, dispatch technicians, track equipment history, build Good/Better/Best estimates, manage maintenance agreements, and collect payments. No more switching between calendar apps and standalone quoting tools.
          </p>
        </div>

        <div class="sr-only">
          {
            capabilityTabs.map((tab) => (
              <div>
                <h3>{tab.label}</h3>
                {tab.cards.map((card) => (
                  <article>
                    <h3>{card.title}</h3>
                    <p>{card.text}</p>
                  </article>
                ))}
              </div>
            ))
          }
        </div>

          <div
            id="hpCapScrollTrack"
            class="h-[calc(100vh+(var(--scroll-steps,5)-1)*45vh)] max-lg:h-auto motion-reduce:h-auto"
            style="--scroll-steps: 5"
          >
            <div
              class="contents lg:flex lg:sticky lg:top-0 lg:z-20 lg:h-[min(calc(100vh-2rem),880px)] lg:flex-col lg:bg-white/95 lg:pt-1 motion-reduce:h-auto motion-reduce:static"
            >
              <div
                class="sticky top-0 z-30 shrink-0 bg-white/95 px-1 pb-5 pt-2 backdrop-blur-md max-lg:overflow-hidden"
              >
                <div
                  id="hpTabs1Nav"
                  class="relative mx-auto flex max-w-6xl scroll-smooth items-center gap-2 overflow-x-auto [scrollbar-width:none] max-xl:gap-3 lg:justify-between max-lg:flex-nowrap max-lg:justify-start max-lg:px-[12vw] [&::-webkit-scrollbar]:hidden"
                  role="tablist"
                  aria-label="HVAC platform capabilities"
                >
                  <span
                    id="hpTabs1Indicator"
                    class="pointer-events-none absolute left-0 top-0 z-0 rounded-full border-2 border-solid border-primary-500 bg-[#F9FFF8] transition-all duration-300 ease-out"
                    aria-hidden="true"></span>
                  {
                    capabilityTabs.map((tab, index) => (
                      <button
                        type="button"
                        data-hp-scroll-step={String(index)}
                        class:list={[
                          "hpTabs1_btn relative z-10 shrink-0 rounded-full border-2 px-5 py-2.5 text-lg font-bold transition-colors hover:border-primary-500/40 hover:text-primary-500 max-xl:px-4 max-xl:py-2 max-xl:text-base max-md:text-sm",
                          index === 0
                            ? "border-transparent text-primary-500"
                            : "border-dashed border-neutral-300 text-neutral-700",
                        ]}
                      >
                        {tab.label}
                      </button>
                    ))
