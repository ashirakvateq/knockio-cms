---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "HVAC Software & CRM for Service Contractors | Knockio";
const description =
  "Book service calls, dispatch techs, build estimates, and collect payment on site. HVAC software that runs every job from the first call to the final invoice.";

const asset = (name: string) => `/assets/cfw/${name}`;

const capabilityTabs = [
  {
    label: "Manage Jobs",
    cards: [
      {
        title: "Customer and Equipment History in One Record",
        text: "Manage Customers and Jobs during every visit, log outcomes, add notes or voice notes, and move prospects into a clear CRM pipeline.",
        image: asset(
          "inner-hvac-software-and-crm-customer-and-equipment-history-in-one-record.webp",
        ),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "Dynamic Job Pipeline for HVAC Stages",
        text: "Move jobs through clear stages like new call, scheduled, dispatched, diagnosed, estimate sent, approved, installed, and invoiced. Statuses are fully customizable for better workflow.",
        image: asset(
          "inner-hvac-software-and-crm-dynamic-job-pipeline-for-hvac-stages.webp",
        ),
        alt: "Lead management in Knockio",
      },
      {
        title: "Scheduling and Dispatch That Match the Board",
        text: "Assign service calls and install jobs to the right tech or crew, and keep the office and the field reading the same schedule instead of two versions that drift apart by mid-morning.",
        image: asset(
          "inner-hvac-software-and-crm-scheduling-and-dispatch-that-match-the-board-1.webp",
        ),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Track the Field",
    cards: [
      {
        title: "Live GPS Tracking of Every Tech",
        text: "See where every tech is in real time, so dispatch routes the closest person to the next emergency instead of guessing. Pin drop verification confirms how close a tech was when marking a job worked.",
        image: asset(
          "inner-hvac-software-and-crm-live-gps-tracking-of-every-tech.webp",
        ),
        alt: "Route planning in Knockio",
      },
      {
        title: "Route Planning for Service Days",
        text: "Plan smarter, tighter routes so your techs cover more calls in a single day, instead of crossing town twice for two jobs that sit only three blocks apart and burning fuel, time, and daylight doing it.",
        image: asset(
          "inner-hvac-software-and-crm-route-planning-for-service-days.webp",
        ),
        alt: "Territory management in Knockio",
      },
      {
        title: "Automated Territory Creation",
        text: "If you run maintenance memberships or new-system sales by area, build territories automatically from zip codes and cities instead of mapping every boundary by hand. Most HVAC tools simply do not do this.",
        image: asset(
          "inner-hvac-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp",
        ),
        alt: "Field activity log in Knockio",
      },
    ],
  },
  {
    label: "Work Orders and Parts",
    cards: [
      {
        title: "Work Orders With Tasks, Budget, and Materials",
        text: "Track work orders and parts from lead to service with notes, status updates, documents, customer details, photos, and clear next steps, so every HVAC job stays organized from the first call to the final invoice.",
        image: asset(
          "inner-hvac-software-and-crm-work-orders-with-tasks-budget-and-materials.webp",
        ),
        alt: "Job management in Knockio",
      },
      {
        title: "Purchase Orders When Parts Run Short",
        text: "When a part is not in inventory, fire off a purchase order straight from the work order. Knockio tracks products, variants, SKUs, cost, and markup, and flags low stock before you run out mid-job.",
        image: asset(
          "inner-hvac-software-and-crm-purchase-orders-when-parts-run-short.webp",
        ),
        alt: "Crew dispatching in Knockio",
      },
      {
        title: "Assign Jobs to Crews or Subcontractors",
        text: "Work orders can go to your own install crew or to a subcontractor, with tasks, notes, photos, and the schedule all attached, so whoever does the work has the full picture.",
        image: asset(
          "inner-hvac-software-and-crm-assign-jobs-to-crews-or-subcontractors-1.webp",
        ),
        alt: "Work orders in Knockio",
      },
    ],
  },
  {
    label: "Documents and Media",
    cards: [
      {
        title: "Job Photos and Equipment Media in One Place",
        text: "Upload before-and-after photos, model and serial shots, and problem images straight to the job. The next tech, the office, and the customer all get the full visual record.",
        image: asset(
          "inner-hvac-software-and-crm-job-photos-and-equipment-media-in-one-place.webp",
        ),
        alt: "Smart estimates in Knockio",
      },
      {
        title: "E-Contracts With Legal Protection",
        text: "Send service agreements and approvals for digital signature with IP address and timestamp logging built in, so you have a documented trail if a job is ever disputed.",
        image: asset(
          "inner-hvac-software-and-crm-e-contracts-with-legal-protection.webp",
        ),
        alt: "Proposals in Knockio",
      },
      {
        title: "Centralized File Storage Per Job",
        text: "Keep warranties, permits, manuals, and invoices attached right to the customer record, not scattered across email and a folder nobody can find when the warranty claim comes up.",
        image: asset(
          "inner-hvac-software-and-crm-centralized-file-storage-per-job.webp",
        ),
        alt: "Digital contracts in Knockio",
      },
    ],
  },
  {
    label: "Quote and Get Paid",
    cards: [
      {
        title: "Estimates and Service Agreements",
        text: "Build clean estimates with optional line items, so a customer can add a surge protector or a better filter without a second visit. Save templates for your common repairs and installs, and pull from a product and service catalog so pricing stays consistent across every tech.",
        image: asset(
          "inner-hvac-software-and-crm-estimates-and-service-agreements.webp",
        ),
        alt: "Video and file storage in Knockio",
      },
      {
        title: "Digital Contracts With E-Signatures",
        text: "Send an estimate or service agreement the customer reviews and signs from their phone, with a documented audit trail. Change orders work the same way, so a mid-job upsell is logged instead of scribbled on a clipboard.",
        image: asset(
          "inner-hvac-software-and-crm-digital-contracts-with-e-signatures.webp",
        ),
        alt: "Photo uploads in Knockio",
      },
      {
        title: "Flexible Payment Collection",
        text: "Collect deposits, milestone payments, and final balances through tap to pay, text to pay, card, or ACH, all tied directly to the job through Knockio's own payment processing. The tech leaves with the money instead of mailing an invoice and waiting.",
        image: asset(
          "inner-hvac-software-and-crm-flexible-payment-collection.webp",
        ),
        alt: "Service reports in Knockio",
      },
    ],
  },
];

const organizedItems = [
  {
    title: "Live Field Tracking",
    text: "Monitor techs in real time with GPS tracking. It helps with dispatch, accountability, and knowing exactly who is on which call right now.",
    href: "https://knockio.com/features/gps-tracking-software/",
    icon: "crosshair" as const,
  },
  {
    title: "Flow Automation",
    text: "Automatically handle the repetitive office work like maintenance reminders, follow ups, and appointment confirmations, so a customer due for a tune-up does not slip through the cracks.",
    href: "https://knockio.com/features/business-automation-software/",
    icon: "sparkles" as const,
  },
  {
    title: "Media and Measurements",
    text: "See every job's photos, equipment details, and service notes in one view, so the office and the field are looking at the same record instead of asking each other for it.",
    href: null,
    icon: "ruler" as const,
  },
  {
    title: "E-Contracts",
    text: "Build, send, review, and sign contracts in one workflow so approved deals move ahead without paperwork or repeated follow-up delays.",
    href: "https://knockio.com/e-contracts/",
    icon: "file" as const,
  },
  {
    title: "CRM Integrations",
    text: "Knockio links your HVAC customer and dispatch data to Salesforce, HubSpot, Google Calendar, and GHL, with thousands more apps through Zapier, FlowChef, and webhooks.",
    href: "https://knockio.com/knockio-integrations/",
    icon: "zap" as const,
  },
  {
    title: "Team Communication",
    text: "Knockio connects dispatchers, techs, and office staff to every job through shared assignees and internal notes, so nothing gets lost between shifts.",
    href: "https://knockio.com/features/business-texting-and-calling-software/",
    icon: "message" as const,
  },
];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "Can technicians build Good/Better/Best estimates directly from a tablet or phone?",
    a: "Yes. Knockio's native iOS and Android apps allow technicians and comfort advisors to generate multi-option Good/Better/Best proposals in the field. They can pull pre-saved equipment templates, apply member discounts, and capture digital signatures on the spot.",
  },
  {
    q: "How does Knockio handle recurring Preventive Maintenance Agreements (PMAs)?",
    a: "Knockio automates your entire PMA workflow. You can set up monthly, quarterly, or annual billing cycles with automatic card processing, track member-only repair discounts, and trigger automated SMS or email reminders when a customer is due for their seasonal tune-up.",
  },
  {
    q: "Does Knockio track equipment serial numbers and warranty dates?",
    a: "Yes. Every property record in Knockio maintains a dedicated equipment history log where technicians can record model numbers, serial tags, installation dates, filter sizes, EPA 608 refrigerant types, and manufacturer warranty expiration dates.",
  },
  {
    q: "How is Knockio different from ServiceTitan, Housecall Pro, or FieldEdge for HVAC companies?",
    a: "ServiceTitan is built and priced for large enterprise operations with heavy overhead, while Housecall Pro relies on paid add-ons for advanced sales features. Knockio brings dispatch, equipment history, Good/Better/Best estimating, work orders, and payments together in one flat-rate system—adding live GPS tracking, automated territory canvassing for changeout campaigns, and personalized support.",
  },
  {
    q: "Does Knockio connect with the tools I already use?",
    a: "Yes. Knockio connects your customer records, invoices, and payments to the tools you use via Zapier and webhooks. You can also present the monthly financing you offer and store the signed lender agreement (GreenSky, Service Finance, Wisetack, and the like) on the customer record.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
