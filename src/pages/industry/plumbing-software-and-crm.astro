const oldStackComparisonData = {
  title: "How Knockio Replaces Your Taped-Together Plumbing Stack",
  subtitle:
    "Stop paying for basic calendar dispatch apps, paper price books, and manual invoicing spreadsheets. Knockio brings your plumbers, drain techs, and office into one platform.",
