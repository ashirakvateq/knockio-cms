---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Plumbing Software & CRM for Plumbing Contractors | Knockio";
const description = "Plumbing software and crm for contractors to schedule calls, send estimates, dispatch plumbers, and collect payment when each job is done.";

const asset = (name: string) => `/assets/cfw/${name}`;

const capabilityTabs = [
	{
		label: "Manage Jobs & History",
		cards: [
			{
				title: "Plumbing & Valve Property History",
				text: "Every property record logs main water shut-off locations, water heater serial numbers, pipe materials (copper, PEX, galvanized), and past repair history. Technicians arrive knowing where to cut the water before stepping into a flood.",
				image: asset("inner-plumbing-software-and-crm-one-record-for-every-customer-and-property.webp"),
				alt: "Door-to-door canvassing in Knockio",
			},
			{
				title: "Dynamic Pipeline for Plumbing Stages",
				text: "Move jobs through clear stages: Emergency Triage, Dispatched, Diagnosing, Price Book Quoted, Approved, Work in Progress, Permitted Inspection, and Completed. Separate boards for quick service calls versus major repipes.",
				image: asset("inner-plumbing-software-and-crm-customizable-job-pipeline.webp"),
				alt: "Lead management in Knockio",
			},
			{
				title: "Plumbing Service Plan Memberships",
				text: "Build customer loyalty with annual plumbing inspection memberships. Track member-only discounts on drain cleaning and water heater flushes, automate inspection reminders, and bill recurring membership fees via recurring invoicing.",
				image: asset("inner-plumbing-software-and-crm-communication-history-per-customer.webp"),
				alt: "Kanban-style sales pipeline in Knockio",
			},
		],
	},
	{
		label: "Track & Dispatch",
		cards: [
			{
				title: "Live GPS Tracking & Emergency Routing",
				text: "See every plumber's real-time GPS location on a live dispatch map. When a burst pipe or sewage backup call comes in, use the live rep map to assign the nearest available technician immediately.",
				image: asset("inner-plumbing-software-and-crm-scheduling-and-dispatch-in-one-calendar-1.webp"),
				alt: "Route planning in Knockio",
			},
			{
				title: "Auto Territory Creation by ZIP & City",
				text: "Carve out service zones or neighborhood canvassing territories automatically by ZIP code and city. Target aging residential subdivisions with water heater changeout or trenchless sewer replacement campaigns.",
				image: asset("inner-plumbing-software-and-crm-live-gps-tracking-with-proximity-intelligence.webp"),
				alt: "Territory management in Knockio",
			},
			{
				title: "Smarter Plumbing Route Planning",
				text: "Optimize daily routes for drain technicians running multiple residential calls a day. Minimize drive time between service stops and keep customers informed with accurate arrival windows.",
				image: asset("inner-plumbing-software-and-crm-automated-territory-creation-by-zip-code-and-city.webp"),
				alt: "Field activity log in Knockio",
			},
		],
	},
	{
		label: "Work Orders & Parts",
		cards: [
			{
				title: "Plumbing Work Orders With Takeoffs",
				text: "Build detailed work orders tracking PEX tubing, copper fittings, ball valves, wax rings, and PVC pipe against real job costs. Plumbers view itemized material takeoffs and job tasks directly on their mobile app.",
				image: asset("inner-plumbing-software-and-crm-detailed-estimates-with-templates.webp"),
				alt: "Job management in Knockio",
			},
			{
				title: "Purchase Orders to Plumbing Suppliers",
				text: "When water heaters, sewage pumps, or specialty valves run short, generate a purchase order for your supplier such as Ferguson, Winsupply, or Home Depot Pro. Flag low stock before parts delay a repipe.",
				image: asset("inner-plumbing-software-and-crm-work-orders-with-tasks-budget-and-materials.webp"),
				alt: "Crew dispatching in Knockio",
			},
			{
				title: "Truck Stock & Inventory Management",
				text: "Track common repair fittings and drain machine cutters across individual service vans. Know exactly which truck has the required repair parts before dispatching them to an emergency call.",
				image: asset("inner-plumbing-software-and-crm-assign-work-to-crews-or-subcontractors-1.webp"),
				alt: "Work orders in Knockio",
			},
		],
	},
	{
		label: "Documents & Media",
		cards: [
			{
				title: "Sewer Camera Video & Photo Logs",
				text: "Attach high-resolution sewer camera inspection videos and before/after photos of corroded pipes directly to the customer record—providing undeniable visual proof to justify rooter or excavation quotes.",
				image: asset("inner-plumbing-software-and-crm-inventory-management-for-plumbing-parts-1.webp"),
				alt: "Smart estimates in Knockio",
			},
			{
				title: "Backflow Testing & Permit Forms",
				text: "Store mandatory municipal backflow testing certifications, water heater permits, and master plumber sign-offs attached to the property record for seamless compliance audits and customer records.",
				image: asset("inner-plumbing-software-and-crm-vendor-bills-and-purchase-orders.webp"),
				alt: "Proposals in Knockio",
			},
			{
				title: "Declined-Repair Liability Waivers",
				text: "When a customer declines a recommended whole-home repipe and chooses a temporary clamp on a leaking pipe, capture a digital Declined-Repair Waiver e-signature on site to document that the customer declined the recommended repair.",
				image: asset("inner-plumbing-software-and-crm-photo-annotation-for-leaks-and-repairs.webp"),
				alt: "Digital contracts in Knockio",
			},
		],
	},
	{
		label: "Quote & Get Paid",
		cards: [
			{
				title: "Flat-Rate Price Book Quoting",
				text: "Present clear, flat-rate pricing from your integrated flat-rate price book. Plumbers quote the exact job price after diagnosis—before turning a wrench—to eliminate billing surprises.",
				image: asset("inner-plumbing-software-and-crm-digital-contracts-with-e-signatures.webp"),
				alt: "Video and file storage in Knockio",
			},
			{
				title: "Good / Better / Best Repipe Estimates",
				text: "Offer interactive multi-option proposals on major jobs like water heater replacements or sewer line repairs. Compare standard tank replacements against high-efficiency tankless installations, with the financing you offer.",
				image: asset("inner-plumbing-software-and-crm-milestone-based-payment-collection.webp"),
				alt: "Photo uploads in Knockio",
			},
			{
				title: "Collect on Site",
				text: "Collect diagnostic trip fees, repair balances, and project deposits immediately upon job completion using Text-to-Pay, card readers, or ACH processing in the field.",
				image: asset("inner-plumbing-software-and-crm-flexible-payment-methods.webp"),
				alt: "Service reports in Knockio",
			},
		],
	},
];

const organizedItems = [
	{
