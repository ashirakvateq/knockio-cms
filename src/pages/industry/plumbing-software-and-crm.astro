const operatingModelsData = {
  pillTag: "OPERATING MODEL FLEXIBILITY",
  title: "Built for How Your Plumbing Business Actually Operates",
  subtitle:
    "An emergency drain-cleaning business and a commercial new-construction plumber share a trade name, but run completely different workflows. Knockio adapts to your specific dispatch model, flat-rate pricing, and project draws out of the box.",
