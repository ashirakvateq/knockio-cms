const operatingModelsData = {
  pillTag: "OPERATING MODEL FLEXIBILITY",
  title: "Built for How Your Junk Removal Business Actually Operates",
  subtitle:
    "A residential garage cleanout and an estate hoarding cleanup share a trade name, but run completely different workflows. Knockio adapts to your specific truck-volume pricing, light demolition safety, and transfer-station costing out of the box.",
  cards: [
    {
      icon: "truck-ramp",
      title: "Residential Junk & Hauling",
