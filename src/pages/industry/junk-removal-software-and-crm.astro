---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/industry-page.css";
import OperatingModels from "../../components/industry/OperatingModels.astro";
import OldStackComparison from "../../components/industry/OldStackComparison.astro";
import {
  ChevronRight,
  Crosshair,
  FileSignature,
  MessageSquare,
  Quote,
  Ruler,
  Sparkles,
  Zap,
} from "lucide-astro";

const title = "Junk Removal Software & CRM for Junk Haulers | Knockio";
const description =
  "Junk removal software and CRM to book jobs, send instant quotes, dispatch crews, collect payment on site, and manage work with Knockio.";

const asset = (name: string) => `/assets/cfw/${name}`;

const capabilityTabs = [
  {
    label: "Manage Bookings & Jobs",
    cards: [
      {
        title: "Customer & Property Hauling History",
        text: "Every property record logs gate access codes, driveway clearance notes, elevator restrictions, past haul volume history, and recurring property management contacts. Crews arrive on site knowing whether they need appliance dollies or extra hands before backing up the truck.",
        image: asset(
          "inner-junk-removal-software-and-crm-fast-booking-from-phone-web-and-referrals.webp",
        ),
        alt: "Door-to-door canvassing in Knockio",
      },
      {
        title: "Dynamic Pipeline for Hauling Stages",
        text: "Move jobs through clear stages: Booked, Dispatched, On-Site Volume Quoted, Price Approved, Loading in Progress, Completed, and Dump / Transfer Station Logged. Customize boards for standard residential cleanouts versus commercial property turnovers.",
        image: asset(
          "inner-junk-removal-software-and-crm-one-record-for-every-customer-and-pickup.webp",
        ),
        alt: "Lead management in Knockio",
      },
      {
        title: "Recurring Property Management Accounts",
        text: "Build predictable repeat business with apartment complexes, real estate investors, and commercial property managers. Manage recurring eviction cleanouts, dumpster overflow cleanups, and monthly commercial invoicing under one parent account.",
        image: asset(
          "inner-junk-removal-software-and-crm-communication-history-per-customer.webp",
        ),
        alt: "Kanban-style sales pipeline in Knockio",
      },
    ],
  },
  {
    label: "Track & Dispatch",
    cards: [
      {
        title: "Live GPS Rep Tracking",
        text: "See where every rep and crew is in real time on a live map. When a same-day booking arrives, use the live rep map to assign the nearest available crew immediately.",
