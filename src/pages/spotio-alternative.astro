---
import KnockioHomeLayout from "../layouts/KnockioHomeLayout.astro";
import "../styles/spotio-alternative.css";
import { Check, X, Quote, WandSparkles, Route } from "lucide-astro";

const title = "Spotio Alternative - Knockio";
const description =
  "Knockio is a better SPOTIO alternative for businesses that want field sales software with deeper CRM functionality and better overall value.";
const ogImage = "/assets/cfw/all-devices-view-knockio-1024x390.webp";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://knockio.com/spotio-alternative/#webpage",
    url: "https://knockio.com/spotio-alternative/",
    name: "Spotio Alternative - Knockio",
    description,
    isPartOf: {
      "@id": "https://knockio.com/#website",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": "https://knockio.com/spotio-alternative/#breadcrumb",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://knockio.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Spotio Alternative",
        item: "https://knockio.com/spotio-alternative/",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "https://knockio.com/spotio-alternative/#faq",
    mainEntity: [
      {
        "@type": "Question",
        name: "Is Knockio a good alternative to SPOTIO?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. Knockio is the ideal SPOTIO alternative for sales and service businesses. It provides the same robust territory mapping and live rep tracking, but natively includes the back-office tools (dispatching, estimates, and billing) that SPOTIO lacks.",
        },
      },
      {
        "@type": "Question",
        name: "What does SPOTIO do well?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "SPOTIO focuses strictly on routing and tracking outside sales reps, but that's where their platform ends. Because it is purely a sales tool, teams are forced to manually transfer closed-won deals into a completely separate operational platform just to schedule the job.",
        },
      },
      {
        "@type": "Question",
        name: "Why would a team switch from SPOTIO to Knockio?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Businesses switch to Knockio to consolidate their software expenses and eliminate data entry errors. Instead of paying for a standalone field sales app and a separate service CRM, Knockio provides a true all-in-one environment. A prospect pinned in the field can be sent a digital contract and scheduled for service without ever leaving the Knockio app.",
        },
      },
      {
        "@type": "Question",
        name: "Is Knockio better for companies that both sell and deliver services?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. If your company relies on reps to hunt for business in the field and technicians to fulfill the work (like solar, roofing, or HVAC), Knockio is custom-built for your workflow. It perfectly bridges the gap between the initial handshake and the final invoice.",
        },
      },
      {
        "@type": "Question",
        name: "What makes Knockio a stronger alternative to SPOTIO?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "SPOTIO caters only to the front lines, meaning it stops working the moment the contract is signed. Knockio is stronger because it carries the baton all the way to the finish line, combining elite prospecting features with a complete operational CRM.",
        },
      },
    ],
  },
];

const comparisonRows = [
  { feature: "Door to door sales CRM", knockio: true, spotio: true },
  { feature: "Territory management", knockio: true, spotio: true },
  { feature: "Route optimization", knockio: true, spotio: true },
  { feature: "Lead management", knockio: true, spotio: true },
  { feature: "Real time rep activity tracking", knockio: true, spotio: true },
  { feature: "Digital proposals", knockio: true, spotio: true },
  { feature: "E contracts and e signatures", knockio: true, spotio: true },
  { feature: "Invoicing and payment tracking", knockio: true, spotio: false },
  { feature: "Sales to service handoff", knockio: true, spotio: false },
  { feature: "Field service CRM", knockio: true, spotio: false },
  { feature: "Notification preferences", knockio: true, spotio: false },
  { feature: "From Sales Lead to Job Completion", knockio: true, spotio: false },
  { feature: "Setup Fee", knockio: false, spotio: true },
  { feature: "Prorated Billing", knockio: true, spotio: false },
  { feature: "Minimum User Requirement", knockio: false, spotio: true },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: "/assets/cfw/avatar-lacey-jackson.webp",
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: "/assets/cfw/avatar-ben-loveland.webp",
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: "/assets/cfw/avatar-bar-galanti.webp",
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: "/assets/cfw/avatar-georgia-hancocks.webp",
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: "/assets/cfw/avatar-sarah-bennett.webp",
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: "/assets/cfw/avatar-ayana-hall.webp",
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <main class="sa-page overflow-hidden bg-white">
    <!-- HERO -->
    <section class="sa-hero">
      <div class="my-container mx-auto">
        <div class="text-white">
          <h1
            class="mb-6 text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-[64px]"
          >
            The SPOTIO Alternative That Doesn't Stop at the Pitch
          </h1>

          <p
            class="mb-8 w-full max-w-[926px] text-sm font-normal leading-6 text-neutral-300 sm:text-base sm:leading-7 md:text-lg md:leading-8"
          >
            SPOTIO is built purely to track field activity, but it abandons your
            operations team the moment a deal actually closes. Stop forcing your
            reps to bridge the gap with disconnected apps. Knockio seamlessly
            combines premium field routing and territory management with a
            heavy-duty service CRM, bringing your field reps and back office into
            one unified system.
          </p>

          <div class="flex flex-col gap-4 sm:flex-row">
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- G2 BADGES + COMPARISON -->
    <section class="overflow-hidden bg-white py-16 sm:py-20 lg:py-28">
      <div class="my-container mx-auto">
        <div
          class="mx-auto mb-14 grid max-w-[820px] grid-cols-2 items-center justify-center gap-5 sm:gap-7 lg:grid-cols-4"
        >
          <img
            src="/assets/cfw/g2-leader-badge-1.webp"
            alt="G2 Leader Badge"
            width="447"
            height="558"
            decoding="async"
            loading="eager"
            class="mx-auto h-auto w-full max-w-[118px] sm:max-w-[145px] lg:max-w-[170px]"
          />
          <img
            src="/assets/cfw/g2-high-performer-badge-1.webp"
            alt="G2 High Performer Badge"
            width="447"
            height="558"
            decoding="async"
            loading="eager"
            class="mx-auto h-auto w-full max-w-[118px] sm:max-w-[145px] lg:max-w-[170px]"
          />
          <img
            src="/assets/cfw/g2-best-support-badge-1.webp"
            alt="G2 Best Support Badge"
            width="447"
            height="558"
            decoding="async"
            loading="lazy"
            class="mx-auto h-auto w-full max-w-[118px] sm:max-w-[145px] lg:max-w-[170px]"
          />
          <img
            src="/assets/cfw/g2-best-roi-badge-1.webp"
            alt="G2 Best ROI Badge"
            width="447"
            height="558"
            decoding="async"
            loading="lazy"
            class="mx-auto h-auto w-full max-w-[118px] sm:max-w-[145px] lg:max-w-[170px]"
          />
        </div>

        <div class="mx-auto mb-8 max-w-[846px] text-center">
          <h2
            class="mb-3 text-3xl font-bold leading-tight text-neutral-950 sm:text-4xl lg:text-[42px] lg:leading-none xl:text-5xl 2xl:text-[56px]"
          >
            Knockio <span class="text-primary-500">vs</span> Spotio
          </h2>
          <p
            class="text-sm font-normal leading-6 text-neutral-600 sm:text-base sm:leading-7 md:text-lg md:leading-8"
          >
            Don't sacrifice your field tools. See how Knockio delivers the
            high-level territory mapping your outside reps demand, while
            completely eliminating the need for expensive, third-party CRM
            integrations
          </p>
        </div>

        <!-- Desktop / Tablet Table -->
        <div class="mx-auto hidden max-w-[1180px] overflow-hidden rounded-t-2xl md:block">
          <table class="w-full border-collapse text-left">
            <thead>
              <tr class="bg-neutral-100 text-neutral-950">
                <th class="w-[58%] rounded-tl-2xl px-5 py-4 text-sm font-bold">
                  MAIN FEATURE COMPARISON
                </th>
                <th class="w-[21%] px-5 py-4 text-center text-sm font-bold">
                  Knockio
                </th>
                <th class="w-[21%] rounded-tr-2xl px-5 py-4 text-center text-sm font-bold">
                  Spotio
                </th>
              </tr>
            </thead>
            <tbody class="text-sm font-semibold text-neutral-950">
              {
                comparisonRows.map((row, index) => (
                  <tr class={index % 2 === 0 ? "bg-white" : "bg-primary-50"}>
                    <td class="px-5 py-3">{row.feature}</td>
                    <td class="px-5 py-3 text-center">
                      {row.knockio ? (
                        <span class="sa-check text-xl" aria-label="Yes">
                          <Check aria-hidden="true" />
                        </span>
                      ) : (
                        <span class="sa-xmark text-xl" aria-label="No">
                          <X aria-hidden="true" />
                        </span>
                      )}
                    </td>
                    <td class="px-5 py-3 text-center">
                      {row.spotio ? (
                        <span class="sa-check text-xl" aria-label="Yes">
                          <Check aria-hidden="true" />
                        </span>
                      ) : (
                        <span class="sa-xmark text-xl" aria-label="No">
                          <X aria-hidden="true" />
                        </span>
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <!-- Mobile Table Cards -->
        <div class="grid gap-3 md:hidden">
          <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-4">
            <div
              class="mb-3 grid grid-cols-[1fr_64px_64px] gap-3 text-xs font-bold text-neutral-950"
            >
              <span>MAIN FEATURE COMPARISON</span>
              <span class="text-center">Knockio</span>
              <span class="text-center">Spotio</span>
            </div>

            <div class="space-y-2 text-sm font-semibold text-neutral-950">
              {
                comparisonRows.map((row, index) => (
                  <div
                    class:list={[
                      "grid grid-cols-[1fr_64px_64px] gap-3 rounded-xl p-3",
                      index % 2 === 0 ? "bg-white" : "bg-primary-50",
                    ]}
                  >
                    <span>{row.feature}</span>
                    <span class="text-center">
                      {row.knockio ? (
                        <span class="sa-check" aria-label="Yes">
                          <Check aria-hidden="true" />
                        </span>
                      ) : (
                        <span class="sa-xmark" aria-label="No">
                          <X aria-hidden="true" />
                        </span>
                      )}
                    </span>
                    <span class="text-center">
                      {row.spotio ? (
                        <span class="sa-check" aria-label="Yes">
                          <Check aria-hidden="true" />
                        </span>
                      ) : (
                        <span class="sa-xmark" aria-label="No">
                          <X aria-hidden="true" />
                        </span>
                      )}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- DARK ROUTE SECTION -->
    <section class="sa-dark-band overflow-hidden py-14 sm:py-20 lg:py-28">
      <div class="my-container mx-auto">
        <div
          class="grid grid-cols-1 items-center gap-10 md:grid-cols-12 md:gap-8 xl:gap-0"
        >
          <div class="text-center md:col-span-7 md:text-left xl:col-span-7">
            <p
              class="mb-3 text-sm font-medium leading-7 text-primary-500 sm:text-base md:text-2xl font-inter"
            >
              Sales Mapping &amp; Lead Generation
            </p>

            <h2
              class="mb-5 text-3xl font-bold leading-tight text-neutral-100 sm:text-4xl lg:text-[42px] lg:leading-none xl:text-5xl 2xl:text-[56px]"
            >
              Go Beyond Just Dropping Pins
            </h2>

            <p
              class="mx-auto mb-8 max-w-[760px] text-sm font-normal leading-6 text-neutral-200 sm:text-base sm:leading-7 md:mx-0 md:text-lg md:leading-8"
            >
              SPOTIO was built to optimize routes and track field reps. But for
              growing service businesses, dropping a pin is only step one.
              Knockio provides the same elite GPS routing and territory cutting
              you are used to, but connects those field visits directly to your
              customer records, digital contracts, and invoicing tools. You get
              the prospecting power of a dedicated field app without the
              bottleneck of a disconnected pipeline.
            </p>

            <div
              class="mx-auto grid max-w-[650px] grid-cols-1 gap-5 sm:gap-6 md:mx-0 md:gap-7"
            >
              <div
                class="flex items-start gap-4 rounded-2xl border border-neutral-200 p-5 text-left sm:gap-5 sm:p-6 md:border-0 md:bg-transparent md:p-0 lg:gap-6"
              >
                <span class="sa-feature-icon" aria-hidden="true">
                  <WandSparkles />
                </span>
                <div class="min-w-0">
                  <h3
                    class="mb-2 text-xl font-bold leading-tight text-white lg:text-2xl"
                  >
                    Find the Next Best Opportunity
                  </h3>
                  <p
                    class="text-sm font-normal leading-6 text-white sm:text-base sm:leading-7"
                  >
                    Plan routes, manage territories, view nearby leads, track
                    rep activity, and help each team member focus on the right
                    prospects without jumping between disconnected tools.
                  </p>
                </div>
              </div>

              <div
                class="flex items-start gap-4 rounded-2xl border border-neutral-200 p-5 text-left sm:gap-5 sm:p-6 md:border-0 md:bg-transparent md:p-0 lg:gap-6"
              >
                <span class="sa-feature-icon" aria-hidden="true">
                  <Route />
                </span>
                <div class="min-w-0">
                  <h3
                    class="mb-2 text-xl font-bold leading-tight text-white lg:text-2xl"
                  >
                    Turn Field Visits Into Sales
                  </h3>
                  <p
                    class="text-sm font-normal leading-6 text-white sm:text-base sm:leading-7"
                  >
                    Create proposals on-site, send digital contracts, update
                    lead status, and keep customer details attached to the same
                    workflow so your team can close deals with less delay.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="flex justify-center md:col-span-5 xl:col-span-5">
            <img
              src="/assets/cfw/lead-detail-mobile-full.webp"
              alt="Lead Detail Mobile Screen"
              width="315"
              height="640"
              decoding="async"
              loading="lazy"
              class="h-auto w-full max-w-[220px] object-contain sm:max-w-[260px] md:max-w-[300px] lg:max-w-[330px] xl:max-w-[360px]"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- MOVE BEYOND / INTEGRATION TAX -->
    <section class="overflow-hidden bg-white py-16 sm:py-20 lg:py-28">
      <div class="my-container mx-auto">
        <div
          class="grid grid-cols-1 items-center gap-10 md:grid-cols-12 md:gap-8 xl:gap-0"
        >
          <div
            class="order-2 flex justify-center md:order-1 md:col-span-5 md:justify-start xl:col-span-5"
          >
            <img
              src="/assets/cfw/route-midpoint-mobile-full.webp"
              alt="Midpoints Selection Mobile Screen"
              width="313"
              height="640"
              decoding="async"
              loading="lazy"
              class="h-auto w-full max-w-[220px] object-contain sm:max-w-[260px] md:max-w-[300px] lg:max-w-[330px] xl:max-w-[360px]"
            />
          </div>

          <div class="hidden md:order-2 md:col-span-1 md:block xl:col-span-1"></div>

          <div
            class="order-1 text-center md:order-3 md:col-span-6 md:text-left xl:col-span-6"
          >
            <p
              class="mb-3 text-sm font-medium leading-7 text-primary-500 sm:text-base md:text-2xl font-inter"
            >
              Advanced CRM &amp; Workflow Control
            </p>

            <h2
              class="mb-5 text-3xl font-bold leading-tight text-neutral-950 sm:text-4xl lg:text-[42px] lg:leading-none xl:text-5xl 2xl:text-[56px]"
            >
              Stop Paying the "Integration Tax"
            </h2>

            <p
              class="mx-auto mb-8 max-w-[790px] text-sm font-normal leading-6 text-neutral-600 sm:text-base sm:leading-7 md:mx-0 md:text-lg md:leading-8"
            >
              If you use SPOTIO, you are likely paying a premium per-user fee,
              plus the cost of a Zapier account or API integration, plus another
              $80/month per user for an operational CRM to actually schedule the
              work. This "Duct-Tape Tax" drains your profit margins and causes
              data leaks between sales and service. Knockio replaces that entire
              fragile stack. Your whole team operates on one native database,
              slashing your software overhead by up to 40%.
            </p>

            <div
              class="mx-auto grid max-w-[650px] grid-cols-1 gap-5 sm:gap-6 md:mx-0 md:gap-7"
            >
              <div
                class="flex items-start gap-4 rounded-2xl border border-neutral-200 bg-white p-5 text-left sm:gap-5 sm:p-6 md:border-0 md:bg-transparent md:p-0 lg:gap-6"
              >
                <span class="sa-feature-icon" aria-hidden="true">
                  <WandSparkles />
                </span>
                <div class="min-w-0">
                  <h3
                    class="mb-2 text-xl font-bold leading-tight text-neutral-950 lg:text-2xl"
                  >
                    Manage more in one place
                  </h3>
                  <p
                    class="text-sm font-normal leading-6 text-neutral-600 sm:text-base sm:leading-7"
                  >
                    Track territories, reps, leads, follow ups, customer records,
                    invoices, and job progress in one connected workflow built
                    for growing sales teams.
                  </p>
                </div>
              </div>

              <div
                class="flex items-start gap-4 rounded-2xl border border-neutral-200 bg-white p-5 text-left sm:gap-5 sm:p-6 md:border-0 md:bg-transparent md:p-0 lg:gap-6"
              >
                <span class="sa-feature-icon" aria-hidden="true">
                  <Route />
                </span>
                <div class="min-w-0">
                  <h3
                    class="mb-2 text-xl font-bold leading-tight text-neutral-950 lg:text-2xl"
                  >
                    Scale without extra tools
                  </h3>
                  <p
                    class="text-sm font-normal leading-6 text-neutral-600 sm:text-base sm:leading-7"
                  >
                    With no setup fee, prorated billing, and more functionality
                    across CRM and service workflows, Knockio gives teams room to
                    grow without adding more software.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-white py-16 sm:py-20 lg:py-24">
      <div class="my-container mx-auto">
        <div class="grid gap-10 lg:grid-cols-2 lg:gap-20">
          <div>
            <p class="mb-4 text-sm leading-7 text-primary-500 md:text-2xl font-inter">
              Common Questions
            </p>
            <h2
              class="mb-8 w-full max-w-xl text-3xl font-bold leading-tight text-neutral-950 sm:text-4xl lg:text-[42px] lg:leading-none xl:text-5xl 2xl:text-[56px]"
            >
              Spotio Alternative FAQs
            </h2>
          </div>

          <div class="space-y-4">
            <div
              class="faq-item overflow-hidden rounded-2xl border border-solid border-neutral-200 transition-all duration-300"
            >
              <button
                type="button"
                class="faq-button group flex w-full items-center justify-between p-4 text-left sm:p-6"
              >
                <span
                  class="text-base font-medium text-neutral-950 transition-colors group-hover:text-primary-500 sm:text-lg lg:text-xl"
                >
                  Is Knockio a good alternative to SPOTIO?
                </span>
                <div
                  class="faq-icon ml-4 flex h-6 w-6 flex-shrink-0 items-center justify-center text-primary-500"
                >
                  <svg
                    class="icon-minus hidden h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M20 12H4"></path>
                  </svg>
                  <svg
                    class="icon-plus h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 4v16m8-8H4"></path>
                  </svg>
                </div>
              </button>
              <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
                <div
                  class="p-4 pt-0 text-sm leading-relaxed text-neutral-600 sm:p-6 sm:pt-0 sm:text-base"
                >
                  Yes. Knockio is the ideal SPOTIO alternative for sales and
                  service businesses. It provides the same robust territory
                  mapping and live rep tracking, but natively includes the
                  back-office tools (dispatching, estimates, and billing) that
                  SPOTIO lacks.
                </div>
              </div>
            </div>

            <div
              class="faq-item overflow-hidden rounded-2xl border border-solid border-neutral-200 transition-all duration-300"
            >
              <button
                type="button"
                class="faq-button group flex w-full items-center justify-between p-4 text-left sm:p-6"
              >
                <span
                  class="text-base font-medium text-neutral-950 transition-colors group-hover:text-primary-500 sm:text-lg lg:text-xl"
                >
                  What does SPOTIO do well?
                </span>
                <div
                  class="faq-icon ml-4 flex h-6 w-6 flex-shrink-0 items-center justify-center text-primary-500"
                >
                  <svg
                    class="icon-minus hidden h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M20 12H4"></path>
                  </svg>
