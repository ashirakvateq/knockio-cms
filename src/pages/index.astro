---
import KnockioHomeLayout from "../layouts/KnockioHomeLayout.astro";
import {
  ArrowDown,
  Bell,
  Boxes,
  BriefcaseBusiness,
  Bug,
  Calculator,
  ChartLine,
  Check,
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  CircleUserRound,
  Copy,
  CreditCard,
  Download,
  Droplets,
  Ellipsis,
  EllipsisVertical,
  FileText,
  Flag,
  Funnel,
  GitBranch,
  HardHat,
  History,
  House,
  Layers,
  Leaf,
  List,
  ListChecks,
  LocateFixed,
  Mail,
  Map,
  Maximize,
  MessageCircle,
  Network,
  PaintRoller,
  Phone,
  PhoneCall,
  Pin,
  Play,
  Plug,
  Plus,
  Quote,
  Receipt,
  RefreshCw,
  Reply,
  Route,
  Rows3,
  Satellite,
  Save,
  Search,
  Shield,
  Signature,
  SolarPanel,
  SprayCan,
  SquareCheck,
  Star,
  StickyNote,
  Thermometer,
  Truck,
  Upload,
  UserCheck,
  Users,
  Warehouse,
  Waves,
  WavesLadder,
  X,
  Zap,
} from "lucide-astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://knockio.com/#organization",
      name: "Knockio",
      url: "https://knockio.com/",
      logo: {
        "@type": "ImageObject",
        url: "https://knockio.com/wp-content/uploads/2026/05/knockio-logo.webp",
      },
      sameAs: [
        "https://apps.apple.com/us/app/knockio-field-service-crm/id6756485440",
        "https://play.google.com/store/apps/details?id=com.knockio.crm&hl=en_US",
        "https://www.linkedin.com/company/knockio",
        "https://www.facebook.com/knockioapp/",
        "https://www.instagram.com/knockioapp/",
        "https://x.com/knockioapp",
        "https://www.youtube.com/@knockioapp",
        "https://www.g2.com/products/knockio-by-knockio",
        "https://www.capterra.com/p/10018264/Knockio/",
        "https://www.softwareadvice.com/field-sales/knockio-profile/",
        "https://www.gartner.com/reviews/product/knockio-1907844446",
        "https://www.crunchbase.com/organization/knockio",
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://knockio.com/#website",
      url: "https://knockio.com/",
      name: "Knockio",
      publisher: { "@id": "https://knockio.com/#organization" },
      potentialAction: {
        "@type": "SearchAction",
        target: "https://knockio.com/?s={search_term_string}",
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "WebApplication",
      "@id": "https://knockio.com/#software",
      name: "Knockio",
      url: "https://knockio.com/",
      applicationCategory: "BusinessApplication",
      applicationSubCategory: "Field Sales Software, Field Service CRM",
      operatingSystem: "Web, iOS, Android",
      description:
        "Knockio is an integrated field service management and door-to-door sales platform that consolidates territory mapping, routing, and lead capture with job scheduling, dispatching, estimates, invoicing, workorders & payments.",
      provider: { "@id": "https://knockio.com/#organization" },
      availableOnDevice: ["Desktop", "Mobile", "Tablet"],
      hasPart: [
        {
          "@type": "SoftwareApplication",
          name: "Knockio iOS App",
          operatingSystem: "iOS",
          applicationCategory: "BusinessApplication",
          downloadUrl:
            "https://apps.apple.com/us/app/knockio-field-service-crm/id6756485440",
          aggregateRating: {
            "@type": "AggregateRating",
            ratingValue: "4.8",
            ratingCount: "40",
          },
        },
        {
          "@type": "SoftwareApplication",
          name: "Knockio Android App",
          operatingSystem: "Android",
          applicationCategory: "BusinessApplication",
          downloadUrl:
            "https://play.google.com/store/apps/details?id=com.knockio.crm&hl=en_US",
        },
        { "@id": "https://knockio.com/canvassing/#software" },
        { "@id": "https://knockio.com/field-service-crm/#software" },
      ],
      offers: {
        "@type": "AggregateOffer",
        lowPrice: "20.00",
        highPrice: "60.00",
        priceCurrency: "USD",
        url: "https://knockio.com/pricing/",
      },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: "4.3",
        ratingCount: "9",
      },
    },
    {
      "@type": "WebPage",
      "@id": "https://knockio.com/#webpage",
      url: "https://knockio.com/",
      name: "Knockio | All-In-One Field Sales & Service Platform",
      description:
        "Stop taping your software together. Knockio is the unified field service management platform that connects your front-line sales to your back-office operations.",
      isPartOf: { "@id": "https://knockio.com/#website" },
      about: { "@id": "https://knockio.com/#software" },
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/#faq",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is Knockio?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Knockio is a field sales and field service platform. It handles door-to-door canvassing, territory mapping, route planning, and lead capture on the sales side, and job scheduling, dispatching, estimates, and invoicing on the service side. Most teams juggle a separate tool for each; Knockio keeps them in one workflow.",
          },
        },
        {
          "@type": "Question",
          name: "Who is Knockio built for?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Field sales and service teams in roofing, solar, HVAC, pest control, fiber, and other home-services industries — anyone managing reps or crews in the field, from the first door knock to the final invoice.",
          },
        },
        {
          "@type": "Question",
          name: "How much does Knockio cost?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Plans start at $25/user/month, with volume discounts at 5+ users, no long-term contracts, and no setup fee. Prospect (canvassing / door-to-door sales) is $25/user/mo, or $20/user/mo with 5+ users. Organize (field service CRM) is $35/user/mo, or $30/user/mo with 5+ users. Growth (all-in-one sales + service) is $60/user/mo, or $45/user/mo with 5+ users.",
          },
        },
        {
          "@type": "Question",
          name: "Does Knockio replace multiple tools, or add another one?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Knockio is built to replace the canvassing app and service CRM you're currently running separately, or just one of them, whichever your team needs. Choose both with the Growth plan, and leads captured in the field move straight into scheduling, estimates, and invoicing without re-entering data anywhere.",
          },
        },
        {
          "@type": "Question",
          name: "Does Knockio work on mobile?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes — reps and crews can use the Knockio Android and iOS apps in the field to capture leads, update job statuses, add notes or photos in real time, and also send invoices, collect payments, and email customers directly from the app.",
          },
        },
        {
          "@type": "Question",
          name: "Can I use just the canvassing side, or just the CRM side?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Teams can run Knockio's canvassing app on its own, the field service CRM on its own, or both together as one connected platform.",
          },
        },
      ],
    },
  ],
};
---

<KnockioHomeLayout
  title="Knockio | All-In-One Field Sales & Service Platform"
  description="Stop taping your software together. Knockio is the unified field service management platform that connects your front-line sales to your back-office operations."
  jsonLd={jsonLd}
>
  <!-- SECTION 1: Hero + Product Demo -->
  <!-- Hero + Interactive Product Demo -->
  <section
    class="hero-background text-white pt-36 max-md:pt-40 max-lg:pb-24 max-md:pb-40 flex flex-col items-center justify-center text-center relative z-0"
  >
    <div class="my-container">
      <div>
        <div
          class="flex items-center gap-3 justify-center mb-3 max-md:flex-col max-md:gap-1"
        >
          <div class="flex">
            <Star size="1.25em" fill="currentColor" class="text-yellow-400" aria-hidden="true" />
            <Star size="1.25em" fill="currentColor" class="text-yellow-400" aria-hidden="true" />
            <Star size="1.25em" fill="currentColor" class="text-yellow-400" aria-hidden="true" />
            <Star size="1.25em" fill="currentColor" class="text-yellow-400" aria-hidden="true" />
            <Star size="1.25em" fill="currentColor" class="text-yellow-400" aria-hidden="true" />
          </div>
          <div>
            <span class="text-base max-md:text-base text-neutral-200"
              >5 stars across 1,000+ reviews</span
            >
          </div>
        </div>
        <h1
          class="text-[56px] max-2xl:text-5xl max-xl:text-4xl max-md:text-3xl leading-[68px] max-xl:leading-[52px] max-md:leading-[38px] text-neutral-900 max-w-4xl mx-auto text-white font-extrabold mb-3"
        >
          The All-In-One <br class="inline-block md:hidden" /> Field Sales and Service
          <br class="inline-block md:hidden" /> Platform
        </h1>

        <p class="text-lg max-xl:text-base max-md:text-sm text-neutral-200 mb-8 max-w-5xl font-normal leading-8 max-xl:leading-7 max-md:leading-6 max-md:extrabold mx-auto">
            Knockio unifies your entire operation. Equip your outside sales team with elite door to door canvassing software,
            and give your back office a powerful field service CRM
            to dispatch crews and collect payments, all in one connected contractor platform.
        </p>
        <div class="my-6 flex flex-wrap justify-center gap-3 sm:gap-4">
          <a
            href="https://play.google.com/store/apps/details?id=com.knockio.crm&hl=en"
            target="_blank"
            class="shadow-md hover:opacity-90 transition-opacity"
          >
            <img
              decoding="async"
              src="/assets/cfw/google-play-button.webp"
              alt="Google Play"
              class="h-auto w-36 xl:w-44 lg:w-[145px]"
            />
          </a>
          <a
            href="https://apps.apple.com/us/app/knockio/id6756485440"
            target="_blank"
            class="shadow-md hover:opacity-90 transition-opacity"
          >
            <img
              decoding="async"
              src="/assets/cfw/apple-store-button.webp"
              alt="App Store"
              class="h-auto w-36 xl:w-44 lg:w-[145px]"
            />
          </a>
        </div>
        <div
          class="flex items-center max-md:flex-col justify-center gap-8 max-md:gap-5"
        >
          <a
            href="#cal-sec"
            class="bg-primary-500 hover:bg-transparent border border-solid border-primary-500 text-white font-medium text-lg max-xl:text-base max-xl:w-52 max-md:w-full py-3 w-60 rounded-lg transition"
          >
            Schedule a Demo
          </a>
        </div>
      </div>

      <!-- Interactive demo: desktop only (1024px+) -->
      <div class="kio-product-demo mt-16 hidden lg:block text-left">
        <!-- Tabs -->
        <div
          data-kio-demo-tabs
          class="mx-auto mb-12 flex w-full max-w-3xl items-center justify-between gap-1 overflow-x-auto rounded-full border border-solid border-white/25 bg-white/10 p-1 backdrop-blur"
        >
          <button
            type="button"
            data-kio-tab="leads"
            class="kio-demo-tab is-active flex shrink-0 items-center rounded-full px-6 py-2.5 text-base font-medium text-white transition-all hover:bg-white/30"
          >
            <Users size="1em" aria-hidden="true" /><span class="ml-2">Leads</span
            >
          </button>
          <button
            type="button"
            data-kio-tab="routes"
            class="kio-demo-tab flex shrink-0 items-center rounded-full px-6 py-2.5 text-base font-medium text-white transition-all hover:bg-white/30"
          >
            <Route size="1em" aria-hidden="true" /><span class="ml-2">Routes</span>
          </button>
          <button
            type="button"
            data-kio-tab="boards"
            class="kio-demo-tab flex shrink-0 items-center rounded-full px-6 py-2.5 text-base font-medium text-white transition-all hover:bg-white/30"
          >
            <Rows3 size="1em" aria-hidden="true" /><span class="ml-2">Boards</span>
          </button>
          <button
            type="button"
            data-kio-tab="invoices"
            class="kio-demo-tab flex shrink-0 items-center rounded-full px-6 py-2.5 text-base font-medium text-white transition-all hover:bg-white/30"
          >
            <Receipt size="1em" aria-hidden="true" /><span class="ml-2"
              >Invoices</span
            >
          </button>
          <button
            type="button"
            data-kio-tab="automations"
            class="kio-demo-tab flex shrink-0 items-center rounded-full px-6 py-2.5 text-base font-medium text-white transition-all hover:bg-white/30"
          >
            <RefreshCw size="1em" aria-hidden="true" /><span class="ml-2"
              >Automations</span
            >
          </button>
        </div>
        <!-- Product Window -->
        <div class="relative mx-auto max-w-[1440px]">
          <div
            class="absolute -inset-4 rounded-[34px] bg-primary-500/20 blur-2xl"
          >
          </div>
          <div
            class="relative overflow-hidden rounded-[30px] border border-solid border-white/15 bg-white/10 p-2 shadow-[0_40px_120px_rgba(0,0,0,.42)] backdrop-blur-xl sm:p-3"
          >
            <!-- Browser header -->
            <div
              class="flex h-[46px] items-center justify-between rounded-t-[22px] border-b border-solid border-white/10 bg-white/10 px-5"
            >
              <div class="flex items-center gap-2">
                <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-yellow-400"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-green-400"></span>
              </div>
              <div
                class="hidden rounded-full border border-solid border-white/10 bg-black/20 px-5 py-1.5 text-[11px] font-medium text-neutral-300 md:block"
              >
                app.knockio.com / workspace
              </div>
              <div class="flex items-center gap-3 text-sm text-neutral-300">
                <Bell size="1em" aria-hidden="true" />
                <CircleUserRound size="1em" aria-hidden="true" />
              </div>
            </div>
            <div class="h-[3px] bg-white/15">
              <div class="kio-progress-bar"></div>
            </div>
            <div
              class="kio-app-viewport relative h-[min(816px,calc(100vw-4rem))] w-full overflow-hidden rounded-b-[22px] bg-white"
            >
              <div class="relative h-full w-full min-h-0 min-w-0">
                <!-- LEADS PANEL -->
                <div
                  class="kio-demo-tab-panel is-active h-full"
                  data-kio-panel="leads"
                >
                  <div class="flex h-full min-h-0 bg-white">
                    <aside
                      class="flex w-[248px] shrink-0 flex-col min-h-0 border-r border-solid border-neutral-200 bg-white"
                      data-kio-sidebar
                      data-sidebar-active="leads"
                    >
                    </aside>
                    <main class="flex min-h-0 min-w-0 flex-1 flex-col">
                      <div
                        class="flex h-14 shrink-0 items-center justify-between border-b border-solid border-neutral-200 bg-white px-4 xl:px-6"
                      >
                        <div
                          class="inline-flex h-[34px] items-center gap-2 rounded-full bg-neutral-100 px-3 text-xs font-semibold text-neutral-500"
                        >
                          Leads
                          <ChevronRight size="1em" class="text-[9px]" aria-hidden="true" />
                          Leads Map
                        </div>
                        <div class="flex items-center gap-2">
<button
                            class="relative inline-flex h-[34px] w-[34px] items-center justify-center rounded-lg bg-neutral-100 text-sm text-neutral-600 transition hover:-translate-y-px hover:shadow-md"
                          
                            aria-label="View notifications">
                            <Bell size="1em" aria-hidden="true" />
                            <span
                              class="absolute right-0.5 top-0.5 h-1.5 w-1.5 rounded-full border border-solid border-white bg-red-500"
                            ></span>
                          </button>
<button
                            class="inline-flex h-[34px] w-[34px] items-center justify-center rounded-lg bg-neutral-100 text-sm text-neutral-600 transition hover:-translate-y-px hover:shadow-md"
                          
                            aria-label="Search">
                            <Search size="1em" aria-hidden="true" />
                          </button>
<button
                            class="inline-flex h-[34px] items-center justify-center gap-1.5 rounded-lg bg-neutral-100 px-4 text-sm font-medium text-neutral-600 transition hover:-translate-y-px hover:shadow-md"
                          
                            aria-label="Choose display">
                            <span class="hidden xl:inline">Smart tv</span>
                            <ChevronDown size="1em" class="text-[10px]" aria-hidden="true" />
                          </button>
<button
                            class="grid h-[34px] w-[34px] place-items-center overflow-hidden rounded-full bg-primary-50"
                          
                            aria-label="Open account menu">
                            <span
                              class="grid h-[28px] w-[28px] place-items-center rounded-full bg-primary-500 text-[11px] font-medium text-white"
                              >S</span
                            >
                          </button>
                        </div>
                      </div>
                      <div class="relative flex min-h-0 flex-1 flex-col">
                        <div class="absolute right-4 top-3 z-30 flex gap-2">
                          <button
                            type="button"
                            class="inline-flex h-[34px] items-center rounded-lg bg-primary-600 px-3.5 text-xs font-semibold text-white shadow-md shadow-primary-600/25 transition hover:-translate-y-px"
                            data-map-list-toggle
                          >
                            <List size="1em" class="mr-1" aria-hidden="true" /> List View
                          </button>
                          <button
                            type="button"
                            class="inline-flex h-[34px] items-center rounded-lg bg-primary-600 px-3.5 text-xs font-semibold text-white shadow-md shadow-primary-600/25 transition hover:-translate-y-px"
                            data-toast-message="Filters opened"
                          >
                            <Funnel size="1em" class="mr-1" aria-hidden="true" /> Filters
                          </button>
                        </div>
                        <div
                          data-leads-map-view
                          class="relative min-h-0 flex-1 overflow-hidden bg-neutral-50"
                          data-kio-map-host
                        >
                          <div
                            class="absolute left-1/2 top-3.5 z-20 flex w-[min(420px,72%)] -translate-x-1/2 items-center gap-2 rounded-[10px] border border-solid border-neutral-200 bg-white px-3.5 py-2.5 shadow-lg"
                          >
                            <Search size="1em" class="text-[11px] text-neutral-400" aria-hidden="true" />
                            <input
                              class="w-full bg-transparent text-[12px] font-medium outline-none placeholder:text-neutral-400"
                              placeholder="Search Location"
                            />
                          </div>
                          <div
                            class="kio-map-marker left-[24%] top-[38%]"
                            style="animation-delay:0.05s"
                          >
<button
                              class="kio-pin pin-green is-active"
                              data-name="Daniel Thomas"
                              data-address="1340 Taylor St, San Francisco, CA"
                              
                            aria-label="View lead details for Daniel Thomas"><Star size="1em" fill="currentColor" aria-hidden="true" /></button
                            >
                            <span
                              class="mt-1 whitespace-nowrap rounded-md bg-white px-2 py-0.5 text-[10px] font-semibold text-neutral-900 shadow-md"
                              >Daniel Thomas</span
                            >
                            <span
                              class="mt-0.5 whitespace-nowrap rounded bg-white/95 px-1.5 py-0.5 text-[9px] font-semibold text-neutral-500"
                              >Inspection Complete</span
                            >
                          </div>
                          <div
                            class="kio-map-marker left-[38%] top-[28%]"
                            style="animation-delay:0.1s"
                          >
<button
                              class="kio-pin pin-red"
                              data-name="Savannah Nguyen"
                              data-address="1200 Geary Road, Walnut Creek, CA"
                              
                            aria-label="View lead details for Savannah Nguyen"><Zap size="1em" aria-hidden="true" /></button
                            >
                            <span
                              class="mt-1 whitespace-nowrap rounded-md bg-white px-2 py-0.5 text-[10px] font-semibold text-neutral-900 shadow-md"
                              >Savannah Nguyen</span
                            >
                          </div>
                          <div
                            class="kio-map-marker left-[52%] top-[38%]"
                            style="animation-delay:0.15s"
                          >
<button
                              class="kio-pin pin-orange"
                              data-name="Courtney Henry"
                              data-address="4517 Washington Ave, Manchester"
                              
                            aria-label="View lead details for Courtney Henry"><Reply size="1em" aria-hidden="true" /></button
                            >
                            <span
                              class="mt-1 whitespace-nowrap rounded-md bg-white px-2 py-0.5 text-[10px] font-semibold text-neutral-900 shadow-md"
                              >Courtney Henry</span
                            >
                          </div>
                          <div
                            class="kio-map-marker left-[68%] top-[38%]"
                            style="animation-delay:0.2s"
                          >
<button
                              class="kio-pin pin-green"
                              data-name="Brooklyn Simmons"
                              data-address="2118 Thornridge Cir, Syracuse"
                              
                            aria-label="View lead details for Brooklyn Simmons"><Star size="1em" fill="currentColor" aria-hidden="true" /></button
                            >
                            <span
                              class="mt-1 whitespace-nowrap rounded-md bg-white px-2 py-0.5 text-[10px] font-semibold text-neutral-900 shadow-md"
                              >Brooklyn Simmons</span
                            >
                          </div>
                          <div
                            class="kio-map-marker left-[50%] top-[55%]"
                            style="animation-delay:0.25s"
                          >
<button
                              class="kio-pin pin-green"
                              data-name="Marvin McKinney"
                              data-address="3891 Ranchview Dr, Richardson"
                              
                            aria-label="View lead details for Marvin McKinney"><Star size="1em" fill="currentColor" aria-hidden="true" /></button
                            >
                            <span
                              class="mt-1 whitespace-nowrap rounded-md bg-white px-2 py-0.5 text-[10px] font-semibold text-neutral-900 shadow-md"
                              >Marvin McKinney</span
                            >
                          </div>
                          <div
                            class="kio-map-marker left-[47%] top-[32%]"
                            style="animation-delay:0.3s"
                          >
<button
                              class="kio-pin pin-red"
                              data-name="Dianne Russell"
                              data-address="2715 Ash Dr, San Jose"
                              
                            aria-label="View lead details for Dianne Russell"><Zap size="1em" aria-hidden="true" /></button
                            >
                            <span
                              class="mt-1 whitespace-nowrap rounded-md bg-white px-2 py-0.5 text-[10px] font-semibold text-neutral-900 shadow-md"
                              >Dianne Russell</span
                            >
                            <span
                              class="mt-0.5 whitespace-nowrap rounded bg-white/95 px-1.5 py-0.5 text-[9px] font-semibold text-neutral-500"
                              >Inspection Complete</span
                            >
                          </div>
                          <div
                            class="absolute left-[46%] top-[38%] z-[7] -translate-x-1/2 -translate-y-1/2"
                          >
                            <span
                              class="grid h-8 w-8 cursor-pointer place-items-center rounded-full bg-neutral-800/80 text-xs font-bold text-white shadow-lg transition hover:scale-110"
                              data-toast-message="2 leads in this area">2</span
                            >
                          </div>
                          <div
                            class="absolute right-3 top-1/2 z-20 flex -translate-y-1/2 flex-col gap-1.5"
                          >
<button
                              type="button"
                              class="grid h-[38px] w-[38px] place-items-center rounded-[10px] bg-primary-600 text-sm text-white shadow-md shadow-primary-600/30 transition hover:scale-105"
                              data-toast-message="Layers toggled"
                              
                            aria-label="Toggle map layers"><Layers size="1em" aria-hidden="true" /></button
                            >
