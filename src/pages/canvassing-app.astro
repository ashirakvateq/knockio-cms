---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/canvassing-app.css';
import canvassingScript from '../scripts/canvassing-app.js?url';
import {
  ArrowRight,
  BadgeCheck,
  Boxes,
  CalendarDays,
  CalendarX,
  ChartLine,
  Check,
  CheckCircle2,
  FileSignature,
  Map,
  Minus,
  Phone,
  Plug,
  Plus,
} from 'lucide-astro';
import {
  assetBase,
  faqs,
  featureCards,
  fullStackItems,
  platformColumns,
  pricingPlans,
  stats,
  trustLogos,
  workSteps,
} from '../data/canvassingApp';

const title = 'Canvassing App - Knockio';
const description =
  "Your canvassing app doesn't talk to your CRM. Knockio puts everything in one place, from the first knock to the collected payment.";
const iconMap = { Map, ChartLine, Boxes };
const currentYear = new Date().getFullYear();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://knockio.com/#organization',
      name: 'Knockio',
      url: 'https://knockio.com/',
      logo: 'https://knockio.com/assets/canvassing-app/knockio-logo.webp',
      sameAs: [
        'https://www.facebook.com/knockioapp',
        'https://www.linkedin.com/company/knockio',
        'https://x.com/knockioapp',
        'https://www.youtube.com/@knockioapp',
      ],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://knockio.com/canvassing-app/#software',
      name: 'Knockio Canvassing App',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web, iOS, Android',
      description,
      image: 'https://knockio.com/assets/canvassing-app/hero-img-new-1280.webp',
      brand: { '@id': 'https://knockio.com/#organization' },
      offers: pricingPlans.map((plan) => ({
        '@type': 'Offer',
        name: plan.title,
        price: plan.price.replace('$', ''),
        priceCurrency: 'USD',
        category: 'subscription',
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://knockio.com/canvassing-app/#faq',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://knockio.com/canvassing-app/#breadcrumb',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://knockio.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Canvassing App',
          item: 'https://knockio.com/canvassing-app/',
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={`${assetBase}/capterra.webp`}
  bodyClass="canvassing-page"
  jsonLd={jsonLd}
  noHeader
  noFooter
  preloadImages={[
    {
      href: `${assetBase}/hero-img-new-1280.webp`,
      imagesrcset: `${assetBase}/hero-img-new-480.webp 480w, ${assetBase}/hero-img-new-1280.webp 1280w`,
      imagesizes: '(max-width: 767px) 92vw, 56vw',
    },
    { href: `${assetBase}/green-name-1280.png` },
  ]}
>
  <main>
    <section class="canvassing-hero min-h-[92svh] py-8 md:py-12 xl:py-16">
      <div class="my-container grid min-h-[82svh] items-center gap-10 lg:grid-cols-[0.85fr_1.15fr]">
        <div class="reveal-up max-lg:text-center">
          <a href="/" aria-label="Knockio home" class="mb-8 inline-block">
            <img
              src={`${assetBase}/green-name-1280.png`}
              alt="Knockio"
              width="1280"
              height="193"
              class="h-auto w-56 sm:w-72 xl:w-80"
              decoding="async"
            />
          </a>

          <h1 class="max-w-3xl text-5xl font-extrabold leading-[1.02] tracking-normal text-slate-950 sm:text-6xl xl:text-7xl">
            The Canvassing App Built for Door to Door Teams
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-700 sm:text-xl max-lg:mx-auto">
            {description}
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row max-lg:justify-center">
            <a
              href="#landing-pricing"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-500 px-6 py-4 text-base font-bold text-white shadow-lg shadow-primary-500/25 transition hover:bg-primary-600 hover:shadow-primary-500/35"
            >
              Get Started
              <ArrowRight size={18} aria-hidden="true" />
            </a>
            <a
              href="#landing-calender"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-primary-500/25 bg-white px-6 py-4 text-base font-bold text-primary-700 shadow-lg shadow-slate-900/5 transition hover:border-primary-500 hover:text-primary-800"
            >
              Book a Free Demo
              <ArrowRight size={18} aria-hidden="true" />
            </a>
          </div>

          <ul class="mt-7 space-y-3 text-left text-slate-700 max-lg:mx-auto max-lg:max-w-xl">
            <li class="flex items-start gap-3">
              <CheckCircle2 class="mt-1 shrink-0 text-primary-500" size={20} aria-hidden="true" />
              <span>No contract. Cancel anytime or book a demo if you would like a walkthrough first.</span>
            </li>
          </ul>

          <div class="mt-7 flex flex-wrap gap-4 max-lg:justify-center">
            <a
              href="https://play.google.com/store/apps/details?id=com.knockio.crm&hl=en"
              target="_blank"
              rel="noopener"
              aria-label="Download Knockio on Google Play"
              class="transition hover:opacity-85"
            >
              <img src={`${assetBase}/google-play-button.webp`} alt="Get it on Google Play" width="520" height="154" class="h-auto w-36 xl:w-44" loading="eager" decoding="async" />
            </a>
            <a
              href="https://apps.apple.com/pk/app/knockio/id6756485440"
              target="_blank"
              rel="noopener"
              aria-label="Download Knockio on the App Store"
              class="transition hover:opacity-85"
            >
              <img src={`${assetBase}/apple-store-button.webp`} alt="Download on the App Store" width="520" height="154" class="h-auto w-36 xl:w-44" loading="eager" decoding="async" />
            </a>
          </div>
        </div>

        <div class="reveal-up" style="--reveal-delay: 120ms">
          <picture>
            <source srcset={`${assetBase}/hero-img-new-480.webp`} media="(max-width: 767px)" />
            <img
              src={`${assetBase}/hero-img-new-1280.webp`}
              alt="Knockio canvassing dashboard and mobile field app screens"
              width="1280"
              height="1077"
              fetchpriority="high"
              loading="eager"
              decoding="async"
              class="mx-auto h-auto w-full max-w-5xl"
            />
          </picture>
        </div>
      </div>
    </section>

    <section aria-labelledby="trusted-heading" class="border-y border-slate-100 bg-white py-10">
      <div class="my-container text-center">
        <h2 id="trusted-heading" class="text-base font-semibold text-slate-700">
          Trusted by 1,000+ field sales teams from Roofing and Solar to Pest Control, HVAC, and beyond.
        </h2>
        <div class="mt-7 flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
          {trustLogos.map((logo) => <img class="trust-logo" src={logo.src} alt={logo.alt} width="200" height="80" loading="lazy" decoding="async" />)}
        </div>
      </div>
    </section>

    <section class="bg-[#f7faf6] py-20 lg:py-28">
      <div class="my-container">
        <h2 class="section-heading">Why D2D Teams Choose Knockio?</h2>
        <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {stats.map(([value, label]) => (
            <article class="rounded-3xl border border-white bg-white p-8 shadow-sm">
              <p class="text-5xl font-extrabold text-primary-600">{value}</p>
              <p class="mt-4 text-lg leading-7 text-slate-700">{label}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 lg:py-28">
      <div class="my-container">
        <h2 class="section-heading">The Best Canvassing Software For Field Teams</h2>
        <div class="mt-14 grid gap-7 lg:grid-cols-2">
          {featureCards.map((feature) => (
            <article class="feature-card grid gap-6 p-6 sm:grid-cols-[0.45fr_0.55fr] sm:items-center lg:p-8">
              <img src={feature.image} alt="" width={feature.width} height={feature.height} class="h-auto w-full" loading="lazy" decoding="async" />
              <div>
                <h3 class="text-2xl font-bold text-slate-950">{feature.title}</h3>
                <p class="mt-4 text-base leading-8 text-slate-600">{feature.copy}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#0d2b0a] py-20 text-white lg:py-24">
      <div class="my-container text-center">
        <blockquote class="mx-auto max-w-5xl text-2xl font-semibold leading-10 sm:text-3xl sm:leading-[1.45]">
          "Tracking leads has never been simpler. We can see real time updates, assign follow-ups instantly, and never worry about losing information. The mapping feature is a game changer."
        </blockquote>
        <div class="mt-8 flex items-center justify-center gap-4">
          <img src={`${assetBase}/testimonial.png`} alt="" width="72" height="72" class="h-14 w-14 rounded-full" loading="lazy" decoding="async" />
          <div class="text-left">
            <p class="font-bold">Michael Palmer</p>
            <p class="text-sm text-white/65">Sales Manager - Modern Roofing</p>
          </div>
        </div>
        <a href="#landing-calender" class="mt-9 inline-flex items-center justify-center gap-2 rounded-xl bg-primary-500 px-7 py-4 font-bold text-white transition hover:bg-primary-600">
          Book a Free Demo
          <ArrowRight size={18} aria-hidden="true" />
        </a>
      </div>
    </section>

    <section class="bg-[#f7faf6] py-20 lg:py-28">
      <div class="my-container">
        <h2 class="section-heading">One Platform. The Full Door-to-Dollar Cycle</h2>
        <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {platformColumns.map((column) => (
            <article class="platform-card p-7">
              <h3 class="text-2xl font-extrabold">{column.title}</h3>
              <ul class="mt-6 space-y-4">
                {column.items.map((item) => (
                  <li class="flex gap-3 text-sm leading-6 text-white/90">
                    <Check class="mt-1 shrink-0" size={17} aria-hidden="true" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>

        <div class="mt-16 grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
          <div>
            <h3 class="max-w-3xl text-3xl font-extrabold leading-tight text-slate-950 md:text-4xl">
              Stop duct-taping tools together. Here is everything your field team needs in one place:
            </h3>
            <ul class="mt-8 grid gap-4 text-slate-700 md:grid-cols-2">
              {fullStackItems.map((item) => (
                <li class="flex gap-3">
                  <BadgeCheck class="mt-0.5 shrink-0 text-primary-500" size={20} aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <a href="#landing-calender" class="mt-9 inline-flex items-center justify-center gap-2 rounded-xl bg-primary-500 px-7 py-4 font-bold text-white transition hover:bg-primary-600">
              Book a Free Demo
              <ArrowRight size={18} aria-hidden="true" />
            </a>
          </div>
          <img src={`${assetBase}/platform-img.webp`} alt="Knockio platform workflow screen" width="759" height="520" class="mx-auto h-auto w-full max-w-2xl" loading="lazy" decoding="async" />
        </div>
      </div>
    </section>

    <section class="py-20 lg:py-28">
      <div class="my-container">
        <h2 class="section-heading">Switching to Knockio is easy</h2>
        <p class="section-copy">
          It is not one app you are replacing, it is the whole stack. Routing tool, canvassing app, photo chats, contracts, e-sign, and a CRM that was never built for the porch. Most teams come from all five, then wish they had switched sooner.
        </p>

        <div class="mt-14 space-y-8">
          {workSteps.map((step, index) => (
            <article class:list={['work-step grid items-center gap-8 p-5 md:grid-cols-2 lg:p-8', index % 2 === 1 && 'md:[&>img]:order-2']}>
              <img src={step.image} alt="" width={step.width} height={step.height} class="h-auto w-full rounded-2xl" loading="lazy" decoding="async" />
              <div class="p-2 lg:p-8">
                <p class="text-sm font-bold uppercase tracking-[0.18em] text-primary-600">Step {index + 1}</p>
                <h3 class="mt-3 text-3xl font-extrabold text-slate-950">{step.title}</h3>
                <p class="mt-4 text-lg leading-8 text-slate-600">{step.copy}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="landing-pricing" class="bg-white py-20 lg:py-28">
      <div class="my-container">
        <div class="text-center">
          <h2 class="section-heading">Straightforward Pricing. No Surprises</h2>
          <p class="section-copy">
            Start with the plan your team needs now. Add users as you grow. Volume discounts apply automatically at 5 users.
          </p>
          <div class="mt-8 inline-flex items-center gap-2 rounded-full border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-900">
            <CheckCircle2 size={18} class="text-primary-500" aria-hidden="true" />
            Pro-rated billing. No setup fee.
          </div>
        </div>

        <div class="mt-14 grid gap-8 lg:grid-cols-3">
          {pricingPlans.map((plan) => {
            const Icon = iconMap[plan.icon as keyof typeof iconMap];
            return (
              <article class:list={['pricing-card relative flex flex-col p-7 lg:p-8', plan.featured && 'is-featured']}>
                {plan.featured && <p class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full border border-white/20 bg-primary-500 px-8 py-1.5 text-sm font-bold text-white">Recommended</p>}
                <div class="flex items-center gap-4">
                  <Icon class={plan.featured ? 'text-primary-400' : 'text-primary-600'} size={27} aria-hidden="true" />
                  <h3 class:list={['text-3xl font-extrabold', plan.featured ? 'text-white' : 'text-slate-950']}>{plan.title}</h3>
                </div>
                <p class:list={['mt-5 min-h-24 text-base leading-7', plan.featured ? 'text-slate-300' : 'text-slate-600']}>{plan.description}</p>
                <p class:list={['mt-4 flex items-end text-5xl font-extrabold', plan.featured ? 'text-white' : 'text-slate-950']}>
                  {plan.price}
                  <span class:list={['ml-2 pb-1 text-base font-medium', plan.featured ? 'text-slate-400' : 'text-slate-500']}>/user/mo</span>
                </p>
                <p class:list={['mt-2 text-sm', plan.featured ? 'text-slate-400' : 'text-slate-500']}>{plan.discountNote}</p>
                <button
                  type="button"
                  data-checkout-package={plan.packageId}
                  class:list={[
                    'mt-7 w-full rounded-md px-5 py-3 font-bold transition',
                    plan.featured ? 'bg-primary-500 text-white hover:bg-primary-600' : 'border border-primary-500 bg-white text-primary-600 hover:bg-primary-500 hover:text-white',
                  ]}
                >
                  {plan.cta}
                </button>
                <h4 class:list={['mt-8 text-xl font-bold', plan.featured ? 'text-white' : 'text-slate-950']}>Features Included:</h4>
                <ul class="mt-5 flex-1 space-y-3.5">
                  {plan.features.map((feature) => (
                    <li class:list={['flex items-start gap-3 text-base leading-7', plan.featured ? 'text-slate-300' : 'text-slate-700']}>
                      {feature.includes('Engage') ? <Phone class="mt-1 shrink-0 text-primary-500" size={18} aria-hidden="true" /> : feature.includes('Zapier') ? <Plug class="mt-1 shrink-0 text-slate-400" size={18} aria-hidden="true" /> : <Check class="mt-1 shrink-0 text-primary-500" size={18} aria-hidden="true" />}
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="bg-[#f7faf6] py-20 lg:py-28">
      <div class="my-container">
        <h2 class="section-heading">See the Full Door-to-Dollar Cycle in Action</h2>
        <p class="section-copy">
          No pitch deck. No scripted walkthrough. No pressure. A live session built around your vertical and team size, so you can see exactly how it handles your workflow before you decide.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          {[
            [CalendarDays, 'Month to Month'],
            [FileSignature, 'No contract'],
            [CalendarX, 'Cancel anytime'],
          ].map(([Icon, label]) => (
            <div class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-bold text-slate-800 shadow-sm">
              <Icon size={18} class="text-primary-500" aria-hidden="true" />
              <span>{label}</span>
            </div>
          ))}
        </div>

        <div id="landing-calender" class="cal-shell mx-auto mt-12 max-w-5xl p-2 sm:p-3 lg:p-4">
          <div id="my-cal-inline" class="cal-placeholder grid place-items-center overflow-hidden" aria-live="polite">
            <div class="max-w-md p-6 text-center">
              <CalendarDays class="mx-auto text-primary-500" size={42} aria-hidden="true" />
              <p class="mt-4 text-xl font-extrabold text-slate-950">Loading the live demo calendar</p>
              <p class="mt-2 text-sm leading-6 text-slate-600">The scheduler loads only when you reach it, keeping the hero fast for PageSpeed and search visitors.</p>
              <button type="button" data-load-cal class="mt-5 rounded-xl bg-primary-500 px-5 py-3 text-sm font-bold text-white transition hover:bg-primary-600">
                Load calendar now
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 lg:py-28" aria-labelledby="faq-heading">
      <div class="my-container max-w-5xl">
        <p class="text-center text-sm font-bold uppercase tracking-[0.18em] text-primary-500 md:text-base">Common Questions</p>
        <h2 id="faq-heading" class="section-heading mt-3">Canvassing App FAQ</h2>
        <div class="mt-12 space-y-4">
          {faqs.map((faq, index) => (
            <details class="faq-item rounded-2xl border border-slate-200 bg-white transition" data-faq-item={faq.question} open={index === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-left sm:p-6">
                <span class="text-lg font-bold text-slate-950 sm:text-xl">{faq.question}</span>
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-primary-50 text-primary-600">
                  <Plus class="faq-plus" size={20} aria-hidden="true" />
                  <Minus class="faq-minus" size={20} aria-hidden="true" />
                </span>
              </summary>
              <div class="px-5 pb-6 text-base leading-8 text-slate-600 sm:px-6">{faq.answer}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="relative overflow-hidden border-t border-white/10 bg-[#0d2b0a]">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary-500/60 to-transparent"></div>
    <div class="my-container">
      <div class="flex flex-col items-center gap-4 py-10 text-center sm:py-12">
        <a href="/" aria-label="Knockio home">
          <img src={`${assetBase}/knockio-logo.webp`} alt="Knockio" width="320" height="96" class="h-9 w-auto object-contain" loading="lazy" decoding="async" />
        </a>
        <p class="max-w-md text-sm leading-6 text-white/55">
          Door-to-door sales software built for canvassing teams from the first knock to the paid invoice.
        </p>
        <a href="mailto:hello@knockio.com" class="text-sm font-bold text-white/75 transition hover:text-primary-300">hello@knockio.com</a>
      </div>

      <div class="flex flex-col items-center gap-5 border-t border-white/10 py-6 sm:flex-row sm:justify-between">
        <p class="order-2 text-xs text-white/45 sm:order-1 sm:text-sm">&copy; {currentYear} Knockio. All rights reserved.</p>

        <div class="order-1 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm sm:order-2">
          <a href="/privacy-policy/" class="text-white/70 transition hover:text-primary-300">Privacy Policy</a>
          <span class="text-white/25" aria-hidden="true">/</span>
          <a href="/terms-and-conditions/" class="text-white/70 transition hover:text-primary-300">Terms & Conditions</a>
        </div>

        <div class="order-3 flex items-center gap-2.5">
          {[
            ['https://www.facebook.com/knockioapp', 'Facebook', 'f'],
            ['https://www.linkedin.com/company/knockio', 'LinkedIn', 'in'],
            ['https://x.com/knockioapp', 'X', 'x'],
            ['https://www.youtube.com/@knockioapp', 'YouTube', 'yt'],
          ].map(([href, label, text]) => (
            <a href={href} aria-label={label} class="grid h-9 w-9 place-items-center rounded-full border border-white/15 text-xs font-bold uppercase text-white/70 transition hover:border-primary-500/50 hover:text-primary-300" target="_blank" rel="noopener">
              {text}
            </a>
          ))}
        </div>
      </div>
    </div>
  </footer>

  <script is:inline src={canvassingScript} defer></script>
</BaseLayout>
