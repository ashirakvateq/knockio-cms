---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/canvassing-app.css";
import canvassingScript from "../scripts/canvassing-app.js?url";
import calInlineScript from "../scripts/cal-inline.js?url";
import {
  ArrowRight,
  BadgeCheck,
  Boxes,
  CalendarDays,
  CalendarX,
  ChartLine,
  Check,
  CheckCircle2,
  FileSignature,
  Map,
  Minus,
  Phone,
  Plug,
  Plus,
} from "lucide-astro";
import {
  assetBase,
  faqs,
  featureCards,
  fullStackItems,
  platformColumns,
  pricingPlans,
  stats,
  trustLogos,
} from "../data/canvassingApp";

const title = "Canvassing App - Knockio";
const description =
  "Your canvassing app doesn't talk to your CRM. Knockio puts everything in one place, from the first knock to the collected payment.";
const iconMap = { Map, ChartLine, Boxes };
const currentYear = new Date().getFullYear();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://knockio.com/#organization",
      name: "Knockio",
      url: "https://knockio.com/",
      logo: "https://knockio.com/assets/canvassing-app/knockio-logo.webp",
      sameAs: [
        "https://www.facebook.com/knockioapp",
        "https://www.linkedin.com/company/knockio",
        "https://x.com/knockioapp",
        "https://www.youtube.com/@knockioapp",
      ],
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://knockio.com/canvassing-app/#software",
      name: "Knockio Canvassing App",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web, iOS, Android",
      description,
      image: "https://knockio.com/assets/canvassing-app/hero-img-new-1280.webp",
      brand: { "@id": "https://knockio.com/#organization" },
      offers: pricingPlans.map((plan) => ({
        "@type": "Offer",
        name: plan.title,
        price: plan.price.replace("$", ""),
        priceCurrency: "USD",
        category: "subscription",
      })),
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/canvassing-app/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://knockio.com/canvassing-app/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Canvassing App",
          item: "https://knockio.com/canvassing-app/",
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={`${assetBase}/capterra.webp`}
  bodyClass="canvassing-page"
  jsonLd={jsonLd}
  noHeader
  noFooter
  preloadImages={[
    {
      href: `${assetBase}/hero-img-new-1280.webp`,
      imagesrcset: `${assetBase}/hero-img-new-480.webp 480w, ${assetBase}/hero-img-new-1280.webp 1280w`,
      imagesizes: "(max-width: 767px) 92vw, 56vw",
    },
    { href: `${assetBase}/green-name-1280.png` },
  ]}
>
  <main>
    <section class="canvassing-hero pt-8 md:pt-12 xl:pt-16">
      <div
        class="my-container grid items-center gap-10 pt-[50px] lg:grid-cols-[0.85fr_1.15fr]"
      >
        <div class="reveal-up max-lg:text-center">
          <a
            href="/"
            aria-label="Knockio home"
            class="hero-logo mb-6 inline-block"
          >
            <img
              src={`${assetBase}/green-name-1280.png`}
              alt="Knockio"
              width="1280"
              height="193"
              decoding="async"
            />
          </a>

          <h1 class="hero-h1">
            The Canvassing<br /> App Built for <br />Door to Door Teams
          </h1>

          <p class="hero-subtitle">
            {description}
          </p>

          <div
            class="mt-8 flex flex-col gap-3 sm:flex-row max-lg:justify-center"
          >
            <a
              href="#landing-pricing"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-500 px-6 py-4 text-base font-bold text-white shadow-lg shadow-primary-500/25 transition hover:bg-primary-600 hover:shadow-primary-500/35"
            >
              Get Started
              <ArrowRight size={18} aria-hidden="true" />
            </a>
            <a
              href="#landing-calender"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-500 px-6 py-4 text-base font-bold text-white shadow-lg shadow-primary-500/25 transition hover:bg-primary-600 hover:shadow-primary-500/35"
            >
              Book a Free Demo
              <ArrowRight size={18} aria-hidden="true" />
            </a>
          </div>

          <ul
            class="hero-checklist mt-7 space-y-3 text-left max-lg:mx-auto max-lg:max-w-xl"
          >
            <li class="flex items-start gap-3">
              <CheckCircle2
                class="mt-1 shrink-0 text-primary-500"
                size={20}
                aria-hidden="true"
              />
              <span
                >No contract, Cancel anytime or book a demo if you'd like a
                walkthrough first.</span
              >
            </li>
          </ul>

          <div class="mt-7 flex flex-wrap gap-4 max-lg:justify-center">
            <a
              href="https://play.google.com/store/apps/details?id=com.knockio.crm&hl=en"
              target="_blank"
              rel="noopener"
              aria-label="Download Knockio on Google Play"
              class="shadow-md transition hover:opacity-90"
            >
              <img
                src={`${assetBase}/google-play-button.webp`}
                alt="Get it on Google Play"
                width="520"
                height="154"
                class="h-auto w-36 xl:w-44 lg:w-[145px]"
                loading="eager"
                decoding="async"
              />
            </a>
            <a
              href="https://apps.apple.com/pk/app/knockio/id6756485440"
              target="_blank"
              rel="noopener"
              aria-label="Download Knockio on the App Store"
              class="shadow-md transition hover:opacity-90"
            >
              <img
                src={`${assetBase}/apple-store-button.webp`}
                alt="Download on the App Store"
                width="520"
                height="154"
                class="h-auto w-36 xl:w-44 lg:w-[145px]"
                loading="eager"
                decoding="async"
              />
            </a>
          </div>
        </div>

        <div class="reveal-up hero-img-wrap" style="--reveal-delay: 120ms">
          <picture>
            <source
              srcset={`${assetBase}/hero-img-new-480.webp`}
              media="(max-width: 767px)"
            />
            <img
              src={`${assetBase}/hero-img-new-1280.webp`}
              alt="Knockio canvassing dashboard and mobile field app screens"
              width="1280"
              height="1077"
              fetchpriority="high"
              loading="eager"
              decoding="async"
              class="mx-auto h-auto w-full max-w-5xl"
            />
          </picture>
        </div>
      </div>
    </section>

    <section aria-labelledby="trusted-heading" class="trust-section">
      <div class="my-container text-center">
        <h2 id="trusted-heading">
          Trusted by 1,000+ field sales teams from Roofing and Solar to Pest
          Control, HVAC, and beyond.
        </h2>
        <div class="trust-logos">
          {
            trustLogos.map((logo) => (
              <img
                class="trust-logo"
                src={logo.src}
                alt={logo.alt}
                width="139"
                height="56"
                loading="lazy"
                decoding="async"
              />
            ))
          }
        </div>
      </div>
    </section>

    <section class="stats-section lg:py-36">
      <div class="my-container">
        <h2 class="section-heading">Why D2D Teams Choose Knockio?</h2>
        <div class="stats-row grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {
            stats.map(([value, label]) => (
              <article class="stat-blurb">
                <div>
                  <h4>
                    <span>{value}</span>
                  </h4>
                  <p>{label}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="features-section">
      <div class="my-container">
        <h2 class="section-heading">
          The Best Canvassing Software For Field Teams
        </h2>
        <div class="features-grid">
          {
            featureCards.map((feature) => (
              <article class="feature-card" data-aos="fade-up">
                <img
                  src={feature.image}
                  alt=""
                  width={feature.width}
                  height={feature.height}
                  class="feature-img"
                  loading="lazy"
                  decoding="async"
                />
                <h3 class="feature-heading">{feature.title}</h3>
                <p class="feature-desc">{feature.copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="testimonial-section py-20 lg:py-32">
      <div class="my-container">
        <div class="testimonial-quote-wrap">
          <p>
            Tracking leads has never been simpler. We can see real time updates,
            assign follow-ups instantly, and never worry about losing
            information. The mapping feature is a game changer it helps us plan
            routes smarter and cover more ground in less time.
          </p>
        </div>
        <div class="testi-wrapper mt-8">
          <img
            src={`${assetBase}/testi.png`}
            alt=""
            width="80"
            loading="lazy"
            decoding="async"
          />
          <div>
            <h6>Michael Palmer</h6>
            <p>Sales Manager - Modern Roofing</p>
          </div>
        </div>
        <div class="mt-9 flex justify-center">
          <a
            href="#landing-calender"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-500 px-7 py-4 font-bold text-white shadow-lg shadow-primary-500/25 transition hover:bg-primary-600 hover:shadow-primary-500/35"
          >
            Book a Free Demo
            <ArrowRight size={18} aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <section class="platform-section">
      <div class="my-container">
        <h2 class="section-heading">
          One Platform. The Full Door-to-Dollar Cycle
        </h2>
        <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {
            platformColumns.map((column) => (
              <div class="platform-wrapper">
                <span class="platform-wrapper-heading">{column.title}</span>
                <ul class="mb-5 space-y-3">
                  {column.items.map((item) => (
                    <li class="flex items-center gap-2.5">
                      <Check
                        class="mt-0.5 shrink-0 text-white"
                        size={17}
                        aria-hidden="true"
                      />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div class="mt-16 grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
          <div>
            <h3 class="platform-fullstack-heading">
              Stop duct-taping tools together. Here's everything your field team
              needs in one place:
            </h3>
            <ul class="platform-fullstack-list mt-8">
              {fullStackItems.map((item) => <li>{item}</li>)}
            </ul>
            <div class="my-10 table mx-auto">
              <a
                href="#landing-calender"
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-500 px-7 py-4 font-bold text-white shadow-lg shadow-primary-500/25 transition hover:bg-primary-600 hover:shadow-primary-500/35"
              >
                Book a Free Demo
                <ArrowRight size={18} aria-hidden="true" />
              </a>
            </div>
          </div>
          <img
            src={`${assetBase}/platform-img.webp`}
            alt="Knockio platform workflow screen"
            width="759"
            height="520"
            class="mx-auto h-auto w-full max-w-2xl"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="onboarding-section">
      <div class="container">
        <div class="editorial-header">
          <!-- Headline Column -->
          <div class="headline-column">
            <h2 class="main-headline">
              Switching<br />
              <span class="headline-sub">to Knockio is</span><br />
              <span class="headline-accent">Easy.</span>
            </h2>
          </div>

          <!-- Intro / Pull-Quote Column -->
          <div class="intro-column">
            <p class="pull-quote">
              It's not one app you are replacing, it is the whole stack. Routing
              tool. Canvassing app. Photo chats, contracts, and e-sign. A CRM
              that was never built for the porch. <br /><br />
              <span class="pull-quote-strong"
                >Most teams come from all five, then wish they had switched
                sooner.</span
              >
            </p>
          </div>
        </div>

        <div>
          <!-- Process Subhead -->
          <h3 class="process-subhead">Here's how it works</h3>

          <!-- 3-Column Grid for Steps -->
          <div class="steps-grid">
            <!-- Step 01 -->
            <div class="step-card">
              <div class="step-number">01</div>
              <h4 class="step-title">Guided Onboarding</h4>
              <p class="step-description">
                Most teams are running live campaigns within the hour. We walk
                you through territory setup, rep accounts, and your first
                campaign.
                <span class="step-description-highlight"
                  >No consultant needed.</span
                >
              </p>
            </div>

            <!-- Step 02 -->
            <div class="step-card">
              <div class="step-number">02</div>
              <h4 class="step-title">Import Your Data</h4>
              <p class="step-description">
                Bring over lead lists, pre-knocked address data, and customer
                records via CSV or direct migration. Your history doesn't
                disappear when you switch, and it
                <span class="step-italic">never</span> gets held hostage.
              </p>
            </div>

            <!-- Step 03 -->
            <div class="step-card">
              <div class="step-number">03</div>
              <h4 class="step-title">Handshake Support</h4>
              <p class="step-description">
                Direct access to the team, including the founder. No ticket
                queues, no offshore tiers, no chatbot. You talk to a real
                person.
                <span class="step-description-highlight"
                  >Most issues resolved same day.</span
                >
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <section id="landing-pricing" class="pricing-section">
    <div class="my-container max-w-[1330px] mx-auto">
      <div class="text-center gap-3 mb-12">
        <h2 class="section-heading">
          Straightforward Pricing<br /> No Surprises
        </h2>
        <p class="section-copy">
          Start with the plan your team needs now. Add users as you grow, volume
          discounts apply automatically at 5 users.
        </p>
        <div
          class="pricing-badge mt-8 inline-flex items-center gap-2 rounded-full border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-900"
        >
          <CheckCircle2 size={18} class="text-primary-500" aria-hidden="true" />
          <span>Pro-rated billing. No setup fee</span>
        </div>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-14 max-xl:gap-7 max-w-[1330px] mx-auto items-stretch"
      >
        {
          pricingPlans.map((plan) => {
            const Icon = iconMap[plan.icon as keyof typeof iconMap];
            return (
              <article
                class:list={[
                  "pricing-card relative flex flex-col",
                  plan.featured && "is-featured",
                ]}
              >
                {plan.featured && (
                  <p class="pricing-badge absolute -top-4 left-1/2 -translate-x-1/2 rounded-full border border-white/20 bg-primary-500 px-8 py-1.5 text-sm font-bold text-white">
                    Recommended
                  </p>
                )}
                <div class="pricing-header flex items-center gap-4">
                  <Icon
                    class={
                      plan.featured ? "text-primary-400" : "text-primary-600"
                    }
                    size={27}
                    aria-hidden="true"
                  />
                  <h3
                    class:list={[
                      "pricing-title text-3xl font-extrabold",
                      plan.featured ? "text-white" : "text-slate-950",
                    ]}
                  >
                    {plan.title}
                  </h3>
                </div>
                <p
                  class:list={[
                    "pricing-desc text-base leading-7",
                    plan.featured ? "text-slate-300" : "text-slate-600",
                  ]}
                >
                  {plan.description}
                </p>
                <p
                  class:list={[
                    "pricing-price flex items-end text-5xl font-extrabold",
                    plan.featured ? "text-white" : "text-slate-950",
                  ]}
                >
                  {plan.price}
                  <span
                    class:list={[
                      "pricing-unit ml-2 pb-1 text-base font-medium",
                      plan.featured ? "text-slate-400" : "text-slate-500",
                    ]}
                  >
                    /user/mo
                  </span>
                </p>
                <p
                  class:list={[
                    "pricing-discount text-sm",
                    plan.featured ? "text-slate-400" : "text-slate-500",
                  ]}
                >
                  {plan.discountNote}
                </p>
                <button
                  type="button"
                  data-checkout-package={plan.packageId}
                  class:list={[
                    "pricing-cta w-full rounded-md px-5 py-3 font-bold transition",
                    plan.featured
                      ? "bg-primary-500 text-white hover:bg-primary-600"
                      : "border border-primary-500 bg-white text-primary-600 hover:bg-primary-500 hover:text-white",
                  ]}
                >
                  {plan.cta}
                </button>
                <h4
                  class:list={[
                    "pricing-features-heading text-xl font-bold",
                    plan.featured ? "text-white" : "text-slate-950",
                  ]}
                >
                  Features Included:
                </h4>
                <ul class="pricing-features-list flex-1 space-y-3.5">
                  {plan.features.map((feature) => (
                    <li
                      class:list={[
                        "flex items-start gap-3 text-base leading-7",
                        plan.featured ? "text-slate-300" : "text-slate-700",
                      ]}
                    >
                      {feature.includes("Engage") ? (
                        <Phone
                          class="mt-1 shrink-0 text-primary-500"
                          size={18}
                          aria-hidden="true"
                        />
                      ) : feature.includes("Zapier") ? (
                        <Plug
                          class="mt-1 shrink-0 text-slate-400"
                          size={18}
                          aria-hidden="true"
                        />
                      ) : (
                        <Check
                          class="mt-1 shrink-0 text-primary-500"
                          size={18}
                          aria-hidden="true"
                        />
                      )}
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="calender-section py-24 lg:py-36">
    <div class="my-container">
      <h2 class="section-heading">
        See the Full Door-to-Dollar Cycle in Action
      </h2>
      <p class="section-copy">
        No pitch deck. No scripted walkthrough. No pressure. A live session
        built around your vertical and team size, so you can see exactly how it
        handles your workflow before you decide.
      </p>

      <div class="calender-wrapper mt-8">
        <div class="calender-wrapper-div">
          <CalendarDays size={28} class="text-[#74726C]" aria-hidden="true" />
          <span>Month to Month</span>
        </div>
        <div class="calender-wrapper-div">
          <FileSignature size={28} class="text-[#74726C]" aria-hidden="true" />
          <span>No contract</span>
        </div>
        <div class="calender-wrapper-div">
          <CalendarX size={28} class="text-[#74726C]" aria-hidden="true" />
          <span>Cancel anytime</span>
        </div>
      </div>

      <div
        id="landing-calender"
        class="cal-shell mx-auto mt-12 max-w-5xl p-2 sm:p-3 lg:p-4"
      >
        <div
          id="my-cal-inline"
          class="cal-placeholder grid place-items-center overflow-hidden"
          aria-live="polite"
        >
          <div class="max-w-md p-6 text-center">
            <CalendarDays
              class="mx-auto text-primary-500"
              size={42}
              aria-hidden="true"
            />
            <p class="mt-4 text-xl font-extrabold text-slate-950">
              Loading the live demo calendar
            </p>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              The scheduler loads only when you reach it, keeping the hero fast
              for PageSpeed and search visitors.
            </p>
            <button
              type="button"
              data-load-cal
              class="mt-5 rounded-xl bg-primary-500 px-5 py-3 text-sm font-bold text-white transition hover:bg-primary-600"
            >
              Load calendar now
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="faq-section py-24 lg:py-36" aria-labelledby="faq-heading">
    <div class="my-container">
      <p
        class="faq-heading-text text-center text-sm font-bold uppercase tracking-[0.18em] text-primary-500 md:text-2xl"
      >
        Common Questions
      </p>

      <div class="faq-container space-y-4">
        {
          faqs.map((faq, index) => (
            <details
              class="faq-item rounded-2xl border border-slate-200 bg-white transition"
              data-faq-item={faq.question}
              open={index === 0}
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-left sm:p-6">
                <span class="text-lg font-bold text-slate-950 sm:text-xl">
                  {faq.question}
                </span>
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-primary-50 text-primary-600">
                  <Plus class="faq-plus" size={20} aria-hidden="true" />
                  <Minus class="faq-minus" size={20} aria-hidden="true" />
                </span>
              </summary>
              <div class="px-5 pb-6 text-base leading-8 text-slate-600 sm:px-6">
                {faq.answer}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<footer class="relative overflow-hidden border-t border-white/10 bg-[#0d2b0a]">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary-500/60 to-transparent"
  >
  </div>
  <div class="my-container">
    <div class="flex flex-col items-center gap-4 py-10 text-center sm:py-12">
      <a href="/" aria-label="Knockio home">
        <img
          src={`${assetBase}/knockio-logo.webp`}
          alt="Knockio"
          width="320"
          height="96"
          class="mx-auto h-8 w-auto object-contain sm:h-9"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="max-w-md text-sm leading-6 text-white/50">
        Door-to-door sales software built for canvassing teams from the first
        knock to the paid invoice.
      </p>
      <a
        href="mailto:hello@knockio.com"
        class="text-sm font-medium text-white/70 transition hover:text-primary-400"
        >hello@knockio.com</a
      >
    </div>

    <div
      class="flex flex-col items-center gap-5 border-t border-white/10 py-6 sm:flex-row sm:justify-between"
    >
      <p class="order-2 text-xs text-white/45 sm:order-1 sm:text-sm">
        &copy; {currentYear} Knockio. All rights reserved.
      </p>

      <div
