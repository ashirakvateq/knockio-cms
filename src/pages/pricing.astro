---
import KnockioHomeLayout from "../layouts/KnockioHomeLayout.astro";
import PricingCalculator from "../components/PricingCalculator.astro";
import PricingPlans from "../components/PricingPlans.astro";
import "../styles/pricing.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Knockio Pricing",
  description:
    "Straightforward pricing for Knockio field sales and service platform. Plans from $20/user/month. No contracts, no setup fees.",
  url: "https://knockio.com/pricing/",
  isPartOf: { "@id": "https://knockio.com/#website" },
};
---

<KnockioHomeLayout
  title="Knockio Pricing | Field Sales & Service Plans from $20/mo"
  description="Straightforward pricing for Knockio. Prospect $20/mo, Organize $30/mo, Growth $45/mo. No contracts, no setup fees. Volume discounts at 5+ users."
  jsonLd={jsonLd}
  fAwsm={true}
>
  <!-- Hero -->
  <section class="pricing-hero relative flex min-h-[520px] items-center py-28 sm:py-32 lg:py-36">
    <div class="my-container relative z-10 mx-auto w-full">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="mb-6 font-inter text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl lg:text-[56px]">
          Knockio Pricing
        </h1>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <div class="inline-flex items-center gap-2 text-base font-semibold text-white sm:text-lg">
            <i class="fas fa-check text-sm text-primary-500"></i>
            <span>No contracts.</span>
          </div>
          <div class="inline-flex items-center gap-2 text-base font-semibold text-white sm:text-lg">
            <i class="fas fa-check text-sm text-primary-500"></i>
            <span>Prorated billing.</span>
          </div>
          <div class="inline-flex items-center gap-2 text-base font-semibold text-white sm:text-lg">
            <i class="fas fa-check text-sm text-primary-500"></i>
            <span>No setup fees.</span>
          </div>
        </div>
      </div>
    </div>
    <div class="pointer-events-none absolute bottom-0 left-0 right-0 h-[160px]" style="background: linear-gradient(to bottom, transparent 0%, rgba(255, 255, 255, 0.6) 50%, #fff 100%)"></div>
  </section>

  <!-- Pricing Plans -->
  <section id="pricing-plans" class="relative z-10 -mt-8 py-20 max-xl:py-16 max-lg:py-14">
    <div class="my-container">
      <div class="mb-10 text-center max-md:mb-7">
        <h2 class="mx-auto mb-4 max-w-3xl font-inter text-[56px] font-bold leading-tight text-neutral-900 max-2xl:text-5xl max-xl:text-4xl max-md:text-3xl">
          Straightforward pricing. No surprises.
        </h2>
        <p class="mx-auto max-w-2xl text-lg text-neutral-600 max-xl:text-base">
          Choose the tools your team needs today, or combine your entire field-sales and service operation in one connected platform.
        </p>
      </div>

      <div class="mb-12 flex flex-wrap items-center justify-center gap-3">
        <div class="flex items-center rounded-full border border-solid border-neutral-200 px-5 py-2.5 text-sm text-neutral-900">
          <i class="fas fa-check mr-2 text-primary-500"></i>
          <span>Pro-rated billing</span>
        </div>
        <div class="flex items-center rounded-full border border-solid border-neutral-200 px-5 py-2.5 text-sm text-neutral-900">
          <i class="fas fa-check mr-2 text-primary-500"></i>
          <span>No setup fee</span>
        </div>
        <div class="flex items-center rounded-full border border-solid border-neutral-200 px-5 py-2.5 text-sm text-neutral-900">
          <i class="fas fa-check mr-2 text-primary-500"></i>
          <span>No contracts</span>
        </div>
        <a href="#pricing-compare" class="flex items-center rounded-full border border-solid border-primary-200 px-5 py-2.5 text-sm font-medium text-primary-600 transition-colors hover:bg-primary-50">
          Compare plans in detail
          <i class="fa-solid fa-arrow-down ml-2 text-xs"></i>
        </a>
      </div>

      <PricingPlans variant="pricing" />
    </div>
  </section>

  <!-- Quick Estimate Calculator -->
  <PricingCalculator />

  <!-- Comparison Table -->
  <section id="pricing-compare" class="relative bg-white py-16 sm:py-20">
    <div class="my-container mx-auto max-w-[1500px] px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-primary-500">Full Feature Comparison</p>
        <h2 class="font-inter text-3xl font-bold text-neutral-950 sm:text-4xl">Compare plans in detail</h2>
        <p class="mx-auto mt-3 max-w-xl text-base leading-7 text-neutral-600">See which Knockio plan best matches your sales, service, and enterprise requirements.</p>
      </div>

      <!-- Desktop Table -->
      <div class="hidden overflow-x-auto rounded-[22px] border border-solid border-neutral-200 bg-white shadow-xl shadow-neutral-900/[0.04] lg:block">
        <table class="min-w-[1280px] w-full border-separate border-spacing-0 text-left">
          <thead>
            <tr>
              <th class="sticky z-30 w-[24%] rounded-tl-[22px] border-b border-r border-solid border-neutral-200 bg-white px-5 py-4 text-sm font-bold text-neutral-950 shadow-sm" style="top:0">Feature</th>
              <th class="sticky z-30 w-[19%] border-b border-r border-solid border-neutral-200 bg-white px-5 py-4 shadow-sm" style="top:0">
                <div class="flex items-center justify-between gap-3"><span class="text-sm font-bold text-neutral-950">Prospect</span><div class="text-right leading-tight"><span class="block text-base font-bold text-primary-600">$20/mo</span><span class="block text-xs font-medium text-neutral-500">5+ users</span></div></div>
              </th>
              <th class="sticky z-30 w-[19%] border-b border-r border-solid border-neutral-200 bg-[#f5faf3] px-5 py-4 shadow-sm" style="top:0">
                <div class="flex items-center justify-between gap-3"><div class="flex items-center gap-2"><span class="text-sm font-bold text-neutral-950">Growth</span><span class="rounded-full bg-primary-500 px-2 py-0.5 text-[10px] font-bold text-white">Popular</span></div><div class="text-right leading-tight"><span class="block text-base font-bold text-primary-600">$45/mo</span><span class="block text-xs font-medium text-neutral-500">5+ users</span></div></div>
              </th>
              <th class="sticky z-30 w-[19%] border-b border-r border-solid border-neutral-200 bg-white px-5 py-4 shadow-sm" style="top:0">
                <div class="flex items-center justify-between gap-3"><span class="text-sm font-bold text-neutral-950">Organize</span><div class="text-right leading-tight"><span class="block text-base font-bold text-primary-600">$30/mo</span><span class="block text-xs font-medium text-neutral-500">5+ users</span></div></div>
              </th>
              <th class="sticky z-30 w-[19%] rounded-tr-[22px] border-b border-solid border-neutral-200 bg-[#f5faf3] px-5 py-4 shadow-sm" style="top:0">
                <div class="flex items-center justify-between gap-3"><div><span class="block text-sm font-bold text-neutral-950">Scale</span><span class="block text-xs font-medium text-primary-600">100+ users</span></div><div class="text-right leading-tight"><span class="block text-sm font-bold text-primary-600">Custom</span></div></div>
              </th>
            </tr>
