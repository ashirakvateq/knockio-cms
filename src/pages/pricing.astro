  <!-- Tooltip Interaction Script -->
  <script is:inline>
    (function () {
      function closeTooltip(wrapper) {
        if (!wrapper) return;
        wrapper.classList.remove("is-open");
        var button = wrapper.querySelector(".kio-plan-info-button");
        var tooltip = wrapper.querySelector(".kio-plan-tooltip");
        var card = wrapper.closest(".kio-pricing-card");
        if (button) button.setAttribute("aria-expanded", "false");
        if (tooltip) tooltip.setAttribute("aria-hidden", "true");
        if (card) card.classList.remove("kio-tooltip-active");
      }
      function closeAllTooltips(except) {
        document.querySelectorAll(".kio-plan-info").forEach(function (wrapper) {
          if (wrapper !== except) closeTooltip(wrapper);
        });
      }
      document.addEventListener("click", function (event) {
        var button = event.target.closest(".kio-plan-info-button");
        if (button) {
          var wrapper = button.closest(".kio-plan-info");
          var tooltip = wrapper.querySelector(".kio-plan-tooltip");
          var card = wrapper.closest(".kio-pricing-card");
          var shouldOpen = !wrapper.classList.contains("is-open");
          closeAllTooltips(wrapper);
          wrapper.classList.toggle("is-open", shouldOpen);
          button.setAttribute("aria-expanded", shouldOpen ? "true" : "false");
          if (tooltip) tooltip.setAttribute("aria-hidden", shouldOpen ? "false" : "true");
          if (card) card.classList.toggle("kio-tooltip-active", shouldOpen);
          event.preventDefault();
          event.stopPropagation();
          return;
        }
        if (!event.target.closest(".kio-plan-tooltip")) closeAllTooltips();
      });
      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") closeAllTooltips();
      });
    })();
  </script>

