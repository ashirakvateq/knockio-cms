          <tbody>
            <tr class="compare-group-start"><td class="border-b border-solid border-neutral-200 bg-white px-5 pt-4 pb-2 text-sm font-bold text-neutral-950 border-r border-neutral-200">Field Sales</td><td class="border-b border-solid border-neutral-200 bg-white px-5 pt-4 pb-2 border-r border-neutral-200"></td><td class="border-b border-solid border-neutral-200 bg-[#f8fbf7] px-5 pt-4 pb-2 border-r border-neutral-200"></td><td class="border-b border-solid border-neutral-200 bg-white px-5 pt-4 pb-2 border-r border-neutral-200"></td><td class="border-b border-solid border-neutral-200 bg-[#f8fbf7] px-5 pt-4 pb-2"></td></tr>
            <tr><td class="border-b border-r border-solid border-neutral-200 px-5 py-3.5 text-sm font-medium text-neutral-900">Unlimited Territories &amp; Campaigns</td><td class="border-b border-r border-solid border-neutral-200 px-5 py-3.5 text-center"><span class="inline-flex items-center justify-center text-primary-500"><i class="fa-solid fa-check text-base"></i></span></td><td class="border-b border-r border-solid border-neutral-200 bg-primary-500/[0.025] px-5 py-3.5 text-center"><span class="inline-flex items-center justify-center text-primary-500"><i class="fa-solid fa-check text-base"></i></span></td><td class="border-b border-r border-solid border-neutral-200 px-5 py-3.5 text-center"><span class="inline-flex items-center justify-center text-neutral-300"><i class="fa-solid fa-minus text-base"></i></span></td><td class="border-b border-solid border-neutral-200 bg-primary-500/[0.025] px-5 py-3.5 text-center"><span class="inline-flex items-center justify-center text-primary-500"><i class="fa-solid fa-check text-base"></i></span></td></tr>
            <tr><td class="border-b border-r border-solid border-neutral-200 px-5 py-3.5 text-sm font-medium text-neutral-900">Route Planning &amp; Optimization</td><td class="border-b border-r border-solid border-neutral-200 px-5 py-3.5 text-center"><span class="inline-flex items-center justify-center text-primary-500"><i class="fa-solid fa-check text-base"></i></span></td><td class="border-b border-r border-solid border-neutral-200 bg-primary-500/[0.025] px-5 py-3.5 text-center"><span class="inline-flex items-center justify-center text-primary-500"><i class="fa-solid fa-check text-base"></i></span></td><td class="border-b border-r border-solid border-neutral-200 px-5 py-3.5 text-center"><span class="inline-flex items-center justify-center text-neutral-300"><i class="fa-solid fa-minus text-base"></i></span></td><td class="border-b border-solid border-neutral-200 bg-primary-500/[0.025] px-5 py-3.5 text-center"><span class="inline-flex items-center justify-center text-primary-500"><i class="fa-solid fa-check text-base"></i></span></td></tr>
            <tr><td class="border-b border-r border-solid border-neutral-200 px-5 py-3.5 text-sm font-medium text-neutral-900">Pre-Knocked Data (15¢ per address)</td><td class="border-b border-r border-solid border-neutral-200 px-5 py-3.5 text-center"><span class="inline-flex items-center justify-center text-primary-500"><i class="fa-solid fa-check text-base"></i></span></td><td class="border-b border-r border-solid border-neutral-200 bg-primary-500/[0.025] px-5 py-3.5 text-center"><span class="inline-flex items-center justify-center text-primary-500"><i class="fa-solid fa-check text-base"></i></span></td><td class="border-b border-r border-solid border-neutral-200 px-5 py-3.5 text-center"><span class="inline-flex items-center justify-center text-neutral-300"><i class="fa-solid fa-minus text-base"></i></span></td><td class="border-b border-solid border-neutral-200 bg-primary-500/[0.025] px-5 py-3.5 text-center"><span class="inline-flex items-center justify-center text-primary-500"><i class="fa-solid fa-check text-base"></i></span></td></tr>
            <tr><td class="border-b border-r border-solid border-neutral-200 px-5 py-3.5 text-sm font-medium text-neutral-900">Real-time Rep Tracking</td><td class="border-b border-r border-solid border-neutral-200 px-5 py-3.5 text-center"><span class="inline-flex items-center justify-center text-primary-500"><i class="fa-solid fa-check text-base"></i></span></td><td class="border-b border-r border-solid border-neutral-200 bg-primary-500/[0.025] px-5 py-3.5 text-center"><span class="inline-flex items-center justify-center text-primary-500"><i class="fa-solid fa-check text-base"></i></span></td><td class="border-b border-r border-solid border-neutral-200 px-5 py-3.5 text-center"><span class="inline-flex items-center justify-center text-neutral-300"><i class="fa-solid fa-minus text-base"></i></span></td><td class="border-b border-solid border-neutral-200 bg-primary-500/[0.025] px-5 py-3.5 text-center"><span class="inline-flex items-center justify-center text-primary-500"><i class="fa-solid fa-check text-base"></i></span></td></tr>
