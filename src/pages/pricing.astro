      mobileBody.innerHTML = groups.map(function (group) {
        return '<div class="rounded-2xl border border-solid border-neutral-200 bg-white shadow-sm"><div class="border-b border-solid border-neutral-200 bg-white px-4 py-4"><h3 class="text-base font-bold text-neutral-950">' + group.title + '</h3></div><div class="divide-y divide-neutral-200">' + group.rows.map(function (row) {
