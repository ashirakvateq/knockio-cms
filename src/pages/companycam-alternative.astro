---
import KnockioHomeLayout from "../layouts/KnockioHomeLayout.astro";
import "../styles/companycam-alternative.css";
import { Check, X, Quote, WandSparkles, Route } from "lucide-astro";

const title = "CompanyCam Alternative - CompanyCam Competitor - Knockio";
const description =
  "Knockio is the best CompanyCam alternative with affordable pricing, CRM, scheduling, dispatch, invoicing, and more features in one sales platform.";
const ogImage = "/assets/cfw/all-devices-view-knockio-1024x390.webp";

type CellValue = boolean | string;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://knockio.com/companycam-alternative/#webpage",
    url: "https://knockio.com/companycam-alternative/",
    name: title,
    description,
    isPartOf: {
      "@id": "https://knockio.com/#website",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": "https://knockio.com/companycam-alternative/#breadcrumb",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://knockio.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "CompanyCam Alternative",
        item: "https://knockio.com/companycam-alternative/",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "https://knockio.com/companycam-alternative/#faq",
    mainEntity: [
      {
        "@type": "Question",
        name: "Is Knockio a good alternative to CompanyCam?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. CompanyCam is excellent for photo documentation and image annotations, but Knockio is the stronger alternative for teams that need CRM, proposals, scheduling, dispatch, work orders, and invoicing in one platform.",
        },
      },
      {
        "@type": "Question",
        name: "What does CompanyCam do well?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "CompanyCam does well with photo documentation, image annotations, measurements, tags, reports, checklists, AI-generated notes, and progress visibility from the field to the office. Those are real strengths, especially for contractors focused on documenting work clearly.",
        },
      },
      {
        "@type": "Question",
        name: "Why would a team switch from CompanyCam to Knockio?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "A team would usually switch when it needs more than an image-first documentation tool. Knockio is better for businesses that want CRM, lead management, proposals, contracts, scheduling, dispatch, invoicing, and sales-to-service workflow in one system.",
        },
      },
      {
        "@type": "Question",
        name: "Is Knockio better for companies that need both sales and service workflows?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. Knockio is publicly positioned around both sales workflow and field service CRM workflow, which makes it more suitable for businesses that need lead tracking, job scheduling, dispatch, work orders, and billing connected together.",
        },
      },
      {
        "@type": "Question",
        name: "What makes Knockio a stronger alternative to CompanyCam?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Knockio is a stronger alternative to CompanyCam for teams that need more than job site photos. CompanyCam is stronger for annotations and photo documentation, but Knockio offers broader CRM and operational functionality that helps teams manage more of the business in one place.",
        },
      },
    ],
  },
];

const comparisonRows: {
  feature: string;
  knockio: CellValue;
  companycam: CellValue;
}[] = [
  {
    feature: "CRM and lead management",
    knockio: true,
    companycam: "Limited / Integration-led",
  },
  {
    feature: "Door to door sales workflow",
    knockio: true,
    companycam: "Integration-led",
  },
  {
    feature: "Pipeline and follow ups",
    knockio: true,
    companycam: "Integration-led",
  },
  {
    feature: "Route planning and territory workflow",
    knockio: true,
    companycam: false,
  },
  { feature: "Digital proposals and quoting", knockio: true, companycam: true },
  { feature: "E contracts and approvals", knockio: true, companycam: true },
  { feature: "Job scheduling and dispatch", knockio: true, companycam: false },
  {
    feature: "Work orders and technician workflow",
    knockio: true,
    companycam: false,
  },
  { feature: "Invoicing and billing workflow", knockio: true, companycam: true },
  { feature: "Sales to service handoff", knockio: true, companycam: false },
  {
    feature: "Field service CRM positioning",
    knockio: true,
    companycam: false,
  },
  {
    feature: "Photo documentation and progress reports",
    knockio: true,
    companycam: true,
  },
  { feature: "Prorated Billing", knockio: true, companycam: false },
  { feature: "Deep Financial Module", knockio: true, companycam: false },
  {
    feature: "Photo annotations and measurements",
    knockio: false,
    companycam: true,
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: "/assets/cfw/avatar-lacey-jackson.webp",
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: "/assets/cfw/avatar-ben-loveland.webp",
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: "/assets/cfw/avatar-bar-galanti.webp",
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: "/assets/cfw/avatar-georgia-hancocks.webp",
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: "/assets/cfw/avatar-sarah-bennett.webp",
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: "/assets/cfw/avatar-ayana-hall.webp",
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <main class="cca-page overflow-hidden bg-white">
    <!-- HERO -->
    <section class="cca-hero">
      <div class="my-container mx-auto">
        <div class="text-white">
          <h1
            class="mb-6 text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-[64px]"
          >
            CompanyCam Alternative
          </h1>

          <p
            class="mb-8 w-full max-w-[926px] text-sm font-normal leading-6 text-neutral-300 sm:text-base sm:leading-7 md:text-lg md:leading-8"
          >
            If your business needs more than photo capture and annotations,
            Knockio is the stronger CompanyCam alternative for managing leads,
            jobs, dispatch, and invoicing. Knockio offers much broader
            functionality with CRM, lead management, proposals, contracts,
            scheduling, dispatch, work orders, invoicing, and connected
            sales-to-service workflow in one platform. CompanyCam is excellent
            for photo documentation, image annotations, progress tracking,
            reports, and field-to-office updates.
          </p>

          <div class="flex flex-col gap-4 sm:flex-row">
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- G2 BADGES + COMPARISON -->
    <section class="overflow-hidden bg-white py-16 sm:py-20 lg:py-28">
      <div class="my-container mx-auto">
        <div
          class="mx-auto mb-14 grid max-w-[820px] grid-cols-2 items-center justify-center gap-5 sm:gap-7 lg:grid-cols-4"
        >
          <img
            src="/assets/cfw/g2-leader-badge-1.webp"
            alt="G2 Leader Badge"
            width="447"
            height="558"
            decoding="async"
            loading="eager"
            class="mx-auto h-auto w-full max-w-[118px] sm:max-w-[145px] lg:max-w-[170px]"
          />
          <img
            src="/assets/cfw/g2-high-performer-badge-1.webp"
            alt="G2 High Performer Badge"
            width="447"
            height="558"
            decoding="async"
            loading="eager"
            class="mx-auto h-auto w-full max-w-[118px] sm:max-w-[145px] lg:max-w-[170px]"
          />
          <img
            src="/assets/cfw/g2-best-support-badge-1.webp"
            alt="G2 Best Support Badge"
            width="447"
            height="558"
            decoding="async"
            loading="lazy"
            class="mx-auto h-auto w-full max-w-[118px] sm:max-w-[145px] lg:max-w-[170px]"
          />
          <img
            src="/assets/cfw/g2-best-roi-badge-1.webp"
            alt="G2 Best ROI Badge"
            width="447"
            height="558"
            decoding="async"
            loading="lazy"
            class="mx-auto h-auto w-full max-w-[118px] sm:max-w-[145px] lg:max-w-[170px]"
          />
        </div>

        <div class="mx-auto mb-8 max-w-[846px] text-center">
          <h2
            class="mb-3 text-3xl font-bold leading-tight text-neutral-950 sm:text-4xl lg:text-[42px] lg:leading-none xl:text-5xl 2xl:text-[56px]"
          >
            Knockio <span class="text-primary-500">vs</span> CompanyCam
          </h2>
          <p
            class="text-sm font-normal leading-6 text-neutral-600 sm:text-base sm:leading-7 md:text-lg md:leading-8"
          >
            Here we are comparing Knockio as an alternative to CompanyCam
          </p>
        </div>

        <!-- Desktop / Tablet Table -->
        <div class="mx-auto hidden max-w-[1180px] overflow-hidden rounded-t-2xl md:block">
          <table class="w-full border-collapse text-left">
            <thead>
              <tr class="bg-neutral-100 text-neutral-950">
                <th class="w-[58%] rounded-tl-2xl px-5 py-4 text-sm font-bold">
                  MAIN FEATURE COMPARISON
                </th>
                <th class="w-[21%] px-5 py-4 text-center text-sm font-bold">
                  Knockio
                </th>
                <th class="w-[21%] rounded-tr-2xl px-5 py-4 text-center text-sm font-bold">
                  CompanyCam
                </th>
              </tr>
            </thead>
            <tbody class="text-sm font-semibold text-neutral-950">
              {
                comparisonRows.map((row, index) => (
                  <tr class={index % 2 === 0 ? "bg-white" : "bg-primary-50"}>
                    <td class="px-5 py-3">{row.feature}</td>
                    <td class="px-5 py-3 text-center">
                      {typeof row.knockio === "string" ? (
                        row.knockio
                      ) : row.knockio ? (
                        <span class="cca-check text-xl" aria-label="Yes">
                          <Check aria-hidden="true" />
                        </span>
                      ) : (
                        <span class="cca-xmark text-xl" aria-label="No">
                          <X aria-hidden="true" />
                        </span>
                      )}
                    </td>
                    <td class="px-5 py-3 text-center">
                      {typeof row.companycam === "string" ? (
                        row.companycam
                      ) : row.companycam ? (
                        <span class="cca-check text-xl" aria-label="Yes">
                          <Check aria-hidden="true" />
                        </span>
                      ) : (
                        <span class="cca-xmark text-xl" aria-label="No">
                          <X aria-hidden="true" />
                        </span>
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <!-- Mobile Table Cards -->
        <div class="grid gap-3 md:hidden">
          <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-4">
            <div
              class="mb-3 grid grid-cols-[1fr_64px_64px] gap-3 text-xs font-bold text-neutral-950"
            >
              <span>MAIN FEATURE COMPARISON</span>
              <span class="text-center">Knockio</span>
              <span class="text-center">CompanyCam</span>
            </div>

            <div class="space-y-2 text-sm font-semibold text-neutral-950">
              {
                comparisonRows.map((row, index) => (
                  <div
                    class:list={[
                      "grid grid-cols-[1fr_64px_64px] gap-3 rounded-xl p-3",
                      index % 2 === 0 ? "bg-white" : "bg-primary-50",
                    ]}
                  >
                    <span>{row.feature}</span>
                    <span class="text-center">
                      {typeof row.knockio === "string" ? (
                        <span class="text-xs font-bold">{row.knockio}</span>
                      ) : row.knockio ? (
                        <span class="cca-check" aria-label="Yes">
                          <Check aria-hidden="true" />
                        </span>
                      ) : (
                        <span class="cca-xmark" aria-label="No">
                          <X aria-hidden="true" />
                        </span>
                      )}
                    </span>
                    <span class="text-center">
                      {typeof row.companycam === "string" ? (
                        <span class="text-xs font-bold">{row.companycam}</span>
                      ) : row.companycam ? (
                        <span class="cca-check" aria-label="Yes">
                          <Check aria-hidden="true" />
                        </span>
                      ) : (
                        <span class="cca-xmark" aria-label="No">
                          <X aria-hidden="true" />
                        </span>
                      )}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- DARK ROUTE SECTION -->
    <section class="cca-dark-band overflow-hidden py-14 sm:py-20 lg:py-28">
      <div class="my-container mx-auto">
        <div
          class="grid grid-cols-1 items-center gap-10 md:grid-cols-12 md:gap-8 xl:gap-0"
        >
          <div class="text-center md:col-span-7 md:text-left xl:col-span-7">
            <p
              class="mb-3 text-sm font-medium leading-7 text-primary-500 sm:text-base md:text-2xl font-inter"
            >
              CRM, Jobs &amp; Revenue Workflow
            </p>

            <h2
              class="mb-5 text-3xl font-bold leading-tight text-neutral-100 sm:text-4xl lg:text-[42px] lg:leading-none xl:text-5xl 2xl:text-[56px]"
            >
              Knockio: More Than a CompanyCam Competitor
            </h2>

            <p
              class="mx-auto mb-8 max-w-[760px] text-sm font-normal leading-6 text-neutral-200 sm:text-base sm:leading-7 md:mx-0 md:text-lg md:leading-8"
            >
              CompanyCam is built around photo documentation, project progress,
              team updates, AI-generated notes and reports, payments, and
              especially strong image annotation tools with arrows, circles,
              text, and measurements. Knockio, by contrast, is publicly
              positioned as a{" "}
              <a href="/" class="text-primary-500">door-to-door sales software</a>
              {" "}and field service CRM with lead tracking, territories,
              proposals, scheduling, dispatch, work orders, and invoicing. That
              makes CompanyCam the stronger image documentation tool, but Knockio
              the much broader operating system.
            </p>

            <div
              class="mx-auto grid max-w-[650px] grid-cols-1 gap-5 sm:gap-6 md:mx-0 md:gap-7"
            >
              <div
                class="flex items-start gap-4 rounded-2xl border border-neutral-200 p-5 text-left sm:gap-5 sm:p-6 md:border-0 md:bg-transparent md:p-0 lg:gap-6"
              >
                <span class="cca-feature-icon" aria-hidden="true">
                  <WandSparkles />
                </span>
                <div class="min-w-0">
                  <h3
                    class="mb-2 text-xl font-bold leading-tight text-white lg:text-2xl"
                  >
                    Start managing the full workflow
                  </h3>
                  <p
                    class="text-sm font-normal leading-6 text-white sm:text-base sm:leading-7"
                  >
                    Track leads, customer records, appointments, jobs, and
                    invoices in one place instead of relying on separate tools
                    for sales, operations, and billing.
                  </p>
                </div>
              </div>

              <div
                class="flex items-start gap-4 rounded-2xl border border-neutral-200 p-5 text-left sm:gap-5 sm:p-6 md:border-0 md:bg-transparent md:p-0 lg:gap-6"
              >
                <span class="cca-feature-icon" aria-hidden="true">
                  <Route />
                </span>
                <div class="min-w-0">
                  <h3
                    class="mb-2 text-xl font-bold leading-tight text-white lg:text-2xl"
                  >
                    Start turning visits into revenue
                  </h3>
                  <p
                    class="text-sm font-normal leading-6 text-white sm:text-base sm:leading-7"
                  >
                    Move from lead capture to proposal, contract, scheduling,
                    dispatch, and invoice with a workflow built for teams that
                    need more than photo tracking alone.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="flex justify-center md:col-span-5 xl:col-span-5">
            <img
              src="/assets/cfw/lead-detail-mobile-full.webp"
              alt="Lead Detail Mobile Screen"
              width="315"
              height="640"
              decoding="async"
              loading="lazy"
              class="h-auto w-full max-w-[220px] object-contain sm:max-w-[260px] md:max-w-[300px] lg:max-w-[330px] xl:max-w-[360px]"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- MOVE BEYOND -->
    <section class="overflow-hidden bg-white py-16 sm:py-20 lg:py-28">
      <div class="my-container mx-auto">
        <div
          class="grid grid-cols-1 items-center gap-10 md:grid-cols-12 md:gap-8 xl:gap-0"
        >
          <div
            class="order-2 flex justify-center md:order-1 md:col-span-5 md:justify-start xl:col-span-5"
          >
            <img
              src="/assets/cfw/route-midpoint-mobile-full.webp"
              alt="Midpoints Selection Mobile Screen"
              width="313"
              height="640"
              decoding="async"
              loading="lazy"
              class="h-auto w-full max-w-[220px] object-contain sm:max-w-[260px] md:max-w-[300px] lg:max-w-[330px] xl:max-w-[360px]"
            />
          </div>

          <div class="hidden md:order-2 md:col-span-1 md:block xl:col-span-1"></div>

          <div
            class="order-1 text-center md:order-3 md:col-span-6 md:text-left xl:col-span-6"
          >
            <p
              class="mb-3 text-sm font-medium leading-7 text-primary-500 sm:text-base md:text-2xl font-inter"
            >
              Photo Documentation vs Full Business Control
            </p>

            <h2
              class="mb-5 text-3xl font-bold leading-tight text-neutral-950 sm:text-4xl lg:text-[42px] lg:leading-none xl:text-5xl 2xl:text-[56px]"
            >
              Knockio Gives More Than{" "}
              <br class="hidden md:block" />
              Image Annotations
            </h2>

            <p
              class="mx-auto mb-8 max-w-[790px] text-sm font-normal leading-6 text-neutral-600 sm:text-base sm:leading-7 md:mx-0 md:text-lg md:leading-8"
            >
              CompanyCam clearly wins on image annotation depth. Its public
              materials strongly emphasize annotated photos, measurements, tags,
              searchable photo libraries, reports, checklists, and AI-generated
              updates built around job site documentation. But most contractors
              and field teams eventually need more than documented proof of work.
              Knockio becomes the better choice when the business needs CRM,
              customer timelines, quotes, contracts, route planning, scheduling,
              dispatch, invoicing, and connected operations in one platform.
            </p>

            <div
              class="mx-auto grid max-w-[650px] grid-cols-1 gap-5 sm:gap-6 md:mx-0 md:gap-7"
            >
              <div
                class="flex items-start gap-4 rounded-2xl border border-neutral-200 bg-white p-5 text-left sm:gap-5 sm:p-6 md:border-0 md:bg-transparent md:p-0 lg:gap-6"
              >
                <span class="cca-feature-icon" aria-hidden="true">
                  <WandSparkles />
                </span>
                <div class="min-w-0">
                  <h3
                    class="mb-2 text-xl font-bold leading-tight text-neutral-950 lg:text-2xl"
                  >
                    Start working with more control
                  </h3>
                  <p
                    class="text-sm font-normal leading-6 text-neutral-600 sm:text-base sm:leading-7"
                  >
                    Give managers one place to see leads, jobs, customer history,
                    schedules, work progress, and billing instead of piecing
                    together updates across multiple apps.
                  </p>
                </div>
              </div>

              <div
                class="flex items-start gap-4 rounded-2xl border border-neutral-200 bg-white p-5 text-left sm:gap-5 sm:p-6 md:border-0 md:bg-transparent md:p-0 lg:gap-6"
              >
                <span class="cca-feature-icon" aria-hidden="true">
                  <Route />
                </span>
                <div class="min-w-0">
                  <h3
                    class="mb-2 text-xl font-bold leading-tight text-neutral-950 lg:text-2xl"
                  >
                    Start scaling with fewer tools
                  </h3>
                  <p
                    class="text-sm font-normal leading-6 text-neutral-600 sm:text-base sm:leading-7"
                  >
                    Keep sales, service, scheduling, dispatch, invoices, and
                    customer records connected in one platform while using
                    dedicated photo apps only when truly needed.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-white py-16 sm:py-20 lg:py-24">
      <div class="my-container mx-auto">
        <div class="grid gap-10 lg:grid-cols-2 lg:gap-20">
          <div>
            <p class="mb-4 text-sm leading-7 text-primary-500 md:text-2xl font-inter">
              Common Questions
            </p>
            <h2
              class="mb-8 w-full max-w-xl text-3xl font-bold leading-tight text-neutral-950 sm:text-4xl lg:text-[42px] lg:leading-none xl:text-5xl 2xl:text-[56px]"
            >
              CompanyCam Alternative FAQs
            </h2>
          </div>

          <div class="space-y-4">
            <div
              class="faq-item overflow-hidden rounded-2xl border border-solid border-neutral-200 transition-all duration-300"
            >
              <button
                type="button"
                class="faq-button group flex w-full items-center justify-between p-4 text-left sm:p-6"
              >
                <span
                  class="text-base font-medium text-neutral-950 transition-colors group-hover:text-primary-500 sm:text-lg lg:text-xl"
                >
                  Is Knockio a good alternative to CompanyCam?
                </span>
                <div
                  class="faq-icon ml-4 flex h-6 w-6 flex-shrink-0 items-center justify-center text-primary-500"
                >
                  <svg
                    class="icon-minus hidden h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M20 12H4"></path>
                  </svg>
                  <svg
                    class="icon-plus h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 4v16m8-8H4"></path>
                  </svg>
                </div>
              </button>
              <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
                <div
                  class="p-4 pt-0 text-sm leading-relaxed text-neutral-600 sm:p-6 sm:pt-0 sm:text-base"
                >
                  Yes. CompanyCam is excellent for photo documentation and image
                  annotations, but Knockio is the stronger alternative for teams
                  that need CRM, proposals, scheduling, dispatch, work orders, and
                  invoicing in one platform.
                </div>
              </div>
            </div>

            <div
              class="faq-item overflow-hidden rounded-2xl border border-solid border-neutral-200 transition-all duration-300"
