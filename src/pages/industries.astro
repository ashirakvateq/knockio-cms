---
import KnockioHomeLayout from "../layouts/KnockioHomeLayout.astro";

const title = "Knockio by Industry: Software for 15 Home Service and Field Sales Trades";
const description = "See how Knockio fits your trade: roofing, solar, HVAC, plumbing, electrical, pest control, landscaping, restoration, and more. One platform from first knock to final payment.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://knockio.com/" },
      { "@type": "ListItem", position: 2, name: "Industries", item: "https://knockio.com/industries/" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Knockio Industries",
    numberOfItems: 15,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Fiber Internet", url: "https://knockio.com/industry/fiber-internet-sales-software-and-crm/" },
      { "@type": "ListItem", position: 2, name: "Electrical", url: "https://knockio.com/industry/electrical-contractor-software/" },
      { "@type": "ListItem", position: 3, name: "Home Security", url: "https://knockio.com/industry/home-security-sales-software-and-crm/" },
      { "@type": "ListItem", position: 4, name: "Pool Service", url: "https://knockio.com/industry/pool-service-software/" },
      { "@type": "ListItem", position: 5, name: "Junk Removal", url: "https://knockio.com/industry/junk-removal-software-and-crm/" },
      { "@type": "ListItem", position: 6, name: "Garage Door", url: "https://knockio.com/industry/garage-door-service-software/" },
      { "@type": "ListItem", position: 7, name: "Painting", url: "https://knockio.com/industry/painting-contractor-software-and-crm/" },
      { "@type": "ListItem", position: 8, name: "Window Cleaning", url: "https://knockio.com/industry/window-cleaning-business-software/" },
      { "@type": "ListItem", position: 9, name: "Landscaping", url: "https://knockio.com/industry/landscaping-business-software/" },
      { "@type": "ListItem", position: 10, name: "Restoration", url: "https://knockio.com/industry/restoration-job-management-software/" },
      { "@type": "ListItem", position: 11, name: "HVAC", url: "https://knockio.com/industry/hvac-software-and-crm/" },
      { "@type": "ListItem", position: 12, name: "Pest Control", url: "https://knockio.com/industry/pest-control-software/" },
      { "@type": "ListItem", position: 13, name: "Plumbing", url: "https://knockio.com/industry/plumbing-software-and-crm/" },
      { "@type": "ListItem", position: 14, name: "Roofing", url: "https://knockio.com/industry/roofing-sales-software-and-crm/" },
      { "@type": "ListItem", position: 15, name: "Solar", url: "https://knockio.com/industry/solar-sales-software-and-crm/" },
    ],
  },
];
---

<KnockioHomeLayout title={title} description={description} jsonLd={jsonLd}>
  <main>

    <section class="hero">
      <div class="wrap">
        <span class="kicker">Industries</span>
        <h1>Built for field sales and service businesses.</h1>
        <p class="lede">Knockio runs the whole job for fifteen home service and field sales trades. Pick your industry to see how the platform fits the way you sell, schedule, and get paid.</p>
        <div class="dir-grid">
          <a class="dir-card" href="https://knockio.com/industry/fiber-internet-sales-software-and-crm/">
            <span class="dir-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12a10 10 0 0 1 14 0"/><path d="M8 15a6 6 0 0 1 8 0"/><circle cx="12" cy="18" r="1.5"/></svg></span>
            <h2>Fiber Internet</h2>
            <p>Territory driven door to door sales software for fiber internet providers and their rep teams.</p>
            <span class="more">Learn more &rarr;</span>
          </a>
          <a class="dir-card" href="https://knockio.com/industry/electrical-contractor-software/">
            <span class="dir-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3v5M15 3v5"/><path d="M7 8h10v4a5 5 0 0 1-10 0V8z"/><path d="M12 17v4"/></svg></span>
            <h2>Electrical</h2>
            <p>Software for electrical contractors covering leads, scheduling, work orders, and invoicing.</p>
            <span class="more">Learn more &rarr;</span>
          </a>
          <a class="dir-card" href="https://knockio.com/industry/home-security-sales-software-and-crm/">
            <span class="dir-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg></span>
            <h2>Home Security</h2>
            <p>Sales and CRM software for home security teams selling door to door and managing installs.</p>
            <span class="more">Learn more &rarr;</span>
          </a>
          <a class="dir-card" href="https://knockio.com/industry/pool-service-software/">
            <span class="dir-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9c2 2 4 2 6 0s4-2 6 0 4 2 6 0"/><path d="M3 15c2 2 4 2 6 0s4-2 6 0 4 2 6 0"/></svg></span>
            <h2>Pool Service</h2>
            <p>Run pool service routes, jobs, and billing from one platform your techs actually use.</p>
            <span class="more">Learn more &rarr;</span>
          </a>
          <a class="dir-card" href="https://knockio.com/industry/junk-removal-software-and-crm/">
            <span class="dir-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V4h6v3"/><path d="M6 7l1 13h10l1-13"/><path d="M10 11v6M14 11v6"/></svg></span>
            <h2>Junk Removal</h2>
            <p>Booking, dispatch, and payment software for junk removal companies on the move.</p>
            <span class="more">Learn more &rarr;</span>
          </a>
          <a class="dir-card" href="https://knockio.com/industry/garage-door-service-software/">
            <span class="dir-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9 12 3l9 6"/><path d="M5 9v12h14V9"/><path d="M5 13h14M5 17h14"/></svg></span>
            <h2>Garage Door</h2>
            <p>Service software for garage door companies, from the first call to the finished repair.</p>
            <span class="more">Learn more &rarr;</span>
          </a>
          <a class="dir-card" href="https://knockio.com/industry/painting-contractor-software-and-crm/">
            <span class="dir-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="12" height="5" rx="1"/><path d="M16 6h4v4h-8v4"/><path d="M12 14v6"/></svg></span>
            <h2>Painting</h2>
            <p>CRM and job management for painting contractors, from estimate to final walkthrough.</p>
            <span class="more">Learn more &rarr;</span>
          </a>
          <a class="dir-card" href="https://knockio.com/industry/window-cleaning-business-software/">
            <span class="dir-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="1"/><path d="M12 4v16M4 12h16"/></svg></span>
            <h2>Window Cleaning</h2>
            <p>Scheduling, routes, and invoicing for window cleaning businesses of any size.</p>
            <span class="more">Learn more &rarr;</span>
          </a>
          <a class="dir-card" href="https://knockio.com/industry/landscaping-business-software/">
            <span class="dir-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/><path d="M5 19c3-4 6-7 10-9"/></svg></span>
            <h2>Landscaping</h2>
            <p>Manage landscaping crews, recurring jobs, and billing without the whiteboard.</p>
            <span class="more">Learn more &rarr;</span>
          </a>
          <a class="dir-card" href="https://knockio.com/industry/restoration-job-management-software/">
            <span class="dir-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5l2 2"/><path d="M20 4v5h-5"/><path d="M20 12a8 8 0 0 1-14 5l-2-2"/><path d="M4 20v-5h5"/></svg></span>
            <h2>Restoration</h2>
            <p>Job management software for restoration teams handling urgent, insurance driven work.</p>
            <span class="more">Learn more &rarr;</span>
          </a>
          <a class="dir-card" href="https://knockio.com/industry/hvac-software-and-crm/">
            <span class="dir-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h10a3 3 0 1 0-3-3"/><path d="M4 12h14a3 3 0 1 1-3 3"/><path d="M4 16h6"/></svg></span>
            <h2>HVAC</h2>
            <p>HVAC software and CRM covering booking, dispatch, timesheets, and one minute invoicing.</p>
            <span class="more">Learn more &rarr;</span>
          </a>
          <a class="dir-card" href="https://knockio.com/industry/pest-control-software/">
            <span class="dir-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="14" r="5"/><path d="M12 9V7M9 7l1.5 1.5M15 7l-1.5 1.5"/><path d="M4 14h3M17 14h3M6 19l2.5-2M18 19l-2.5-2"/></svg></span>
            <h2>Pest Control</h2>
            <p>Route based scheduling, recurring service plans, and payments for pest control operators.</p>
            <span class="more">Learn more &rarr;</span>
          </a>
          <a class="dir-card" href="https://knockio.com/industry/plumbing-software-and-crm/">
            <span class="dir-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3s6 7 6 11a6 6 0 0 1-12 0c0-4 6-11 6-11z"/></svg></span>
            <h2>Plumbing</h2>
            <p>Plumbing software and CRM that keeps dispatch, techs, and invoices in one system.</p>
            <span class="more">Learn more &rarr;</span>
          </a>
          <a class="dir-card" href="https://knockio.com/industry/roofing-sales-software-and-crm/">
            <span class="dir-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11 12 4l9 7"/><path d="M5 11v9h14v-9"/></svg></span>
            <h2>Roofing</h2>
            <p>Roofing sales software and CRM, from the first knock to production and final payment.</p>
            <span class="more">Learn more &rarr;</span>
          </a>
          <a class="dir-card" href="https://knockio.com/industry/solar-sales-software-and-crm/">
            <span class="dir-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/></svg></span>
            <h2>Solar</h2>
            <p>Solar sales software and CRM built for canvassing teams, proposals, and installs.</p>
            <span class="more">Learn more &rarr;</span>
          </a>
        </div>
        <div class="crossband">
          <div>
            <h2>Explore every Knockio feature</h2>
            <p>One platform, first knock to final payment. Everything works together because it was built together.</p>
          </div>
          <a class="btn btn-outline" href="/features/">Browse features</a>
        </div>
      </div>
    </section>

    <section class="cta">
      <h2>See it all working together.</h2>
      <p>A 20 minute demo with your real workflow on screen, from the first knock to the final payment.</p>
      <div class="cta-buttons">
        <a class="btn btn-green" href="https://knockio.com/book-a-demo/">Book a demo</a>
        <a class="btn btn-outline" href="https://knockio.com/pricing/">See pricing</a>
      </div>
    </section>
  </main>
</KnockioHomeLayout>
