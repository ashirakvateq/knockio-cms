        { "@type": "ListItem", position: 6, name: "Project video" },
        { "@type": "ListItem", position: 7, name: "Contracts" },
        { "@type": "ListItem", position: 8, name: "Permits" },
        { "@type": "ListItem", position: 9, name: "Inspection reports" },
      ],
    },
    {
      "@type": "BreadcrumbList",
      "@id":
        "https://knockio.com/features/photo-and-media-management/#breadcrumb",
