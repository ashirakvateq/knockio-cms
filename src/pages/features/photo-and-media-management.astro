---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/feature-page.css";
import {
  ArrowRight,
  Camera,
  ChevronDown,
  ChevronRight,
  Link2,
  Quote,
  RefreshCw,
  ShieldCheck,
  Users,
} from "lucide-astro";

const title = "Photo and Media Management Software | Knockio";
const description =
  "Capture, annotate, and organize job photos, videos, and documents in one record. See why field teams trust Knockio to keep every job visually documented.";

const asset = (name: string) => `/assets/cfw/${name}`;

const proposalGroups = [
  {
    key: "capture",
    title: "Capture Media However the Job Requires It",
    icon: "camera" as const,
    items: [
      {
        label: "Photos From the Job Site",
        title: "Photos From the Job Site",
        text: "Technicians and reps upload inspection photos, damage evidence, measurements, before-and-after shots, completion proof, and project video straight from the job site, no separate camera app required.",
        image: asset(
          "inner-photo-media-capture-photos-from-job-site.webp",
        ),
      },
      {
        label: "Built-In Photo Annotation",
        title: "Built-In Photo Annotation",
        text: "Draw, highlight, add arrows, and drop notes directly on an image to point out a problem area, a measurement, or a scope change without writing a paragraph to explain it.",
        image: asset(
          "inner-photo-media-capture-built-in-photo-annotation.webp",
        ),
      },
      {
        label: "Documents Alongside Photos",
        title: "Documents Alongside Photos",
        text: "Store contracts, permits, inspection reports, and other job files next to the photos and videos for that job, so nobody has to hunt through email to find one document.",
        image: asset(
          "inner-photo-media-capture-documents-alongside-photos.webp",
        ),
      },
    ],
  },
  {
    key: "connected",
    title: "Media Connected to Every Job Record",
    icon: "link" as const,
    items: [
      {
        label: "Files Tied to the Job",
        title: "Files Tied to the Job",
        text: "Every photo, video, and document lives inside the specific lead, customer, work order, or project it belongs to, instead of a shared folder someone has to sort through later.",
        image: asset(
          "inner-photo-media-connected-files-tied-to-job.webp",
        ),
      },
      {
        label: "One Job History",
        title: "One Job History",
        text: "Contracts, estimates, invoices, and service reports stay connected to the same job history as the media, so the full story of a job is in one place.",
        image: asset(
          "inner-photo-media-connected-one-job-history.webp",
        ),
      },
      {
        label: "Sharper Estimates and Inspections",
        title: "Sharper Estimates and Inspections",
        text: "Use marked-up images to support inspections, build more accurate estimates, and give crews clear work instructions before they ever step on site.",
        image: asset(
          "inner-photo-media-connected-sharper-estimates-and-inspections.webp",
        ),
      },
    ],
  },
  {
    key: "trail",
    title: "A Media Trail That Protects Your Business",
    icon: "shield" as const,
    items: [
      {
        label: "Instant Accountability",
        title: "Instant Accountability",
        text: "Every upload stamps and attaches to its job automatically, giving managers clear proof that field crews documented the work properly without chasing anyone for missing shots.",
        image: asset(
          "inner-photo-media-trail-instant-accountability.webp",
        ),
      },
      {
        label: "Faster Approvals",
        title: "Faster Approvals",
        text: "Paired before-and-after images hand customers, adjusters, and warranty reviewers the visual proof they need, so sign-offs and payments move ahead instead of stalling on requests.",
        image: asset(
          "inner-photo-media-trail-faster-approvals.webp",
        ),
      },
      {
        label: "Searchable for Years",
        title: "Searchable for Years",
        text: "When a customer questions the work or a claim needs backup, a dated, annotated photo history gives you something to point to.",
        image: asset(
          "inner-photo-media-trail-searchable-for-years.webp",
        ),
      },
    ],
  },
];

const initialItem = proposalGroups[0].items[0];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "Can field service businesses manage job photos, videos, and documents in one place?",
    a: "Yes. Knockio includes built-in media management that lets field teams upload photos, videos, and documents directly from the job site, mark up images with annotation tools, and keep every file attached to the correct lead, work order, or customer record. Nothing gets buried in a text thread or a personal camera roll, and nothing has to be re-uploaded into a separate storage tool.",
  },
  {
    q: "Does Knockio include photo and media management?",
    a: "Yes. Knockio has built-in media management that lets you upload, organize, and annotate photos, videos, and documents, with everything tied to the correct job record.",
  },
  {
    q: "Can technicians annotate photos directly on their phone?",
    a: "Yes. Field teams can draw, highlight, add arrows, and leave notes on photos from the mobile app while they're still on site.",
  },
  {
    q: "Are photos and documents connected to the job, or stored separately?",
    a: "They're connected. Every photo, video, and document attaches to the relevant lead, customer, work order, or project record instead of sitting in an unrelated folder or app.",
  },
  {
    q: "How does media management help with insurance claims or customer disputes?",
    a: "By keeping a dated, annotated photo and document history attached to each job, Knockio gives you a clear visual record to reference if an adjuster, a customer, or your own team needs proof of what happened and when.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const jsonLd = {
