---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/feature-page.css";
import {
  ArrowRight,
  Bell,
  Check,
  ChevronDown,
  ChevronRight,
  ClipboardList,
  DollarSign,
  FileSignature,
  FileText,
  ListChecks,
  Quote,
  RefreshCw,
} from "lucide-astro";

const title = "Sales Pipeline Software for Service Businesses | Knockio";
const description =
  "Visualize every lead and work order with sales pipeline software for service businesses. Build custom stages and separate boards by department.";

const asset = (name: string) => `/assets/cfw/${name}`;

const proposalGroups = [
  {
    key: "digital",
    title: "Build a Board That Matches How You Work",
    icon: "clipboard" as const,
    items: [
      {
        label: "Visual Clarity",
        title: "Custom Boards for Leads, Jobs, and Work Orders",
        text: "Create a board for sales and a separate board for work orders, so each team sees exactly what matters to them without digging through everything else.",
        image: asset(
          "inner-boards-build-a-board-that-matches-how-you-work-visual-clarity-new.webp",
        ),
      },
      {
        label: "Your Stages, Your Names",
        title: "Fully Customizable Pipeline Stages",
        text: "Name your stages whatever fits your business, whether that is New Lead, Estimate Sent, Approved, In Production, or anything else. Knockio does not force you into a template.",
        image: asset(
          "inner-boards-build-a-board-that-matches-how-you-work-your-stages-your-names.webp",
        ),
      },
      {
        label: "Unlimited Flexibility",
        title: "Create as Many Boards as You Need",
        text: "Run one simple board for a small operation or a dozen boards for different departments and crews. There is no cap on how you organize the work.",
        image: asset(
          "inner-boards-build-a-board-that-matches-how-you-work-unlimited-flexibility.webp",
        ),
      },
    ],
  },
  {
    key: "pricing",
    title: "Sort and Find What Matters Fast",
    icon: "dollar" as const,
    items: [
      {
        label: "Catch What Is Stalling",
        title: "Sort by Days in Stage",
        text: "Instantly spot the estimate that has been sitting untouched for two weeks or the job that has been stuck waiting on approval far too long.",
        image: asset(
          "inner-boards-sort-and-find-what-matters-fast-catch-what-is-stalling-new.webp",
        ),
      },
      {
        label: "Focus on the Big Wins",
        title: "Sort by Highest Value",
        text: "Put your biggest jobs at the top of the board so your sales team and project managers never lose sight of the work that matters most to revenue.",
        image: asset(
          "inner-boards-sort-and-find-what-matters-fast-focus-on-the-big-wins-new.webp",
        ),
      },
      {
        label: "See It Your Way",
        title: "Multiple Sorting and Filtering Options",
        text: "Filter and sort by rep, territory, status, or value so every person looking at the board sees exactly the slice of information they need.",
        image: asset(
          "inner-boards-sort-and-find-what-matters-fast-see-it-your-way.webp",
        ),
      },
    ],
  },
  {
    key: "tracking",
    title: "Boards That Work Like Departments",
    icon: "file" as const,
    items: [
      {
        label: "Controlled Access",
        title: "Assign Roles to Specific Boards",
        text: "Give your sales team access to the sales board and your production team access to the work order board, without either group seeing information that is not relevant to them.",
        image: asset(
          "inner-boards-boards-that-work-like-departments-controlled-access.webp",
        ),
      },
      {
        label: "Built In Security",
        title: "Only Assigned Roles Can View or Move Jobs",
        text: "Keep boards locked down so only the people who need to act on a job can move it through the pipeline.",
        image: asset(
          "inner-boards-boards-that-work-like-departments-built-in-security.webp",
        ),
      },
      {
        label: "Cross Department Handoffs",
        title: "Shared Statuses Move Jobs Between Boards Automatically",
        text: "When a status exists on more than one board, a job moves into the matching stage on the second board automatically, so sales and production can work the same job without manual handoffs.",
        image: asset(
          "inner-boards-boards-that-work-like-departments-cross-department-handoffs.webp",
        ),
      },
    ],
  },
  {
    key: "followup",
    title: "One Job, Tracked Everywhere It Needs to Be",
    icon: "bell" as const,
    items: [
      {
        label: "No Duplicate Data Entry",
        title: "A Single Job Record Across Every Board",
        text: "The job does not get copied or recreated when it moves to a new board. It is the same record, visible wherever it needs to be.",
        image: asset(
          "inner-boards-one-job-tracked-everywhere-it-needs-to-be-no-duplicate-data-entry.webp",
        ),
      },
      {
        label: "Full Visibility",
        title: "See History Across Every Stage and Board",
        text: "Look back at every stage a job passed through, on every board it touched, to understand exactly how long each part of the process actually took.",
        image: asset(
          "inner-boards-one-job-tracked-everywhere-it-needs-to-be-full-visibility.webp",
        ),
      },
      {
        label: "Connected to the Whole Platform",
        title: "Boards Tied to Estimates, Work Orders, and Financials",
        text: "Pipeline boards are not a separate tool bolted on. They connect directly to the same job data running through your estimates, invoices, and work orders.",
        image: asset(
          "inner-boards-one-job-tracked-everywhere-it-needs-to-be-connected-to-the-whole-platform.webp",
        ),
      },
    ],
  },
];

const initialItem = proposalGroups[0].items[0];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "Can I create more than one board?",
    a: "Yes. You can create unlimited boards for leads, jobs, work orders, or any other workflow your business needs to track separately.",
  },
  {
    q: "Can I sort jobs by how long they have been in a stage?",
    a: "Yes. Boards let you sort by days in stage, so you can quickly spot leads or jobs that have gone stale and need attention.",
  },
  {
    q: "Can I sort by job value?",
    a: "Yes. You can sort by highest value, helping your team prioritize the jobs that matter most to revenue first.",
  },
  {
    q: "Can I restrict who has access to a specific board?",
    a: "Yes. Boards can be treated like a department. Assign specific roles to a board so only those roles can view it and move jobs through it.",
  },
  {
    q: "What happens when a job's status exists on more than one board?",
    a: "If a status exists on multiple boards, the job automatically appears in the matching stage on every board where that status exists, letting two departments work the same job without manual re-entry.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://knockio.com/features/sales-pipeline-software/#webpage",
      url: "https://knockio.com/features/sales-pipeline-software/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      about: { "@id": "https://knockio.com/field-service-crm/#software" },
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://knockio.com/features/sales-pipeline-software/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Features",
          item: "https://knockio.com/features/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Sales Pipeline Software",
          item: "https://knockio.com/features/sales-pipeline-software/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/features/sales-pipeline-software/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};

const tabIconClass =
  "inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-primary-500 sm:h-10 sm:w-10";
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={asset("inner-boards-hero.webp")}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="sales-pipeline-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white pt-[72px]"
    >
      <div
        class="grid min-h-0 lg:min-h-[610px] lg:grid-cols-[50%_50%] xl:min-h-[720px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] py-12 sm:py-16 lg:min-h-[600px] lg:px-0 lg:py-0 lg:pb-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[32px] font-bold leading-[38px] text-neutral-950 sm:text-[38px] sm:leading-[44px] xl:text-[48px] xl:leading-[54px] 2xl:text-[56px] 2xl:leading-[60px]"
            >
              Sales Pipeline Software{" "}
              <br class="hidden sm:block" />
              for Service Businesses
            </h1>
            <p
              class="mb-10 max-w-[710px] text-base font-medium text-neutral-600 lg:text-lg"
            >
              If you have to ask three different people where a job stands, your
              pipeline is not working. Knockio gives you a board for leads and
              jobs, and a separate board for work orders, so you can see every
              stage at a glance. Sort by how long something has been sitting,
              sort by dollar value, and move a job forward with a single drag.
              No spreadsheet, no sticky notes, no guessing.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <h3
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              What is pipeline software for home service businesses and how does
              it work?
            </h3>
            <p
              class="max-w-[720px] text-[15px] leading-6 text-neutral-600 sm:text-base sm:leading-6"
            >
              Pipeline software for home service businesses organizes leads,
              jobs, and work orders into visual boards with custom stages, so
              you can see exactly where everything stands at a glance. Knockio
              lets you build unlimited boards, create your own stages, sort jobs
              by how long they have sat in a stage or by total value, and assign
              specific boards to specific roles or departments, so a job can
              move between two boards at once if the same status exists on both.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-feature-visual relative flex min-h-[320px] items-end justify-center overflow-hidden px-4 sm:min-h-[400px] lg:min-h-full lg:px-0"
        >
          <img
            src={asset("inner-boards-hero.webp")}
            alt="Sales pipeline software preview"
            width="801"
            height="637"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="relative z-10 w-[min(92%,720px)] max-w-[830px] object-contain object-bottom lg:-mb-3 lg:w-[min(92%,830px)] lg:animate-kio-float"
          />
        </div>
      </div>
    </section>

    <!-- ========== Everything You Need ========== -->
    <section
      class="relative overflow-hidden bg-white py-20 sm:py-24 lg:py-[130px]"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.35] [background-image:radial-gradient(#0f172a_0.7px,transparent_0.7px)] [background-size:18px_18px]"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-14 max-w-[900px] text-center lg:mb-16">
          <h2
            class="text-center text-[31px] font-bold leading-[39px] text-neutral-950 sm:text-4xl sm:leading-[44px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Everything You Need, <br class="hidden md:block" />
            Built Into One Platform
          </h2>
        </div>

        <div
          class="mx-auto grid max-w-[1450px] items-start gap-10 lg:grid-cols-[500px_minmax(0,1fr)] lg:gap-16 xl:grid-cols-[540px_minmax(0,1fr)] xl:gap-20"
        >
          <div class="grid w-full max-w-[540px] content-start gap-4">
            {
              proposalGroups.map((group, groupIndex) => (
                <div
                  class:list={[
                    "proposal-tab overflow-hidden rounded-2xl border border-solid border-[#e1e8de] bg-white shadow-sm transition-all duration-300 [&.is-active]:border-[#0f172a]",
                    groupIndex === 0 && "is-active",
                  ]}
                  data-tab={group.key}
                >
                  <button
                    class="proposal-tab-header flex w-full cursor-pointer items-center justify-between gap-4 rounded-2xl bg-white px-5 py-4 text-left text-[#0f172a] transition-all duration-300 [&[aria-expanded='true']]:rounded-b-none [&[aria-expanded='true']]:bg-[#0f172a] [&[aria-expanded='true']]:text-white sm:px-6 sm:py-5"
                    type="button"
                    aria-expanded={groupIndex === 0 ? "true" : "false"}
                  >
                    <span class="flex items-center gap-4">
                      <span class={tabIconClass}>
                        {group.icon === "clipboard" && (
                          <ClipboardList
                            class="size-[22px]"
                            aria-hidden="true"
                          />
                        )}
                        {group.icon === "dollar" && (
                          <DollarSign class="size-[22px]" aria-hidden="true" />
                        )}
                        {group.icon === "file" && (
                          <FileText class="size-[22px]" aria-hidden="true" />
                        )}
                        {group.icon === "bell" && (
                          <Bell class="size-[22px]" aria-hidden="true" />
                        )}
                      </span>
                      <span class="text-xl font-bold leading-7 sm:text-lg sm:leading-8">
                        {group.title}
                      </span>
                    </span>
                    <ChevronDown
                      class="proposal-chevron size-[18px] shrink-0"
                      aria-hidden="true"
                    />
                  </button>

                  <div class="proposal-panel">
                    <div class="grid gap-3 rounded-b-2xl border border-t-0 border-solid border-[#e1e8de] bg-white px-5 py-5 sm:px-6">
                      {group.items.map((item, itemIndex) => (
                        <button
                          class:list={[
                            "proposal-subitem grid w-full grid-cols-[24px_1fr] items-start gap-3 rounded-xl px-3 py-2.5 text-left text-base font-semibold leading-6 text-[#0f172a] transition-all duration-300 hover:bg-[#f2f8f0] sm:text-[18px] sm:leading-7 [&.is-active]:bg-primary-500 [&.is-active]:text-white",
                            groupIndex === 0 && itemIndex === 0 && "is-active",
                          ]}
                          type="button"
                          data-tab={group.key}
                          data-index={String(itemIndex)}
                          data-title={item.title}
                          data-text={item.text}
                          data-image={item.image}
                        >
                          <ArrowRight
                            class="mt-1 size-[17px]"
                            aria-hidden="true"
                          />
                          <span>{item.label}</span>
                        </button>
                      ))}
                    </div>
                  </div>
                </div>
              ))
            }
          </div>

          <div class="w-full self-start">
            <div
              id="proposalVisual"
              class="proposal-visual-card relative overflow-hidden"
            >
              <img
                id="proposalVisualImage"
                src={initialItem.image}
                alt={initialItem.title}
                width="714"
                height="386"
                decoding="async"
                loading="lazy"
                class="relative z-10 h-full w-full object-contain"
              />
            </div>
            <div class="mt-7 max-w-[760px]">
              <p
                id="proposalVisualTitle"
                class="mb-4 text-[24px] font-bold leading-8 text-[#0f172a] sm:text-[32px] sm:leading-[40px]"
              >
                {initialItem.title}
              </p>
              <p
                id="proposalVisualText"
                class="text-base font-normal leading-7 text-neutral-700 sm:text-lg sm:leading-8"
              >
                {initialItem.text}
              </p>
            </div>
          </div>
        </div>

        <div class="sr-only">
          {
            proposalGroups.map((group) => (
              <div>
                <h3>{group.title}</h3>
                <div>
                  {group.items.map((item) => (
                    <article>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </article>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ========== Trusted ========== -->
    <section
      class="relative overflow-hidden bg-[#0F172A] py-24 sm:py-28 lg:py-[150px]"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.22] [background-image:radial-gradient(rgba(255,255,255,0.65)_0.8px,transparent_0.8px)] [background-size:18px_18px]"
      >
      </div>
      <div
        class="pointer-events-none absolute top-16 left-1/2 h-[420px] w-[860px] -translate-x-1/2 rounded-full bg-primary-500/10 blur-3xl"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-16 max-w-[1040px] text-center lg:mb-20">
          <h2
            class="mb-6 text-center text-[31px] font-bold leading-[39px] text-white sm:text-4xl sm:leading-[44px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Trusted by 100&rsquo;s of customers
          </h2>
          <p
            class="mx-auto max-w-[800px] text-base leading-7 text-white/80 sm:text-lg sm:leading-8"
          >
            Join hundreds of growing teams using Knockio to manage leads, sales,
            field teams, and customer relationships.
          </p>
        </div>

        <div
          class="mx-auto grid max-w-[1120px] grid-cols-1 justify-items-center gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10"
        >
          {
            trustBadges.map((badge) => (
              <a
                href={badge.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={badge.label}
                class="group block rounded-3xl focus:ring-2 focus:ring-primary-500 focus:ring-offset-4 focus:ring-offset-[#0F172A] focus:outline-none"
              >
                <img
                  src={badge.src}
                  alt={badge.alt}
                  width="203"
                  height="280"
                  decoding="async"
                  loading="lazy"
                  class="w-full max-w-[200px] object-contain transition duration-300 group-hover:-translate-y-2 group-hover:drop-shadow-[0_24px_34px_rgba(255,255,255,0.12)]"
                />
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ========== Manage ========== -->
    <section
      class="relative overflow-hidden bg-white py-24 sm:py-28 lg:py-[150px]"
    >
      <div
        class="pointer-events-none absolute top-32 left-1/2 h-[420px] w-[900px] -translate-x-1/2 rounded-full bg-primary-500/5 blur-3xl"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-14 max-w-[1120px] text-center lg:mb-20">
          <h2
            class="mb-6 text-center text-[31px] font-bold leading-[39px] text-neutral-950 sm:text-4xl sm:leading-[44px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Manage Every Job From First Contact to Final Walkthrough
          </h2>
          <p
            class="mx-auto max-w-[800px] text-base leading-6 text-neutral-700 sm:text-lg sm:leading-6"
          >
            Knockio's boards connect directly to estimates, work orders,
            invoices, and payments, so a job moving across your pipeline is not
            just a card sliding across a screen. It is the real job, with real
            data, visible to whichever department needs to see it next.
          </p>
        </div>

