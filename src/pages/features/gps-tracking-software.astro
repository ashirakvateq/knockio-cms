---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/gps-tracking-software.css";
import {
  ArrowRight,
  Check,
  ChevronDown,
  ChevronRight,
  CircleCheck,
  Crosshair,
  FileSignature,
  History,
  ListChecks,
  MapPin,
  Quote,
  RefreshCw,
} from "lucide-astro";

const title = "GPS Tracking Software for Sales Reps & Dispatchers | Knockio";
const description =
  "GPS tracking software by Knockio shows live sales rep and dispatcher location, full movement history, and pin drop distance verification in the field.";

const asset = (name: string) => `/assets/cfw/${name}`;

const proposalGroups = [
  {
    key: "digital",
    title: "Built for Field-First Businesses",
    icon: "map" as const,
    items: [
      {
        label: "Connected to the Job",
        title: "GPS Tracking Connected to the Job",
        text: "See field activity in the same place as the job itself, so location history is not floating in a separate app disconnected from the work your team is doing.",
        image: asset(
          "inner-gps-tracking-built-for-field-first-businesses-connected-to-the-job.webp",
        ),
      },
      {
        label: "Customer Confidence",
        title: "Arrival Proof That Builds Trust",
        text: "Show customers when your rep or technician arrived, helping reduce disputes and giving them more confidence that your team is where they said they would be.",
        image: asset(
          "inner-gps-tracking-built-for-field-first-businesses-customer-confidence.webp",
        ),
      },
      {
        label: "Safety and Support",
        title: "Better Safety and Support in the Field",
        text: "Know where your team members are during the workday so managers can respond faster when someone needs help or something goes wrong in the field.",
        image: asset(
          "inner-gps-tracking-built-for-field-first-businesses-safety-and-support.webp",
        ),
      },
    ],
  },
  {
    key: "pricing",
    title: "Know Where Your Team Is Right Now",
    icon: "crosshair" as const,
    items: [
      {
        label: "Real-Time Visibility",
        title: "Live Map Visibility for Every Rep",
        text: "See where your field team is right now instead of waiting for end of day updates, making it easier to manage jobs as they happen.",
        image: asset(
          "inner-gps-tracking-know-where-your-team-is-right-now-real-time-visibility.webp",
        ),
      },
      {
        label: "Smarter Dispatch",
        title: "Smarter Dispatch Decisions",
        text: "Send the closest available rep to the next stop or urgent job instead of guessing who is nearby.",
        image: asset(
          "inner-gps-tracking-know-where-your-team-is-right-now-smarter-dispatch.webp",
        ),
      },
      {
        label: "Team Oversight",
        title: "Real Oversight Without Constant Check-Ins",
        text: "Managers can verify where people are and how routes are progressing without calling reps every hour for updates.",
        image: asset(
          "inner-gps-tracking-know-where-your-team-is-right-now-team-oversight.webp",
        ),
      },
    ],
  },
  {
    key: "tracking",
    title: "Understand the Full Day, Not Just a Snapshot",
    icon: "history" as const,
    items: [
      {
        label: "Complete Picture",
        title: "A Complete View of the Workday",
        text: "See the full route and movement history across the day, not just a single point on a map, so you understand what actually happened.",
        image: asset(
          "inner-gps-tracking-understand-the-full-day-not-just-a-snapshot-complete-picture.webp",
        ),
      },
      {
        label: "Operational Insight",
        title: "Operational Insight From Real Movement Data",
        text: "Identify route inefficiencies, unnecessary drive time, or missed coverage areas by reviewing how the day really played out.",
        image: asset(
          "inner-gps-tracking-understand-the-full-day-not-just-a-snapshot-operational-insight.webp",
        ),
      },
      {
        label: "Time Management",
        title: "Better Time Management Across the Team",
        text: "Compare travel time, time on site, and time between stops so you can make scheduling and staffing decisions with more confidence.",
        image: asset(
          "inner-gps-tracking-understand-the-full-day-not-just-a-snapshot-time-management.webp",
        ),
      },
    ],
  },
  {
    key: "followup",
    title: "Verify Field Activity, Not Just Claims",
    icon: "check" as const,
    items: [
      {
        label: "Accountability",
        title: "Accountability Based on Real Activity",
        text: "Verify field activity using actual location history instead of relying on memory or manual notes from the rep.",
        image: asset(
          "inner-gps-tracking-verify-field-activity-not-just-claims-accountability.webp",
        ),
      },
      {
        label: "Fair Performance Reviews",
        title: "Fairer Performance Reviews",
        text: "Use real route and activity data to review performance more fairly, separating effort and consistency from guesswork.",
        image: asset(
          "inner-gps-tracking-verify-field-activity-not-just-claims-fair-performance-reviews.webp",
        ),
      },
      {
        label: "Honest Reporting",
        title: "More Honest Reporting Across the Team",
        text: "GPS based records help create cleaner internal reporting, reducing inflated claims and making conversations about performance more objective.",
        image: asset(
          "inner-gps-tracking-verify-field-activity-not-just-claims-honest-reporting.webp",
        ),
      },
    ],
  },
];

const initialItem = proposalGroups[0].items[0];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "Can I see where my reps are in real time?",
    a: "Yes. Knockio's Live Tracking shows the current GPS location of every rep on a live map.",
  },
  {
    q: "Can I see where reps have been in the past?",
    a: "Yes. Knockio keeps a history of each rep's location and movement, so you can review past activity by day or time range.",
  },
  {
    q: "How does Knockio verify if a pin drop is legitimate?",
    a: "When a rep drops a pin for an activity like a knocked door, Knockio calculates the distance between the device's location and the property address at that time, helping you identify pins dropped far from the actual location.",
  },
  {
    q: "Is live tracking connected to jobs and leads?",
    a: "Yes. Location and pin drop data are tied to the relevant job or lead record, giving you full context alongside activity history.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://knockio.com/features/gps-tracking-software/#webpage",
      url: "https://knockio.com/features/gps-tracking-software/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      about: { "@id": "https://knockio.com/field-service-crm/#software" },
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://knockio.com/features/gps-tracking-software/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Features",
          item: "https://knockio.com/features/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "GPS Tracking Software",
          item: "https://knockio.com/features/gps-tracking-software/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/features/gps-tracking-software/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};

const tabIconClass =
  "inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-primary-500 sm:h-10 sm:w-10";
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={asset("inner-gps-tracking-hero.webp")}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="gps-tracking-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white pt-[72px]"
    >
      <div
        class="gps-tracking-hero grid min-h-0 lg:min-h-[610px] xl:min-h-[820px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] py-12 sm:py-16 lg:min-h-[600px] lg:px-0 lg:py-0 lg:pb-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[34px] font-bold leading-[42px] text-neutral-950 sm:text-[40px] sm:leading-[48px] xl:text-[52px] xl:leading-[60px] 2xl:text-[60px] 2xl:leading-[68px]"
            >
              GPS Tracking Software{" "}
              <br class="hidden sm:block" />
              for Field Staff
            </h1>
            <p
              class="mb-10 max-w-[710px] text-base font-medium text-neutral-600 lg:text-lg"
            >
              Knockio&rsquo;s GPS Tracking Software shows each rep&rsquo;s
              real-time location, full movement history, and pin drop distance,
              so you can verify real field visits. Know who is working, where
              they went, and which visits actually happened.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <h3
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              How does GPS tracking software verify if a field rep actually
              visited a property?
            </h3>
            <p
              class="max-w-[720px] text-[15px] leading-6 text-neutral-600 sm:text-base sm:leading-6"
            >
              Knockio&rsquo;s GPS tracking software calculates the distance
              between a rep&rsquo;s device location and the property address at
              the exact moment they log an activity, such as dropping a pin for
              a knocked door. This pin drop distance check flags activity logged
              far from the actual property, helping managers confirm field reps
              are working real locations rather than reporting activity from a
              vehicle or somewhere else entirely.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-estimate-visual relative flex min-h-[320px] items-end justify-center overflow-hidden px-4 sm:min-h-[400px] lg:min-h-full lg:px-0"
        >
          <img
            src={asset("inner-gps-tracking-hero.webp")}
            alt="GPS tracking software preview"
            width="830"
            height="560"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="relative z-10 w-[min(92%,720px)] max-w-[830px] object-contain object-bottom lg:-mb-3 lg:w-[min(92%,830px)] lg:animate-kio-float"
          />
        </div>
      </div>
    </section>

    <!-- ========== Everything You Need ========== -->
    <section
      class="relative overflow-hidden bg-white py-20 sm:py-24 lg:py-[130px]"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.35] [background-image:radial-gradient(#0f172a_0.7px,transparent_0.7px)] [background-size:18px_18px]"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-14 max-w-[900px] text-center lg:mb-16">
          <h2
            class="text-center text-[31px] font-bold leading-[39px] text-neutral-950 sm:text-4xl sm:leading-[44px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Everything You Need, <br class="hidden md:block" />
            Built Into One Platform
          </h2>
        </div>

        <div
          class="mx-auto grid max-w-[1450px] items-start gap-10 lg:grid-cols-[500px_minmax(0,1fr)] lg:gap-16 xl:grid-cols-[540px_minmax(0,1fr)] xl:gap-20"
        >
          <div class="grid w-full max-w-[540px] content-start gap-4">
            {
              proposalGroups.map((group, groupIndex) => (
                <div
                  class:list={[
                    "proposal-tab overflow-hidden rounded-2xl border border-solid border-[#e1e8de] bg-white shadow-sm transition-all duration-300 [&.is-active]:border-[#0f172a]",
                    groupIndex === 0 && "is-active",
                  ]}
                  data-tab={group.key}
                >
                  <button
                    class="proposal-tab-header flex w-full cursor-pointer items-center justify-between gap-4 rounded-2xl bg-white px-5 py-4 text-left text-[#0f172a] transition-all duration-300 [&[aria-expanded='true']]:rounded-b-none [&[aria-expanded='true']]:bg-[#0f172a] [&[aria-expanded='true']]:text-white sm:px-6 sm:py-5"
                    type="button"
                    aria-expanded={groupIndex === 0 ? "true" : "false"}
                  >
                    <span class="flex items-center gap-4">
                      <span class={tabIconClass}>
                        {group.icon === "map" && (
                          <MapPin class="size-[22px]" aria-hidden="true" />
                        )}
                        {group.icon === "crosshair" && (
                          <Crosshair class="size-[22px]" aria-hidden="true" />
                        )}
                        {group.icon === "history" && (
                          <History class="size-[22px]" aria-hidden="true" />
                        )}
                        {group.icon === "check" && (
                          <CircleCheck
                            class="size-[22px]"
                            aria-hidden="true"
                          />
                        )}
                      </span>
                      <span class="text-xl font-bold leading-7 sm:text-lg sm:leading-8">
                        {group.title}
                      </span>
                    </span>
                    <ChevronDown
                      class="proposal-chevron size-[18px] shrink-0"
                      aria-hidden="true"
                    />
                  </button>

                  <div class="proposal-panel">
                    <div class="grid gap-3 rounded-b-2xl border border-t-0 border-solid border-[#e1e8de] bg-white px-5 py-5 sm:px-6">
                      {group.items.map((item, itemIndex) => (
                        <button
                          class:list={[
                            "proposal-subitem grid w-full grid-cols-[24px_1fr] items-start gap-3 rounded-xl px-3 py-2.5 text-left text-base font-semibold leading-6 text-[#0f172a] transition-all duration-300 hover:bg-[#f2f8f0] sm:text-[18px] sm:leading-7 [&.is-active]:bg-primary-500 [&.is-active]:text-white",
                            groupIndex === 0 &&
                              itemIndex === 0 &&
                              "is-active",
                          ]}
                          type="button"
                          data-tab={group.key}
                          data-index={String(itemIndex)}
                          data-title={item.title}
                          data-text={item.text}
                          data-image={item.image}
                        >
                          <ArrowRight
                            class="mt-1 size-[17px]"
                            aria-hidden="true"
                          />
                          <span>{item.label}</span>
                        </button>
                      ))}
                    </div>
                  </div>
                </div>
              ))
            }
          </div>

          <div class="w-full self-start">
            <div
              id="proposalVisual"
              class="proposal-visual-card relative overflow-hidden"
            >
              <img
                id="proposalVisualImage"
                src={initialItem.image}
                alt={initialItem.title}
                width="714"
                height="386"
                decoding="async"
                loading="lazy"
                class="relative z-10 h-full w-full object-contain"
              />
            </div>
            <div class="mt-7 max-w-[760px]">
              <h3
                id="proposalVisualTitle"
                class="mb-4 text-[24px] font-bold leading-8 text-[#0f172a] sm:text-[32px] sm:leading-[40px]"
              >
                {initialItem.title}
              </h3>
              <p
                id="proposalVisualText"
                class="text-base font-normal leading-7 text-neutral-700 sm:text-lg sm:leading-8"
              >
                {initialItem.text}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== Trusted ========== -->
    <section
      class="relative overflow-hidden bg-[#0F172A] py-24 sm:py-28 lg:py-[150px]"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.22] [background-image:radial-gradient(rgba(255,255,255,0.65)_0.8px,transparent_0.8px)] [background-size:18px_18px]"
      >
      </div>
      <div
        class="pointer-events-none absolute top-16 left-1/2 h-[420px] w-[860px] -translate-x-1/2 rounded-full bg-primary-500/10 blur-3xl"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-16 max-w-[1040px] text-center lg:mb-20">
          <h2
            class="mb-6 text-center text-[31px] font-bold leading-[39px] text-white sm:text-4xl sm:leading-[44px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Trusted by 100&rsquo;s of customers
          </h2>
          <p
            class="mx-auto max-w-[800px] text-base leading-7 text-white/80 sm:text-lg sm:leading-8"
          >
            Join hundreds of growing teams using Knockio to manage leads, sales,
            field teams, and customer relationships.
          </p>
        </div>

        <div
          class="mx-auto grid max-w-[1120px] grid-cols-1 justify-items-center gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10"
        >
          {
            trustBadges.map((badge) => (
              <a
                href={badge.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={badge.label}
                class="group block rounded-3xl focus:ring-2 focus:ring-primary-500 focus:ring-offset-4 focus:ring-offset-[#0F172A] focus:outline-none"
              >
                <img
                  src={badge.src}
                  alt={badge.alt}
                  width="203"
                  height="280"
                  decoding="async"
                  loading="lazy"
                  class="w-full max-w-[200px] object-contain transition duration-300 group-hover:-translate-y-2 group-hover:drop-shadow-[0_24px_34px_rgba(255,255,255,0.12)]"
                />
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ========== Manage ========== -->
    <section
      class="relative overflow-hidden bg-white py-24 sm:py-28 lg:py-[150px]"
    >
      <div
        class="pointer-events-none absolute top-32 left-1/2 h-[420px] w-[900px] -translate-x-1/2 rounded-full bg-primary-500/5 blur-3xl"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-14 max-w-[1120px] text-center lg:mb-20">
          <h2
            class="mb-6 text-center text-[31px] font-bold leading-[39px] text-neutral-950 sm:text-4xl sm:leading-[44px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            <span class="lg:whitespace-nowrap"
              >Manage Field Operations With Confidence,</span
            >
            <br class="hidden lg:block" />
            Not Guesswork
          </h2>
          <p
            class="mx-auto max-w-[800px] text-base leading-6 text-neutral-700 sm:text-lg sm:leading-6"
          >
            From dispatching a same day HVAC repair to verifying a roofing
            canvasser&rsquo;s door knocking activity, Knockio&rsquo;s Live
            Tracking gives owners and managers the visibility they need to run
            an efficient, accountable field operation.
          </p>
        </div>

        <div class="mx-auto grid max-w-[1380px] gap-6 lg:grid-cols-3 lg:gap-8">
          <article
            class="group relative overflow-hidden rounded-[28px] border border-solid border-neutral-200 bg-white p-7 shadow-[0_18px_50px_rgba(15,23,42,0.05)] transition-all duration-300 hover:-translate-y-1 hover:border-primary-500/40 hover:shadow-[0_28px_70px_rgba(15,23,42,0.09)] sm:p-8 lg:p-9"
          >
            <div
              class="absolute top-0 right-0 h-32 w-32 translate-x-10 -translate-y-10 rounded-full bg-primary-500/10"
            >
            </div>
            <div class="relative mb-8 flex items-start justify-between gap-5">
              <div
                class="flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-500/10 text-primary-500 transition-all duration-300 group-hover:bg-primary-500 group-hover:text-white"
              >
