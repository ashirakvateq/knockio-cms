        {
          "@type": "ListItem",
          position: 5,
          name: "Recurring service stops",
        },
        { "@type": "ListItem", position: 6, name: "Maintenance visits" },
        { "@type": "ListItem", position: 7, name: "Work orders" },
      ],
    },
    {
      "@type": "BreadcrumbList",
      "@id":
        "https://knockio.com/features/route-planning-and-dispatching/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Features",
          item: "https://knockio.com/features/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Route Planning and Dispatching",
          item: "https://knockio.com/features/route-planning-and-dispatching/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/features/route-planning-and-dispatching/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
