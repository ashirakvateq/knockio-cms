---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/feature-page.css";
import {
  ArrowRight,
  Check,
  ChevronDown,
  ChevronRight,
  LayoutDashboard,
  Link2,
  ListChecks,
  Map,
  Quote,
  TrendingUp,
  Users,
} from "lucide-astro";

const title = "Route Planning and Dispatching Software | Knockio";
const description =
  "Build routes, assign crews, and dispatch the right technician from one screen. See why field service teams stop juggling maps, calendars, and CRMs with Knockio.";

const asset = (name: string) => `/assets/cfw/${name}`;

const proposalGroups = [
  {
    key: "planning",
    title: "Plan the Day Without Switching Tools",
    icon: "map" as const,
    items: [
      {
        label: "Daily Routes",
        title: "Daily Routes",
        text: "Build routes for leads, customers, inspections, jobs, and recurring service stops in one view, instead of piecing together a plan across a map app and a spreadsheet.",
        image: asset(
          "inner-route-planning-plan-the-day-daily-routes.webp",
        ),
      },
      {
        label: "Assigned Stop Details",
        title: "Assigned Stop Details",
        text: "Reps and crews see each stop's customer information, visit status, notes, and photos alongside the next action expected of them, so nobody arrives without context.",
        image: asset(
          "inner-route-planning-plan-the-day-assigned-stop-details.webp",
        ),
      },
      {
        label: "Recurring Stops",
        title: "Recurring Stops",
        text: "Set up routes for repeat service visits so maintenance and inspection stops do not need to be rebuilt from scratch every cycle.",
        image: asset(
          "inner-route-planning-plan-the-day-recurring-stops.webp",
        ),
      },
    ],
  },
  {
    key: "dispatch",
    title: "Dispatch the Right Person, Fast",
    icon: "users" as const,
    items: [
      {
        label: "Job Scheduling",
        title: "Job Scheduling",
        text: "Office teams schedule jobs and assign technicians or crews from the same screen where the route was built, cutting out the back-and-forth between calendar and dispatch board.",
        image: asset(
          "inner-route-planning-dispatch-job-scheduling.webp",
        ),
      },
      {
        label: "Skill-Based Assignment",
        title: "Skill-Based Assignment",
        text: "Dispatch based on who is qualified, available, and positioned to take the job, rather than guessing from memory who is free.",
        image: asset(
          "inner-route-planning-dispatch-skill-based-assignment.webp",
        ),
      },
      {
        label: "Live Reassignment",
        title: "Live Reassignment",
        text: "When a job changes or a technician/crew runs long, dispatch a different crew without rebuilding the route or losing the job's history.",
        image: asset(
          "inner-route-planning-dispatch-live-reassignment.webp",
        ),
      },
    ],
  },
  {
    key: "records",
    title: "Keep Everyone on the Same Record",
    icon: "link" as const,
    items: [
      {
        label: "Connected Job History",
        title: "Connected Job History",
        text: "Route activity, visit status, and dispatch decisions stay tied to the customer and job record, so a stop completed in the field updates the same file the office is looking at.",
        image: asset(
          "inner-route-planning-records-connected-job-history.webp",
        ),
      },
      {
        label: "Route Progress Visibility",
        title: "Route Progress Visibility",
        text: "Managers see which stops are done, which are in progress, and which still need attention, without calling the field for an update.",
        image: asset(
          "inner-route-planning-records-route-progress-visibility.webp",
        ),
      },
      {
        label: "Fewer Missed Stops",
        title: "Fewer Missed Stops",
        text: "Because routing, scheduling, and dispatch share one system, conflicting assignments, duplicate visits, and forgotten stops are easier to catch before they cost a day.",
        image: asset(
          "inner-route-planning-records-fewer-missed-stops.webp",
        ),
      },
    ],
  },
];

const initialItem = proposalGroups[0].items[0];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "Can Knockio plan routes and dispatch crews on the same platform as the CRM?",
    a: "Yes. Knockio lets office staff build daily routes for leads, jobs, inspections, and recurring service stops, then dispatch technicians or crews without leaving the platform. Because routing and dispatch pull from the same customer and job records used across sales and service, a reassignment does not require re-entering information in a separate mapping or calendar tool.",
  },
  {
    q: "Does Knockio handle both route planning and dispatching, or are they separate tools?",
    a: "Both live in the same platform. Office teams build the route and assign technicians or crews from the same screen, without exporting data to a separate dispatch tool.",
  },
  {
    q: "Can I build routes for recurring service visits, not just one-time jobs?",
    a: "Yes. Routes can include recurring stops for repeat service, maintenance, or inspection visits alongside one-time jobs and leads.",
  },
  {
    q: "What can technicians and crews see when they're out on their route?",
    a: "They can view each stop's customer information, visit status, notes, and photos, along with the next action expected at that stop.",
  },
  {
    q: "What happens if I need to reassign a job mid-day?",
    a: "Dispatch can reassign a job to a different technician or crew without rebuilding the route, and the job's history stays connected to the customer record.",
  },
  {
    q: "Do route and dispatch activities connect to the rest of the customer record?",
    a: "Yes. Route activity and dispatch decisions stay tied to the customer and job record used across the platform, so office staff and field teams are working from the same information.",
  },
  {
    q: "What is route planning and dispatching software?",
    a: "Route planning and dispatching tool helps field businesses organize where teams need to go and who should handle each stop. It also keeps the information needed to complete the visit close to the work. Route planning arranges leads, customers, inspections, jobs, and repeat service stops. Dispatching assigns those stops to a representative, technician, or crew and keeps the schedule visible to the office and field. Knockio connects both parts of the workflow. Each stop can stay tied to its lead, customer, appointment, job, or work order, so the route carries more than an address.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const jsonLd = {
