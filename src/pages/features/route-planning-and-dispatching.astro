  "@graph": [
    {
      "@type": "WebPage",
      "@id":
        "https://knockio.com/features/route-planning-and-dispatching/#webpage",
      url: "https://knockio.com/features/route-planning-and-dispatching/",
      name: "Route Planning and Dispatching Software | Knockio",
      headline: "Route Planning and Dispatching That Runs From One Screen",
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      about: { "@id": "https://knockio.com/#software" },
      mainEntity: { "@id": "https://knockio.com/#software" },
      mainContentOfPage: {
        "@type": "WebPageElement",
        name: "Route Planning and Dispatching That Runs From One Screen",
        text: "Your crews are scattered across town, the calendar lives in one app, the map lives in another, and every reassignment means a phone call to whoever is closest to the next stop. Knockio puts route planning and dispatching inside the same platform as your leads, jobs, and customer records, so building a route and assigning the right person to it does not mean switching tools.",
      },
      hasPart: [
        {
          "@type": "WebPageElement",
          name: "Quick Answer: Can Knockio plan routes and dispatch crews on the same platform as the CRM?",
          text: "Yes. Knockio lets office staff build daily routes for leads, jobs, inspections, and recurring service stops, then dispatch technicians or crews without leaving the platform. Because routing and dispatch pull from the same customer and job records used across sales and service, a reassignment does not require re-entering information in a separate mapping or calendar tool.",
        },
        {
          "@type": "WebPageElement",
          name: "Plan the Day Without Switching Tools",
          hasPart: [
            {
              "@type": "WebPageElement",
              name: "Daily Routes",
              text: "Build routes for leads, customers, inspections, jobs, and recurring service stops in one view, instead of piecing together a plan across a map app and a spreadsheet.",
            },
            {
              "@type": "WebPageElement",
              name: "Assigned Stop Details",
              text: "Reps and crews see each stop's customer information, visit status, notes, and photos alongside the next action expected of them, so nobody arrives without context.",
            },
            {
              "@type": "WebPageElement",
              name: "Recurring Stops",
              text: "Set up routes for repeat service visits so maintenance and inspection stops do not need to be rebuilt from scratch every cycle.",
            },
          ],
        },
        {
          "@type": "WebPageElement",
          name: "Dispatch the Right Person, Fast",
          hasPart: [
            {
              "@type": "WebPageElement",
              name: "Job Scheduling",
              text: "Office teams schedule jobs and assign technicians or crews from the same screen where the route was built, cutting out the back-and-forth between calendar and dispatch board.",
            },
            {
              "@type": "WebPageElement",
              name: "Skill-Based Assignment",
              text: "Dispatch based on who is qualified, available, and positioned to take the job, rather than guessing from memory who is free.",
            },
            {
              "@type": "WebPageElement",
              name: "Live Reassignment",
              text: "When a job changes or a technician/crew runs long, dispatch a different crew without rebuilding the route or losing the job's history.",
            },
          ],
        },
        {
          "@type": "WebPageElement",
          name: "Keep Everyone on the Same Record",
          hasPart: [
            {
              "@type": "WebPageElement",
              name: "Connected Job History",
              text: "Route activity, visit status, and dispatch decisions stay tied to the customer and job record, so a stop completed in the field updates the same file the office is looking at.",
            },
            {
              "@type": "WebPageElement",
              name: "Route Progress Visibility",
              text: "Managers see which stops are done, which are in progress, and which still need attention, without calling the field for an update.",
            },
            {
              "@type": "WebPageElement",
              name: "Fewer Missed Stops",
              text: "Because routing, scheduling, and dispatch share one system, conflicting assignments, duplicate visits, and forgotten stops are easier to catch before they cost a day.",
            },
          ],
        },
        {
          "@type": "WebPageElement",
          name: "Why Route Planning and Dispatching Belong in One Platform",
          text: "Field service delays rarely come from a bad route. They come from the gap between the route, the calendar, and whoever is deciding who goes where. When those three things live in separate tools, a single change, a cancellation, a sick technician, or a job that runs long means someone has to manually update a map, a calendar, and a CRM, in that order, before the next crew even knows their day changed.",
          hasPart: [
            {
              "@type": "WebPageElement",
              name: "One Screen for Planning and Dispatch",
              text: "Building the route and assigning the work happen in the same place, so office staff are not exporting a route plan into a separate dispatch board.",
            },
            {
              "@type": "WebPageElement",
              name: "Field Teams See the Full Picture",
              text: "Technicians and reps view their stops alongside the customer's history, prior notes, and photos, cutting down on calls back to the office just to get context on a job.",
            },
            {
              "@type": "WebPageElement",
              name: "Managers Track the Day in Real Time",
              text: "Route progress updates as stops are completed, giving managers a current view of coverage and delays instead of waiting for end-of-day recaps.",
            },
          ],
        },
      ],
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://knockio.com/#software",
      name: "Knockio",
      applicationCategory: "BusinessApplication",
      applicationSubCategory: "Route planning and dispatching software",
      operatingSystem: "Web, iOS, Android",
      description:
        "Knockio lets office staff build daily routes for leads, jobs, inspections, and recurring service stops, then dispatch technicians or crews without leaving the platform, with routing and dispatch pulling from the same customer and job records used across sales and service.",
      featureList: [
        "Build daily routes for leads, customers, inspections, jobs, and recurring service stops in one view",
        "Show reps and crews each stop's customer information, visit status, notes, and photos alongside the next expected action",
        "Set up routes for repeat service, maintenance, and inspection visits without rebuilding them each cycle",
        "Schedule jobs and assign technicians or crews from the same screen where the route was built",
        "Skill-based assignment by who is qualified, available, and positioned to take the job",
        "Live reassignment to a different crew without rebuilding the route or losing the job's history",
        "Keep route activity, visit status, and dispatch decisions tied to the customer and job record",
        "Route progress visibility showing which stops are done, in progress, or still need attention",
        "Catch conflicting assignments, duplicate visits, and forgotten stops before they cost a day",
      ],
    },
    {
      "@type": "DefinedTerm",
      "@id":
        "https://knockio.com/features/route-planning-and-dispatching/#definition",
      name: "Route planning and dispatching software",
