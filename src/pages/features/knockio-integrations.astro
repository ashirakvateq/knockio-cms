---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/feature-page.css";
import {
  ArrowRight,
  Briefcase,
  Calendar,
  ChevronDown,
  ChevronRight,
  Database,
  Layers,
  Link2,
  Quote,
  TrendingUp,
  Zap,
} from "lucide-astro";

const title = "Knockio Integrations: Connect Your CRM and Field Apps";
const description =
  "Knockio integrations connect GoHighLevel, Salesforce, HubSpot, and QuickBooks, plus thousands of apps via Flow Chef and Zapier. One record, no retyping.";

const asset = (name: string) => `/assets/cfw/${name}`;

const proposalGroups = [
  {
    key: "crm",
    title: "Connect the CRM Your Team Already Uses",
    icon: "link" as const,
    items: [
      {
        label: "GoHighLevel Integration",
        title: "GoHighLevel Integration",
        text: "Leads from your funnels and ad forms land in Knockio, ready to route and knock. What happened at the door flows back, so marketing sees which ads paid for real jobs.",
        image: asset("inner-integrations-crm-gohighlevel.webp"),
      },
      {
        label: "Salesforce Integration",
        title: "Salesforce Integration",
        text: "Keep Salesforce as the book of record for sales while Knockio runs the field. No more weekly export before a closed deal turns into a booked crew.",
        image: asset("inner-integrations-crm-salesforce.webp"),
      },
      {
        label: "HubSpot Integration",
        title: "HubSpot Integration",
        text: "Contacts and deal stages move both ways. That counts most on the day a rep marks a deal won and the service side needs the address, notes, and scope inside the hour.",
        image: asset("inner-integrations-crm-hubspot.webp"),
      },
    ],
  },
  {
    key: "calendar",
    title: "Keep Calendars, Email, and Files Together",
    icon: "calendar" as const,
    items: [
      {
        label: "Calendar Integration",
        title: "Calendar Integration",
        text: "Visits booked in Knockio show up on the calendar your team opens all day. Dispatch and the tech stop reading two schedules, which is where most double bookings start.",
        image: asset("inner-integrations-calendar-sync.webp"),
      },
      {
        label: "Google Workspace Integration",
        title: "Google Workspace Integration",
        text: "Sync Gmail, Calendar, Drive, and Contacts. Emails thread onto the right job, and shared files stop hiding in one person's inbox.",
        image: asset("inner-integrations-google-workspace.webp"),
      },
      {
        label: "Microsoft 365 Integration",
        title: "Microsoft 365 Integration",
        text: "Outlook mail, contacts, and files hook up the same way. Your office staff keeps working in the tools they know while the job record stays current behind them.",
        image: asset("inner-integrations-microsoft-365.webp"),
      },
    ],
  },
  {
    key: "automation",
    title: "Connect Thousands of Apps Through Flow Chef and Zapier",
    icon: "zap" as const,
    items: [
      {
        label: "Zapier Integration",
        title: "Zapier Integration",
        text: "Zapier ties Knockio to thousands of apps: web forms, sheets, Slack, books, review sites, lead markets. A new lead posts to a channel, and a closed job asks the homeowner for a review. Nobody writes code.",
        image: asset("inner-integrations-zapier.webp"),
      },
      {
        label: "Flow Chef Integration",
        title: "Flow Chef Integration",
        text: "Flow Chef reaches thousands of apps too, and it costs less than Zapier for the same work. When your automations fire hundreds of times a month, that gap on the bill adds up fast.",
        image: asset("inner-integrations-flow-chef.webp"),
      },
      {
        label: "API Support",
        title: "API Support",
        text: "Some crews run custom software or a parts system nobody else has heard of. Your dev builds a direct link. You bend the tool to fit your shop, not the reverse.",
        image: asset("inner-integrations-api-support.webp"),
      },
    ],
  },
  {
    key: "job",
    title: "Connect the Tools That Touch the Job Itself",
    icon: "briefcase" as const,
    items: [
      {
        label: "EagleView Integration",
        title: "EagleView Integration",
        text: "Pull roof reports and property measures into quotes and job records. A roof price then rests on measured square footage, not a guess from the driveway.",
        image: asset("inner-integrations-eagleview.webp"),
      },
      {
        label: "QuickBooks Integration",
        title: "QuickBooks Integration",
        text: "Sync invoices, payments, and billing through Zapier today, with native support on the way. Your bookkeeper stops rebuilding bills that already exist in Knockio.",
        image: asset("inner-integrations-quickbooks.webp"),
      },
      {
        label: "Job Workflow Sync",
        title: "Job Workflow Sync",
        text: "Schedules, crew updates, and service records move out to the tools your team uses. A change in the field travels on its own. No follow-up text needed.",
        image: asset("inner-integrations-job-workflow-sync.webp"),
      },
    ],
  },
];

const initialItem = proposalGroups[0].items[0];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "What does Knockio integrate with?",
    a: "Knockio links to GoHighLevel, Salesforce, HubSpot, Google Calendar, Google Workspace, Microsoft 365, EagleView, and QuickBooks. It also reaches thousands more apps through Flow Chef and Zapier, or straight through API support. Most teams hook up three or four outside tools. Not a dozen.",
  },
  {
    q: "How many apps can Knockio connect to?",
    a: "Thousands, through Flow Chef and Zapier. That covers forms, sheets, chat, reports, books, and most of the tools your office runs today.",
  },
  {
    q: "Does Knockio have an API?",
    a: "Yes. Knockio supports API links for custom workflows, in-house dashboards, and company software that never shows up in a connector list.",
  },
  {
    q: "Can I sync invoices and payments with QuickBooks?",
    a: "Yes, through Zapier. A Zap moves invoices, payments, and customer billing between Knockio and QuickBooks, so your books stay current without hand entry.",
  },
  {
    q: "Do I need integrations to use Knockio?",
    a: "No. Canvassing, booking, dispatch, quotes, work orders, and payments all run inside Knockio on their own. Integrations are just for the tools you would rather not give up.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

