---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/feature-page.css";
import {
  ArrowRight,
  Check,
  ChevronDown,
  ChevronRight,
  FileSignature,
  FileText,
  FolderOpen,
  Quote,
  RefreshCw,
  Shield,
  Zap,
} from "lucide-astro";

const title = "E-Contracts Software for Field Business";
const description =
  "A handshake and a verbal yes don't hold up when a customer changes their mind halfway through a job. Knockio's native e-contracts let you send legally binding agreements for signature in minutes — generated straight from an approved estimate.";

const asset = (name: string) => `/assets/cfw/${name}`;

const proposalGroups = [
  {
    key: "digital",
    title: "Send and Sign Without the Paperwork",
    icon: "signature" as const,
    items: [
      {
        label: "Generate from an estimate",
        title: "Turn an approved estimate into a contract in seconds",
        text: "Turn an approved estimate into a contract in seconds, with pricing and scope already filled in.",
        image: asset(
          "inner-e-contract-send-and-sign-without-the-paperwork-built-in-not-bolted-on.webp",
        ),
      },
      {
        label: "Send from the job",
        title: "Deliver the agreement for e-signature without leaving the job record",
        text: "Deliver the agreement for e-signature without leaving the job record.",
        image: asset(
          "inner-e-contract-send-and-sign-without-the-paperwork-sign-from-anywhere.webp",
        ),
      },
      {
        label: "Sign from any device",
        title: "Customers review and sign in minutes from a phone, tablet, or laptop",
        text: "Customers review and sign in minutes from a phone, tablet, or laptop.",
        image: asset(
          "inner-e-contract-send-and-sign-without-the-paperwork-speed-to-close.webp",
        ),
      },
    ],
  },
  {
    key: "pricing",
    title: "Built for Legal Protection",
    icon: "shield" as const,
    items: [
      {
        label: "Full audit log",
        title: "Each view and signature is stamped with IP address, date, and time",
        text: "Each view and signature is stamped with IP address, date, and time, and the trail is shared with the workspace owner once the document is signed.",
        image: asset(
          "inner-e-contract-built-for-legal-protection-court-ready-records.webp",
        ),
      },
      {
        label: "Court-ready records",
        title: "The documented trail supports legal standing if an agreement is ever disputed",
        text: "The documented trail supports legal standing if an agreement is ever disputed.",
        image: asset(
          "inner-e-contract-built-for-legal-protection-identity-verification.webp",
        ),
      },
      {
        label: "Identity verification",
        title: "Signatures are captured with the details that back up a legitimate, documented agreement",
        text: "Signatures are captured with the details that back up a legitimate, documented agreement.",
        image: asset(
          "inner-e-contract-built-for-legal-protection-peace-of-mind.webp",
        ),
      },
    ],
  },
  {
    key: "tracking",
    title: "Contracts That Fit How You Sell",
    icon: "file" as const,
    items: [
      {
        label: "Reusable templates",
        title: "Build signable templates for the agreements you send over and over",
        text: "Build signable templates for the agreements you send over and over.",
        image: asset(
          "inner-e-contract-contracts-that-fit-how-you-sell-consistency.webp",
        ),
      },
      {
        label: "Disclosures built in",
        title: "Include the notices your trade requires — like a 3-day right-to-cancel",
        text: "Include the notices your trade requires — like a 3-day right-to-cancel — right in the template so they're always attached.",
        image: asset(
          "inner-e-contract-contracts-that-fit-how-you-sell-accurate-terms.webp",
        ),
      },
      {
        label: "A template per agreement",
        title: "Contingency, build agreement, service plan — each ready to send in seconds",
        text: "Contingency, build agreement, service plan — each ready to send in seconds.",
        image: asset(
          "inner-e-contract-contracts-that-fit-how-you-sell-flexible-workflows.webp",
        ),
      },
    ],
  },
  {
    key: "followup",
    title: "Everything in One Record",
    icon: "folder" as const,
    items: [
      {
        label: "Stored on the job",
        title: "The signed contract lives in the job's file section",
        text: "The signed contract lives in the job's file section, part of the record your team can act on.",
        image: asset(
          "inner-e-contract-everything-in-one-record-centralized-files.webp",
        ),
      },
      {
        label: "Connected to the job",
        title: "Contracts link to estimates, invoices, and work orders",
        text: "Contracts link to estimates, invoices, and work orders, so a signed agreement isn't a PDF lost in an inbox.",
        image: asset(
          "inner-e-contract-everything-in-one-record-team-visibility.webp",
        ),
      },
      {
        label: "Signature reminders",
        title: "An automation follows up with anyone who hasn't signed",
        text: "An automation follows up with anyone who hasn't signed, so deals don't stall waiting on a signature.",
        image: asset(
          "inner-e-contract-everything-in-one-record-faster-disputes-resolution.webp",
        ),
      },
    ],
  },
];

const initialItem = proposalGroups[0].items[0];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "Are e-contracts in Knockio legally binding, and what do they log?",
    a: "Yes. You can send legally binding agreements for e-signature, and each one logs the date, time, and IP address every time it's viewed and signed. The audit trail is shared with the workspace owner once the document is signed and supports legal standing if an agreement is ever disputed.",
  },
  {
    q: "Can I reuse contract templates?",
    a: "Yes. Build signable templates for the agreements you send repeatedly, so a new contract goes out in seconds with the right language every time.",
  },
  {
    q: "Can I generate a contract from an estimate?",
    a: "Yes. Turn an approved estimate into a contract in seconds with the pricing and scope already filled in, ready to send without leaving the job.",
  },
  {
    q: "Can I include required disclosures like a 3-day cancellation notice?",
    a: "Yes — by building the disclosure into the contract template, so the right notice (for example, an FTC 3-day right-to-cancel for door-to-door sales) is attached every time you send that template.",
  },
  {
    q: "Does it remind customers who haven't signed?",
    a: "Yes. The automation builder follows up automatically with anyone who hasn't signed a sent contract, so deals don't stall waiting on a signature.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://knockio.com/features/e-contracts-software/#webpage",
      url: "https://knockio.com/features/e-contracts-software/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      about: { "@id": "https://knockio.com/field-service-crm/#software" },
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://knockio.com/features/e-contracts-software/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Features",
          item: "https://knockio.com/features/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "E-Contracts Software",
          item: "https://knockio.com/features/e-contracts-software/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/features/e-contracts-software/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};

const tabIconClass =
  "inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-primary-500 sm:h-10 sm:w-10";
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={asset("inner-e-contract-hero.webp")}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="feature-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white pt-[64px]"
    >
      <div
        class="grid min-h-0 lg:min-h-[610px] lg:grid-cols-[50%_50%] xl:min-h-[720px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] py-12 sm:py-16 lg:min-h-[600px] lg:px-0 lg:py-0 lg:pb-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[32px] font-bold leading-[38px] text-neutral-950 sm:text-[38px] sm:leading-[44px] xl:text-[48px] xl:leading-[54px] 2xl:text-[56px] 2xl:leading-[60px]"
            >
              E-Contracts Software for Field Business
            </h1>
            <p
              class="mb-10 max-w-[710px] text-base font-medium text-neutral-600 lg:text-lg"
            >
              A handshake and a verbal yes don't hold up when a customer
              changes their mind halfway through a job. Knockio's native
              e-contracts let you send legally binding agreements for signature
              in minutes — generated straight from an approved estimate — while
              automatically logging the IP address and timestamp of every view
              and signature. You close fast and you keep a paper trail if
              anyone ever questions what was agreed.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <h3
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              Are e-contracts created in Knockio legally binding, and what do
              they log?
            </h3>
            <p
              class="max-w-[720px] text-[15px] leading-6 text-neutral-600 sm:text-base sm:leading-6"
            >
              Yes. Knockio's native e-contract feature lets you send legally
              binding agreements for electronic signature. Each contract
              automatically logs the date, time, and IP address whenever it's
              viewed and signed, creating a documented audit trail that's shared
              with the workspace owner once the document is signed and supports
              legal standing if a contract is ever disputed down the road.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-feature-visual relative flex min-h-[320px] items-end justify-center overflow-hidden px-4 sm:min-h-[400px] lg:min-h-full lg:px-0"
        >
          <img
            src={asset("inner-e-contract-hero.webp")}
            alt="E-Contracts preview"
            width="809"
            height="637"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="relative z-10 w-[min(92%,720px)] max-w-[830px] object-contain object-bottom lg:-mb-3 lg:w-[min(92%,830px)] lg:animate-kio-float"
          />
        </div>
      </div>
    </section>

    <!-- ========== Everything You Need ========== -->
    <section
      class="relative overflow-hidden bg-white py-20 sm:py-24 lg:py-[130px]"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.35] [background-image:radial-gradient(#0f172a_0.7px,transparent_0.7px)] [background-size:18px_18px]"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-14 max-w-[900px] text-center lg:mb-16">
          <h2
            class="text-center text-[31px] font-bold leading-[39px] text-neutral-950 sm:text-4xl sm:leading-[44px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Everything You Need, <br class="hidden md:block" />
            Built Into One Platform
          </h2>
        </div>

        <div
          class="mx-auto grid max-w-[1450px] items-start gap-10 lg:grid-cols-[500px_minmax(0,1fr)] lg:gap-16 xl:grid-cols-[540px_minmax(0,1fr)] xl:gap-20"
        >
          <div class="grid w-full max-w-[540px] content-start gap-4">
            {
              proposalGroups.map((group, groupIndex) => (
                <div
                  class:list={[
                    "proposal-tab overflow-hidden rounded-2xl border border-solid border-[#e1e8de] bg-white shadow-sm transition-all duration-300 [&.is-active]:border-[#0f172a]",
                    groupIndex === 0 && "is-active",
                  ]}
                  data-tab={group.key}
                >
                  <button
                    class="proposal-tab-header flex w-full cursor-pointer items-center justify-between gap-4 rounded-2xl bg-white px-5 py-4 text-left text-[#0f172a] transition-all duration-300 [&[aria-expanded='true']]:rounded-b-none [&[aria-expanded='true']]:bg-[#0f172a] [&[aria-expanded='true']]:text-white sm:px-6 sm:py-5"
                    type="button"
                    aria-expanded={groupIndex === 0 ? "true" : "false"}
                  >
                    <span class="flex items-center gap-4">
                      <span class={tabIconClass}>
                        {group.icon === "signature" && (
                          <FileSignature
                            class="size-[22px]"
                            aria-hidden="true"
                          />
                        )}
                        {group.icon === "shield" && (
                          <Shield class="size-[22px]" aria-hidden="true" />
                        )}
                        {group.icon === "file" && (
                          <FileText class="size-[22px]" aria-hidden="true" />
                        )}
                        {group.icon === "folder" && (
                          <FolderOpen class="size-[22px]" aria-hidden="true" />
                        )}
                      </span>
                      <span class="text-xl font-bold leading-7 sm:text-lg sm:leading-8">
                        {group.title}
                      </span>
                    </span>
                    <ChevronDown
                      class="proposal-chevron size-[18px] shrink-0"
                      aria-hidden="true"
                    />
                  </button>

                  <div class="proposal-panel">
                    <div class="grid gap-3 rounded-b-2xl border border-t-0 border-solid border-[#e1e8de] bg-white px-5 py-5 sm:px-6">
                      {group.items.map((item, itemIndex) => (
                        <button
                          class:list={[
                            "proposal-subitem grid w-full grid-cols-[24px_1fr] items-start gap-3 rounded-xl px-3 py-2.5 text-left text-base font-semibold leading-6 text-[#0f172a] transition-all duration-300 hover:bg-[#f2f8f0] sm:text-[18px] sm:leading-7 [&.is-active]:bg-primary-500 [&.is-active]:text-white",
                            groupIndex === 0 &&
                              itemIndex === 0 &&
                              "is-active",
                          ]}
                          type="button"
                          data-tab={group.key}
                          data-index={String(itemIndex)}
                          data-title={item.title}
                          data-text={item.text}
                          data-image={item.image}
                        >
                          <ArrowRight
                            class="mt-1 size-[17px]"
                            aria-hidden="true"
                          />
                          <span>{item.label}</span>
                        </button>
                      ))}
                    </div>
                  </div>
                </div>
              ))
            }
          </div>

          <div class="w-full self-start">
            <div
              id="proposalVisual"
              class="proposal-visual-card relative overflow-hidden"
            >
              <img
                id="proposalVisualImage"
                src={initialItem.image}
                alt={initialItem.title}
                width="737"
                height="409"
                decoding="async"
                loading="lazy"
                class="relative z-10 h-full w-full object-contain"
              />
            </div>
            <div class="mt-7 max-w-[760px]">
              <p
                id="proposalVisualTitle"
                class="mb-4 text-[24px] font-bold leading-8 text-[#0f172a] sm:text-[32px] sm:leading-[40px]"
              >
                {initialItem.title}
              </p>
              <p
                id="proposalVisualText"
                class="text-base font-normal leading-7 text-neutral-700 sm:text-lg sm:leading-8"
              >
                {initialItem.text}
              </p>
            </div>
          </div>
        </div>

        <div class="sr-only">
          {
            proposalGroups.map((group) => (
              <div>
                <h3>{group.title}</h3>
                <div>
                  {group.items.map((item) => (
                    <article>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </article>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ========== Trusted ========== -->
    <section
      class="relative overflow-hidden bg-[#0F172A] py-24 sm:py-28 lg:py-[150px]"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.22] [background-image:radial-gradient(rgba(255,255,255,0.65)_0.8px,transparent_0.8px)] [background-size:18px_18px]"
      >
      </div>
      <div
        class="pointer-events-none absolute top-16 left-1/2 h-[420px] w-[860px] -translate-x-1/2 rounded-full bg-primary-500/10 blur-3xl"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-16 max-w-[1040px] text-center lg:mb-20">
          <h2
            class="mb-6 text-center text-[31px] font-bold leading-[39px] text-white sm:text-4xl sm:leading-[44px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Trusted by 100&rsquo;s of customers
          </h2>
          <p
            class="mx-auto max-w-[800px] text-base leading-7 text-white/80 sm:text-lg sm:leading-8"
          >
            Join hundreds of growing teams using Knockio to manage leads, sales,
            field teams, and customer relationships.
          </p>
        </div>

        <div
          class="mx-auto grid max-w-[1120px] grid-cols-1 justify-items-center gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10"
        >
          {
            trustBadges.map((badge) => (
              <a
                href={badge.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={badge.label}
                class="group block rounded-3xl focus:ring-2 focus:ring-primary-500 focus:ring-offset-4 focus:ring-offset-[#0F172A] focus:outline-none"
              >
                <img
                  src={badge.src}
                  alt={badge.alt}
                  width="203"
                  height="280"
                  decoding="async"
                  loading="lazy"
                  class="w-full max-w-[200px] object-contain transition duration-300 group-hover:-translate-y-2 group-hover:drop-shadow-[0_24px_34px_rgba(255,255,255,0.12)]"
                />
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ========== Manage Agreements ========== -->
    <section
      class="relative overflow-hidden bg-white py-24 sm:py-28 lg:py-[150px]"
    >
      <div
        class="pointer-events-none absolute top-32 left-1/2 h-[420px] w-[900px] -translate-x-1/2 rounded-full bg-primary-500/5 blur-3xl"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-14 max-w-[1120px] text-center lg:mb-20">
          <h2
            class="mb-6 text-center text-[31px] font-bold leading-[39px] text-neutral-950 sm:text-4xl sm:leading-[44px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Manage Agreements From the First Signature to the Final Job
          </h2>
          <p
            class="mx-auto max-w-[800px] text-base leading-6 text-neutral-700 sm:text-lg sm:leading-6"
          >
            Knockio connects e-contracts to the rest of the job — estimates,
            invoices, and work orders — so a signed agreement isn't just a PDF
            sitting in someone's inbox. It's part of the full job record your
            team can actually act on.
          </p>
        </div>

        <div class="mx-auto grid max-w-[1380px] gap-6 lg:grid-cols-3 lg:gap-8">
          <article
