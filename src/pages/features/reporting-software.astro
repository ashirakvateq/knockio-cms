---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/reporting-software.css";
import {
  ArrowRight,
  ChartColumn,
  ChartLine,
  Check,
  ChevronDown,
  ChevronRight,
  ClipboardList,
  DollarSign,
  FileSignature,
  ListChecks,
  Quote,
  RefreshCw,
} from "lucide-astro";

const title = "Reporting Software for Data Driven Decisions | Knockio";
const description =
  "Reporting Software for data driven decisions by Knockio tracks conversions, revenue, payments, and rep performance with custom reports.";

const asset = (name: string) => `/assets/cfw/${name}`;

const proposalGroups = [
  {
    key: "digital",
    title: "Build Reports Around Your Own Rules",
    icon: "clipboard" as const,
    items: [
      {
        label: "Total Flexibility",
        title: "Custom Report Builder",
        text: "Define your own rules and conditions to generate a report, instead of being stuck with a handful of generic templates that almost fit your business.",
        image: asset(
          "inner-reports-build-reports-around-your-own-rules-total-flexibility.webp",
        ),
      },
      {
        label: "No Limits",
        title: "Reports for Any Part of Your Operation",
        text: "Build reports around sales, field activity, payments, or staffing, all from the same data already living inside Knockio.",
        image: asset(
          "inner-reports-build-reports-around-your-own-rules-no-limits.webp",
        ),
      },
      {
        label: "Always Current",
        title: "Reports That Update With Your Data",
        text: "Set up a report once and it reflects your live job, payment, and activity data going forward, no manual refresh or export required.",
        image: asset(
          "inner-reports-build-reports-around-your-own-rules-always-current.webp",
        ),
      },
    ],
  },
  {
    key: "pricing",
    title: "Understand Your Sales and Conversions",
    icon: "chartLine" as const,
    items: [
      {
        label: "Know What Is Working",
        title: "Conversion Rate Reports",
        text: "See exactly what percentage of leads turn into booked jobs, broken down however you need it, whether that is by rep, source, or territory.",
        image: asset(
          "inner-reports-understand-your-sales-and-conversions-know-what-is-working.webp",
        ),
      },
      {
        label: "Spot the Bottleneck",
        title: "Reports on Leads by Status History",
        text: "Build a report showing every lead that passed through a specific status, which is the fastest way to find out exactly where deals are stalling out.",
        image: asset(
          "inner-reports-understand-your-sales-and-conversions-spot-the-bottleneck.webp",
        ),
      },
      {
        label: "Plan With Confidence",
        title: "Forecasted Revenue Reports",
        text: "Build a forward looking report on pipeline value and expected close dates, so you are planning around real numbers instead of a gut feeling.",
        image: asset(
          "inner-reports-understand-your-sales-and-conversions-plan-with-confidence.webp",
        ),
      },
    ],
  },
  {
    key: "tracking",
    title: "Track Your Field Team's Real Performance",
    icon: "chartCol" as const,
    items: [
      {
        label: "Territory Insights",
        title: "Rep Performance by Territory",
        text: "Build a report comparing how reps perform in different territories, helping you figure out if results come from skill, territory quality, or both.",
        image: asset(
          "inner-reports-track-your-field-teams-real-performance-territory-insights.webp",
        ),
      },
      {
        label: "Time Accountability",
        title: "Time Spent in the Field Reports",
        text: "See exactly how much time each rep actually spends in the field versus sitting idle, based on real location and activity data, not their word for it.",
        image: asset(
          "inner-reports-track-your-field-teams-real-performance-time-accountability.webp",
        ),
      },
      {
        label: "Workforce Oversight",
        title: "Employee Check In and Check Out Reports",
        text: "Build a report tracking when employees check in and out each day, giving you a clear record for payroll, accountability, and scheduling decisions.",
        image: asset(
          "inner-reports-track-your-field-teams-real-performance-workforce-oversight.webp",
        ),
      },
    ],
  },
  {
    key: "followup",
    title: "Stay on Top of Every Dollar",
    icon: "dollar" as const,
    items: [
      {
        label: "Cash Flow Clarity",
        title: "Incoming and Outgoing Payment Reports",
        text: "Build a report showing money coming in and money going out across all your jobs, so you always know where your cash position actually stands.",
        image: asset(
          "inner-reports-stay-on-top-of-every-dollar-cash-flow-clarity.webp",
        ),
      },
      {
        label: "Collections Tracking",
        title: "Due and Paid Payment Reports",
        text: "See which invoices are paid and which are still due at a glance, broken down by customer, job, or date range.",
        image: asset(
          "inner-reports-stay-on-top-of-every-dollar-collections-tracking.webp",
        ),
      },
      {
        label: "Connected Financial Picture",
        title: "Reports Tied to Jobs, Invoices, and Estimates",
        text: "Every report pulls from the same connected data running your jobs, so the numbers always match what is actually happening on the ground.",
        image: asset(
          "inner-reports-stay-on-top-of-every-dollar-connected-financial-picture.webp",
        ),
      },
    ],
  },
];

const initialItem = proposalGroups[0].items[0];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "Can I build a custom report instead of using a preset template?",
    a: "Yes. Knockio lets you create custom rules and conditions to generate a report, so you are not limited to a fixed set of preset templates.",
  },
  {
    q: "Can I build a report on lead conversion rates?",
    a: "Yes. You can create a conversion report broken down by rep, territory, source, or any other rule that matters to your business.",
  },
  {
    q: "Can I see how much time each rep spends in the field?",
    a: "Yes. Knockio can generate a report showing how much time each rep actually spends in the field, based on real activity and location data.",
  },
  {
    q: "Can I build a report showing leads that went through a specific status?",
    a: "Yes. You can create a report that shows every lead or job that passed through a specific status, which helps identify exactly where deals are stalling.",
  },
  {
    q: "Does Knockio support revenue forecasting?",
    a: "Yes. You can build forecasted revenue reports based on your pipeline data, giving you a realistic view of expected revenue going forward.",
  },
  {
    q: "Can I track payments through reports?",
    a: "Yes. Knockio supports reports covering incoming, outgoing, due, and paid payments, giving you a clear and current financial picture at all times.",
  },
  {
    q: "Can I track employee check in and check out times?",
    a: "Yes. You can build a report on employee check in and check out activity, useful for payroll, accountability, and scheduling decisions.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://knockio.com/features/reporting-software/#webpage",
      url: "https://knockio.com/features/reporting-software/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      about: { "@id": "https://knockio.com/field-service-crm/#software" },
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://knockio.com/features/reporting-software/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Features",
          item: "https://knockio.com/features/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Reporting Software",
          item: "https://knockio.com/features/reporting-software/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/features/reporting-software/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};

const tabIconClass =
  "inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-primary-500 sm:h-10 sm:w-10";
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={asset("inner-reports-hero.webp")}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="reporting-software-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white pt-[72px]"
    >
      <div
        class="reporting-hero grid min-h-0 lg:min-h-[610px] xl:min-h-[720px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] py-12 sm:py-16 lg:min-h-[600px] lg:px-0 lg:py-0 lg:pb-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[32px] font-bold leading-[38px] text-neutral-950 sm:text-[38px] sm:leading-[44px] xl:text-[48px] xl:leading-[54px] 2xl:text-[56px] 2xl:leading-[60px]"
            >
              Reporting Software{" "}
              <br class="hidden sm:block" />
              for Data-Driven Decisions
            </h1>
            <p
              class="mb-10 max-w-[710px] text-base font-medium text-neutral-600 lg:text-lg"
            >
              Knockio's reporting software for data-driven decisions helps you
              see what is working and what needs fixing. Build custom reports
              for conversion rates, territory performance, field activity,
              payments, and stalled leads. Create the report once, and Knockio
              keeps your data updated for smarter decisions.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <h3
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              What kinds of reports can home service businesses build with
              Knockio?
            </h3>
            <p
              class="max-w-[720px] text-[15px] leading-6 text-neutral-600 sm:text-base sm:leading-6"
            >
              Knockio lets home service businesses build custom reports based on
              their own rules, covering things like conversion rates, rep
              performance by territory, time spent in the field, leads that
              passed through specific statuses, forecasted revenue, incoming and
              outgoing payments, and employee check in and check out times.
              Because the reports are built on custom rules rather than fixed
              templates, you can create the exact report your business needs
              instead of settling for whatever a platform like ServiceTitan or
              Jobber decided to pre build.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-estimate-visual relative flex min-h-[320px] items-end justify-center overflow-hidden px-4 sm:min-h-[400px] lg:min-h-full lg:px-0"
        >
          <img
            src={asset("inner-reports-hero.webp")}
            alt="Reporting software preview"
            width="688"
            height="637"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="relative z-10 w-[min(92%,720px)] max-w-[830px] object-contain object-bottom lg:-mb-3 lg:w-[min(92%,830px)] lg:animate-kio-float"
          />
        </div>
      </div>
    </section>

    <!-- ========== Everything You Need ========== -->
    <section
      class="relative overflow-hidden bg-white py-20 sm:py-24 lg:py-[130px]"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.35] [background-image:radial-gradient(#0f172a_0.7px,transparent_0.7px)] [background-size:18px_18px]"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-14 max-w-[900px] text-center lg:mb-16">
          <h2
            class="text-center text-[31px] font-bold leading-[39px] text-neutral-950 sm:text-4xl sm:leading-[44px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Everything You Need, <br class="hidden md:block" />
            Built Into One Platform
          </h2>
        </div>

        <div
          class="mx-auto grid max-w-[1450px] items-start gap-10 lg:grid-cols-[500px_minmax(0,1fr)] lg:gap-16 xl:grid-cols-[540px_minmax(0,1fr)] xl:gap-20"
        >
          <div class="grid w-full max-w-[540px] content-start gap-4">
            {
              proposalGroups.map((group, groupIndex) => (
                <div
                  class:list={[
                    "proposal-tab overflow-hidden rounded-2xl border border-solid border-[#e1e8de] bg-white shadow-sm transition-all duration-300 [&.is-active]:border-[#0f172a]",
                    groupIndex === 0 && "is-active",
                  ]}
                  data-tab={group.key}
                >
                  <button
                    class="proposal-tab-header flex w-full cursor-pointer items-center justify-between gap-4 rounded-2xl bg-white px-5 py-4 text-left text-[#0f172a] transition-all duration-300 [&[aria-expanded='true']]:rounded-b-none [&[aria-expanded='true']]:bg-[#0f172a] [&[aria-expanded='true']]:text-white sm:px-6 sm:py-5"
                    type="button"
                    aria-expanded={groupIndex === 0 ? "true" : "false"}
                  >
                    <span class="flex items-center gap-4">
                      <span class={tabIconClass}>
                        {group.icon === "clipboard" && (
                          <ClipboardList
                            class="size-[22px]"
                            aria-hidden="true"
                          />
                        )}
                        {group.icon === "chartLine" && (
                          <ChartLine class="size-[22px]" aria-hidden="true" />
                        )}
                        {group.icon === "chartCol" && (
                          <ChartColumn
                            class="size-[22px]"
                            aria-hidden="true"
                          />
                        )}
                        {group.icon === "dollar" && (
                          <DollarSign class="size-[22px]" aria-hidden="true" />
                        )}
                      </span>
                      <span class="text-xl font-bold leading-7 sm:text-lg sm:leading-8">
                        {group.title}
                      </span>
                    </span>
                    <ChevronDown
                      class="proposal-chevron size-[18px] shrink-0"
                      aria-hidden="true"
                    />
                  </button>

                  <div class="proposal-panel">
                    <div class="grid gap-3 rounded-b-2xl border border-t-0 border-solid border-[#e1e8de] bg-white px-5 py-5 sm:px-6">
                      {group.items.map((item, itemIndex) => (
                        <button
                          class:list={[
                            "proposal-subitem grid w-full grid-cols-[24px_1fr] items-start gap-3 rounded-xl px-3 py-2.5 text-left text-base font-semibold leading-6 text-[#0f172a] transition-all duration-300 hover:bg-[#f2f8f0] sm:text-[18px] sm:leading-7 [&.is-active]:bg-primary-500 [&.is-active]:text-white",
                            groupIndex === 0 &&
                              itemIndex === 0 &&
                              "is-active",
                          ]}
                          type="button"
                          data-tab={group.key}
                          data-index={String(itemIndex)}
                          data-title={item.title}
                          data-text={item.text}
                          data-image={item.image}
                        >
                          <ArrowRight
                            class="mt-1 size-[17px]"
                            aria-hidden="true"
                          />
                          <span>{item.label}</span>
                        </button>
                      ))}
                    </div>
                  </div>
                </div>
              ))
            }
          </div>

          <div class="w-full self-start">
            <div
              id="proposalVisual"
              class="proposal-visual-card relative overflow-hidden"
            >
              <img
                id="proposalVisualImage"
                src={initialItem.image}
                alt={initialItem.title}
                width="714"
                height="386"
                decoding="async"
                loading="lazy"
                class="relative z-10 h-full w-full object-contain"
              />
            </div>
            <div class="mt-7 max-w-[760px]">
              <h3
                id="proposalVisualTitle"
                class="mb-4 text-[24px] font-bold leading-8 text-[#0f172a] sm:text-[32px] sm:leading-[40px]"
              >
                {initialItem.title}
              </h3>
              <p
                id="proposalVisualText"
                class="text-base font-normal leading-7 text-neutral-700 sm:text-lg sm:leading-8"
              >
                {initialItem.text}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== Trusted ========== -->
    <section
      class="relative overflow-hidden bg-[#0F172A] py-24 sm:py-28 lg:py-[150px]"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.22] [background-image:radial-gradient(rgba(255,255,255,0.65)_0.8px,transparent_0.8px)] [background-size:18px_18px]"
      >
      </div>
      <div
        class="pointer-events-none absolute top-16 left-1/2 h-[420px] w-[860px] -translate-x-1/2 rounded-full bg-primary-500/10 blur-3xl"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-16 max-w-[1040px] text-center lg:mb-20">
          <h2
            class="mb-6 text-center text-[31px] font-bold leading-[39px] text-white sm:text-4xl sm:leading-[44px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Trusted by 100&rsquo;s of customers
          </h2>
          <p
            class="mx-auto max-w-[800px] text-base leading-7 text-white/80 sm:text-lg sm:leading-8"
          >
            Join hundreds of growing teams using Knockio to manage leads, sales,
            field teams, and customer relationships.
          </p>
        </div>

        <div
          class="mx-auto grid max-w-[1120px] grid-cols-1 justify-items-center gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10"
        >
          {
            trustBadges.map((badge) => (
              <a
                href={badge.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={badge.label}
                class="group block rounded-3xl focus:ring-2 focus:ring-primary-500 focus:ring-offset-4 focus:ring-offset-[#0F172A] focus:outline-none"
              >
                <img
                  src={badge.src}
                  alt={badge.alt}
                  width="203"
                  height="280"
                  decoding="async"
                  loading="lazy"
                  class="w-full max-w-[200px] object-contain transition duration-300 group-hover:-translate-y-2 group-hover:drop-shadow-[0_24px_34px_rgba(255,255,255,0.12)]"
                />
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ========== Manage ========== -->
    <section
      class="relative overflow-hidden bg-white py-24 sm:py-28 lg:py-[150px]"
    >
      <div
        class="pointer-events-none absolute top-32 left-1/2 h-[420px] w-[900px] -translate-x-1/2 rounded-full bg-primary-500/5 blur-3xl"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-14 max-w-[1120px] text-center lg:mb-20">
          <h2
            class="mb-6 text-center text-[31px] font-bold leading-[39px] text-neutral-950 sm:text-4xl sm:leading-[44px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            <span class="lg:whitespace-nowrap"
              >Manage Your Business With Numbers, Not</span
            >
            <br class="hidden lg:block" />
            Guesses
          </h2>
          <p
            class="mx-auto max-w-[800px] text-base leading-6 text-neutral-700 sm:text-lg sm:leading-6"
          >
            Knockio's reports pull directly from the same job, payment, and
            activity data already living in your boards, work orders, and
            invoices, so what you see in a report is exactly what is happening
            in your business right now, not a stale export from last month.
          </p>
        </div>

        <div class="mx-auto grid max-w-[1380px] gap-6 lg:grid-cols-3 lg:gap-8">
          <article
