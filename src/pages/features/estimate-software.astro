---
import KnockioHomeLayout from "../../layouts/KnockioHomeLayout.astro";
import "../../styles/feature-page.css";
import {
  ArrowRight,
  Bell,
  Check,
  ChevronDown,
  ChevronRight,
  ClipboardList,
  DollarSign,
  FileSignature,
  FileText,
  ListChecks,
  Quote,
  RefreshCw,
} from "lucide-astro";

const title = "Estimate Software for Contractors and Home Service | Knockio";
const description =
  "Build estimates that win jobs with e-signatures, online approvals, and change orders. See why contractors choose Knockio over Jobber and ServiceTitan.";

const asset = (name: string) => `/assets/cfw/${name}`;

const proposalGroups = [
  {
    key: "digital",
    title: "Build Estimates That Win Jobs",
    icon: "clipboard" as const,
    items: [
      {
        label: "Professional Proposals",
        title: "Branded Digital Estimates",
        text: "Send polished, on brand estimates by email or text that customers can open and review on any device. No paper, no fax machine, no excuses.",
        image: asset(
          "inner-estimate-build-estimates-that-win-jobs-professional-proposals.webp",
        ),
      },
      {
        label: "Higher Average Job Value",
        title: "Optional Line Items for Upsells",
        text: "Let homeowners add upgrades like gutter guards on a roofing job or a smart thermostat on an HVAC install, right inside the estimate.",
        image: asset(
          "inner-estimate-build-estimates-that-win-jobs-higher-average-job-value.webp",
        ),
      },
      {
        label: "Speed and Consistency",
        title: "Templates and a Product or Service Catalog",
        text: "Pull from a library of priced services and products so every estimate goes out fast, accurate, and consistent across your team.",
        image: asset(
          "inner-estimate-build-estimates-that-win-jobs-speed-and-consistency.webp",
        ),
      },
    ],
  },
  {
    key: "pricing",
    title: "Make Approval Effortless",
    icon: "dollar" as const,
    items: [
      {
        label: "Sign Anywhere",
        title: "Digital Signatures",
        text: "Customers approve estimates with a legally binding e signature from their phone. No printing, scanning, or waiting around for someone to be home.",
        image: asset(
          "inner-estimate-make-approval-effortless-sign-anywhere.webp",
        ),
      },
      {
        label: "Self Serve Approval",
        title: "Online Customer Acceptance Portal",
        text: "Give clients a dedicated portal to review pricing, photos, and scope, then accept the job whenever it works for them.",
        image: asset(
          "inner-estimate-make-approval-effortless-self-serve-approval.webp",
        ),
      },
      {
        label: "Transparent Pricing",
        title: "Itemized Cost Breakdown",
        text: "Show customers exactly what they are paying for with clear line items. That builds confidence and cuts down on back and forth questions.",
        image: asset(
          "inner-estimate-make-approval-effortless-transparent-pricing.webp",
        ),
      },
    ],
  },
  {
    key: "tracking",
    title: "Handle Changes Without the Chaos",
    icon: "file" as const,
    items: [
      {
        label: "Scope Changes Made Easy",
        title: "Built In Change Orders",
        text: "When the job grows mid project, create a change order linked to the original estimate so pricing and approvals stay organized.",
        image: asset(
          "inner-estimate-handle-changes-without-the-chaos-scope-changes-made-easy.webp",
        ),
      },
      {
        label: "Connected Records",
        title: "Estimates Linked to Jobs and Work Orders",
        text: "Every estimate ties to the job record, so approved pricing flows into work orders and invoices automatically.",
        image: asset(
          "inner-estimate-handle-changes-without-the-chaos-connected-records.webp",
        ),
      },
      {
        label: "Clean Audit Trail",
        title: "Full Estimate History per Job",
        text: "Track every version, revision, and change order tied to a job, all in one place for easy reference down the road.",
        image: asset(
          "inner-estimate-handle-changes-without-the-chaos-clean-audit-trail.webp",
        ),
      },
    ],
  },
  {
    key: "followup",
    title: "Close More, Follow Up Less",
    icon: "bell" as const,
    items: [
      {
        label: "Automated Nudges",
        title: "Estimate Follow Up Reminders",
        text: "Automatically remind customers about pending estimates by email or text, so your sales team is not stuck chasing 'still thinking about it' leads forever.",
        image: asset(
          "inner-estimate-close-more-follow-up-less-automated-nudges.webp",
        ),
      },
      {
        label: "Real Time Edits",
        title: "Live Pricing Updates",
        text: "Adjust line items, discounts, or pricing during an in home conversation and the customer sees the updated total right away.",
        image: asset(
          "inner-estimate-close-more-follow-up-less-real-time-edits.webp",
        ),
      },
      {
        label: "From Quote to Job",
        title: "One Click Conversion to Work Orders and Invoices",
        text: "Turn an approved estimate straight into a work order or invoice, keeping your pipeline moving without manual handoffs.",
        image: asset(
          "inner-estimate-close-more-follow-up-less-from-quote-to-job.webp",
        ),
      },
    ],
  },
];

const initialItem = proposalGroups[0].items[0];

const trustBadges = [
  {
    href: "https://www.capterra.com/p/10018264/Knockio/",
    src: asset("badge-new-capterra.webp"),
    alt: "Knockio Capterra rating badge",
    label: "View Knockio reviews on Capterra",
  },
  {
    href: "https://www.softwareadvice.com/field-sales/knockio-profile/",
    src: asset("badge-new-software-advice.webp"),
    alt: "Knockio Software Advice rating badge",
    label: "View Knockio reviews on Software Advice",
  },
  {
    href: "https://www.getapp.com/all-software/a/knockio/",
    src: asset("badge-new-get-app.webp"),
    alt: "Knockio GetApp rating badge",
    label: "View Knockio reviews on GetApp",
  },
  {
    href: "https://www.g2.com/products/knockio-by-knockio/reviews",
    src: asset("badge-new-g2.webp"),
    alt: "Knockio G2 rating badge",
    label: "View Knockio reviews on G2",
  },
];

const faqs = [
  {
    q: "Can customers approve and sign estimates online?",
    a: "Yes. Knockio includes a customer acceptance portal with digital signature support, so homeowners and commercial clients can review and approve estimates from any device.",
  },
  {
    q: "Does Knockio support change orders?",
    a: "Yes. If the scope of work changes after an estimate is approved, you can create a change order linked to the original job and estimate, keeping pricing and approvals organized.",
  },
  {
    q: "Can I offer optional add ons in an estimate?",
    a: "Yes. Estimates support optional line items, letting customers choose upgrades or extras, which is a simple way to increase average job value for roofing, HVAC, solar, and remodeling jobs.",
  },
  {
    q: "Can I save estimate templates for common jobs?",
    a: "Yes. Knockio supports estimate templates and a product or service catalog, so your team can build accurate, consistent quotes quickly for repeatable job types.",
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: asset("avatar-lacey-jackson.webp"),
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: asset("avatar-ben-loveland.webp"),
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: asset("avatar-bar-galanti.webp"),
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: asset("avatar-georgia-hancocks.webp"),
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: asset("avatar-sarah-bennett.webp"),
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: asset("avatar-ayana-hall.webp"),
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://knockio.com/features/estimate-software/#webpage",
      url: "https://knockio.com/features/estimate-software/",
      name: title,
      description,
      isPartOf: { "@id": "https://knockio.com/#website" },
      about: { "@id": "https://knockio.com/field-service-crm/#software" },
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://knockio.com/features/estimate-software/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Features",
          item: "https://knockio.com/features/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Estimate Software",
          item: "https://knockio.com/features/estimate-software/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/features/estimate-software/#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};

const tabIconClass =
  "inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-primary-500 sm:h-10 sm:w-10";
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={asset("inner-estimate-hero.webp")}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main id="estimate-software-page">
    <!-- ========== Hero ========== -->
    <section
      class="overflow-hidden border-b border-solid border-[#7fc271] bg-white pt-[72px]"
    >
      <div
        class="grid min-h-0 lg:min-h-[610px] lg:grid-cols-[50%_50%] xl:min-h-[720px]"
      >
        <div
          class="relative flex flex-col justify-center px-[5%] py-12 sm:py-16 lg:min-h-[600px] lg:px-0 lg:py-0 lg:pb-[72px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-[42px] xl:pr-[70px]"
        >
          <div class="max-w-[810px]">
            <h1
              class="mb-7 text-[32px] font-bold leading-[38px] text-neutral-950 sm:text-[38px] sm:leading-[44px] xl:text-[48px] xl:leading-[54px] 2xl:text-[56px] 2xl:leading-[60px]"
            >
              Estimate Software for Contractors<br class="hidden sm:block" />
            </h1>
            <p
              class="mb-10 max-w-[710px] text-base font-medium text-neutral-600 lg:text-lg"
            >
              Most contractors lose jobs not because their price is wrong, but
              because the estimate looks unprofessional, takes too long to send,
              or sits in someone's inbox with no follow up. Knockio gives you
              branded, easy to approve estimates with digital signatures and
              online acceptance built in. Create a consistent, professional
              estimating experience across every representative, crew, branch,
              service line, and customer interaction.
            </p>
            <a
              href="#cal-sec"
              class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white hover:bg-primary-600 sm:w-auto sm:px-10 sm:py-4 sm:text-base lg:px-12"
            >
              Schedule a Demo
            </a>
          </div>

          <div
            id="kioSummaryPanel"
            class="kio-summary-panel z-[18] mt-6 rounded-xl border border-solid border-primary-500/35 bg-white/95 px-[5%] py-5 text-base leading-7 text-neutral-600 lg:absolute lg:inset-x-0 lg:bottom-[72px] lg:mt-0 lg:px-0 lg:py-[22px] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10 lg:shadow-[0_-18px_45px_rgba(15,23,42,0.08)]"
          >
            <h3
              class="mb-4 text-[21px] font-semibold leading-[27px] text-neutral-950 sm:text-2xl sm:leading-7"
            >
              What should I look for in estimate software for contractors?
            </h3>
            <p
              class="max-w-[720px] text-[15px] leading-6 text-neutral-600 sm:text-base sm:leading-6"
            >
              Good estimate software for contractors should let you build
              branded, itemized quotes fast, support digital signatures and
              online approval so customers can accept from any device, handle
              change orders when scope shifts mid job, and connect directly to
              your invoicing and inventory. Knockio includes all of this out of
              the box, plus optional line items for upsells and a reusable
              product and service catalog. Knockio connects estimate templates,
              optional line items, digital approvals, change orders, products,
              services, work orders, invoices, payments, and job history in one
              workflow.
            </p>
          </div>

          <div
            class="z-20 mt-8 min-h-[72px] border-t border-solid border-primary-500/70 bg-[#f3faf3] lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0"
          >
            <button
              id="kioSummaryBtn"
              class="kio-summary-button duration-250 flex min-h-[72px] w-full items-center justify-between gap-5 px-[5%] text-neutral-950 transition-colors hover:bg-[#edf8ed] lg:pl-[max(6.2vw,calc((100vw-1680px)/2))] lg:pr-10"
              type="button"
              aria-expanded="false"
              aria-controls="kioSummaryPanel"
            >
              <span class="text-lg font-medium leading-6">Quick summary</span>
              <ChevronRight
                class="summary-chevron size-5 shrink-0"
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <div
          class="hero-feature-visual relative flex min-h-[320px] items-end justify-center overflow-hidden px-4 sm:min-h-[400px] lg:min-h-full lg:px-0"
        >
          <img
            src={asset("inner-estimate-hero.webp")}
            alt="Roofing estimate preview"
            width="858"
            height="644"
            decoding="async"
            loading="eager"
            fetchpriority="high"
            class="relative z-10 w-[min(92%,720px)] max-w-[830px] object-contain object-bottom lg:-mb-3 lg:w-[min(92%,830px)] lg:animate-kio-float"
          />
        </div>
      </div>
    </section>

    <!-- ========== Everything You Need ========== -->
    <section
      class="relative overflow-hidden bg-white py-20 sm:py-24 lg:py-[130px]"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.35] [background-image:radial-gradient(#0f172a_0.7px,transparent_0.7px)] [background-size:18px_18px]"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-14 max-w-[900px] text-center lg:mb-16">
          <h2
            class="text-center text-[31px] font-bold leading-[39px] text-neutral-950 sm:text-4xl sm:leading-[44px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Everything You Need, <br class="hidden md:block" />
            Built Into One Platform
          </h2>
        </div>

        <div
          class="mx-auto grid max-w-[1450px] items-start gap-10 lg:grid-cols-[500px_minmax(0,1fr)] lg:gap-16 xl:grid-cols-[540px_minmax(0,1fr)] xl:gap-20"
        >
          <div class="grid w-full max-w-[540px] content-start gap-4">
            {
              proposalGroups.map((group, groupIndex) => (
                <div
                  class:list={[
                    "proposal-tab overflow-hidden rounded-2xl border border-solid border-[#e1e8de] bg-white shadow-sm transition-all duration-300 [&.is-active]:border-[#0f172a]",
                    groupIndex === 0 && "is-active",
                  ]}
                  data-tab={group.key}
                >
                  <button
                    class="proposal-tab-header flex w-full cursor-pointer items-center justify-between gap-4 rounded-2xl bg-white px-5 py-4 text-left text-[#0f172a] transition-all duration-300 [&[aria-expanded='true']]:rounded-b-none [&[aria-expanded='true']]:bg-[#0f172a] [&[aria-expanded='true']]:text-white sm:px-6 sm:py-5"
                    type="button"
                    aria-expanded={groupIndex === 0 ? "true" : "false"}
                  >
                    <span class="flex items-center gap-4">
                      <span class={tabIconClass}>
                        {group.icon === "clipboard" && (
                          <ClipboardList
                            class="size-[22px]"
                            aria-hidden="true"
                          />
                        )}
                        {group.icon === "dollar" && (
                          <DollarSign class="size-[22px]" aria-hidden="true" />
                        )}
                        {group.icon === "file" && (
                          <FileText class="size-[22px]" aria-hidden="true" />
                        )}
                        {group.icon === "bell" && (
                          <Bell class="size-[22px]" aria-hidden="true" />
                        )}
                      </span>
                      <span class="text-xl font-bold leading-7 sm:text-lg sm:leading-8">
                        {group.title}
                      </span>
                    </span>
                    <ChevronDown
                      class="proposal-chevron size-[18px] shrink-0"
                      aria-hidden="true"
                    />
                  </button>

                  <div class="proposal-panel">
                    <div class="grid gap-3 rounded-b-2xl border border-t-0 border-solid border-[#e1e8de] bg-white px-5 py-5 sm:px-6">
                      {group.items.map((item, itemIndex) => (
                        <button
                          class:list={[
                            "proposal-subitem grid w-full grid-cols-[24px_1fr] items-start gap-3 rounded-xl px-3 py-2.5 text-left text-base font-semibold leading-6 text-[#0f172a] transition-all duration-300 hover:bg-[#f2f8f0] sm:text-[18px] sm:leading-7 [&.is-active]:bg-primary-500 [&.is-active]:text-white",
                            groupIndex === 0 &&
                              itemIndex === 0 &&
                              "is-active",
                          ]}
                          type="button"
                          data-tab={group.key}
                          data-index={String(itemIndex)}
                          data-title={item.title}
                          data-text={item.text}
                          data-image={item.image}
                        >
                          <ArrowRight
                            class="mt-1 size-[17px]"
                            aria-hidden="true"
                          />
                          <span>{item.label}</span>
                        </button>
                      ))}
                    </div>
                  </div>
                </div>
              ))
            }
          </div>

          <div class="w-full self-start">
            <div
              id="proposalVisual"
              class="proposal-visual-card relative overflow-hidden"
            >
              <img
                id="proposalVisualImage"
                src={initialItem.image}
                alt={initialItem.title}
                width="714"
                height="386"
                decoding="async"
                loading="lazy"
                class="relative z-10 h-full w-full object-contain"
              />
            </div>
            <div class="mt-7 max-w-[760px]">
              <p
                id="proposalVisualTitle"
                class="mb-4 text-[24px] font-bold leading-8 text-[#0f172a] sm:text-[32px] sm:leading-[40px]"
              >
                {initialItem.title}
              </p>
              <p
                id="proposalVisualText"
                class="text-base font-normal leading-7 text-neutral-700 sm:text-lg sm:leading-8"
              >
                {initialItem.text}
              </p>
            </div>
          </div>
        </div>

        <div class="sr-only">
          {
            proposalGroups.map((group) => (
              <div>
                <h3>{group.title}</h3>
                <div>
                  {group.items.map((item) => (
                    <article>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </article>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ========== Trusted ========== -->
    <section
      class="relative overflow-hidden bg-[#0F172A] py-24 sm:py-28 lg:py-[150px]"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.22] [background-image:radial-gradient(rgba(255,255,255,0.65)_0.8px,transparent_0.8px)] [background-size:18px_18px]"
      >
      </div>
      <div
        class="pointer-events-none absolute top-16 left-1/2 h-[420px] w-[860px] -translate-x-1/2 rounded-full bg-primary-500/10 blur-3xl"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-16 max-w-[1040px] text-center lg:mb-20">
          <h2
            class="mb-6 text-center text-[31px] font-bold leading-[39px] text-white sm:text-4xl sm:leading-[44px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            Trusted by 100&rsquo;s of customers
          </h2>
          <p
            class="mx-auto max-w-[800px] text-base leading-7 text-white/80 sm:text-lg sm:leading-8"
          >
            Join hundreds of growing teams using Knockio to manage leads, sales,
            field teams, and customer relationships.
          </p>
        </div>

        <div
          class="mx-auto grid max-w-[1120px] grid-cols-1 justify-items-center gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10"
        >
          {
            trustBadges.map((badge) => (
              <a
                href={badge.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={badge.label}
                class="group block rounded-3xl focus:ring-2 focus:ring-primary-500 focus:ring-offset-4 focus:ring-offset-[#0F172A] focus:outline-none"
              >
                <img
                  src={badge.src}
                  alt={badge.alt}
                  width="203"
                  height="280"
                  decoding="async"
                  loading="lazy"
                  class="w-full max-w-[200px] object-contain transition duration-300 group-hover:-translate-y-2 group-hover:drop-shadow-[0_24px_34px_rgba(255,255,255,0.12)]"
                />
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ========== Manage Proposals ========== -->
    <section
      class="relative overflow-hidden bg-white py-24 sm:py-28 lg:py-[150px]"
    >
      <div
        class="pointer-events-none absolute top-32 left-1/2 h-[420px] w-[900px] -translate-x-1/2 rounded-full bg-primary-500/5 blur-3xl"
      >
      </div>

      <div class="my-container relative z-10">
        <div class="mx-auto mb-14 max-w-[1120px] text-center lg:mb-20">
          <h2
            class="mb-6 text-center text-[31px] font-bold leading-[39px] text-neutral-950 sm:text-4xl sm:leading-[44px] xl:text-5xl xl:leading-[58px] 2xl:text-[56px] 2xl:leading-[68px]"
          >
            <span class="lg:whitespace-nowrap"
              >Manage Proposals From the First Estimate</span
            >
            <br class="hidden lg:block" />
            to the Final Job
          </h2>
          <p
            class="mx-auto max-w-[800px] text-base leading-6 text-neutral-700 sm:text-lg sm:leading-6"
          >
            Stop letting quotes get lost in someone's inbox. Knockio moves every
            opportunity, from the first estimate to a signed job, a change
            order, and a final invoice, through one connected pipeline so
            nothing falls through the cracks.
          </p>
        </div>

        <div class="mx-auto grid max-w-[1380px] gap-6 lg:grid-cols-3 lg:gap-8">
          <article
            class="group relative overflow-hidden rounded-[28px] border border-solid border-neutral-200 bg-white p-7 shadow-[0_18px_50px_rgba(15,23,42,0.05)] transition-all duration-300 hover:-translate-y-1 hover:border-primary-500/40 hover:shadow-[0_28px_70px_rgba(15,23,42,0.09)] sm:p-8 lg:p-9"
          >
            <div
