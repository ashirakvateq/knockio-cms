---
const title = 'Knockio · The Door Knocking App for Field Sales Teams';
const description =
  'Knockio is the door knocking app and door-to-door canvassing software for field sales teams. Territory mapping, live GPS, 10-second lead logging, and e-signatures. Trusted by 1,000+ teams.';
import '../styles/knockio-door-knocking-lp.css';

---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link
      rel="icon"
      type="image/webp"
      sizes="32x32"
      href="data:image/webp;base64,"
    />
  </head>
  <body>
    <script is:inline>
      
    </script>
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-MG8F3DS9"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="gtm"></iframe></noscript
    >

    <a class="skip" href="#top">Skip to content</a>
    <nav>
      <div class="wrap nav-in">
        <a class="brand" href="#top"
          ><img
            src="data:image/webp;base64,"
            alt="Knockio"
            class="brand-logo"
            decoding="async"
          /></a
        >
        <div class="nav-links">
          <a href="#features">Features</a>
          <a href="#how">How it works</a>
          <a href="#pricing">Pricing</a>
          <a href="#faq">FAQ</a>
        </div>
        <div class="nav-right">
          <button class="theme-btn" id="themeToggle" aria-label="Toggle theme"
            >◐</button
          >
          <a class="btn btn-primary btn-sm" href="#book-live" data-demo-scroll
            ><span class="cta-full">Book a Free Demo</span><span
              class="cta-short">Book a Demo</span
            ></a
          >
        </div>
      </div>
    </nav>

    <span id="top"></span>
    <header class="hero">
      <div class="wrap hero-grid">
        <div class="reveal in">
          <p class="eyebrow">Door-to-door canvassing software</p>
          <h1 style="margin-top:14px;">
            The door knocking app built to <span class="u"
              >close at the door.</span
            >
          </h1>
          <p class="lede">
            Territory mapping, live GPS, ten-second lead logging, and
            e-signatures. <b>Start solo for $25/mo</b> and add the whole crew when
            you're ready. It's the canvassing app that <b>1,000+ field teams</b> knock
            with every day.
          </p>
          <form class="email-form" novalidate>
            <input
              type="email"
              name="email"
              required
              placeholder="you@company.com"
              aria-label="Work email"
              autocomplete="email"
            />
            <a
              href="#cal-sec"
              role="button"
              class="btn btn-primary"
              data-demo-email>Book a Free Demo</a
            >
          </form>
          <p class="cta-alt">
            Or <a href="#" data-pricing
              >get started with the $25 Solo plan now →</a
            >
          </p>
          <p class="cta-note">month-to-month · no contracts · cancel anytime</p>
          <div
            class="platforms"
            aria-label="Also available as iOS, Android and web apps"
          >
            <span
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  d="M16.365 1.43c0 1.14-.493 2.27-1.177 3.08-.744.9-1.99 1.57-2.987 1.57-.12 0-.23-.02-.3-.03-.01-.06-.04-.22-.04-.39 0-1.15.572-2.27 1.206-2.98.804-.94 2.142-1.64 3.248-1.68.03.13.05.28.05.43zm4.565 15.71c-.03.07-.463 1.58-1.518 3.12-.945 1.34-1.94 2.71-3.43 2.71-1.517 0-1.9-.88-3.63-.88-1.698 0-2.302.91-3.67.91-1.377 0-2.332-1.26-3.428-2.8-1.287-1.82-2.323-4.63-2.323-7.28 0-4.28 2.797-6.55 5.552-6.55 1.448 0 2.675.95 3.6.95.865 0 2.222-1.01 3.902-1.01.613 0 2.886.06 4.374 2.19-.13.09-2.383 1.37-2.383 4.19 0 3.26 2.854 4.42 2.955 4.45z"
                ></path></svg
              >iOS</span
            >
            <span class="psep" aria-hidden="true">·</span>
            <span
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  d="M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V8H6v10zM3.5 8C2.67 8 2 8.67 2 9.5v7c0 .83.67 1.5 1.5 1.5S5 17.33 5 16.5v-7C5 8.67 4.33 8 3.5 8zm17 0c-.83 0-1.5.67-1.5 1.5v7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zm-4.97-5.84l1.3-1.3c.2-.2.2-.51 0-.71-.2-.2-.51-.2-.71 0l-1.48 1.48C13.85 1.23 12.95 1 12 1c-.96 0-1.86.23-2.66.63L7.85.15c-.2-.2-.51-.2-.71 0-.2.2-.2.51 0 .71l1.31 1.31C6.97 3.26 6 5.01 6 7h12c0-1.99-.97-3.75-2.47-4.84zM10 5H9V4h1v1zm5 0h-1V4h1v1z"
                ></path></svg
              >Android</span
            >
            <span class="psep" aria-hidden="true">·</span>
            <span
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                ></path></svg
              >Web app</span
            >
          </div>
        </div>

        <div class="reveal in heroimg">
          <img
            src="/assets/cfw/Knockio-web-and-app-preview.webp"
            alt="Knockio territory management dashboard showing two live territories with reps and mapped doors"
            loading="eager"
            width="791"
            height="637"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </header>

    <div class="trust">
      <div class="wrap trust-in">
        <span class="trust-lead">Trusted by 1,000+ field sales teams</span>
        <div class="rev">
          <span class="r"><span class="stars">★★★★★</span>Google</span>
          <span class="r"><span class="stars">★★★★★</span>Capterra</span>
          <span class="r"><span class="stars">★★★★★</span>Software Advice</span>
        </div>
        <div class="verts">
          <span class="pill">Roofing</span><span class="pill">Solar</span><span
            class="pill">Pest Control</span
          ><span class="pill">HVAC</span><span class="pill">+11 more</span>
        </div>
      </div>
    </div>

    <section id="stats" style="padding-top:clamp(44px,6vw,72px);">
      <div class="wrap reveal">
        <div class="stats">
          <div class="stat">
            <div class="n" data-count="1000">0<small>+</small></div><div
              class="l"
            >
              Field sales teams
            </div>
          </div>
          <div class="stat">
            <div class="n" data-count="12">0<small>+</small></div><div
              class="l"
            >
              Verticals supported
            </div>
          </div>
          <div class="stat">
            <div class="n">10<small>s</small></div><div class="l">
              To log a door
            </div>
          </div>
          <div class="stat">
            <div class="n">1</div><div class="l">Platform, knock to paid</div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="problem"
      style="background:var(--panel-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line);"
    >
      <div class="wrap">
        <div class="sec-head reveal">
          <p class="eyebrow">The problem</p>
          <h2>Field teams are stuck juggling too many tools.</h2>
          <p>
            A map in one app, the CRM in another, notes in a group chat. Things
            slip between the cracks, and it usually costs you the sale.
          </p>
        </div>
        <div class="probs reveal">
          <div class="prob">
            <span class="prob-ic"
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
                ></path><line x1="12" y1="9" x2="12" y2="13"></line><line
                  x1="12"
                  y1="17"
                  x2="12.01"
                  y2="17"></line></svg
              ></span
            ><h3>No shared job record</h3><p>
              Managers can't see where reps are, what they finished, or which
              leads need action.
            </p>
          </div>
          <div class="prob">
            <span class="prob-ic"
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
                ></path><line x1="12" y1="9" x2="12" y2="13"></line><line
                  x1="12"
                  y1="17"
                  x2="12.01"
                  y2="17"></line></svg
              ></span
            ><h3>Weak field visibility</h3><p>
              Notes, photos, and updates sit in different places, so teams
              repeat work and miss context.
            </p>
          </div>
          <div class="prob">
            <span class="prob-ic"
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
                ></path><line x1="12" y1="9" x2="12" y2="13"></line><line
                  x1="12"
                  y1="17"
                  x2="12.01"
                  y2="17"></line></svg
              ></span
            ><h3>Missed follow-ups</h3><p>
              Hot leads go cold when reminders and next steps aren't tied to one
              workflow.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="features">
      <div class="wrap">
        <div class="sec-head reveal">
          <p class="eyebrow">What the app does</p>
          <h2>Door knocking isn't the hard part. Keeping it organized is.</h2>
          <p>
            Paper notes, group chats, a separate map, a separate CRM. Knockio
            replaces the stack with one door knocking app your reps actually
            open.
          </p>
        </div>
        <div class="feat" style="margin-top:38px;">
          <div class="frow2 reveal">
            <div class="frow2-media pad">
              <img
                src="data:image/webp;base64,"
                alt="Territory management map in Knockio"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="frow2-body">
              <span class="ftag2">Territories &amp; campaigns</span><h3>
                No overlapping territory
              </h3><p>
                Draw unlimited territories, map them to campaigns, and assign
                reps to the same or different areas as each campaign needs.
                Every rep sees exactly the doors that are theirs, so no two
                people knock the same house.
              </p>
            </div>
          </div>
          <div class="frow2 reveal">
            <div class="frow2-media">
              <img
                src="data:image/webp;base64,"
                alt="Live rep tracking on the Knockio map"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="frow2-body">
              <span class="ftag2">Live rep tracking</span><h3>
                Full visibility of the field
              </h3><p>
                Live GPS shows who's out, where they are, and how far they are
                from the next door (or the pin they just dropped), so managers
                coach from the office instead of chasing texts.
              </p>
            </div>
          </div>
          <div class="frow2 reveal">
            <div class="frow2-media">
              <img
                src="data:image/webp;base64,"
                alt="Door-to-door lead capture in Knockio"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="frow2-body">
              <span class="ftag2">10-second logging</span><h3>
                Every door gets a record
              </h3><p>
                Log a knock in ten seconds: status, notes, photos. Set up a
                built-in automation once, and it schedules the callbacks for
                you, so no lead falls through the cracks between visits.
              </p>
            </div>
          </div>
          <div class="frow2 reveal">
            <div class="frow2-media pad">
              <img
                src="data:image/webp;base64,"
                alt="Digital contract and e-signature in Knockio"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="frow2-body">
              <span class="ftag2">Estimates &amp; e-sign</span><h3>
                Get it signed at the door
              </h3><p>
                Build the estimate and collect a digital signature. The knock,
                the pitch, and the close happen in the same app.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="how"
      style="background:var(--panel-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line);"
    >
      <div class="wrap">
        <div class="sec-head reveal">
          <p class="eyebrow">How it works</p>
          <h2>From the first knock to a signed job, in one flow.</h2>
        </div>
        <div class="pipe reveal" style="margin-top:36px;">
          <div class="step">
            <div class="k">STEP <b>01</b></div><h3>Knock</h3><ul>
              <li>Assigned territory</li><li>Optimized route</li><li>
                Offline-ready map
              </li>
            </ul><span class="arrow">→</span>
          </div>
          <div class="step">
            <div class="k">STEP <b>02</b></div><h3>Capture</h3><ul>
              <li>10-second door log</li><li>Photos &amp; notes</li><li>
                Disposition &amp; status
              </li>
            </ul><span class="arrow">→</span>
          </div>
          <div class="step">
            <div class="k">STEP <b>03</b></div><h3>Track</h3><ul>
              <li>Live rep GPS</li><li>Follow-up automations</li><li>
                Customer history
              </li>
            </ul><span class="arrow">→</span>
          </div>
          <div class="step">
            <div class="k">STEP <b>04</b></div><h3>Close</h3><ul>
              <li>On-door estimates</li><li>Digital signatures</li><li>
                Invoice &amp; payment
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="compare">
      <div class="wrap reveal">
        <div class="compare">
          <div>
            <p class="eyebrow">Why teams switch</p>
            <p class="big" style="margin-top:14px;">
              SalesRabbit and SPOTIO stop at the knock. <b
                >Knockio keeps going</b
              >: estimates, contracts, invoices, and payment in the same app.
            </p>
          </div>
          <div class="cmp-track">
            <div class="cmp-stage shared">
              <span class="tick">✓</span> Knock &amp; canvass <span class="who"
                >any canvassing app</span
              >
            </div>
            <div class="cmp-stage shared">
              <span class="tick">✓</span> Capture the lead <span class="who"
                >any canvassing app</span
              >
            </div>
            <div class="cmp-divider"><span>where others stop</span></div>
            <div class="cmp-stage only">
              <span class="tick">✓</span> Estimate at the door <span class="who"
                >only Knockio</span
              >
            </div>
            <div class="cmp-stage only">
              <span class="tick">✓</span> Contract &amp; e-sign <span
                class="who">only Knockio</span
              >
            </div>
            <div class="cmp-stage only">
              <span class="tick">✓</span> Invoice &amp; get paid <span
                class="who">only Knockio</span
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="ownership" style="padding-top:0;">
      <div class="wrap reveal">
        <div class="owncard">
          <p class="eyebrow">Built for high-turnover teams</p>
          <h2>Your leads stay with your company, not your reps.</h2>
          <p>
            Reps come and go. With Knockio, every door, note, and customer
            record stays in your account, and you decide exactly what each rep
            can see.
          </p>
        </div>
      </div>
    </section>

    <section
      id="reviews"
      style="background:var(--panel-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line);"
    >
      <div class="wrap">
        <div class="sec-head reveal">
          <p class="eyebrow">In the field</p>
          <h2>What door-to-door teams say after they switch.</h2>
        </div>
        <div class="tgrid reveal" style="margin-top:34px;">
          <div class="tcard">
            <div class="stars">★★★★★</div><p>
              "This app is the best thing that has happened to our company! The
              support team is so responsive."
            </p><div class="who">
              <span class="av">LJ</span><div>
                <b>Lacey Jackson</b><span>Field sales</span>
              </div>
            </div>
          </div>
          <div class="tcard">
            <div class="stars">★★★★★</div><p>
              "We use it for roofing sales canvassing. Their support team is
              responsive and fixes issues immediately."
            </p><div class="who">
              <span class="av">BL</span><div>
                <b>Ben Loveland</b><span>Roofing</span>
              </div>
            </div>
          </div>
          <div class="tcard">
            <div class="stars">★★★★★</div><p>
              "Tracking leads has never been simpler. We can see real-time
              updates and assign territory in seconds."
            </p><div class="who">
              <span class="av">MP</span><div>
                <b>Michael Palmer</b><span>Sales Manager · Modern Roofing</span>
              </div>
            </div>
          </div>
          <div class="tcard">
            <div class="stars">★★★★★</div><p>
              "The live tracking feature is very useful. The pricing is fair as
              well!"
            </p><div class="who">
              <span class="av">BG</span><div>
                <b>Bar Galanti</b><span>Field sales</span>
              </div>
            </div>
          </div>
          <div class="tcard">
            <div class="stars">★★★★★</div><p>
              "My team and I absolutely love using it, so user friendly and
              simple."
            </p><div class="who">
              <span class="av">GH</span><div>
                <b>Georgia Hancocks</b><span>Operations</span>
              </div>
            </div>
          </div>
          <div class="tcard">
            <div class="stars">★★★★★</div><p>
              "It's solving a lot of the issues of the other canvassing apps we
              tried."
            </p><div class="who">
              <span class="av">SB</span><div>
                <b>Sarah Bennett</b><span>Field sales</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="case-study">
      <div class="wrap">
        <div class="sec-head reveal" style="max-width:62ch;">
          <p class="eyebrow">Case study · Roofing</p>
          <h2>
            1,100 leads in 72 hours, and $30k a month clawed back from busywork.
          </h2>
          <p>
            Modern Roofing runs 45 canvassers across 15 locations in 5 states.
            They knocked doors on five disconnected tools, then moved canvassing
            all the way to payment onto one Knockio record in six weeks.
          </p>
        </div>
        <div class="cs-wrap reveal">
          <div class="cs-stats">
            <div class="cs-stat">
              <b>1,100</b><span
                >inbound leads in the first 72 hrs of a storm</span
              >
            </div>
            <div class="cs-stat">
              <b>60%</b><span>first-contact rate during storm response</span>
            </div>
            <div class="cs-stat">
              <b>$30k</b><span>operating cost recovered every month</span>
            </div>
            <div class="cs-stat">
              <b>2.5 hrs</b><span>of admin cut per rep, every week</span>
            </div>
          </div>
          <blockquote class="cs-quote">
            <p>
              &ldquo;The first 72 hours after a storm decide the claim. We were
              wasting chunks of those moving data between apps.&rdquo;
            </p>
            <footer>
              <span class="cs-av">SP</span><span class="cs-who"
                ><b>Steven Purdy</b><span
                  >District Manager &middot; Modern Roofing</span
                ></span
              >
            </footer>
          </blockquote>
        </div>
        <div class="cs-cta reveal">
          <a class="btn btn-primary" href="#cal-sec" data-demo
            >See it on your streets</a
          >
          <a
            class="cs-link"
            href="/case-studies/modern-roofing/"
            target="_blank"
            rel="noopener">Read the full case study &rarr;</a
          >
        </div>
      </div>
    </section>

    <section
      id="book-live"
      style="background:var(--panel-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line);"
    >
      <div class="wrap reveal">
        <div
          class="sec-head"
          style="max-width:62ch;margin:0 auto;text-align:center;"
        >
          <p class="eyebrow">Book a live demo</p>
          <h2>See it on your streets. Pick a time.</h2>
          <p style="margin-left:auto;margin-right:auto;">
            20 minutes, live. We'll map one of your neighborhoods and walk the
            knock-to-paid flow. No slides, just your streets.
          </p>
        </div>
        <div
          id="calInline"
          class="cal-inline"
          role="region"
          aria-label="Book a Knockio demo"
        >
        </div>
        <p class="cal-inline-note">
          Can't find a time that works? <a
            href="https://knockio.com/book-a-demo/"
            target="_blank"
            rel="noopener">Open the full booking page ↗</a
          >
        </p>
      </div>
    </section>

    <section id="pricing">
      <div class="wrap">
        <div class="sec-head reveal">
          <p class="eyebrow">Pricing</p>
          <h2>Start solo from $25/mo. Add the crew when you're ready.</h2>
          <p>
            One rep or a hundred. Month-to-month, pro-rated, no setup fee.
            Volume pricing kicks in automatically at five users.
          </p>
          <div class="ptoggle" role="group" aria-label="Team size">
            <button id="tier1" aria-pressed="true">1-4 users</button>
            <button id="tier5" aria-pressed="false">5+ users</button>
          </div>
        </div>
        <div class="plans reveal">
          <div class="plan">
            <div class="pname">
              Prospect <span
                style="font-family:var(--mono);font-size:11px;color:var(--field);background:var(--field-soft);padding:3px 8px;border-radius:6px;margin-left:6px;vertical-align:middle;letter-spacing:.02em;"
