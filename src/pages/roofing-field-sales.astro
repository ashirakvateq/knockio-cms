---
import LandingPagesLayout from "../layouts/LandingPagesLayout.astro";
import "../styles/roofing.css";
import "../styles/canvassing-app.css";
import canvassingScript from "../scripts/canvassing-app.js?url";
import calInlineScript from "../scripts/cal-inline.js?url";
import {
  ArrowRight,
  BadgeCheck,
  BarChart3,
  Boxes,
  CalendarDays,
  CalendarX,
  Camera,
  ChartLine,
  Check,
  CheckCircle2,
  ClipboardList,
  CreditCard,
  DollarSign,
  FileSignature,
  FolderOpen,
  LayoutDashboard,
  Map,
  MapPin,
  MessageSquare,
  Minus,
  Phone,
  Plug,
  Plus,
  Radio,
  TrendingDown,
} from "lucide-astro";
import {
  roofingCycleCards,
  roofingFaqs,
  roofingHero,
  roofingPricingPlans,
  roofingTestimonial,
  roofingTrustLogos,
  roofingWorkSteps,
  workflowGroups,
} from "../data/roofingFieldSales";

import { stats } from "../data/canvassingApp";

const title = "Roofing Sales Software & CRM for Field Teams | Knockio";
const description =
  "Territory, live tracking, and payments for retail and insurance roofing jobs. One platform, first knock to collected payment. No contract.";

const iconMap = { Map, ChartLine, Boxes } as const;
const workflowIconMap = {
  MapPin,
  Radio,
  BarChart3,
  MessageSquare,
  Camera,
  FileSignature,
  ClipboardList,
  FolderOpen,
  DollarSign,
  TrendingDown,
  LayoutDashboard,
  CreditCard,
} as const;

const currentYear = new Date().getFullYear();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://knockio.com/#organization",
      name: "Knockio",
      url: "https://knockio.com/",
      logo: "https://knockio.com/assets/cfw/knockio-logo.webp",
      sameAs: [
        "https://www.facebook.com/knockioapp",
        "https://www.linkedin.com/company/knockio",
        "https://x.com/knockioapp",
        "https://www.youtube.com/@knockioapp",
      ],
    },
    {
      "@type": "WebPage",
      "@id": "https://knockio.com/roofing-field-sales/#webpage",
      url: "https://knockio.com/roofing-field-sales/",
      name: "Roofing Sales Software & CRM for Field Teams | Knockio",
      isPartOf: { "@id": "https://knockio.com/#website" },
      inLanguage: "en-US",
    },
    {
      "@type": "FAQPage",
      "@id": "https://knockio.com/roofing-field-sales/#faq",
      mainEntity: roofingFaqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://knockio.com/roofing-field-sales/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://knockio.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Roofing Field Sales",
          item: "https://knockio.com/roofing-field-sales/",
        },
      ],
    },
  ],
};
---

<LandingPagesLayout
  title={title}
  description={description}
  ogImage="/assets/cfw/capterra.webp"
  bodyClass="storm-page"
  jsonLd={jsonLd}
  robots="noindex, follow"
  noHeader
  noFooter
  preloadImages={[
    {
      href: `${roofingHero.image}`,
      imagesrcset: `/assets/storm-restoration-roofing/restoration-hero-480.webp 480w, /assets/storm-restoration-roofing/restoration-hero-1280.webp 1280w`,
      imagesizes: "(max-width: 767px) 92vw, 56vw",
    },
    { href: "/assets/canvassing-app/green-name-1280.png" },
  ]}
>
  <main>
    <section class="storm-hero">
      <div
        class="my-container grid items-center gap-10 pt-[50px] lg:grid-cols-[0.85fr_1.15fr]"
      >
        <div class="storm-reveal max-lg:text-center">
          <a href="/" aria-label="Knockio home" class="mb-6 inline-block">
            <img
              src="/assets/canvassing-app/green-name-1280.png"
              alt="Knockio"
              width="1280"
              height="193"
              class="h-auto w-56 sm:w-72 xl:w-80"
              decoding="async"
            />
          </a>

          <h1 class="storm-hero-heading">
            {roofingHero.title}<br class="hidden sm:block" />
            <span class="text-primary-600">{roofingHero.titleBreak1}</span><br
              class="hidden sm:block"
            />
            {roofingHero.titleBreak2}
          </h1>

          <p class="storm-hero-subtitle">
            {roofingHero.description}
          </p>

          <div
            class="storm-reveal-cta mt-8 flex flex-col gap-3 sm:flex-row max-lg:justify-center"
          >
            <a
              href="#landing-pricing"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-500 px-6 py-4 text-base font-bold text-white shadow-lg shadow-primary-500/25 transition hover:bg-primary-600 hover:shadow-primary-500/35"
            >
              Get Started
              <ArrowRight size={18} aria-hidden="true" />
            </a>
            <a
              href="#landing-calender"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-500 px-6 py-4 text-base font-bold text-white shadow-lg shadow-primary-500/25 transition hover:bg-primary-600 hover:shadow-primary-500/35"
            >
              Book a Free Demo
              <ArrowRight size={18} aria-hidden="true" />
            </a>
          </div>

          <ul
            class="storm-hero-checklist mt-7 space-y-3 text-left max-lg:mx-auto max-lg:max-w-xl"
          >
            <li class="flex items-start gap-3">
              <CheckCircle2
                class="mt-1 shrink-0 text-primary-500"
                size={20}
                aria-hidden="true"
              />
              <span
                >No contract, cancel anytime or book a demo if you'd like a
                walkthrough first.</span
              >
            </li>
          </ul>

          <div class="mt-7 flex flex-wrap gap-4 max-lg:justify-center">
            <a
              href="https://play.google.com/store/apps/details?id=com.knockio.crm&hl=en"
              target="_blank"
              rel="noopener"
              aria-label="Download Knockio on Google Play"
              class="shadow-md transition hover:opacity-90"
            >
              <img
                src="/assets/cfw/google-play-button.webp"
                alt="Get it on Google Play"
                width="520"
                height="154"
                class="h-auto w-36 xl:w-44 lg:w-[145px]"
                loading="lazy"
                decoding="async"
              />
            </a>
            <a
              href="https://apps.apple.com/us/app/knockio-field-service-crm/id6756485440"
              target="_blank"
              rel="noopener"
              aria-label="Download Knockio on the App Store"
              class="shadow-md transition hover:opacity-90"
            >
              <img
                src="/assets/cfw/apple-store-button.webp"
                alt="Download on the App Store"
                width="520"
                height="154"
                class="h-auto w-36 xl:w-44 lg:w-[145px]"
                loading="lazy"
                decoding="async"
              />
            </a>
          </div>
        </div>

        <div
          class="storm-reveal storm-hero-img-wrap"
          style="--reveal-delay: 120ms"
        >
          <picture>
            <source
              srcset="/assets/storm-restoration-roofing/restoration-hero-480.webp"
              media="(max-width: 767px)"
            />
            <img
              src="/assets/cfw/roofing-field-hero-1280.webp"
              alt={roofingHero.imageAlt}
              width={roofingHero.imageWidth}
              height={roofingHero.imageHeight}
              fetchpriority="high"
              loading="lazy"
              decoding="async"
              class="mx-auto h-auto w-full max-w-5xl"
            />
          </picture>
        </div>
      </div>
    </section>

    <section aria-labelledby="trusted-heading" class="storm-trust-section">
      <div class="my-container text-center">
        <h2 id="trusted-heading">
          Trusted by 1,000+ field sales teams from Roofing and Solar to Pest
          Control, HVAC, and beyond.
        </h2>
        <div class="storm-trust-logos">
          {
            roofingTrustLogos.map((logo) => (
              <img
                class="storm-trust-logo"
                src={logo.src}
                alt={logo.alt}
                width="139"
                height="56"
                loading="lazy"
                decoding="async"
              />
            ))
          }
        </div>
      </div>
    </section>

    <section class="stats-section lg:py-36">
      <div class="my-container">
        <h2 class="section-heading">Why Roofing Teams Choose Knockio?</h2>
        <div class="stats-row grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {
            stats.map(([value, label]) => (
              <article class="stat-blurb">
                <div>
                  <h4>
                    <span>{value}</span>
                  </h4>
                  <p>{label}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="features-section">
      <div class="my-container">
        <h2 class="section-heading">
          The Best Canvassing Software For Field Teams
        </h2>
        <div class="features-grid">
          {
            roofingCycleCards.map((feature) => (
              <article class="feature-card" data-aos="fade-up">
                <img
                  src={feature.image}
                  alt=""
                  width={feature.width}
                  height={feature.height}
                  class="feature-img"
                  loading="lazy"
                  decoding="async"
                />
                <h3 class="feature-heading">{feature.title}</h3>
                <p class="feature-desc">{feature.copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="storm-testimonial-section">
      <div class="my-container">
        <div class="mt-5 mb-10 flex justify-center">
          <a
            href="#landing-calender"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-500 px-7 py-4 font-bold text-white shadow-lg shadow-primary-500/25 transition hover:bg-primary-600 hover:shadow-primary-500/35"
          >
            Book a Free Demo
            <ArrowRight size={18} aria-hidden="true" />
          </a>
        </div>
        <div class="storm-testimonial-quote-wrap mt-8">
          <p>
            &ldquo;{roofingTestimonial.quote}&rdquo;
          </p>
        </div>
        <div class="storm-testimonial-author">
          <img
            src={roofingTestimonial.image}
            alt=""
            width="80"
            loading="lazy"
            decoding="async"
          />
          <div>
            <h6>{roofingTestimonial.name}</h6>
            <p>{roofingTestimonial.role}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="operations-section">
      <div class="container">
        <div class="editorial-header">
          <div class="headline-column">
            <h2 class="operations-headline">
              Everything Your<br />
              Roofing Operation<br />
              Runs On
            </h2>
          </div>

          <div class="intro-column">
            <p class="operations-pull-quote">
              Three parts of your operation. One platform. Nothing handed off to
              a separate tool.
            </p>
          </div>
        </div>

        <div class="columns-grid">
          <div class="category-column">
            <div class="category-header">
              <div class="category-number">I</div>
              <h3 class="category-title">Field Sales</h3>
            </div>

            <ul class="feature-list">
              <li class="feature-item">
                <h4 class="feature-title">Territory Assignment</h4>
                <p class="feature-desc">
                  Assign streets and neighborhoods before your reps leave the
                  lot.
                </p>
              </li>
              <li class="feature-item">
                <h4 class="feature-title">Live Rep Tracking</h4>
                <p class="feature-desc">
                  See every rep's real-time location and activity on the map.
                </p>
              </li>
              <li class="feature-item">
                <h4 class="feature-title">Rep Performance</h4>
                <p class="feature-desc">
                  Measure doors knocked, leads, conversations, and jobs.
                </p>
              </li>
              <li class="feature-item">
                <h4 class="feature-title">Communications</h4>
                <p class="feature-desc">
                  Text, call, and email homeowners from one place. All
                  conversations are logged.
                </p>
              </li>
            </ul>
          </div>

          <div class="category-column">
            <div class="category-header">
              <div class="category-number">II</div>
              <h3 class="category-title">Completion</h3>
            </div>

            <ul class="feature-list">
              <li class="feature-item">
                <h4 class="feature-title">Damage & Roof Doc.</h4>
                <p class="feature-desc">
                  Capture photos, videos, notes, and homeowner details in
                  seconds.
                </p>
              </li>
              <li class="feature-item">
                <h4 class="feature-title">Contracts & Signing</h4>
                <p class="feature-desc">
                  Legally binding e-signatures captured on-site, even offline.
                  Retail contracts or insurance contingencies.
                </p>
              </li>
              <li class="feature-item">
                <h4 class="feature-title">Work Order Creation</h4>
                <p class="feature-desc">
                  Convert signed agreements into work orders and jobs with one
                  tap.
                </p>
              </li>
              <li class="feature-item">
                <h4 class="feature-title">Document Storage</h4>
                <p class="feature-desc">
                  Store photos, contracts, invoices, and all job files tied to
                  one record.
                </p>
              </li>
            </ul>
          </div>

          <div class="category-column">
            <div class="category-header">
              <div class="category-number">III</div>
              <h3 class="category-title">Business Control</h3>
            </div>

            <ul class="feature-list">
              <li class="feature-item">
                <h4 class="feature-title">Estimates & Invoicing</h4>
                <p class="feature-desc">
                  Build branded estimates and send invoices from the field.
                </p>
              </li>
              <li class="feature-item">
                <h4 class="feature-title">Insurance Payment Tracking</h4>
                <p class="feature-desc">
                  Track ACV and depreciation separately on insurance jobs.
                </p>
              </li>
              <li class="feature-item">
                <h4 class="feature-title">Campaign Reporting</h4>
                <p class="feature-desc">
                  Dashboards show what's winning. Campaigns, reps, markets.
                </p>
              </li>
              <li class="feature-item">
                <h4 class="feature-title">Payment Processing</h4>
                <p class="feature-desc">
                  Pay vendors. Collect payments. Every transaction tied to the
                  job.
                </p>
              </li>
            </ul>
          </div>
        </div>
        <div class="mt-12 table mx-auto">
          <a
            href="#landing-calender"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-500 px-7 py-4 font-bold text-white shadow-lg shadow-primary-500/25 transition hover:bg-primary-600 hover:shadow-primary-500/35"
          >
            Book a Free Demo
            <ArrowRight size={18} aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <section class="onboarding-section">
      <div class="container">
        <div class="editorial-header">
          <!-- Headline Column -->
          <div class="headline-column">
            <h2 class="onboarding-main-headline">
              Switching<br />
              <span class="headline-sub">to Knockio is</span><br />
              <span class="headline-accent">Easy.</span>
            </h2>
          </div>

          <!-- Intro / Pull-Quote Column -->
          <div class="intro-column">
            <p class="onboarding-pull-quote">
              Most roofing teams come from JobNimbus, AccuLynx, or a patchwork
              of canvassing tools, spreadsheets, and WhatsApp threads. <br /><br
              />
              <span class="pull-quote-strong"
                >Knockio replaces the whole stack, starting at the door, not the
                office</span
              >
            </p>
          </div>
        </div>

        <div>
          <!-- Process Subhead -->
          <h3 class="process-subhead">Here's how it works</h3>

          <!-- 3-Column Grid for Steps -->
          <div class="steps-grid">
            {
              roofingWorkSteps.map((step, index) => (
                <div class="step-card">
                  <div class="step-number">0{index + 1}</div>
                  <h4 class="step-title">{step.title}</h4>
                  <p class="step-description">{step.copy}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <section id="landing-pricing" class="pricing-section">
    <div class="my-container max-w-[1330px] mx-auto">
      <div class="text-center gap-3 mb-12">
        <h2 class="section-heading">
          Straightforward Pricing<br /> No Surprises
        </h2>
        <p class="section-copy">
          Start with the plan your team needs now. Add users as you grow, volume
          discounts apply automatically at 5 users.
        </p>
        <div
          class="pricing-badge mt-8 inline-flex items-center gap-2 rounded-full border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-900"
        >
          <CheckCircle2 size={18} class="text-primary-500" aria-hidden="true" />
          <span>Pro-rated billing. No setup fee</span>
        </div>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-14 max-xl:gap-7 max-w-[1330px] mx-auto items-stretch"
      >
        {
          roofingPricingPlans.map((plan) => {
            const Icon = iconMap[plan.icon as keyof typeof iconMap];
            return (
              <article
                class:list={[
                  "pricing-card relative flex flex-col",
                  plan.featured && "is-featured",
                ]}
              >
                {plan.featured && (
                  <p class="pricing-badge absolute -top-4 left-1/2 -translate-x-1/2 rounded-full border border-white/20 bg-primary-500 px-8 py-1.5 text-sm font-bold text-white">
                    Recommended
                  </p>
                )}
                <div class="pricing-header flex items-center gap-4">
                  <Icon
                    class={
                      plan.featured ? "text-primary-400" : "text-primary-600"
                    }
                    size={27}
                    aria-hidden="true"
                  />
                  <h3
                    class:list={[
                      "pricing-title text-3xl font-extrabold",
                      plan.featured ? "text-white" : "text-slate-950",
                    ]}
                  >
                    {plan.title}
                  </h3>
                </div>
                <p
                  class:list={[
                    "pricing-desc text-base leading-7",
                    plan.featured ? "text-slate-300" : "text-slate-600",
                  ]}
                >
                  {plan.description}
                </p>
                <p
                  class:list={[
                    "pricing-price flex items-end text-5xl font-extrabold",
                    plan.featured ? "text-white" : "text-slate-950",
                  ]}
                >
                  {plan.price}
                  <span
                    class:list={[
                      "pricing-unit ml-2 pb-1 text-base font-medium",
                      plan.featured ? "text-slate-400" : "text-slate-500",
                    ]}
                  >
                    /user/mo
                  </span>
                </p>
                <p
                  class:list={[
                    "pricing-discount text-sm",
                    plan.featured ? "text-slate-400" : "text-slate-500",
                  ]}
                >
                  {plan.discountNote}
                </p>
                <button
                  type="button"
                  data-checkout-package={plan.packageId}
                  class:list={[
                    "pricing-cta w-full rounded-md px-5 py-3 font-bold transition",
                    plan.featured
                      ? "bg-primary-500 text-white hover:bg-primary-600"
                      : "border border-primary-500 bg-white text-primary-600 hover:bg-primary-500 hover:text-white",
                  ]}
                >
                  {plan.cta}
                </button>
                <h4
                  class:list={[
                    "pricing-features-heading text-xl font-bold",
                    plan.featured ? "text-white" : "text-slate-950",
                  ]}
                >
                  Features Included:
                </h4>
                <ul class="pricing-features-list flex-1 space-y-3.5">
                  {plan.features.map((feature) => (
                    <li
                      class:list={[
                        "flex items-start gap-3 text-base leading-7",
                        plan.featured ? "text-slate-300" : "text-slate-700",
                      ]}
                    >
                      {feature.includes("Engage") ? (
                        <Phone
                          class="mt-1 shrink-0 text-primary-500"
                          size={18}
                          aria-hidden="true"
                        />
                      ) : feature.includes("Zapier") ? (
                        <Plug
                          class="mt-1 shrink-0 text-slate-400"
                          size={18}
                          aria-hidden="true"
                        />
                      ) : (
                        <Check
                          class="mt-1 shrink-0 text-primary-500"
                          size={18}
                          aria-hidden="true"
                        />
                      )}
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="calender-section py-24 lg:py-36">
    <div class="my-container">
      <h2 class="section-heading">
        See how Knockio runs the full roofing sales cycle
      </h2>
      <p class="section-copy">
        A live walkthrough built around your team size, your markets, and
        whether you run retail, insurance, or both. No pitch deck. No recorded
        video. No pressure.
      </p>

      <div class="calender-wrapper mt-8">
        <div class="calender-wrapper-div">
          <CalendarDays size={28} class="text-[#53aa38]" aria-hidden="true" />
          <span>Month to Month</span>
        </div>
        <div class="calender-wrapper-div">
          <FileSignature size={28} class="text-[#53aa38]" aria-hidden="true" />
          <span>No contract</span>
        </div>
        <div class="calender-wrapper-div">
          <CalendarX size={28} class="text-[#53aa38]" aria-hidden="true" />
          <span>Cancel anytime</span>
        </div>
      </div>

      <div
        id="landing-calender"
        class="cal-shell mx-auto mt-12 max-w-5xl p-2 sm:p-3 lg:p-4"
      >
        <div
          id="my-cal-inline"
          class="cal-placeholder grid place-items-center overflow-hidden"
          aria-live="polite"
        >
          <div class="max-w-md p-6 text-center">
            <CalendarDays
              class="mx-auto text-primary-500"
              size={42}
              aria-hidden="true"
            />
            <p class="mt-4 text-xl font-extrabold text-slate-950">
              Loading the live demo calendar
            </p>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              The scheduler loads only when you reach it, keeping the hero fast
              for PageSpeed and search visitors.
            </p>
            <button
              type="button"
              data-load-cal
              class="mt-5 rounded-xl bg-primary-500 px-5 py-3 text-sm font-bold text-white transition hover:bg-primary-600"
            >
              Load calendar now
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="faq-section py-24 lg:py-36" aria-labelledby="faq-heading">
    <div class="my-container">
      <p
        class="faq-heading-text text-center text-sm font-bold uppercase tracking-[0.18em] text-primary-500 md:text-2xl"
      >
        Common Questions
      </p>

      <div class="faq-container space-y-4">
        {
          roofingFaqs.map(
            (faq: { question: string; answer: string }, index: number) => (
              <details
                class="faq-item rounded-2xl border border-slate-200 bg-white transition"
                data-faq-item={faq.question}
                open={index === 0}
              >
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-left sm:p-6">
                  <span class="text-lg font-bold text-slate-950 sm:text-xl">
                    {faq.question}
                  </span>
                  <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-primary-50 text-primary-600">
                    <Plus class="faq-plus" size={20} aria-hidden="true" />
                    <Minus class="faq-minus" size={20} aria-hidden="true" />
                  </span>
                </summary>
                <div class="px-5 pb-6 text-base leading-8 text-slate-600 sm:px-6">
                  {faq.answer}
                </div>
              </details>
            ),
          )
        }
      </div>
    </div>
  </section>
</LandingPagesLayout>

