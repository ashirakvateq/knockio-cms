---
import LandingPagesLayout from "../layouts/LandingPagesLayout.astro";
import CalendarLoadingCopy from "../components/CalendarLoadingCopy.astro";
import "../styles/door-to-door-sales-app.css";
import "../styles/roofing.css";
import {
  ArrowRight,
  CalendarDays,
  CalendarX,
  FileSignature,
  Minus,
  Plus,
} from "lucide-astro";
import { stormTrustLogos } from "../data/stormRestoration";
import { DoorToDoorSalesAppFaqs } from "../data/DoorToDoorSalesApp";

const title = "Knockio Door to Door Sales App | Semantic Pixel";
const description =
  "Most door to door software stops at the logged lead. Knockio carries it further—territory, live tracking, estimates, contracts, and payment on one record.";
const ogImage =
  "/assets/cfw/knockio-semantic-pixel-knockio-field-sales-product-visual-f1cf47c102.png";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://knockio.com/knockio-semantic-pixel/#webpage",
    url: "https://knockio.com/knockio-semantic-pixel/",
    name: title,
    description,
    isPartOf: { "@id": "https://knockio.com/#website" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": "https://knockio.com/knockio-semantic-pixel/#breadcrumb",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://knockio.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Knockio Semantic Pixel",
        item: "https://knockio.com/knockio-semantic-pixel/",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "https://knockio.com/knockio-semantic-pixel/#faq",
    mainEntity: DoorToDoorSalesAppFaqs.map(
      (faq: { question: string; answer: string }) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      }),
    ),
  },
];
---

<LandingPagesLayout
  title={title}
  description={description}
  ogImage={ogImage}
  bodyClass="ksp-body"
  jsonLd={jsonLd}
  noHeader
  preloadImages={[
    { href: "/assets/cfw/green-name-640.webp" },
    {
      href: "/assets/cfw/knockio-semantic-pixel-knockio-field-sales-product-visual-f1cf47c102.png",
    },
  ]}
>
  <div class="ksp-page">
    <!-- SECTION 1 — HERO -->
    <section class="hero" aria-labelledby="hero-heading">
      <div
        class="hero-section grid items-center gap-10 pt-[50px] lg:grid-cols-[0.85fr_1.15fr]"
      >
        <div class="hero-copy storm-reveal max-lg:text-center pb-[20px] min-w-0">
          <a href="/" aria-label="Knockio home" class="mb-6 inline-block max-w-full">
            <img
              src="/assets/cfw/green-name-640.webp"
              alt="Knockio"
              width="1280"
              height="193"
              class="h-auto w-56 max-w-full sm:w-72 xl:w-80"
              decoding="async"
              loading="eager"
            />
          </a>

          <h1 id="hero-heading" class="storm-hero-heading">
            The <span class="text-primary-600">Door to Door</span> Sales<br
              class="hidden sm:block"
            />
            App That Goes Past the<br class="hidden sm:block" />
            Knock
          </h1>

          <p class="hero-intro storm-hero-subtitle">
            Most door to door software stops at the logged lead. Knockio carries it further.
            Territory, live tracking, estimates, contracts, and payment on one record.
            Door to door sales software your reps will actually open.
          </p>

          <ul class="hero-bullets">
            <li><span class="tick">✓</span><span>Territory assigned before reps leave</span></li>
            <li><span class="tick">✓</span><span>Log a door in 10 seconds</span></li>
            <li><span class="tick">✓</span><span>Lead proximity on every door</span></li>
            <li><span class="tick">✓</span><span>Estimate built in the field</span></li>
            <li><span class="tick">✓</span><span>Signed on the porch</span></li>
            <li><span class="tick">✓</span><span>Invoice/payment on the same record</span></li>
          </ul>

          <div
            class="hero-actions storm-reveal-cta mt-8 flex flex-col gap-3 sm:flex-row max-lg:justify-center"
          >
            <a
              href="#landing-pricing"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-500 px-6 py-4 text-base font-bold text-white shadow-lg shadow-primary-500/25 transition hover:bg-primary-600 hover:shadow-primary-500/35"
            >
              Get Started
              <ArrowRight size={18} aria-hidden="true" />
            </a>
            <a
              href="#landing-calender"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-500 px-6 py-4 text-base font-bold text-white shadow-lg shadow-primary-500/25 transition hover:bg-primary-600 hover:shadow-primary-500/35"
            >
              Book a Free Demo
              <ArrowRight size={18} aria-hidden="true" />
            </a>
          </div>

          <p class="hero-note max-lg:mx-auto">
            No contract, Cancel anytime or book a demo<br>
            if you'd like a walkthrough first.
          </p>

          <div class="mt-7 flex flex-wrap gap-4 max-lg:justify-center">
            <a
              href="https://play.google.com/store/apps/details?id=com.knockio.crm&hl=en"
              target="_blank"
              rel="noopener"
              aria-label="Download Knockio on Google Play"
              class="shadow-md transition hover:opacity-90"
            >
              <img
                src="/assets/cfw/google-play-button.webp"
                alt="Get it on Google Play"
                width="520"
                height="154"
                class="h-auto w-36 xl:w-44 lg:w-[145px]"
                loading="lazy"
                decoding="async"
              />
            </a>
            <a
              href="https://apps.apple.com/us/app/knockio-field-service-crm/id6756485440"
              target="_blank"
              rel="noopener"
              aria-label="Download Knockio on the App Store"
              class="shadow-md transition hover:opacity-90"
            >
              <img
                src="/assets/cfw/apple-store-button.webp"
                alt="Download on the App Store"
                width="520"
                height="154"
                class="h-auto w-36 xl:w-44 lg:w-[145px]"
                loading="lazy"
                decoding="async"
              />
            </a>
          </div>
        </div>

        <div
          class="hero-visual storm-reveal storm-hero-img-wrap self-end min-w-0"
          style="--reveal-delay: 120ms"
        >
          <img
            src="/assets/cfw/door-to-door-sales-hero-image.webp"
            alt="Knockio field sales product visual"
            width="1780"
            height="1200"
            class="mx-auto h-auto w-full max-w-5xl"
            decoding="async"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section aria-labelledby="trusted-heading" class="storm-trust-section">
      <div class="my-container text-center">
        <h2 id="trusted-heading">
          Trusted by 1,000+ field sales teams from Roofing and Solar to Pest
          Control, HVAC, and beyond.
        </h2>
        <div class="storm-trust-logos">
          {
            stormTrustLogos.map((logo) => (
              <img
                class="storm-trust-logo"
                src={logo.src}
                alt={logo.alt}
                width="139"
                height="56"
                loading="lazy"
                decoding="async"
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- SECTION 3 — PROBLEM -->
    <section class="problems" aria-labelledby="problem-heading">
      <div class="container">

        <header class="problems-header">
          <h2 id="problem-heading">
            Your Reps are Not the Problem<br>
            What Happens After the Door is
          </h2>

          <p>
            A rep knocks 60 doors. Ten of them go somewhere. By the time the office hears about it,
            three have gone quiet and two have already signed with someone else. Nothing was written
            down in a place anyone else could see.
          </p>
        </header>

        <div class="problem-grid">

          <article class="problem-card">
            <div class="problem-copy">
              <div class="problem-title">
                <img src="/assets/cfw/door-to-door-icon1.webp" alt="" loading="lazy" decoding="async">
                <h3>The Lead Lives on one Phone</h3>
              </div>
              <p>
                A name in a notes app. A photo in a camera roll. When that rep is off on Tuesday,
                nobody else can work the lead.
              </p>
            </div>
            <div class="problem-visual">
              <img src="/assets/cfw/door-to-door-sales-img1.webp" alt="Notes app showing a lead stored on one phone" loading="lazy" decoding="async">
            </div>
          </article>

          <article class="problem-card">
            <div class="problem-visual top">
              <img src="/assets/cfw/door-to-door-sales-img2.webp" alt="Map showing two reps at the same house" loading="lazy" decoding="async">
            </div>
            <div class="problem-copy bottom">
              <div class="problem-title">
                <img src="/assets/cfw/door-to-door-icon2.webp" alt="" loading="lazy" decoding="async">
                <h3>Two reps, one house</h3>
              </div>
              <p>
                Without a shared map, your team knocks the same door twice and misses the street
                behind it. The homeowner notices.
              </p>
            </div>
          </article>

          <article class="problem-card">
            <div class="problem-copy">
              <div class="problem-title">
                <img src="/assets/cfw/door-to-door-icon3.webp" alt="" loading="lazy" decoding="async">
                <h3>The follow-up nobody owns</h3>
              </div>
              <p>
                Everyone assumed someone else was calling back. Nobody was.
              </p>
            </div>
            <div class="problem-visual">
              <img src="/assets/cfw/door-to-door-sales-img3.webp" alt="Team group showing an unanswered follow-up" loading="lazy" decoding="async">
            </div>
          </article>

          <article class="problem-card">
            <div class="problem-visual top">
              <img src="/assets/cfw/door-to-door-sales-img4.webp" alt="Estimate sent two days after the knock" loading="lazy" decoding="async">
            </div>
            <div class="problem-copy bottom">
              <div class="problem-title">
                <img src="/assets/cfw/door-to-door-icon4.webp" alt="" loading="lazy" decoding="async">
                <h3>The estimate that took two days</h3>
              </div>
              <p>
                The homeowner was ready on the porch. By the time the number arrived, so had three competitors.
              </p>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- SECTION 4 — CTA BAND -->
    <section class="green-band" id="demo" aria-labelledby="growth-heading">
      <div class="container">
        <div class="eyebrow">From the First Knock to the Paid Invoice</div>
        <h2 id="growth-heading">Drive Sales Growth Like Never Before</h2>
        <p>One app instead of three. Territory, leads, estimates, and payment in one place.</p>
        <a class="button button-pill" href="#landing-calender">Book a Free Demo</a>
      </div>
    </section>

    <!-- SECTION 5 — MANAGERS + REPS -->
    <section class="audiences">
      <div class="container">

        <article class="audience-row">
          <div class="audience-copy">
            <div class="audience-label">For Owners and Sales Managers</div>
            <h2>Know What Happened Today</h2>

            <p>
              Most owners run the day on trust. A rep says he knocked the street, and there is no way
              to know until it is too late to do anything about it. That is working blind, and it is
              the first thing every manager brings up.
            </p>

            <ul class="feature-list">
              <li>
                <span class="tick">✓</span>
                <div>
                  <strong>See every rep on one map</strong>
                  <span>Live location and activity while they are still out. No check-in calls.</span>
                </div>
              </li>
              <li>
                <span class="tick">✓</span>
                <div>
                  <strong>Know who is working</strong>
                  <span>Every lead shows how far the rep was from the door when they logged it.</span>
                </div>
              </li>
              <li>
                <span class="tick">✓</span>
                <div>
                  <strong>Coach from what actually happened</strong>
                  <span>Doors knocked, conversations had, deals signed. By rep, by territory, by campaign.</span>
                </div>
              </li>
              <li>
                <span class="tick">✓</span>
                <div>
                  <strong>The pipeline is not in someone's head</strong>
                  <span>Every lead sits on a board with a stage you can read at a glance.</span>
                </div>
              </li>
            </ul>

            <a class="button button-light" href="#landing-calender">Book a Free Demo</a>
          </div>

          <div class="audience-visual">
            <img src="/assets/cfw/door-to-door-sales-img5.webp" alt="Knockio territory manager dashboard" loading="lazy" decoding="async">
          </div>
        </article>

        <article class="audience-row reps">
          <div class="audience-visual">
            <img src="/assets/cfw/door-to-door-sales-img6.webp" alt="Knockio rep mobile lead logging interface" loading="lazy" decoding="async">
          </div>

          <div class="audience-copy">
            <div class="audience-label">For Reps</div>
            <h2>
              Ten Seconds a Door<br>
              Then Back to Knocking
            </h2>

            <p>
              Most owners run the day on trust. A rep says he knocked the street, and there is no way
              to know until it is too late to do anything about it. That is working blind, and it is
              the first thing every manager brings up.
            </p>

            <ul class="feature-list">
              <li>
                <span class="tick">✓</span>
                <div>
                  <strong>Log it before you step off the porch</strong>
                  <span>Outcome, photo, notes. Ten seconds.</span>
                </div>
              </li>
              <li>
                <span class="tick">✓</span>
                <div>
                  <strong>Not home becomes a callback</strong>
                  <span>Scheduled automatically before the rep walks away. If the rep forgets, the system does not.</span>
                </div>
              </li>
              <li>
                <span class="tick">✓</span>
                <div>
                  <strong>Your streets, clearly marked</strong>
                  <span>No guessing which houses are yours and which are already done.</span>
                </div>
              </li>
              <li>
                <span class="tick">✓</span>
                <div>
                  <strong>Every lead shows how far you were</strong>
                  <span>Lead proximity is recorded in feet on every door you log.<br>Your numbers speak for themselves.</span>
                </div>
              </li>
            </ul>

            <a class="button button-light" href="#landing-calender">Book a Free Demo</a>
          </div>
        </article>

      </div>
    </section>

    <!-- SECTION 6 — CTA BAND -->
    <section class="green-band" aria-labelledby="won-heading">
      <div class="container">
        <div class="eyebrow">From the First Knock to the Paid Invoice</div>
        <h2 id="won-heading">Stop Losing Deals You Already Won</h2>
        <p>Your rep knocked it. Knockio takes it the rest of the way.</p>
        <a class="button button-pill" href="#landing-calender">Book a Free Demo</a>
      </div>
    </section>

    <!-- SECTION 7 — KNOCK TO PAID -->
    <section class="knock-paid" aria-labelledby="knock-paid-heading">
      <div class="container">

        <div class="section-label">The Whole Sale Not Just the Knock</div>

        <h2 id="knock-paid-heading">
          Most Door To Door Apps Stop<br>
          at the Lead This One Does Not
        </h2>

        <p class="intro">
          One app instead of three. Your rep knocked it. Knockio takes it the rest of the way.
        </p>

        <p class="keyword-line">
          Door canvassing software and apps for door to door sales should<br>
          not stop at a logged lead.
        </p>

        <div class="stage-grid">

          <article class="stage-card">
            <img src="/assets/cfw/knockio-semantic-pixel-pixel-18-29d01feb51.png" alt="" loading="lazy" decoding="async">
            <h3>Knock</h3>
            <p>
              Territory assigned before the rep leaves. Every door logged where the whole team can see it.
            </p>
          </article>

          <article class="stage-card">
            <img src="/assets/cfw/knockio-semantic-pixel-pixel-19-bd08243d70.png" alt="" loading="lazy" decoding="async">
            <h3>Document</h3>
            <p>
              Photos, notes, and homeowner details saved to the lead, not to a camera roll.
            </p>
          </article>

          <article class="stage-card">
            <img src="/assets/cfw/knockio-semantic-pixel-pixel-20-47a4783246.png" alt="" loading="lazy" decoding="async">
            <h3>Close</h3>
            <p>
              Build a branded estimate in the field on retail jobs. On insurance work, document the
              damage and get the contingency signed on the spot.
            </p>
          </article>

          <article class="stage-card">
            <img src="/assets/cfw/knockio-semantic-pixel-pixel-21-ea9eed3292.png" alt="" loading="lazy" decoding="async">
            <h3>Invoice</h3>
            <p>
              Send the invoice the same day the job is won. No re-entry, no second tool.
            </p>
          </article>

          <article class="stage-card">
            <img src="/assets/cfw/knockio-semantic-pixel-pixel-22-a70d45bc19.png" alt="" loading="lazy" decoding="async">
            <h3>Paid</h3>
            <p>
              Collect payment on site or by link. Every transaction tied back to the job it came from.
            </p>
          </article>

        </div>
      </div>
    </section>

    <section class="calender-section">
      <div class="my-container">
        <h2 class="section-heading text-center mx-auto w-full">
          Watch Your Door To Door Cycle, Live
        </h2>
        <p class="section-copy text-center mx-auto w-full max-w-3xl">
          No pitch deck. No scripted walkthrough. No pressure. A live session
          built around your vertical and team size, so you can see exactly how it
          handles your workflow before you decide.
        </p>
  
        <div class="calender-wrapper mt-8">
          <div class="calender-wrapper-div">
            <CalendarDays size={28} class="text-[#53aa38]" aria-hidden="true" />
            <span>Month to Month</span>
          </div>
          <div class="calender-wrapper-div">
            <FileSignature size={28} class="text-[#53aa38]" aria-hidden="true" />
            <span>No contract</span>
          </div>
          <div class="calender-wrapper-div">
            <CalendarX size={28} class="text-[#53aa38]" aria-hidden="true" />
            <span>Cancel anytime</span>
          </div>
        </div>
  
        <div
          id="landing-calender"
          class="cal-shell mx-auto mt-12 max-w-5xl p-2 sm:p-3 lg:p-4"
        >
          <CalendarLoadingCopy />
          <div
            id="my-cal-inline"
            class="cal-placeholder grid place-items-center overflow-hidden"
            aria-live="polite"
            aria-busy="false"
            aria-label="Book a demo"
            role="region"
          >
          </div>
        </div>
      </div>
    </section>
  
    <section
      id="landing-pricing"
      class="pricing-section relative z-10 py-20 max-xl:py-16 max-lg:py-14 mt-10"
    >
      <div class="my-container">
        <div class="mb-10 text-center max-md:mb-7">
          <h2
            class="mx-auto mb-4 w-full max-w-4xl text-center text-[56px] font-bold leading-tight text-neutral-900 max-2xl:text-5xl max-xl:text-4xl max-md:text-3xl"
          >
            Straightforward pricing. No surprises.
          </h2>
          <p
            class="mx-auto w-full max-w-3xl text-center text-lg text-neutral-600 max-xl:text-base"
          >
            Choose the tools your team needs today, or combine your entire
            field-sales and service operation in one connected platform.
          </p>
        </div><div class="mb-12 flex flex-wrap items-center justify-center gap-3">
          <div
            class="flex items-center rounded-full border border-solid border-neutral-200 px-5 py-2.5 text-sm text-neutral-900"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              stroke-width="2"
              width="24"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
              class="lucide lucide-check mr-2 size-4 shrink-0 text-primary-500"
              ><path d="M20 6 9 17l-5-5"></path></svg
            ><span>Pro-rated billing</span>
          </div><div
            class="flex items-center rounded-full border border-solid border-neutral-200 px-5 py-2.5 text-sm text-neutral-900"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              stroke-width="2"
              width="24"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
              class="lucide lucide-check mr-2 size-4 shrink-0 text-primary-500"
              ><path d="M20 6 9 17l-5-5"></path></svg
            ><span>No setup fee</span>
          </div><div
            class="flex items-center rounded-full border border-solid border-neutral-200 px-5 py-2.5 text-sm text-neutral-900"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              stroke-width="2"
              width="24"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
              class="lucide lucide-check mr-2 size-4 shrink-0 text-primary-500"
              ><path d="M20 6 9 17l-5-5"></path></svg
            ><span>No contracts</span>
          </div><a
            href="https://knockio.com/pricing/#pricing-compare"
            class="flex items-center rounded-full border border-solid border-primary-200 px-5 py-2.5 text-sm font-medium text-primary-600 transition-colors hover:bg-primary-50"
            >Compare plans in detail<svg
              xmlns="http://www.w3.org/2000/svg"
              stroke-width="2"
              width="24"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
              class="lucide lucide-arrow-down ml-2 size-3"
              ><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg
            ></a
          >
        </div><div
          class="mx-auto grid w-full max-w-[1200px] grid-cols-1 items-stretch justify-center gap-7 lg:grid-cols-3"
        >
          <div
            class="kio-pricing-card flex flex-col rounded-3xl border border-solid border-neutral-200 bg-white p-7 transition duration-150 ease-out hover:-translate-y-1 hover:shadow-xl max-md:p-6"
          >
            <div class="mb-3 flex items-start justify-between gap-4">
              <div class="flex items-center gap-4">
                <span
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600"
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    stroke-width="2"
                    width="24"
                    height="24"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    class="lucide lucide-map size-5"
                    ><path
                      d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"
                    ></path><path d="M15 5.764v15"></path><path d="M9 3.236v15"
                    ></path></svg
                  ></span
                ><div>
                  <p
                    class="mb-1 text-xs font-bold uppercase tracking-wider text-blue-600"
                  >
                    Field Sales
                  </p><h3
                    class="text-3xl font-bold text-neutral-900 max-xl:text-2xl"
