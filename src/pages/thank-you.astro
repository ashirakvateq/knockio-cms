---
import KnockioHomeLayout from "../layouts/KnockioHomeLayout.astro";
import "../styles/thank-you.css";
import {
  Check,
  Tags,
  Newspaper,
  CalendarCheck,
  Mail,
  Clock,
  MessagesSquare,
  Info,
  Quote,
} from "lucide-astro";

const title = "thank you - Knockio";
const description =
  "We're excited to connect with you. Your meeting has been scheduled, and our team will meet you at the selected time.";
const ogImage = "/assets/cfw/all-devices-view-knockio-1024x390.webp";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://knockio.com/thank-you/#webpage",
    url: "https://knockio.com/thank-you/",
    name: "thank you - Knockio",
    description,
    isPartOf: {
      "@id": "https://knockio.com/#website",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": "https://knockio.com/thank-you/#breadcrumb",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://knockio.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Thank You",
        item: "https://knockio.com/thank-you/",
      },
    ],
  },
];

const reviewsRow1 = [
  {
    name: "Lacey Jackson",
    avatar: "/assets/cfw/avatar-lacey-jackson.webp",
    quote:
      "This app is the best thing that has happened to our company! Asad is absolutely amazing! He is so responsive, it doesn't matter what time of day he is on it! I highly recommend this company add this app!",
  },
  {
    name: "Ben Loveland",
    avatar: "/assets/cfw/avatar-ben-loveland.webp",
    quote:
      "Knockio is a great product! We use it for our roofing sales canvassing. Their support team is responsive and fixes issues immediately. Highly recommend!",
  },
  {
    name: "Bar Galanti",
    avatar: "/assets/cfw/avatar-bar-galanti.webp",
    quote:
      "The support team is awesome. The live tracking feature is very useful. The pricing is fair as well!",
  },
];

const reviewsRow2 = [
  {
    name: "Georgia Hancocks",
    avatar: "/assets/cfw/avatar-georgia-hancocks.webp",
    quote:
      "Knockio is the best! My team and I absolutely love using it - it is so user friendly and simple. Support is brilliant too, nothing is ever too much trouble. The best on the market. Thanks Knockio!",
  },
  {
    name: "Sarah Bennett",
    avatar: "/assets/cfw/avatar-sarah-bennett.webp",
    quote:
      "We love Knockio so far! It is solving a lot of the issues of the other canvassing apps. The team have worked with us providing excellent fast support. Highly recommend if you're seeing people face to face.",
  },
  {
    name: "Ayana Hall",
    avatar: "/assets/cfw/avatar-ayana-hall.webp",
    quote:
      "Amazing app! Definitely has helped out my team a whole lot from our previous canvassing software. They identified what we were struggling with and needed, and everything has been addressed. Highly recommend.",
  },
];
---

<KnockioHomeLayout
  title={title}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  whiteBg={true}
>
  <main class="ty-page overflow-hidden bg-white">
    <!-- THANK YOU PAGE SECTION -->
    <section
      class="relative flex min-h-[calc(100vh-90px)] items-center overflow-hidden bg-neutral-50 py-16 sm:py-20 lg:py-24"
    >
      <!-- Background Effects -->
      <div class="pointer-events-none absolute inset-0">
        <div
          class="absolute -left-28 top-16 h-72 w-72 rounded-full bg-primary-500/10 blur-3xl"
        >
        </div>
        <div
          class="absolute right-0 top-24 h-96 w-96 translate-x-1/3 rounded-full bg-primary-500/10 blur-3xl"
        >
        </div>
        <div
          class="absolute bottom-0 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-white blur-3xl"
        >
        </div>

        <!-- Soft grid pattern -->
        <div
          class="absolute inset-0 opacity-[0.35] [background-image:linear-gradient(to_right,#e5e7eb_1px,transparent_1px),linear-gradient(to_bottom,#e5e7eb_1px,transparent_1px)] [background-size:56px_56px]"
        >
        </div>
      </div>

      <div class="relative z-10 my-container mx-auto">
        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-16">
          <!-- Left Content -->
          <div class="text-center lg:col-span-6 lg:text-left">
            <!-- Badge -->
            <div
              class="mb-5 mt-6 inline-flex items-center gap-2 rounded-full border border-primary-500/20 bg-primary-500/10 px-4 py-2"
            >
              <span
                class="ty-badge-icon flex h-6 w-6 items-center justify-center rounded-full bg-primary-500 text-white"
              >
                <Check aria-hidden="true" stroke-width={3} />
              </span>
              <span class="text-xs font-medium text-primary-600 sm:text-sm">
                Meeting scheduled successfully
              </span>
            </div>

            <!-- Heading -->
            <h1
              class="mb-5 text-4xl font-extrabold leading-tight text-neutral-950 sm:text-5xl lg:text-[58px] lg:leading-[1.08]"
            >
              Thank You for Scheduling a Meeting! 🎉
            </h1>

            <!-- Paragraph -->
            <p
              class="mx-auto mb-8 max-w-[620px] text-sm leading-6 text-neutral-600 sm:text-base sm:leading-7 md:text-lg md:leading-8 lg:mx-0"
            >
              We’re excited to connect with you. Your meeting has been scheduled,
              and our team will meet you at the selected time.
            </p>

            <!-- Buttons -->
            <div
              class="flex flex-col justify-center gap-4 sm:flex-row lg:justify-start"
            >
              <a
                href="/"
                class="inline-flex w-full items-center justify-center rounded-lg bg-primary-500 px-6 py-3.5 text-sm font-medium text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-primary-600 hover:shadow-lg hover:shadow-primary-500/25 sm:w-auto sm:px-10 sm:py-4 sm:text-base"
              >
                Back to Home
              </a>
            </div>

            <!-- Quick Links -->
            <div
              class="mt-9 flex flex-wrap justify-center gap-3 lg:justify-start"
            >
              <a
                href="/pricing/"
                class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm font-medium text-neutral-700 shadow-sm transition-all duration-300 hover:border-primary-500/40 hover:text-primary-600"
              >
                <span class="ty-chip-icon text-primary-500">
                  <Tags aria-hidden="true" />
                </span>
                Pricing
              </a>

              <a
                href="/blog/"
                class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm font-medium text-neutral-700 shadow-sm transition-all duration-300 hover:border-primary-500/40 hover:text-primary-600"
              >
                <span class="ty-chip-icon text-primary-500">
                  <Newspaper aria-hidden="true" />
                </span>
                Blog
              </a>
            </div>
          </div>

          <!-- Right Visual Card -->
          <div class="lg:col-span-6">
            <div class="relative mx-auto max-w-[620px] lg:ml-auto">
              <!-- Offset Border -->
              <div
                class="absolute -right-4 -bottom-5 hidden h-full w-full rounded-[2rem] border border-primary-500/20 lg:block"
              >
              </div>

              <div
                class="relative overflow-hidden rounded-[2rem] border border-neutral-200 bg-white p-5 shadow-xl shadow-neutral-900/10 sm:p-8 lg:p-10"
              >
                <!-- Card Glow -->
                <div
                  class="pointer-events-none absolute -right-20 -top-20 h-56 w-56 rounded-full bg-primary-500/10"
                >
                </div>
                <div
                  class="pointer-events-none absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-neutral-100"
                >
                </div>

                <div class="relative z-10">
                  <!-- Visual Header -->
                  <div class="mb-8 flex items-center justify-between gap-4">
                    <div>
                      <p class="mb-1 text-sm font-medium text-primary-500">
                        Meeting status
                      </p>
                      <h3
                        class="text-2xl font-bold text-neutral-950 sm:text-3xl"
                      >
                        You’re All Set
                      </h3>
                    </div>

                    <div
                      class="ty-status-icon flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-primary-500 text-white"
                    >
                      <CalendarCheck aria-hidden="true" />
                    </div>
                  </div>

                  <!-- Schedule Illustration -->
                  <div class="relative rounded-[1.5rem] bg-neutral-50 p-5 sm:p-8">
                    <!-- Route Line -->
                    <div
                      class="absolute left-[2.75rem] top-12 h-[calc(100%-96px)] w-1 rounded-full bg-primary-500/20 sm:left-[3.25rem]"
                    >
                    </div>

                    <!-- Step 1 -->
                    <div class="relative z-10 mb-7 flex items-start gap-4">
                      <span
                        class="ty-step-icon flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary-500 text-white shadow-lg shadow-primary-500/20"
                      >
                        <Mail aria-hidden="true" />
                      </span>

                      <div class="rounded-2xl bg-white p-4 shadow-sm">
                        <h4 class="text-sm font-semibold text-neutral-950">
                          Confirmation sent
                        </h4>
                        <p class="mt-1 text-xs leading-5 text-neutral-500">
                          Please check your email for the meeting details.
                        </p>
                      </div>
                    </div>

                    <!-- Step 2 -->
                    <div class="relative z-10 mb-7 flex items-start gap-4">
                      <span
                        class="ty-step-icon flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary-500 text-white shadow-lg shadow-primary-500/20"
                      >
                        <Clock aria-hidden="true" />
                      </span>

                      <div class="rounded-2xl bg-white p-4 shadow-sm">
                        <h4 class="text-sm font-semibold text-neutral-950">
                          Join on time
                        </h4>
                        <p class="mt-1 text-xs leading-5 text-neutral-500">
                          Be ready at your selected meeting time.
                        </p>
                      </div>
                    </div>

                    <!-- Step 3 -->
                    <div class="relative z-10 flex items-start gap-4">
                      <span
                        class="ty-step-icon flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary-500 text-white shadow-lg shadow-primary-500/20"
                      >
                        <MessagesSquare aria-hidden="true" />
                      </span>

                      <div class="rounded-2xl bg-white p-4 shadow-sm">
                        <h4 class="text-sm font-semibold text-neutral-950">
                          Discuss next steps
                        </h4>
                        <p class="mt-1 text-xs leading-5 text-neutral-500">
                          We’ll understand your needs and guide you forward.
                        </p>
                      </div>
                    </div>
                  </div>

                  <!-- Bottom Help Note -->
                  <div
                    class="mt-5 flex items-start gap-3 rounded-2xl border border-primary-500/15 bg-primary-500/5 p-4"
                  >
                    <span class="ty-info-icon mt-0.5 text-primary-500">
                      <Info aria-hidden="true" />
                    </span>

                    <p
                      class="text-xs leading-5 text-neutral-600 sm:text-sm sm:leading-6"
                    >
                      Didn’t receive the confirmation email? Please check your
                      spam folder or contact our team for help.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CUSTOMER REVIEWS -->
    <section class="overflow-hidden bg-white py-16 sm:py-20 lg:py-24">
      <div class="my-container mx-auto mb-10 text-center lg:mb-16">
        <p
          class="mb-4 text-sm leading-7 text-primary-500 md:text-2xl font-inter"
        >
          Customer Reviews
        </p>
        <h2
          class="mb-8 text-3xl font-bold leading-tight text-neutral-950 sm:text-4xl lg:text-[42px] lg:leading-none xl:text-5xl 2xl:text-[56px]"
        >
          What Field Service and Sales<br />
          Teams Say About Knockio
        </h2>

        <img
          src="/assets/cfw/google-5-star.webp"
          alt="google review badge"
          width="183"
          height="60"
          decoding="async"
          loading="lazy"
          class="mx-auto h-auto w-[150px] sm:w-[183px]"
        />
      </div>

      <div class="mt-7 space-y-8">
        <div class="testimonial-track-container flex overflow-hidden">
          <div
            class="testimonial-track hover:pause flex animate-marquee-left gap-4 sm:gap-6"
          >
            {
              [0, 1].map((dup) => (
                <div
                  class="card-set flex gap-4 sm:gap-6"
                  aria-hidden={dup === 1 ? "true" : undefined}
                >
                  {reviewsRow1.map((review) => (
                    <div class="group relative w-[300px] flex-shrink-0 rounded-2xl border border-neutral-200 bg-neutral-50 p-5 sm:w-[380px] sm:p-6 lg:w-[450px] lg:p-8">
                      <p class="relative z-10 mb-6 min-h-[168px] text-sm italic text-neutral-700 sm:mb-8 sm:text-base lg:text-lg">
                        {review.quote}
                      </p>
                      <div class="relative z-10 flex items-center gap-4">
                        <img
                          src={review.avatar}
                          alt={review.name}
                          width="48"
                          height="48"
                          decoding="async"
                          loading="lazy"
                          class="h-12 w-12 rounded-full object-cover grayscale transition-all group-hover:grayscale-0"
                        />
                        <div>
                          <h5 class="mb-1 font-bold text-neutral-950">
                            {review.name}
                          </h5>
                          <p
                            class="text-sm text-neutral-500"
                            aria-label="5 out of 5 stars"
                          >
                            ⭐⭐⭐⭐⭐
                          </p>
                        </div>
                      </div>
                      <Quote
                        size="1em"
                        class="ty-quote-icon pointer-events-none absolute right-8 bottom-6 text-5xl text-primary-500/10 sm:text-6xl lg:text-7xl"
                        aria-hidden="true"
                      />
                    </div>
                  ))}
                </div>
              ))
            }
          </div>
        </div>

        <div class="testimonial-track-container flex overflow-hidden">
          <div
            class="testimonial-track hover:pause flex animate-marquee-right gap-4 sm:gap-6"
          >
            {
              [0, 1].map((dup) => (
                <div
                  class="card-set flex gap-4 sm:gap-6"
                  aria-hidden={dup === 1 ? "true" : undefined}
                >
                  {reviewsRow2.map((review) => (
                    <div class="group relative w-[300px] flex-shrink-0 rounded-2xl border border-neutral-200 bg-neutral-50 p-5 sm:w-[380px] sm:p-6 lg:w-[450px] lg:p-8">
                      <p class="relative z-10 mb-6 min-h-[168px] text-sm italic text-neutral-700 sm:mb-8 sm:text-base lg:text-lg">
                        {review.quote}
                      </p>
                      <div class="relative z-10 flex items-center gap-4">
                        <img
                          src={review.avatar}
                          alt={review.name}
                          width="48"
                          height="48"
                          decoding="async"
                          loading="lazy"
                          class="h-12 w-12 rounded-full object-cover grayscale transition-all group-hover:grayscale-0"
                        />
                        <div>
                          <h5 class="mb-1 font-bold text-neutral-950">
                            {review.name}
                          </h5>
                          <p
                            class="text-sm text-neutral-500"
                            aria-label="5 out of 5 stars"
                          >
                            ⭐⭐⭐⭐⭐
                          </p>
                        </div>
                      </div>
                      <Quote
                        size="1em"
                        class="ty-quote-icon pointer-events-none absolute right-8 bottom-6 text-5xl text-primary-500/10 sm:text-6xl lg:text-7xl"
                        aria-hidden="true"
                      />
                    </div>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    (function () {
      function getQueryParam(param: string) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(param);
      }

      const bookingName = getQueryParam("name") || "Guest";
      const bookingEmail = getQueryParam("email") || "Not provided";
      const bookingDate = getQueryParam("date") || "No date selected";
      const bookingDuration = getQueryParam("duration") || "Unknown";

      console.log("Booking Info:");
      console.log("Name:", bookingName);
      console.log("Email:", bookingEmail);
      console.log("Date:", bookingDate);
      console.log("Duration:", bookingDuration);
    })();
  </script>
</KnockioHomeLayout>
