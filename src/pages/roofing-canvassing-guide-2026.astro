    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://knockio.com/roofing-canvassing-guide-2026/#webpage",
    url: "https://knockio.com/roofing-canvassing-guide-2026/",
    name: "roofing canvassing guide 2026 - Knockio",
    description:
      "A practical playbook for roofing teams that want better door-to-door systems, stronger reps, cleaner territories, smarter follow-ups, and higher close rates",
    isPartOf: {
      "@id": "https://knockio.com/#website",
    },
    about: {
      "@id": "https://knockio.com/canvassing/#software",
    },
    audience: {
      "@type": "Audience",
