                  <Check class="h-5 w-5" />
                </span>
                <span class="text-sm font-medium leading-5 text-neutral-700">
                  Price surge playbook for roofers
                </span>
              </div>

              <div class="flex items-center gap-3 rounded-2xl border border-neutral-200 bg-white p-4 shadow-sm">
