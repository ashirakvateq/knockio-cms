---

<KnockioHomeLayout title={title} description={description} jsonLd={jsonLd}>
  <!-- Roofing Canvassing Guide Page -->
  <main class="overflow-hidden bg-white">
    <!-- HERO SECTION -->
    <section class="relative overflow-hidden bg-neutral-50 py-16 sm:py-20 lg:py-28">
