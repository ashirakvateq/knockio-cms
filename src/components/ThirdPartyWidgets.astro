---
interface Props {
  talkgenie?: boolean;
}

const { talkgenie = true } = Astro.props;
const TALKGENIE_UID = "7ea6979e-c78c-4ec3-a26a-822f2665858b";
const TALKGENIE_SRC = "https://unpkg.com/talkgeniejs@latest/talkgeniejs.umd.js";
---

{talkgenie && (
  <script
    is:inline
    define:vars={{ TALKGENIE_UID, TALKGENIE_SRC }}
  >
    (function () {
      var talkgenieLoaded = false;

      function loadTalkgenie() {
        if (talkgenieLoaded) return;
        talkgenieLoaded = true;

        window.protoSettings = { widgetUid: TALKGENIE_UID };

        var s = document.createElement("script");
        s.src = TALKGENIE_SRC;
        s.type = "text/javascript";
        s.async = true;
        document.head.appendChild(s);
      }

      function arm() {
        var events = ["pointerdown", "keydown", "touchstart"];

        events.forEach(function (eventName) {
          window.addEventListener(eventName, loadTalkgenie, {
            once: true,
            passive: true,
          });
        });

        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(loadTalkgenie, { timeout: 8000 });
        } else {
          window.setTimeout(loadTalkgenie, 5000);
        }
      }

      if (document.readyState === "complete") {
        arm();
      } else {
        window.addEventListener("load", arm, { once: true });
      }
    })();
  </script>
)}
