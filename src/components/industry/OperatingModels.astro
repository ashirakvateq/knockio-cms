---
import {
  Activity,
  ArrowRightLeft,
  BadgeCheck,
  Battery,
  BatteryFull,
  Blocks,
  Box,
  Boxes,
  Briefcase,
  Building,
  Building2,
  CalendarCheck,
  Carrot,
  CircuitBoard,
  CloudLightning,
  Cog,
  DoorOpen,
  Droplets,
  Factory,
  FileText,
  Flame,
  Gem,
  HandCoins,
  HardHat,
  Home,
  Hotel,
  House,
  Layers,
  Leaf,
  Lock,
  MapPin,
  Paintbrush,
  Package,
  PawPrint,
  Plug,
  Repeat,
  Shield,
  ShieldAlert,
  ShieldCheck,
  Snowflake,
  SprayCan,
  Sprout,
  Sun,
  Thermometer,
  Truck,
  Users,
  Warehouse,
  Wifi,
  Wrench,
  Zap,
} from "lucide-astro";

type OperatingModelCard = {
  icon: string;
  title: string;
  text: string;
  pills: string[];
};

type Props = {
  pillTag: string;
  title: string;
  subtitle: string;
  cards: OperatingModelCard[];
};

const { pillTag, title, subtitle, cards } = Astro.props;

const iconMap: Record<string, any> = {
  home: Home,
  house: House,
  "cloud-lightning": CloudLightning,
  layers: Layers,
  building: Building,
  "building-2": Building2,
  sun: Sun,
  "file-text": FileText,
  battery: Battery,
  "battery-full": BatteryFull,
  "truck-fast": Truck,
  "calendar-check": CalendarCheck,
  thermometer: Thermometer,
  snowflake: Snowflake,
  "faucet-drip": Droplets,
  tools: Wrench,
  wrench: Wrench,
  "house-flood": HandCoins,
  zap: Zap,
  "charging-station": Plug,
  plug: Plug,
  "plug-bolt": CircuitBoard,
  bug: ShieldAlert,
  "house-circle": ShieldAlert,
  paw: PawPrint,
  "building-shield": Shield,
  leaf: Leaf,
  "spray-can": SprayCan,
  trowel: Sprout,
  "water-ladder": Droplets,
  cog: Cog,
  droplet: Droplets,
  hotel: Hotel,
  "paint-roller": Paintbrush,
  shield: Shield,
  "shield-halved": ShieldCheck,
  broom: Wrench,
  hammer: HardHat,
  "truck-ramp": Package,
  warehouse: Warehouse,
  gem: Gem,
  repeat: Repeat,
  lock: Lock,
  "house-signal": Wifi,
  "map-pin": MapPin,
  "tower-cell": Factory,
  blocks: Blocks,
  users: Users,
  "badge-check": BadgeCheck,
  activity: Activity,
  "arrow-right-left": ArrowRightLeft,
  box: Box,
  boxes: Boxes,
  briefcase: Briefcase,
  carrot: Carrot,
  "door-open": DoorOpen,
  flame: Flame,
};

function getIcon(name: string) {
  return iconMap[name] || Circle;
}

import { Circle } from "lucide-astro";
---

<section class="border-b border-t border-solid border-neutral-200/80 bg-neutral-50 py-20 sm:py-24 lg:py-28">
  <div class="my-container">

    <div class="mx-auto mb-12 max-w-[1020px] text-center lg:mb-16">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-solid border-primary-500/30 bg-primary-50 px-4 py-1.5">
        <span class="flex h-2 w-2 rounded-full bg-primary-50"></span>
        <span class="text-xs font-bold uppercase tracking-[0.14em] text-primary-700">
          {pillTag}
        </span>
      </div>

      <h2 class="mb-5 text-center text-[34px] font-bold leading-[42px] text-neutral-950 sm:text-4xl sm:leading-[48px] xl:text-5xl xl:leading-[58px]">
        {title}
      </h2>

      <p class="mx-auto max-w-[860px] text-base font-normal leading-8 text-neutral-600 sm:text-lg sm:leading-9">
        {subtitle}
      </p>
    </div>

    <div class="mx-auto grid max-w-[1280px] gap-6 sm:grid-cols-2 lg:gap-8">
      {cards.map((card) => (
        <article class="flex flex-col justify-between rounded-[24px] border border-solid border-neutral-200 bg-white p-7 shadow-sm transition-all duration-300 hover:border-primary-500/50 hover:shadow-md sm:p-8">
          <div>
            <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-50 text-primary-600">
              {(() => {
                const Icon = getIcon(card.icon);
                return <Icon class="size-6" aria-hidden="true" />;
              })()}
            </div>

            <h3 class="mb-3 text-2xl font-bold leading-8 text-neutral-950">
              {card.title}
            </h3>

            <p class="mb-6 text-base leading-7 text-neutral-600">
              {card.text}
            </p>
          </div>

          <div class="flex flex-wrap gap-2 border-t border-solid border-neutral-100 pt-4">
            {card.pills.map((pill) => (
              <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold text-neutral-700">
                {pill}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
