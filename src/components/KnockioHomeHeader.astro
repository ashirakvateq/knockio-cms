</header>

<div id="mobileMenuOverlay" class="kh-mobile-overlay" aria-hidden="true"></div>

<aside id="mobileSidebar" class="kh-sidebar" aria-hidden="true" aria-label="Mobile navigation">
  <div class="kh-sidebar-inner">
    <div class="kh-sidebar-head">
      <a href="/" class="kh-logo" aria-label="Knockio home">
        <img src="/assets/cfw/knockio-logo.webp" alt="Knockio" width="120" height="36" decoding="async" />
      </a>
      <button id="mobileCloseBtn" type="button" class="kh-sidebar-close" aria-label="Close menu">
        <X size={20} aria-hidden="true" />
      </button>
    </div>

    <div class="kh-sidebar-scroll">
      <div class="kh-mobile-section">
        <button type="button" class="kh-mobile-accordion-toggle" aria-expanded="false" data-target="mobileProductsSubmenu">
          <span class="kh-mobile-accordion-left">
            <span class="kh-mobile-accordion-icon"><Boxes size={18} aria-hidden="true" /></span>
            <span class="kh-mobile-accordion-title">
              <span>Products</span>
              <span>Choose your Knockio workflow</span>
            </span>
          </span>
          <ChevronDown size={12} class="kh-mobile-accordion-chevron" aria-hidden="true" />
        </button>
        <div id="mobileProductsSubmenu" class="kh-mobile-submenu" aria-hidden="true">
          <div class="kh-mobile-submenu-grid">
            {products.map(({ href, icon: Icon, label }) => (
              <a href={href} class="kh-mobile-submenu-link">
                <Icon size={16} aria-hidden="true" />
                <span>{label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="kh-mobile-section">
        <button type="button" class="kh-mobile-accordion-toggle" aria-expanded="false" data-target="mobileFeaturesSubmenu">
          <span class="kh-mobile-accordion-left">
            <span class="kh-mobile-accordion-icon"><Layers size={18} aria-hidden="true" /></span>
            <span class="kh-mobile-accordion-title">
              <span>Features</span>
              <span>Explore Knockio tools</span>
            </span>
          </span>
          <ChevronDown size={12} class="kh-mobile-accordion-chevron" aria-hidden="true" />
        </button>
        <div id="mobileFeaturesSubmenu" class="kh-mobile-submenu" aria-hidden="true">
          <div class="kh-mobile-submenu-grid">
            <a href="https://knockio.com/features/" class="kh-mobile-view-all">
              <span class="kh-mobile-view-all-left">
                <BookOpen size={16} aria-hidden="true" />
                <span>View All Features</span>
              </span>
              <ArrowRight size={14} aria-hidden="true" />
            </a>
            {features.map(({ href, icon: Icon, label }) => (
              <a href={href} class="kh-mobile-submenu-link">
                <Icon size={16} aria-hidden="true" />
                <span>{label}</span>
              </a>
            ))}
            <div class="kh-mobile-marketing-divider">
              <div class="kh-marketing-header">
                <span class="kh-mobile-accordion-icon"><Megaphone size={16} aria-hidden="true" /></span>
                <p class="kh-marketing-label">Marketing</p>
              </div>
              <div class="kh-mobile-submenu-grid">
                {marketing.map(({ icon: Icon, label }) => (
                  <span class="kh-mobile-submenu-link kh-coming-soon-link" style="cursor: default;">
                    <span style="display: flex; align-items: center; gap: 0.75rem; min-width: 0;">
                      <Icon size={16} aria-hidden="true" />
                      <span style="min-width: 0;">{label}</span>
                    </span>
                    <span class="kh-coming-soon-badge">Coming soon</span>
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="kh-mobile-section">
        <button type="button" class="kh-mobile-accordion-toggle" aria-expanded="false" data-target="mobileIndustriesSubmenu">
          <span class="kh-mobile-accordion-left">
            <span class="kh-mobile-accordion-icon"><Building2 size={18} aria-hidden="true" /></span>
            <span class="kh-mobile-accordion-title">
              <span>Industries</span>
              <span>Solutions by business type</span>
            </span>
          </span>
          <ChevronDown size={12} class="kh-mobile-accordion-chevron" aria-hidden="true" />
        </button>
        <div id="mobileIndustriesSubmenu" class="kh-mobile-submenu" aria-hidden="true">
          <div class="kh-mobile-submenu-grid">
            <a href="https://knockio.com/industries/" class="kh-mobile-view-all" style="grid-column: 1 / -1;">
              <span class="kh-mobile-view-all-left">
                <BookOpen size={16} aria-hidden="true" />
                <span>View All Industries</span>
              </span>
              <ArrowRight size={14} aria-hidden="true" />
            </a>
          </div>
          <div class="kh-mobile-industries-grid" style="margin-top: 0.5rem;">
            {industries.map(({ href, label }) => (
              <a href={href} class="kh-mobile-submenu-link">
                <span>{label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="kh-mobile-simple-links">
        <a href="https://knockio.com/pricing/" class="kh-mobile-simple-link">
          <span class="kh-mobile-simple-icon"><DollarSign size={18} aria-hidden="true" /></span>
          <span>Pricing</span>
        </a>
        <a href="https://knockio.com/blog/" class="kh-mobile-simple-link">
          <span class="kh-mobile-simple-icon"><Newspaper size={18} aria-hidden="true" /></span>
          <span>Blog</span>
        </a>
      </div>

      <div class="kh-mobile-section" style="margin-top: 0.75rem;">
        <button type="button" class="kh-mobile-accordion-toggle" aria-expanded="false" data-target="mobileResourcesSubmenu">
          <span class="kh-mobile-accordion-left">
            <span class="kh-mobile-accordion-icon"><BookOpen size={18} aria-hidden="true" /></span>
            <span class="kh-mobile-accordion-title">
              <span>Resources</span>
              <span>Guides and playbooks</span>
            </span>
          </span>
          <ChevronDown size={12} class="kh-mobile-accordion-chevron" aria-hidden="true" />
        </button>
        <div id="mobileResourcesSubmenu" class="kh-mobile-submenu" aria-hidden="true">
          <div class="kh-mobile-submenu-grid">
            {resources.map(({ href, icon: Icon, label }) => (
              <a href={href} class="kh-mobile-submenu-link">
                <Icon size={16} aria-hidden="true" />
                <span>{label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="kh-mobile-ctas">
        <div class="kh-mobile-ctas-grid">
          <a href="https://app.knockio.com/" class="kh-btn-signin">Sign in</a>
          <a href="https://knockio.com/book-a-demo/" class="kh-btn-demo">Book a demo</a>
        </div>
      </div>
    </div>
  </div>
</aside>

<script>
  const DESKTOP_BREAKPOINT = 1180;
  const navbar = document.getElementById("mainNavbar");
  const mobileBtn = document.getElementById("mobileMenuBtn");
  const closeBtn = document.getElementById("mobileCloseBtn");
  const sidebar = document.getElementById("mobileSidebar");
  const overlay = document.getElementById("mobileMenuOverlay");
  const desktopDropdowns = document.querySelectorAll(".kh-dropdown");
  const accordionBtns = document.querySelectorAll(".kh-mobile-accordion-toggle");
  let lastFocused: Element | null = null;

  function normalizePath(v: string) {
    try {
      const u = new URL(v, window.location.origin);
      return decodeURIComponent(u.pathname || "/").replace(/\/{2,}/g, "/").replace(/\/$/, "") || "/";
    } catch { return ""; }
  }

  function isSamePage(el: HTMLAnchorElement) {
    if (!el || !el.getAttribute("href")) return false;
    const h = el.getAttribute("href")!;
    if (h === "#" || h.startsWith("javascript:")) return false;
    try {
      const u = new URL(h, window.location.origin);
      return u.origin === window.location.origin && normalizePath(u.href) === normalizePath(window.location.href);
    } catch { return false; }
  }

  function setActiveNav() {
    document.querySelectorAll("#mainNavbar a[href], #mobileSidebar a[href]").forEach((link) => {
      const a = link as HTMLAnchorElement;
      a.classList.remove("kh-nav-active", "kh-mega-link-active", "kh-mobile-link-active");
      if (!isSamePage(a)) return;
      if (a.closest("#mobileSidebar")) {
        a.classList.add("kh-mobile-link-active");
      } else if (a.closest(".kh-mega-menu")) {
        a.classList.add("kh-mega-link-active");
      } else {
        a.classList.add("kh-nav-active");
      }
    });

    desktopDropdowns.forEach((dd) => {
      const trigger = dd.querySelector(".kh-nav-trigger");
      if (!trigger) return;
      if (dd.querySelector(".kh-mega-link-active")) {
        trigger.classList.add("kh-trigger-active");
      } else {
        trigger.classList.remove("kh-trigger-active");
      }
    });

    accordionBtns.forEach((btn) => {
      const targetId = btn.getAttribute("data-target");
      const target = targetId ? document.getElementById(targetId) : null;
      if (!target) return;
      if (target.querySelector(".kh-mobile-link-active")) {
        btn.classList.add("kh-mobile-active", "is-open");
        btn.setAttribute("aria-expanded", "true");
        target.classList.add("is-open");
        target.setAttribute("aria-hidden", "false");
        const chev = btn.querySelector(".kh-mobile-accordion-chevron");
        if (chev) chev.classList.add("is-rotated");
      }
    });
  }

  function updateOnScroll() {
    if (!navbar) return;
    navbar.classList.toggle("kh-scrolled", window.scrollY > 12);
  }

  function closeAllDropdowns(except?: Element) {
    desktopDropdowns.forEach((dd) => {
      if (dd === except) return;
      const t = dd.querySelector(".kh-nav-trigger");
      if (t) t.setAttribute("aria-expanded", "false");
    });
  }

  function toggleDropdown(dd: Element) {
    const trigger = dd.querySelector(".kh-nav-trigger");
    if (!trigger) return;
    const open = trigger.getAttribute("aria-expanded") !== "true";
    closeAllDropdowns(dd);
    trigger.setAttribute("aria-expanded", String(open));
  }

  function toggleAccordion(btn: Element) {
    const targetId = btn.getAttribute("data-target");
    const target = targetId ? document.getElementById(targetId) : null;
    if (!target) return;
    const open = btn.getAttribute("aria-expanded") !== "true";

    accordionBtns.forEach((other) => {
      if (other === btn) return;
      const oId = other.getAttribute("data-target");
      const oTarget = oId ? document.getElementById(oId) : null;
      other.setAttribute("aria-expanded", "false");
      other.classList.remove("is-open");
      if (oTarget) {
        oTarget.classList.remove("is-open");
        oTarget.setAttribute("aria-hidden", "true");
      }
    });

    btn.setAttribute("aria-expanded", String(open));
    btn.classList.toggle("is-open", open);
    target.classList.toggle("is-open", open);
    target.setAttribute("aria-hidden", String(!open));
  }

  function openMobile() {
    if (!sidebar || !overlay || !mobileBtn) return;
    lastFocused = document.activeElement as Element | null;
    sidebar.classList.add("is-open");
    sidebar.setAttribute("aria-hidden", "false");
    overlay.classList.add("is-open");
    overlay.setAttribute("aria-hidden", "false");
    mobileBtn.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    setTimeout(() => closeBtn?.focus(), 50);
  }

  function closeMobile() {
    if (!sidebar || !overlay || !mobileBtn) return;
    sidebar.classList.remove("is-open");
    sidebar.setAttribute("aria-hidden", "true");
    overlay.classList.remove("is-open");
    overlay.setAttribute("aria-hidden", "true");
    mobileBtn.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    if (lastFocused) (lastFocused as HTMLElement).focus();
  }

  desktopDropdowns.forEach((dd) => {
    const trigger = dd.querySelector(".kh-nav-trigger");
    if (!trigger) return;
    trigger.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      toggleDropdown(dd);
    });
  });

  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest(".kh-dropdown")) {
      closeAllDropdowns();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeAllDropdowns();
      if (sidebar && sidebar.getAttribute("aria-hidden") === "false") closeMobile();
    }
    if (e.key === "Tab" && sidebar && sidebar.getAttribute("aria-hidden") === "false") {
      const focusable = Array.from(
        sidebar.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
      ).filter((el) => (el as HTMLElement).offsetParent !== null);
      if (!focusable.length) return;
      const first = focusable[0] as HTMLElement;
      const last = focusable[focusable.length - 1] as HTMLElement;
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  accordionBtns.forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      toggleAccordion(btn);
    });
  });

  if (mobileBtn) mobileBtn.addEventListener("click", openMobile);
  if (closeBtn) closeBtn.addEventListener("click", closeMobile);
  if (overlay) overlay.addEventListener("click", closeMobile);

  if (sidebar) {
    sidebar.addEventListener("click", (e) => {
      const accBtn = (e.target as Element).closest(".kh-mobile-accordion-toggle");
      if (accBtn && sidebar.contains(accBtn)) {
        e.preventDefault();
        e.stopPropagation();
        toggleAccordion(accBtn);
        return;
      }
      const link = (e.target as Element).closest('a[href]:not([href="#"])');
      if (link && !link.closest(".kh-coming-soon-link")) {
        closeMobile();
      }
    });
  }

  window.addEventListener("scroll", updateOnScroll, { passive: true });
  window.addEventListener("resize", () => {
    if (window.innerWidth > DESKTOP_BREAKPOINT) {
      closeMobile();
    } else {
      closeAllDropdowns();
    }
  });

  updateOnScroll();
  setActiveNav();
</script>
