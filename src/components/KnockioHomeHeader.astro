---
import {
  TrendingUp, DollarSign, Package, Receipt, ClipboardList, CalendarCheck,
  CreditCard, FileSignature, MessageSquare, ShieldCheck, MapPin,
  Footprints, Crosshair, Settings, BarChart3,
  Network, Zap, Shield, Waves, Truck, Warehouse,
  Paintbrush, Sparkles, Leaf, Droplets, Thermometer,
  Bug, Droplet, Home, Sun,
  Boxes, Wrench, Layers, Megaphone, Headphones, Bot, Filter,
  CloudLightning, Building2, BookOpen, Newspaper,
  ChevronDown, Menu, X, ArrowRight,
} from "lucide-astro";

const products = [
  { href: "https://knockio.com/canvassing/", icon: Footprints, label: "Door to Door Canvassing Software" },
  { href: "https://knockio.com/field-service-crm/", icon: Wrench, label: "Field Service CRM" },
];

const features = [
  { href: "https://knockio.com/features/sales-pipeline-software/", icon: TrendingUp, label: "Sales Pipeline" },
  { href: "https://knockio.com/features/estimate-software/", icon: DollarSign, label: "Estimates" },
  { href: "https://knockio.com/features/inventory-management-software/", icon: Package, label: "Inventory" },
  { href: "https://knockio.com/features/invoicing-software/", icon: Receipt, label: "Invoicing" },
  { href: "https://knockio.com/features/work-order-management-software/", icon: ClipboardList, label: "Work Orders" },
  { href: "https://knockio.com/features/appointment-scheduling-software/", icon: CalendarCheck, label: "Appointments" },
  { href: "https://knockio.com/features/payment-processing/", icon: CreditCard, label: "Payment Processing" },
  { href: "https://knockio.com/features/e-contracts-software/", icon: FileSignature, label: "E-Contracts" },
  { href: "https://knockio.com/features/business-texting-and-calling-software/", icon: MessageSquare, label: "Call Text and Email" },
  { href: "https://knockio.com/features/user-management-software/", icon: ShieldCheck, label: "User Management" },
  { href: "https://knockio.com/features/territory-management-software/", icon: MapPin, label: "Territory Management" },
  { href: "https://knockio.com/features/sales-canvassing-software/", icon: Footprints, label: "Sales Canvassing" },
  { href: "https://knockio.com/features/gps-tracking-software/", icon: Crosshair, label: "GPS Tracking" },
  { href: "https://knockio.com/features/business-automation-software/", icon: Settings, label: "Automations" },
  { href: "https://knockio.com/features/reporting-software/", icon: BarChart3, label: "Reports and Analytics" },
];

const industries = [
  { href: "https://knockio.com/industry/fiber-internet-sales-software-and-crm/", icon: Network, label: "Fiber Internet" },
  { href: "https://knockio.com/industry/electrical-contractor-software/", icon: Zap, label: "Electrical" },
  { href: "https://knockio.com/industry/home-security-sales-software-and-crm/", icon: Shield, label: "Home Security" },
  { href: "https://knockio.com/industry/pool-service-software/", icon: Waves, label: "Pool Service" },
  { href: "https://knockio.com/industry/junk-removal-software-and-crm/", icon: Truck, label: "Junk Removal" },
  { href: "https://knockio.com/industry/garage-door-service-software/", icon: Warehouse, label: "Garage Door" },
  { href: "https://knockio.com/industry/painting-contractor-software-and-crm/", icon: Paintbrush, label: "Painting" },
  { href: "https://knockio.com/industry/window-cleaning-business-software/", icon: Sparkles, label: "Window Cleaning" },
  { href: "https://knockio.com/industry/landscaping-business-software/", icon: Leaf, label: "Landscaping" },
  { href: "https://knockio.com/industry/restoration-job-management-software/", icon: Droplets, label: "Restoration" },
  { href: "https://knockio.com/industry/hvac-software-and-crm/", icon: Thermometer, label: "HVAC" },
  { href: "https://knockio.com/industry/pest-control-software/", icon: Bug, label: "Pest Control" },
  { href: "https://knockio.com/industry/plumbing-software-and-crm/", icon: Droplet, label: "Plumbing" },
  { href: "https://knockio.com/industry/roofing-sales-software-and-crm/", icon: Home, label: "Roofing" },
  { href: "https://knockio.com/industry/solar-sales-software-and-crm/", icon: Sun, label: "Solar" },
];

const marketing = [
  { icon: Headphones, label: "AI Receptionist" },
  { icon: Bot, label: "AI Chatbot" },
  { icon: Filter, label: "Lead Generation" },
];

const resources = [
  { href: "https://knockio.com/storm-playbook/", icon: CloudLightning, label: "Storm Playbook" },
  { href: "https://knockio.com/roofing-canvassing-guide-2026/", icon: Home, label: "Roofing Canvassing Guide" },
];
---

<header id="mainNavbar" class="kh-header">
  <div class="kh-header-inner">
    <a href="/" class="kh-logo" aria-label="Knockio home">
      <img src="/assets/cfw/knockio-logo.webp" alt="Knockio" width="179" height="36" decoding="async" />
    </a>

    <nav class="kh-desktop-nav" aria-label="Main navigation">
      <ul>
        <li class="kh-dropdown">
          <button type="button" class="kh-nav-trigger" aria-expanded="false" aria-controls="productsMegaMenu">
            <span>Products</span>
            <ChevronDown size={10} class="kh-chevron" aria-hidden="true" />
          </button>
          <div id="productsMegaMenu" class="kh-mega-menu" role="region" aria-label="Products menu">
            <div class="kh-mega-panel">
              <div class="kh-mega-head">
                <div class="kh-mega-head-text">
                  <p class="kh-mega-kicker">Knockio Products</p>
                  <p class="kh-mega-sub">Choose the workflow built for your team.</p>
                </div>
              </div>
              <div class="kh-mega-grid" style="grid-template-columns: repeat(2, 1fr);">
                {products.map(({ href, icon: Icon, label }) => (
                  <a href={href} class="kh-mega-link">
                    <span class="kh-mega-ic"><Icon size={18} aria-hidden="true" /></span>
                    <span class="kh-mega-label">{label}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </li>

        <li class="kh-dropdown">
          <button type="button" class="kh-nav-trigger" aria-expanded="false" aria-controls="featuresMegaMenu">
            <span>Features</span>
            <ChevronDown size={10} class="kh-chevron" aria-hidden="true" />
          </button>
          <div id="featuresMegaMenu" class="kh-mega-menu kh-mega-features" role="region" aria-label="Features menu">
            <div class="kh-mega-panel">
              <div class="kh-mega-head">
                <div class="kh-mega-head-text">
                  <p class="kh-mega-kicker">Knockio Features</p>
                  <p class="kh-mega-sub">Everything you need to manage field sales and service.</p>
                </div>
                <a href="https://knockio.com/features/" class="kh-mega-cta-btn">
                  View all features
                  <ArrowRight size={14} aria-hidden="true" />
                </a>
              </div>
              <div class="kh-features-layout">
                <div class="kh-features-grid">
                  {features.map(({ href, icon: Icon, label }) => (
                    <a href={href} class="kh-mega-link">
                      <span class="kh-mega-ic"><Icon size={18} aria-hidden="true" /></span>
                      <span class="kh-mega-label">{label}</span>
                    </a>
