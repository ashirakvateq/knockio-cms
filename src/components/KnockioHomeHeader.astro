                <aside class="kh-marketing-column">
                  <div class="kh-marketing-header">
                    <span class="kh-mega-ic"><Megaphone size={18} aria-hidden="true" /></span>
                    <p class="kh-marketing-label">Marketing</p>
                  </div>
                  <div class="kh-marketing-items">
                    {marketing.map(({ icon: Icon, label }) => (
                      <span class="kh-coming-soon-link">
                        <span class="kh-mega-ic"><Icon size={18} aria-hidden="true" /></span>
                        <span class="kh-mega-label">{label}</span>
                        <span class="kh-coming-soon-badge">Coming soon</span>
                      </span>
                    ))}
