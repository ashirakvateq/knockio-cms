    <div class="kh-actions">
      <button id="mobileMenuBtn" type="button" class="kh-mobile-toggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobileSidebar">
        <Menu size={20} aria-hidden="true" />
      </button>
      <a href="https://app.knockio.com/" class="kh-btn-signin">Sign in</a>
      <a href="https://knockio.com/book-a-demo/" class="kh-btn-demo">Book a demo</a>
    </div>
