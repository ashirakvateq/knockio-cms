              </div>
            </div>
          </div>
        </li>

        <li class="kh-dropdown">
          <button type="button" class="kh-nav-trigger" aria-expanded="false" aria-controls="industriesMegaMenu">
            <span>Industries</span>
            <ChevronDown size={10} class="kh-chevron" aria-hidden="true" />
          </button>
          <div id="industriesMegaMenu" class="kh-mega-menu kh-mega-industries" role="region" aria-label="Industries menu">
            <div class="kh-mega-panel">
              <div class="kh-mega-head">
                <div class="kh-mega-head-text">
                  <p class="kh-mega-kicker">Industries</p>
                  <p class="kh-mega-sub">Built for field sales and service businesses.</p>
                </div>
                <a href="https://knockio.com/industries/" class="kh-mega-cta-btn">
                  View all industries
                  <ArrowRight size={14} aria-hidden="true" />
                </a>
              </div>
              <div class="kh-mega-grid kh-mega-scroll">
                {industries.map(({ href, icon: Icon, label }) => (
                  <a href={href} class="kh-mega-link">
                    <span class="kh-mega-ic kh-mega-ic-sm"><Icon size={16} aria-hidden="true" /></span>
                    <span class="kh-mega-label">{label}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </li>

        <li><a href="https://knockio.com/pricing/" class="kh-nav-link">Pricing</a></li>
        <li><a href="https://knockio.com/blog/" class="kh-nav-link">Blog</a></li>

        <li class="kh-dropdown">
          <button type="button" class="kh-nav-trigger" aria-expanded="false" aria-controls="resourcesMegaMenu">
            <span>Resources</span>
            <ChevronDown size={10} class="kh-chevron" aria-hidden="true" />
          </button>
          <div id="resourcesMegaMenu" class="kh-mega-menu" role="region" aria-label="Resources menu">
            <div class="kh-mega-panel">
              <div class="kh-mega-head">
                <div class="kh-mega-head-text">
                  <p class="kh-mega-kicker">Knockio Resources</p>
                  <p class="kh-mega-sub">Practical guides for roofing sales and storm campaigns.</p>
                </div>
              </div>
              <div class="kh-mega-grid" style="grid-template-columns: repeat(2, 1fr);">
                {resources.map(({ href, icon: Icon, label }) => (
                  <a href={href} class="kh-mega-link">
                    <span class="kh-mega-ic"><Icon size={18} aria-hidden="true" /></span>
