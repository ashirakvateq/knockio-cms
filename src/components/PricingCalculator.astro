---
import { Calculator, TrendingUp, Users, Phone, UserCheck, PhoneCall, Building } from 'lucide-astro';
---

<section class="bg-neutral-50/80 py-12 max-xl:py-10">
  <div class="my-container">
    <div
      data-kio-calc
      class="relative mx-auto max-w-5xl overflow-hidden rounded-[2rem] border border-solid border-neutral-200 bg-white p-5 shadow-xl shadow-neutral-900/5 sm:p-6 lg:p-8"
    >
      <div class="pointer-events-none absolute -right-20 -top-20 h-56 w-56 rounded-full bg-primary-500/10"></div>
      <div class="pointer-events-none absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-neutral-100"></div>

      <div class="relative z-10">
        <div class="mb-6 flex flex-col gap-4 border-b border-neutral-100 pb-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <span class="mb-3 inline-flex items-center gap-2 rounded-full bg-[#0f172a] px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-white">
              <Calculator class="size-4 text-primary-400" strokeWidth={2.5} />
              Quick Estimate
            </span>
            <h3 class="mt-3 font-inter text-2xl font-bold leading-tight text-neutral-950 sm:text-3xl">
              Estimate your monthly cost
            </h3>
            <p class="mt-2 text-sm text-neutral-600 sm:text-base">
              Choose your plan, users, and Engage phone numbers to preview pricing.
            </p>
          </div>
          <div class="hidden h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-primary-500 text-white sm:flex">
            <TrendingUp class="size-5" />
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          <div class="rounded-2xl border border-solid border-neutral-200 bg-neutral-50 p-4 transition-all focus-within:border-primary-500/40 focus-within:bg-white focus-within:shadow-md">
            <label for="kio-users" class="mb-2 block text-xs font-bold uppercase tracking-wider text-neutral-950">Total Users</label>
            <div class="relative">
              <input
                id="kio-users"
                data-kio-users
                type="number"
                min="1"
                value="1"
                inputmode="numeric"
                class="min-h-[48px] w-full rounded-xl border border-solid border-neutral-200 bg-white px-4 pr-11 text-sm font-medium outline-none focus:border-primary-500 focus:ring-4 focus:ring-primary-500/10"
              />
              <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-neutral-400">
                <Users class="size-4" />
              </span>
            </div>
          </div>

          <div class="rounded-2xl border border-solid border-neutral-200 bg-neutral-50 p-4 transition-all focus-within:border-primary-500/40 focus-within:bg-white focus-within:shadow-md">
            <label for="kio-plan" class="mb-2 block text-xs font-bold uppercase tracking-wider text-neutral-950">Plan Type</label>
            <div class="relative">
              <select
                id="kio-plan"
                data-kio-plan
                class="min-h-[48px] w-full appearance-none rounded-xl border border-solid border-neutral-200 bg-white px-4 pr-11 text-sm font-medium outline-none focus:border-primary-500 focus:ring-4 focus:ring-primary-500/10"
                style="background-image: url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2216%22 height=%2216%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%236b7280%22 stroke-width=%222%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22%3E%3Cpolyline points=%226 9 12 15 18 9%22%3E%3C/polyline%3E%3C/svg%3E'); background-repeat: no-repeat; background-position: right 12px center; background-size: 16px;"
              >
                <option value="prospect" selected>Prospect — Field Sales</option>
                <option value="growth">Growth — All-In-One</option>
                <option value="organize">Organize — Field Service</option>
                <option value="scale">Scale — 100+ Users</option>
              </select>
            </div>
          </div>

          <div class="rounded-2xl border border-solid border-neutral-200 bg-neutral-50 p-4 transition-all focus-within:border-primary-500/40 focus-within:bg-white focus-within:shadow-md">
            <label for="kio-lines" class="mb-2 block text-xs font-bold uppercase tracking-wider text-neutral-950">Phone Numbers</label>
            <div class="relative">
              <input
                id="kio-lines"
                data-kio-lines
                type="number"
                min="0"
                value="0"
                inputmode="numeric"
                placeholder="0"
                class="min-h-[48px] w-full rounded-xl border border-solid border-neutral-200 bg-white px-4 pr-11 text-sm font-medium outline-none focus:border-primary-500 focus:ring-4 focus:ring-primary-500/10"
              />
              <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-neutral-400">
                <Phone class="size-4" />
              </span>
            </div>
            <p class="mt-2 text-xs text-neutral-500">Engage add-on, $15 per phone number.</p>
          </div>
        </div>

        <div class="mt-6 overflow-hidden rounded-2xl bg-[#0f172a]">
          <div class="grid grid-cols-1 items-center gap-5 p-5 sm:p-6 lg:grid-cols-12">
            <div class="lg:col-span-5">
              <p class="mb-1 text-xs font-bold uppercase tracking-wider text-primary-400">Estimated Total</p>
              <div data-kio-total class="font-inter text-3xl font-extrabold text-white sm:text-4xl">$25 / mo</div>
              <div data-kio-billing-label class="mt-1 text-sm text-neutral-300">Billed monthly</div>
            </div>
            <div class="lg:col-span-7">
              <div class="rounded-2xl border border-solid border-white/10 bg-white/[0.04] p-4">
                <p class="mb-2 text-xs font-bold uppercase tracking-wider text-neutral-400">Breakdown</p>
                <div data-kio-breakdown class="text-sm font-medium leading-6 text-white">1 user × $25</div>
              </div>
            </div>
          </div>
          <div class="grid grid-cols-1 border-t border-white/10 sm:grid-cols-3">
            <div class="flex items-center gap-3 border-white/10 p-4 sm:border-r">
              <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary-500/15 text-primary-400">
                <UserCheck class="size-4" />
              </span>
              <span class="text-xs text-neutral-300">Volume pricing starts at 5 users</span>
            </div>
            <div class="flex items-center gap-3 border-white/10 p-4 sm:border-r">
              <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary-500/15 text-primary-400">
                <PhoneCall class="size-4" />
              </span>
              <span class="text-xs text-neutral-300">Engage phone numbers are optional</span>
            </div>
            <div class="flex items-center gap-3 p-4">
              <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary-500/15 text-primary-400">
                <Building class="size-4" />
              </span>
              <span class="text-xs text-neutral-300">Scale pricing is customized for 100+ users</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
