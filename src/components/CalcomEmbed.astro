---
import CalendarLoadingCopy from "./CalendarLoadingCopy.astro";
---

<!-- Book a Demo / Calendly CTA Section -->
<section id="cal-sec" class="py-36 max-xl:py-28 max-lg:py-20 max-md:py-16">
  <div class="my-container">
    <div
      class="mx-auto max-w-[1440px] rounded-3xl bg-[linear-gradient(90deg,#0b1f12_0%,#0f2a17_100%)] px-6 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28 xl:px-16"
    >
      <!-- Heading Content -->
      <div class="mx-auto mb-10 max-w-3xl text-center max-md:mb-8">
        <p
          class="mb-3 text-sm font-medium leading-7 text-primary-500 md:text-2xl"
        >
          See Knockio In Action
        </p>
        <h2
          class="mb-0 text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-[42px] lg:leading-none xl:text-5xl 2xl:text-[56px]"
        >
          Book a Demo Now!
        </h2>
      </div>
      <!-- Cal.com Calendar Embed -->
      <div class="cal-shell mx-auto mt-12 max-w-5xl p-2 sm:p-3 lg:p-4">
        <CalendarLoadingCopy />
        <div
          id="my-cal-inline"
          class="mx-auto grid place-items-center overflow-hidden min-h-[680px] max-w-5xl rounded-2xl bg-white p-4 sm:min-h-[720px] sm:p-6"
          aria-live="polite"
          aria-busy="false"
          aria-label="Book a demo"
          role="region"
        >
        </div>
      </div>
    </div>
  </div>
</section>
